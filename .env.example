# Nothing here is needed for local work. With neither URL set, the database module reaches the
# container in docker-compose.yml: the owner at postgres://lumischool:lumischool@localhost:8502/lumischool
# and the app role at postgres://lumischool_app:lumischool_app@localhost:8502/lumischool. The tests make
# their own database on the same container, one per test process (lumischool_test_<pid>), built from
# the migrations on every run, and drop the ones whose process has ended.

# The owner: runs migrations and writes the catalogue. It must be a superuser or have BYPASSRLS,
# because every table forces row-level security. Never what a server uses to answer a request.
# DATABASE_URL=postgres://owner:password@host:5432/lumischool

# The app role: what the server connects as, only through withFamily in server/db/client.ts. It must be
# neither a superuser nor able to bypass row-level security; the migration refuses to finish if it is.
# APP_DATABASE_URL=postgres://lumischool_app:password@host:5432/lumischool

# How long the app role waits: seconds for a connection, and milliseconds for any one statement.
# DB_CONNECT_TIMEOUT=10
# DB_STATEMENT_TIMEOUT=10000

# Set to 1 in CI so the database tests fail, rather than skip, when there is no database.
# LUMISCHOOL_REQUIRE_DB=1

# The API server (.docs/api.md). LUMISCHOOL_ENV must be local or production; local is what
# `npm run dev:api` and `npm run dev` set, and production also needs APP_ORIGIN, AUTH_PEPPER,
# RESEND_API_KEY and RESEND_FROM below, since it refuses to start without any of them.
# LUMISCHOOL_ENV=local

# The fixed port and address, overridable so a second checkout can run beside the first. Locally the
# address must be a loopback one, since the local routes answer only on this computer.
# API_PORT=8501
# API_HOST=127.0.0.1

# Render injects PORT and the server reads it before API_PORT, so this is set in production only,
# never by hand; API_PORT is what a local checkout uses.
# PORT=8501

# The one origin: the only one a state-changing request may come from, and the only one CORS answers.
# Locally the scratchpad's http://localhost:5173 is accepted as well. Required in production, where it
# must start with https:// and is the only origin, with no scratchpad exception.
# APP_ORIGIN=http://localhost:8500

# The key for sign-in codes, the family PIN and network hashes, kept out of the database. A fixed value
# is used locally; in production it must be set and must not be that local value, since a code hashed
# under one would match the other.
# AUTH_PEPPER=

# The fixed code the code step accepts beside the emailed one, eight digits, 12345678 when unset. Locally
# only: the server refuses to start with it set anywhere else, since there it would sign in anyone.
# AUTH_DEV_CODE=12345678

# Resend, which sends every email in production; the console transport is local only. Required in
# production, since an emailed code is the only way to sign in and a server that cannot send is worse
# than one that refuses to start. RESEND_FROM is the address mail comes from; there is no default,
# since the sending domain is not finalized yet.
# RESEND_API_KEY=
# RESEND_FROM=
# RESEND_WEBHOOK_SECRET=  # Signing secret for /api/email/webhook
# WEEKLY_EMAIL_ENABLED=1 # Scheduler only; parents must also opt in at /letters

# The header naming the caller's real address behind Render's proxy, read only in production, where the
# socket belongs to the load balancer and not the caller. Never x-forwarded-for as a whole, which a
# client can seed and Render only appends to. Not required; cf-connecting-ip, Cloudflare's header, is
# the default when unset.
# CLIENT_IP_HEADER=cf-connecting-ip

# The server-only key for adult authoring requests. There is no child route for Gemini, and its output
# remains untrusted until the notation verifier and a person accept it.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
