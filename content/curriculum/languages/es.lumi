# The Spanish phrasebook: every phrase the language lessons name, by key, in Castilian as it is
# spoken in Spain. A typed answer in a box written accents=loose may leave the acute accent and the
# diaeresis off; ñ is a letter of its own and is always marked.
phrasebook es v=1 lenient=[acute, diaeresis] {
  name "Spanish"
  variety "Castilian, as spoken in Spain"
  entry aboutme.a-bit "un poco" gloss="a bit"
  entry aboutme.also "también" gloss="also"
  entry aboutme.and "y" gloss="and"
  entry aboutme.as-well-as-that "además" gloss="as well as that"
  entry aboutme.because "porque" gloss="because"
  entry aboutme.because-it-is-cold "porque hace frío" gloss="because it is cold"
  entry aboutme.because-it-is-hot "porque hace calor" gloss="because it is hot"
  entry aboutme.because-there-is-no-beach "porque no hay playa" gloss="because there is no beach"
  entry aboutme.but "pero" gloss="but"
  entry aboutme.chatty-and-fun "habladora y divertida" gloss="chatty and fun"
  entry aboutme.delights "encanta" gloss="delights"
  entry aboutme.favourite "favorita" gloss="favourite, for a feminine word"
  entry aboutme.gazpacho "el gazpacho" gloss="gazpacho"
  entry aboutme.has-lives "tiene ... vive" gloss="has ... lives"
  entry aboutme.however "sin embargo" gloss="however"
  entry aboutme.i-am-twelve "Tengo doce años." gloss="I am twelve."
  entry aboutme.i-do-not-like "no me gusta" gloss="I do not like"
