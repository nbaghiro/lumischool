lesson k-listen-and-point v=1 format=teach grade=0 unit=9 subject=reading levels=[easy, medium, hard] {
  title "Listen and point"
  goal "Hear the first sound of a word and point to its letter among more letters than before, including the first letter of a name."

  look {
    scene 30x7 {
      lettercards cards letters=["b", "r", "f", "l", "g", "j"] at=canvas(1, 1)
    }
    say """
      More letters now: b, r, f, l, g and j. Listen to a word, say its first sound, and point to the
      card. Bus starts with b. Red starts with r. A name starts with a capital letter, so Ben starts
      with a big B.
      """
  }
  do {
    level easy {
      worked k.point-first-sound k=0 level=medium
    }
    practice k.point-first-sound count=2 seed=2
    practice k.word-for-letter count=2 seed=3
    practice k.name-starts count=2 seed=4 easy-count=1
    practice k.same-sound-animal count=2 seed=5
  }
  try stars=2 {
    show k.cat-and-kite k=0 hard-k=1
  }
  try stars=3 {
    show k.own-word letter="b" easy-letter="m" hard-letter="s"
  }
  remember {
    say "Listen for the first sound, then find its letter."
  }

  grown-ups """
    Say each word clearly and let the child say it back before pointing. The harder cards look
    alike, b and d, g and q, w and v, so if the child picks a look-alike, trace both letters with a
    finger and say their sounds. The three-star question is for you to listen to. Off the page, play
    I spy with the new letters, and point out the first letter of names on post and on signs.
    England, Reception, ELG Word Reading: "Say a sound for each letter in the alphabet and at least
    10 digraphs".
    """
  level easy {
    grown-ups "At this level the words start with b, r, f and l, one is worked in the teacher's pen first, the words to hear are short, and the three-star letter is m."
  }
  level hard {
    grown-ups "At this level the words start with g, j, w and v beside look-alike cards, the two-star is cup and kid, and the three-star letter is s."
  }
}
