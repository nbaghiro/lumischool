lesson k-reading-little-words v=1 format=teach grade=0 unit=4 subject=reading levels=[easy, medium, hard] {
  title "Reading little words"
  goal "Read a three-letter word alone by blending its sounds."

  look {
    scene 14x7 {
      lettercards word letters=["c", "a", "t"] at=canvas(1, 1)
    }
    say """
        No buttons this time and nobody says the word. Look at each card and say its sound: c, a, t.
        Now push the sounds together: cat. You have read a word by yourself.
      """
  }
  do {
    level easy {
      worked k.read-the-cards k=0 p=0 level=medium
    }
    practice k.read-the-cards count=2 seed=2
    practice k.word-matches count=3 seed=3 easy-count=2
    practice k.which-word count=2 seed=4 easy-count=1
    show k.read-and-do w="hop" easy-w="sit" hard-w="nod"
  }
  try stars=2 {
    show k.which-sound-wrong k=0 hard-k=1
  }
  try stars=3 {
    show k.sit-on-it k=0 hard-k=1
  }
  remember {
    say "Say each sound, then push them together into a word."
  }

  grown-ups """
    This lesson is different: do not read the word aloud, because reading it is the child's job.
    Sound buttons blended words with a dot under each sound; this is the step on from it, the same
    blending with no buttons and no picture to start from. Read only the question to the child. If
    the child guesses from the first letter, cover the word and reveal one card at a time. Off the
    page, write little words on cards and hide them round the house to read when found. England,
    Reception, ELG Word Reading (recalled, not fetched): "Read words consistent with their phonic
    knowledge by sound-blending".
    """
  level easy {
    grown-ups "At this level cat is read in the teacher's pen first, the words are cat and dog, and the words that match their pictures do."
  }
  level hard {
    grown-ups "At this level the words are pig, hen and fox, the words that differ from their pictures by one vowel are asked, and the three-star finds something to eat."
  }
}
