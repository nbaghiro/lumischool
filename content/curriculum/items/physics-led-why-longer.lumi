# Two stars: why the LED lasts longer on the same cell. It wastes less of its energy heating, so it
# needs fewer joules each second for the same light.
item physics.led-why-longer v=1 stars=2 skills=[physics.energy, reasoning.explain] {
  title "Why the LED lasts longer"

  scene 24x44 {
    energyflow a thing="filament bulb" from="electricity" to="light" input=100 useful=5 wasted=[95] wastes=["heating"] blank=-1 unit=J at=canvas(1, 0)
    energyflow b thing="LED" from="electricity" to="light" input=100 useful=40 wasted=[60] wastes=["heating"] blank=-1 unit=J below=a gap=1
    text ask "On the same cell, an LED as bright as this bulb stays lit about eight times as long. Why?" narrate width=22 below=b gap=1
    choice pick options=["It wastes less by heating", "Its cell stores more", "It makes some energy too", "It gives out less light"] stack=column below=ask gap=1
  }

  answer pick="It wastes less by heating"
  feedback {
    when (pick == "Its cell stores more") point=ask {
      say "It is the same cell both times. Compare the heating bands."
    }
    when (pick == "It makes some energy too") point=b {
      say "Nothing makes energy. The LED's bands out add up to its band in, just as the bulb's do."
    }
    when (pick == "It gives out less light") point=ask {
      say "The two are as bright as each other. What does each do with the rest of its joules?"
    }
  }
  hint "Compare the heating bands of the two lamps."
  hint "For the same light, which lamp has to be given fewer joules each second?"
}
