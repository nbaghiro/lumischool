# The way in to a scaled bar chart: each square is worth the scale's step, so a bar's height is read
# off the numbered axis, not counted in squares. The slip is reading the squares as ones.
item data.scale-read v=1 skills=[data.bar-charts, data.scales, multiplication.tables] {
  title "Read a bar on a scale"
  difficulty (pick(s, 0, 1, 2) + b / 10)
  let s=0..2 a=2..8 b=2..8 c=2..8
  let p={pick(s, 2, 5, 10)}
  where (a != b and b != c)
  level easy {
    let s={0}
  }
  level hard {
    let s={2}
  }

  scene 36x16 {
    bargraph chart labels=["A", "B", "C"] values=[a, b, c] max=9 color=mint per=p at=canvas(1, 0)
    text ask "The lab planted three trays of beans and counted the sprouts. How many sprouts are in tray B?" narrate width=19 right-of=chart gap=2
    number-input answer width=3 below=ask gap=1
    microscope mic slide=1 lamp=1 right-of=answer gap=6
  }

  answer (p * b)
  feedback {
    when (answer == b) point=chart {
      say "That counts squares. Read the number on the scale beside the top of the bar."
    }
  }
  hint "What does the scale go up in? Read the numbers up the side."
  hint "Follow the top of bar B across to the scale."
}
