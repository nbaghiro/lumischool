# Linking adverbials (joining words) that hold a piece together across sentences, each matched to
# its job. The jobs' list turns with r.
item writing.joining-word-job v=1 skills=[writing.cohesion, writing.joining-sentences] {
  title "What does each linking adverbial do?"
  difficulty k
  let k=0..1 r=0..2
  let s1={pick(k, "However", "After that")}
  let s2={pick(k, "Meanwhile", "Also")}
  let s3={pick(k, "As a result", "Finally")}
  let c1={pick(k, "turns the other way", "comes next in time")}
  let c2={pick(k, "at the same time", "adds one more")}
  let c3={pick(k, "says what it caused", "comes last")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 34x23 {
    text ask "Linking adverbials, the joining words at the start of a sentence, tell a reader how it follows the one before. Write the number of each one's job." narrate width=32 at=canvas(1, 0)
    row bottom below=ask gap=1 space=2 align=start {
      clocktower tower hour=12 minute=0
      match m left=["{s1}", "{s2}", "{s3}"] right=["{if r == 0 then c2 else if r == 1 then c3 else c1}", "{if r == 0 then c3 else if r == 1 then c1 else c2}", "{if r == 0 then c1 else if r == 1 then c2 else c3}"] blanks=[x, y, z]
    }
  }

  answer x=(if r == 0 then 3 else if r == 1 then 2 else 1) y=(if r == 0 then 1 else if r == 1 then 3 else 2) z=(if r == 0 then 2 else if r == 1 then 1 else 3)
  hint "Say a sentence about the clock tower, then start the next one with each adverbial. What does the word make the next sentence do?"
  hint "Some adverbials are about time, some about adding, some about turning or causing."
}
