# A reason in the core: a kitchen scale brought from Earth measures how hard a thing presses on its
# pan and was set where each kilogram presses with 10 N, so on the Moon it shows 1.6 / 10 of the mass.
item physics.moon-kitchen-scale v=1 skills=[physics.weight, physics.measuring, reasoning.backwards] {
  title "A kitchen scale on the Moon"
  difficulty v
  let v=0..3
  level easy {
    let v=0..1
  }
  level hard {
    let v=2..3
  }
  let shown={pick(v, 160, 320, 240, 400)}

  scene 34x44 {
    dialscale d max=1000 step=100 value=shown unit=g at=canvas(1, 0)
    text ask "A kitchen scale shows how hard a thing presses on its pan, and it was set on Earth, where each kilogram presses with 10 N. On the Moon, where each kilogram presses with 1.6 N, a bag of rock on it shows {shown} g. What is the rock's mass, in kilograms?" narrate width=32 below=d gap=1
    number-input mass below=ask gap=1
    text then "Why does the scale show less than the rock's mass?" narrate width=32 below=mass gap=1
    choice pick options=["It measures the pull, and the Moon pulls less", "The rock has less mass on the Moon", "The Moon's rock is made of lighter stuff", "Scales do not work without air"] stack=column below=then gap=1
  }

  answer mass=(if shown % 160 == 0 then plain(shown / 160) else decimals(shown / 160, 1)) pick="It measures the pull, and the Moon pulls less"
  feedback {
    when (mass == shown / 1000) point=d {
      say "That is what the dial shows in kilograms. The scale was set for Earth's pull, and the Moon pulls less."
    }
    when (pick == "The rock has less mass on the Moon") point=d {
      say "Nothing has been taken off the rock. What does the scale really measure?"
    }
  }
  hint "On Earth this bag would press with 10 N for each kilogram. How hard does it press on the Moon?"
  hint "The scale shows 160 g for every kilogram that sits on it on the Moon. How many lots of 160 g are there?"
}
