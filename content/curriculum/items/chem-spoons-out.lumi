# How many spoons' worth of alum come out as a full warm cup cools to a colder row of the table.
item chem.spoons-out v=1 skills=[chemistry.crystals, subtraction.to-twenty] {
  title "How much comes out?"
  difficulty (if to == 20 then 1 else 0)
  let from={40, 60} to={10, 20}
  let hot={if from == 40 then 6 else 14}
  let cold={if to == 10 then 2 else 3}
  level easy {
    let to={10}
  }
  level hard {
    let to={20}
  }

  scene 34x17 {
    crystalstring jar days=3 crystals=4 kind=alum at=canvas(0, 0)
    text ask "A cup of water at {from} °C holds {hot} spoons of alum; at {to} °C it holds {cold}. A cup of {from} °C water dissolved all {hot} spoons and then cooled to {to} °C with a string in it. How many spoons' worth of alum grew on the string?" narrate width=20 right-of=jar gap=1
    number-input answer below=jar gap=1
  }

  answer (hot - cold)
  feedback {
    when (answer == hot) point=jar {
      say "That is all the alum that went in. The water at {to} °C still holds {cold} spoons of it."
    }
    when (answer == cold and cold != hot - cold) point=jar {
      say "That is the alum that stays dissolved. The rest of the {hot} spoons is what came out."
    }
  }
  hint "How many spoons can the water still hold once it is at {to} °C? The rest cannot stay in."
  hint "Take what stays dissolved from all that went in."
}
