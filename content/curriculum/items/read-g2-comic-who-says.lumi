# Both people are in every panel, so the tail of the bubble is what says who is talking.
item reading.comic-who-says v=1 skills=[reading.comics, reading.characters] {
  title "Who is talking?"
  let k=0..2 j=1..3

  scene 36x16 {
    comic strip who=[if k == 0 then "boy" else if k == 1 then "girl" else "gran", if k == 0 then "gran" else if k == 1 then "boy" else "kid", if k == 0 then "boy" else if k == 1 then "girl" else "gran"] says=[if k == 0 then "Can we go to the park?" else if k == 1 then "Where is my sock?" else "Who ate the last biscuit?", if k == 0 then "Put your coat on first." else if k == 1 then "Is it under the bed?" else "Not me.", if k == 0 then "I have got it on now." else if k == 1 then "Yes, here it is." else "Then why are there crumbs on your chin?"] moods=[if k == 0 then "happy" else if k == 1 then "worried" else "cross", if k == 0 then "happy" else if k == 1 then "happy" else "worried", if k == 0 then "excited" else if k == 1 then "surprised" else "happy"] with=[if k == 0 then "gran" else if k == 1 then "boy" else "kid", if k == 0 then "boy" else if k == 1 then "girl" else "gran", if k == 0 then "gran" else if k == 1 then "boy" else "kid"] thinks=[if k == 0 then 0 else if k == 1 then 0 else 0, if k == 0 then 0 else if k == 1 then 0 else 0, if k == 0 then 0 else if k == 1 then 0 else 0] holds=[if k == 0 then "" else if k == 1 then "" else "", if k == 0 then "" else if k == 1 then "" else "", if k == 0 then "" else if k == 1 then "" else ""] labels=["1", "2", "3"] at=canvas(1, 0)
    text ask "Who is talking in picture {j}?" narrate width=16 below=strip gap=1
    choice pick options=[if k == 0 then "the boy" else if k == 1 then "the girl" else "Gran", if k == 0 then "Gran" else if k == 1 then "the boy" else "the child"] right-of=ask gap=1
  }

  answer pick=(if j == 2 then if k == 0 then "Gran" else if k == 1 then "the boy" else "the child" else if k == 0 then "the boy" else if k == 1 then "the girl" else "Gran")
  hint "Find the bubble in picture {j}. Both people are there."
  hint "Follow the tail of the bubble. Whose mouth does it point to?"
}
