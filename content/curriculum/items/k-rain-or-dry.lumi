item k.rain-or-dry v=1 skills=[nature.weather] {
  title "Is it raining?"
  difficulty 0
  let r=0..1

  scene 24x14 {
    cloud c puffs=4 rain=r at=canvas(1, 1)
    text ask "Look at the cloud. Is it raining?" narrate width=22 below=c gap=1
    choice pick options=["yes", "no"] stack=row below=ask gap=1
  }

  answer pick=(if r == 1 then "yes" else "no")
  hint "Look under the cloud. Is anything falling from it?"
}
