# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.pencil-case-match v=1 skills=[language.school, language.questions] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[school.the-pencil]]", "[[school.the-scissors]]", "[[school.the-felt-pen]]"), pick(k, "[[school.the-rubber]]", "[[school.the-exercise-book]]", "[[school.the-brush]]"), pick(k, "[[school.the-ruler]]", "[[school.the-school-bag]]", "[[school.the-crayon]]"), pick(k, "[[school.the-book]]", "[[school.the-glue]]", "[[school.the-sharpener]]")] right=[pick(k, "the ruler", "the glue", "the crayon"), pick(k, "the pencil", "the scissors", "the felt pen"), pick(k, "the rubber", "the exercise book", "the sharpener"), pick(k, "the book", "the school bag", "the brush")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
