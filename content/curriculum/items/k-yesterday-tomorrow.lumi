item k.yesterday-tomorrow v=1 skills=[coding.sequences, time.days] {
  title "Yesterday and tomorrow"
  difficulty (if w == 0 then 0 else 1)
  let m=1..5 w=0..1
  level easy {
    let w={0}
  }
  level hard {
    let w={1}
  }

  scene 28x13 {
    days week mark=m start=0 at=canvas(1, 1)
    text q "The ringed day is today. Which day was {if w == 0 then \"tomorrow\" else \"yesterday\"}? Say which card, counting from the left." narrate width=26 below=week gap=1
    number-input answer below=q gap=1
  }

  answer (if w == 0 then m + 2 else m)
  hint "Put a finger on today. Tomorrow is the next card along; yesterday is the one before."
}
