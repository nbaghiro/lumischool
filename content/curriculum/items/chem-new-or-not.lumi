# The way in: the before and after are both drawn, so the child judges whether the stuff after is
# still the same stuff in a different state or something new.
item chem.new-or-not v=1 skills=[chemistry.changes] {
  title "Something new?"
  difficulty (if c == "dissolve-sugar" or c == "rise-dough" or c == "fizz" or c == "rust-nail" then 2 else if c == "boil-water" or c == "burn-candle" then 1 else 0)
  let c={"toast-bread", "cook-egg", "bake-cake", "burn-candle", "rust-nail", "fizz", "rise-dough", "melt-ice", "freeze-water", "melt-chocolate", "boil-water", "dissolve-sugar"}
  level easy {
    let c={"melt-ice", "freeze-water", "melt-chocolate", "toast-bread", "cook-egg", "bake-cake"}
  }
  level hard {
    let c={"dissolve-sugar", "boil-water", "rise-dough", "fizz", "rust-nail", "burn-candle"}
  }

  scene 31x8 {
    row kit at=canvas(1, 0) space=1 align=start {
      beforeafter ch change=c show=1 names=1
      column side space=1 align=start {
        text ask "Does this change make a new material?" width=14
        choice pick options=["yes", "no"]
      }
    }
  }

  check chem.change of=ch pick=new
  hint "Is the stuff after the change still the same stuff, only warmer, colder or runnier?"
  hint "Could you get back exactly what you started with?"
}
