item coding.define-where v=1 skills=[coding.procedures] {
  title "Where does the zigzag end?"
  difficulty (z + a)
  let a=1..2 z=2..3

  scene 31x22 {
    row top at=canvas(1, 0) space=1 align=start {
      program p code=["define zigzag", "  right 1", "  down 1", "repeat {z}", "  zigzag", "right {a}"]
      maze g cols=6 rows=5 code=["define zigzag", "  right 1", "  down 1", "repeat {z}", "  zigzag", "right {a}"] upto=0 trail=none
    }
    text ask "Which square does the robot stop on?" width=16 below=top gap=1
    row ans below=ask gap=1 space=1 align=centre {
      text lc "column"
      number-input col width=3
      text lr "row"
      number-input row width=3
    }
  }

  check coding.runs of=g col=col row=row
  hint "Line 1 only says what zigzag means. The program starts at line 4."
}
