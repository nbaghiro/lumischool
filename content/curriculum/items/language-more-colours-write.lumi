# The word written from its picture: [[colour.pink]], [[colour.orange]], [[colour.grey]], [[colour.brown]], [[colour.purple]], [[colour.green]].
# Accent-tolerant: the box takes the word with its accents left off (accents=loose); ñ is a letter and is marked.
item language.more-colours-write v=1 skills=[language.colours, language.spelling] {
  title "Write the word"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x16 {
    column all at=canvas(1, 1) space=1 align=start {
      mixingtray tray wells=["{pick(k, \"pink\", \"orange\", \"black+white\", \"brown\", \"red+blue\", \"green\")}"] labels=true
      text ask "Write this colour in [[language.name]]." width=32
      word-input word options=[pick(k, "[[colour.pink]]", "[[colour.orange]]", "[[colour.grey]]", "[[colour.brown]]", "[[colour.purple]]", "[[colour.green]]")] accents=loose
    }
  }

  answer word=pick(k, "[[colour.pink]]", "[[colour.orange]]", "[[colour.grey]]", "[[colour.brown]]", "[[colour.purple]]", "[[colour.green]]")
  hint "Say the word quietly first. What sound does it start with?"
  hint "Count the sounds, then write one letter or pair of letters for each."
}
