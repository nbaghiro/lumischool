# An eleventh puzzle for the hard sheet: times on the clock tower's 24-hour display that read the same
# backwards. Listing hour by hour, and seeing that the minutes are the hour reversed, is the system.
item puzzle.mirror-times v=1 stars=3 skills=[time.twenty-four-hour, reasoning.systematic] {
  title "Times that read both ways"
  difficulty s
  let s=0..1

  scene 32x12 {
    digital clock time="12:21" at=canvas(1, 1)
    text ask "The clock tower's display shows 12:21, which reads the same backwards. How many times {if s == 0 then \"in a whole day, from 00:00 to 23:59,\" else \"from midday, 12:00, to 23:59\"} read the same backwards?" narrate width=18 right-of=clock gap=2
    number-input answer width=3 below=ask gap=1
  }

  answer (if s == 0 then 16 else 8)
  feedback {
    when (answer == (if s == 0 then 24 else 12)) point=ask {
      say "Not every hour has one. For 17:00 to 17:59 the minutes would have to be 71."
    }
  }
  hint "For each hour, what would the minutes have to be? Is that a real time?"
  hint "The minutes are the hour's two digits the other way round. Which hours give minutes under 60?"
}
