# Value contrast at the focal point: the eye goes to the greatest difference of light and dark, so
# the tone for the thing that matters is the one furthest from the tone round it.
item art.earth-contrast v=1 skills=[art.composition, art.tone, reasoning.compare] {
  title "The tone that pulls the eye"
  difficulty (if k == 2 then 1 else 0)
  let k=0..2
  let r={(k + 1) % 3}
  let what={pick(k, "the lander, against a sky of tone 5", "a footprint in shadow, on ground in the sun of tone 1", "the Earth, against a sky of tone 4")}
  let right={pick(k, "Tone 1", "Tone 5", "Tone 1")}
  let w1={pick(k, "Tone 4", "Tone 2", "Tone 3")}
  let w2={pick(k, "Tone 3", "Tone 3", "Tone 5")}
  level easy {
    let k={0, 1}
  }
  level hard {
    let k={1, 2}
  }

  scene 36x16 {
    tonescale scale steps=5 blank=-1 ring=-1 at=canvas(1, 1)
    text ask "The tones are numbered 1, white, to 5, black. Ada wants the eye to go first to {what}. Which tone should she paint it?" width=34 below=scale gap=1
    choice pick options=[if r == 0 then right else if r == 1 then w1 else w2, if r == 0 then w1 else if r == 1 then w2 else right, if r == 0 then w2 else if r == 1 then right else w1] below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=scale {
      say "The eye goes first to the biggest jump from light to dark. Which tone is furthest along the scale from the tone round it?"
    }
  }
  hint "What tone is round the thing? Find it on the scale."
  hint "Which of the three tones is furthest from it along the scale?"
}
