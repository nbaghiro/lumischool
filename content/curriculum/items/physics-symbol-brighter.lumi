# Predict, then check: two diagrams, with nothing lit in either, and the brighter bulbs are the ones
# with more cells shared among them.
item physics.symbol-brighter v=1 skills=[physics.circuits, physics.symbols, reasoning.compare] {
  title "Which bulbs are brighter?"
  difficulty (4 - 2 * abs(ca / na - cb / nb))
  let ca=1..3 na=1..2 cb=1..3 nb=1..2
  where (ca != cb or na != nb)
  level easy {
    where (abs(ca / na - cb / nb) >= 1)
  }
  level hard {
    where (abs(ca / na - cb / nb) <= 1 / 2)
  }

  scene 34x19 {
    row two at=canvas(1, 0) space=1 align=start {
      series a cells=ca bulbs=na show=0 symbols=1 tag="A"
      series b cells=cb bulbs=nb show=0 symbols=1 tag="B"
    }
    text ask "Which circuit has the brighter bulbs?" narrate width=30 below=two gap=0
    choice pick options=["A", "B", "The same"] below=ask gap=1
  }

  check physics.circuit of=a vs=b pick=brighter
  hint "How many cells does each bulb get in each loop?"
  hint "More cells to each bulb is brighter. Work out cells divided by bulbs for each."
}
