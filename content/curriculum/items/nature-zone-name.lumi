# The way in: a short description of a place and the zone it belongs to. The plain ones name their
# animal; the harder ones give only the warmth, the rain and the plants.
item nature.zone-name v=1 skills=[nature.zones, nature.habitats] {
  title "Which zone is it?"
  difficulty (if k <= 2 then 0 else 1)
  let k=0..5
  let told={pick(k, "Hot and dry nearly all year, with sand, rock and a few tough plants. Camels cross it.", "Cold, with a short cool summer. The ground stays frozen deep down, and only moss, lichen and small bushes grow. Reindeer graze it.", "Hot and wet all year, with tall trees so close their tops make a roof. Parrots and monkeys live high up.", "Long cold winters and mild summers, with enough rain for tall fir trees as far as you can see.", "Warm summers and cold winters, too dry for many trees, so grass covers the land as far as you can see.", "Ice and snow all year, and the sea frozen most of it. Nothing grows on the land at all.")}
  let right={pick(k, "desert", "tundra", "rainforest", "fir forest", "grassland", "ice")}
  let o1={pick(k, "grassland", "ice", "fir forest", "tundra", "desert", "tundra")}
  let o2={pick(k, "rainforest", "fir forest", "grassland", "rainforest", "fir forest", "desert")}
  let x1={pick(k, right, o1, o2, o1, right, o2)}
  let x2={pick(k, o1, right, o1, right, o2, o1)}
  let x3={pick(k, o2, o2, right, o2, o1, right)}
  level easy {
    let k=0..2
  }
  level hard {
    let k=3..5
  }

  scene 36x25 {
    row all at=canvas(1, 1) space=2 align=end {
      iceberg ib under=0
      firs fr count=1 snow=1
      camel cm
      parrot pr
    }
    text ask "Ada and Ben's atlas has a page for each zone of life between the North Pole and the equator. One page says: {told} Which zone is it?" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=all {
      say "Take the clues one at a time: how warm, how wet, and what grows. Which zone fits all three?"
    }
  }
  hint "Is it hot or cold? Wet or dry?"
  hint "What grows there: nothing, moss, grass, fir trees, or tall trees in a roof?"
}
