# Choosing by the job: the thing that would make a towel is the one that soaks up water, whatever
# its shape. At hard the wrong ones are the soft, bendy things that keep water out.
item chem.for-a-towel v=1 skills=[chemistry.materials] {
  title "Which would make a towel?"
  difficulty (if k >= 2 then 1 else 0)
  let k=0..3 p=0..2
  let a={pick(k, "wool-sock", "paper-book", "towel", "wool-hat")}
  let b={pick(k, "metal-can", "glass-bottle", "raincoat", "rubber-boot")}
  let c={pick(k, "metal-key", "plastic-spoon", "plastic-bottle", "rubber-band")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 24x13 {
    text ask "Mia wants to dry her wet hands. Which of these is made of something that would do the job?" width=23 at=canvas(1, 0)
    materials row things=["{if p == 0 then a else if p == 1 then b else c}", "{if p == 0 then b else if p == 1 then c else a}", "{if p == 0 then c else if p == 1 then a else b}"] below=ask gap=0
    choice pick options=["A", "B", "C"] below=row gap=0
  }

  check chem.materials of=row pick="only(absorbent)"
  hint "Drying hands means the water has to go into the thing. Which one soaks water up?"
  hint "A thing that keeps water out leaves the water on your hands."
}
