# The parts of one letter's single movement, in order: the curl first for every letter of the
# family, then what makes it a, d or g.
item writing.movement-parts v=1 skills=[writing.letter-formation, reasoning.order] {
  title "One movement, in order"
  difficulty (if ch == "g" then 1 else 0)
  let ch={"a", "d", "g"} p=0..2
  let s1={pick(0, "Curl round to the left, like c")}
  let s2={if ch == "a" then "Close the curl up to the top" else if ch == "d" then "Go up tall to the top line" else "Close the curl and go down past the line"}
  let s3={if ch == "a" then "Straight down the right side to the line" else if ch == "d" then "Straight down to the line" else "Hook round to the left under the line"}
  let w1={pick(p, s1, s3, s2)}
  let w2={pick(p, s2, s1, s3)}
  let w3={pick(p, s3, s2, s1)}
  level easy {
    let ch={"a", "d"} p=0..1
  }
  level hard {
    let ch={"g"} p=1..2
  }

  scene 34x24 {
    formletter big letter=ch copies=0 write=0 label=true at=canvas(1, 1)
    text ask "The letter {ch} is one movement. Its parts are muddled. Number them 1, 2, 3 in the order the pencil goes." narrate width=18 right-of=big gap=1
    sequence s items=["{w1}", "{w2}", "{w3}"] blanks=[x, y, z] below=big gap=1
  }

  answer x=(if p == 0 then 1 else if p == 1 then 3 else 2) y=(if p == 0 then 2 else if p == 1 then 1 else 3) z=(if p == 0 then 3 else if p == 1 then 2 else 1)
  feedback {
    when ((if p == 0 then x else if p == 1 then y else z) != 1) point=big {
      say "Every letter in the family starts the same way, with the curl. Look at where the dot is."
    }
  }
  hint "Find the dot: what does the pencil do first? Every curly letter starts with c's curl."
  hint "After the curl, follow the arrows: where does the pencil go, and where does it finish?"
}
