# Two repeat untils one after the other: drive until something is in the way, turn, and drive
# again. Where the rocks are decides where it stops.
item coding.until-wall v=1 skills=[coding.decisions, coding.repetition] {
  title "Until something is in the way"
  difficulty (if k == 2 then 2 else if k == 0 then 1 else 0)
  let k=0..2

  scene 36x17 {
    row top at=canvas(1, 0) space=1 align=start {
      program p code=["repeat until wall ahead", "  forward 1", "turn right", "repeat until wall ahead", "  forward 1"]
      maze g map=["{if k == 0 then \"S . . # . .\" else if k == 1 then \"S . . . # .\" else \"S . # . . .\"}", ". . . . . .", "{if k == 1 then \". . . # . .\" else \". . . . . .\"}", "{if k == 0 then \". . # . . .\" else \". . . . . .\"}"] code=["repeat until wall ahead", "  forward 1", "turn right", "repeat until wall ahead", "  forward 1"] upto=0 trail=none
    }
    text ask "Which square does the robot stop on?" width=16 below=top gap=1
    row ans right-of=ask gap=1 space=1 align=centre {
      text lc "column"
      number-input col width=3
      text lr "row"
      number-input row width=3
    }
  }

  check coding.runs of=g col=col row=row
  hint "The robot starts facing right. How far can it go before a rock or the edge is in front of it?"
  hint "Turn right means turn from the robot's own side. Which way is it facing now?"
}
