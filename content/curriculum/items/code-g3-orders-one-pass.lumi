# All the orders of three cards, sorted by what the first pass does to them: six orders to list and
# test, and the count changes with the number of swaps asked about.
item coding.orders-one-pass v=1 stars=3 skills=[coding.algorithms, reasoning.all-the-ways] {
  title "Six orders"
  difficulty k
  let k=0..2

  scene 33x11 {
    sortcards c cards=[3, 1, 2] compare=0 swap=false at=canvas(1, 0)
    column q right-of=c gap=2 space=1 align=start {
      text ask "The cards 1, 2 and 3 can be put in six different orders. For how many of them does the first pass make exactly {k} swap{if k == 1 then \"\" else \"s\"}?" width=18
      number-input answer
    }
  }

  answer (if k == 0 then 1 else if k == 1 then 3 else 2)
  hint "Write all six orders down first, starting 1 2 3 and 1 3 2."
  hint "Do one pass on each order and count its swaps."
}
