# The language to English: [[phrase.what-time-do-you-get-up]], [[phrase.on-saturdays-i-get-up-late]], [[phrase.first-i-have-a-shower-and-then-i-have-br]], [[phrase.in-the-afternoon-i-play-in-the-park]], [[phrase.before-i-go-to-sleep-i-read-a-book]], [[phrase.my-brother-goes-to-bed-at-eight]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.my-day-meaning v=1 skills=[language.time, language.sentences] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "girl", "boy", "gran", "girl")] says=[pick(k, "[[phrase.what-time-do-you-get-up]]", "[[phrase.on-saturdays-i-get-up-late]]", "[[phrase.first-i-have-a-shower-and-then-i-have-br]]", "[[phrase.in-the-afternoon-i-play-in-the-park]]", "[[phrase.before-i-go-to-sleep-i-read-a-book]]", "[[phrase.my-brother-goes-to-bed-at-eight]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "My brother goes to bed at eight.", "In the afternoon I play in the park.", "On Saturdays I get up late.", "My brother goes to bed at eight.", "My brother goes to bed at eight.", "In the afternoon I play in the park."), pick(k, "What time do you get up?", "On Saturdays I get up late.", "Before I go to sleep, I read a book.", "In the afternoon I play in the park.", "First I have a shower and then I have breakfast.", "My brother goes to bed at eight."), pick(k, "First I have a shower and then I have breakfast.", "Before I go to sleep, I read a book.", "In the afternoon I play in the park.", "On Saturdays I get up late.", "Before I go to sleep, I read a book.", "First I have a shower and then I have breakfast."), pick(k, "Before I go to sleep, I read a book.", "First I have a shower and then I have breakfast.", "First I have a shower and then I have breakfast.", "First I have a shower and then I have breakfast.", "In the afternoon I play in the park.", "Before I go to sleep, I read a book.")] stack=column
    }
  }

  answer pick=pick(k, "What time do you get up?", "On Saturdays I get up late.", "First I have a shower and then I have breakfast.", "In the afternoon I play in the park.", "Before I go to sleep, I read a book.", "My brother goes to bed at eight.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
