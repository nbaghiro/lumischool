# A machine turns a rule into something you can watch happen, which is where algebra starts.
item machine.one-step v=1 skills=[algebra.function-machines] {
  title "What comes out"
  difficulty (r * n)
  let r={3, 4, 6, 8} n=3..9

  scene 30x15 {
    machine box rule="× {r}" input="{n}" output="?" at=canvas(1, 1)
    text ask "What comes out of the machine?" narrate below=box gap=1
    number-input answer below=ask gap=1
  }

  answer (r * n)
  feedback {
    when (answer == r + n) point=box {
      say "The machine multiplies by {r}, it does not add {r}."
    }
  }
  hint "{n} lots of {r}."
}
