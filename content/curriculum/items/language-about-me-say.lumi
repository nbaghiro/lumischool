# Writing, read by a grown-up who ticks what they see (writing.by-eye).
item language.about-me-say v=1 skills=[language.reading, language.writing, language.writing] {
  title "Write about yourself"
  let k=0..2

  scene 34x10 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "{pick(k, \"Write five sentences about yourself in [[language.name]], using Sara's text as a model: your name and age, where you live, what you look like, what you like, and one reason with because.\", \"Write about a friend in [[language.name]] in five sentences: their name, their age, what they look like, what they are like and what they like.\", \"Write eight sentences about yourself in [[language.name]], using and, but, because and also at least once each.\")}" width=32
    }
  }

  check writing.by-eye look-for="Sentences that each say one thing, a verb in the right person, describing words that match, and because giving a reason." notice=["Name, age and where you live", "What you look like and are like", "A like with a reason", "And, but or because joining ideas"]
  hint "Follow Sara's text, one sentence at a time."
  hint "Change each fact to your own."
}
