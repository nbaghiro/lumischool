# Counting metals from the shaded key: rows two to four hold 2, 3 and 2 metals, and rows two and three
# hold 6 and 5 elements that are not metals, the metalloids boron and silicon among them.
item chem.metals-in-row v=1 skills=[chemistry.metals, chemistry.elements] {
  title "How many metals?"
  difficulty w
  let w=0..1 r=2..4
  where (w == 0 or r <= 3)
  let asks={pick(w, pick(r - 2, "How many elements in row 2 are metals?", "How many elements in row 3 are metals?", "How many elements in row 4 are metals?"), pick(r - 2, "How many elements in row 2 are not metals?", "How many elements in row 3 are not metals?", ""))}
  let want={pick(w, pick(r - 2, "count(metal 2)", "count(metal 3)", "count(metal 4)"), pick(r - 2, "count(not-metal 2)", "count(not-metal 3)", ""))}
  level easy {
    let w=0..0
  }
  level hard {
    let w=1..1
  }

  scene 36x13 {
    periodic t rows=4 blank=0 mark=0 shade=metal at=canvas(1, 0)
    text ask "{asks}" narrate width=13 right-of=t gap=1
    number-input answer below=ask gap=1
  }

  check chem.elements of=t answer="{want}"
  hint "Read the key. Which cells are metals?"
  hint "{pick(w, \"Count the shaded cells in that row only.\", \"How many cells are in that row, and how many of them are shaded?\")}"
}
