# Four words to their English, 4 sets, the later sets with the words most often mixed up.
item language.my-family-match v=1 skills=[language.family] {
  title "Match the words"
  difficulty pick(k, 0, 0, 1, 2)
  let k=0..3

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[family.mother]]", "[[family.grandfather]]", "[[family.daughter]]", "[[family.parents]]"), pick(k, "[[family.father]]", "[[family.grandmother]]", "[[family.granddaughter]]", "[[family.grandparents]]"), pick(k, "[[family.brother]]", "[[family.brother]]", "[[family.sister]]", "[[family.brothers-and-sisters]]"), pick(k, "[[family.sister]]", "[[family.mother]]", "[[family.grandmother]]", "[[family.family]]")] right=[pick(k, "brother", "mother", "sister", "grandparents"), pick(k, "mother", "grandfather", "daughter", "family"), pick(k, "father", "grandmother", "grandmother", "brothers and sisters"), pick(k, "sister", "brother", "granddaughter", "parents")] blanks=[a, b, c, d]
    }
  }

  answer a=pick(k, 2, 2, 2, 4) b=pick(k, 3, 3, 4, 1) c=pick(k, 1, 4, 1, 3) d=pick(k, 4, 1, 3, 2)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
