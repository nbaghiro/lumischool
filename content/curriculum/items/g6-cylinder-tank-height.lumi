# The unknown moves to the height: the volume shared by the area of the base.
item volume.cylinder-tank-height v=1 skills=[volume.cylinders, reasoning.inverse] {
  title "How tall is the tank"
  difficulty (r / 2 + h / 10)
  let r={1, 3, 4, 5} h={2, 3, 4, 6}
  level easy {
    let r={1, 3} h={2, 3}
  }
  level hard {
    let r={4, 5} h={4, 6}
  }

  scene 33x15 {
    circleparts base size=5 lines=1 radius=r unit="m" at=canvas(1, 1)
    text ask "A round water tank by the waterfall holds {r * r * 3.14 * h} m³. Its base has the radius shown. Using 3.14, how tall is the tank, in metres?" narrate width=16 right-of=base gap=2
    number-input answer width=3 below=ask gap=1
  }

  answer h
  feedback {
    when (answer == r * r * 3.14 * h / (2 * r * 3.14)) point=base {
      say "That shared by the distance round. Share by the area of the base: radius times radius times 3.14."
    }
  }
  hint "What is the area of the base?"
  hint "How many layers of that area make the whole volume?"
}
