# The month of the family's festival, found on the year wheel from its season.
item history.nation-festival-month v=1 skills=[history.nation, time.months] {
  title "Which month?"
  let n=0..4
  let fest={pick(n, "Bonfire Night", "Independence Day", "Children's Day", "New Year's Day", "National Day")}
  let key={pick(n, "November", "July", "May", "January", "October")}
  let two={pick(n, "March", "December", "August", "June", "April")}
  let three={pick(n, "July", "February", "January", "September", "July")}

  scene 34x16 {
    yearwheel wheel seasons=true mark="" at=canvas(1, 0)
    text ask "In which month do we keep {fest}?" narrate width=16 right-of=wheel gap=2
    choice pick options=["{two}", "{key}", "{three}"] stack=column below=ask gap=1
  }

  answer pick=key
  hint "Is it a warm time of year or a cold one?"
  hint "Find that season on the wheel, then read its months."
}
