# The two-star reason for each country's unit: how we know about a time or why a date is what it
# is (n as in n3-order).
item history.n3-why v=1 skills=[history.nation, reasoning.why] {
  title "How do we know?"
  let n=0..4
  let ask={pick(n, "The people of Skara Brae left no writing. How do we know how they lived?", "The people of Cahokia left no books. How do we know how big their town was?", "Why did so many families buy an electric rice cooker in the 1950s and 1960s?", "People lived where Moscow is long before 1147. Why do we give 1147 as its first date?", "The farmers of Banpo left no writing. How do we know they farmed?")}
  let right={pick(n, "From the houses and things they left behind", "From the mounds and houses archaeologists dug up", "It saved hours of work every day", "It is the first time it was written down", "From the seeds, tools and store pits dug up")}
  let w1={pick(n, "From their letters", "From their newspapers", "Rice cookers were free", "Moscow was founded that year", "From their diaries")}
  let w2={pick(n, "We cannot know anything", "From photographs of the town", "The law said every family must have one", "Nobody lived there before", "From a book they wrote about farming")}

  scene 36x26 {
    timeline line from=-4000 to=2000 step=1000 years=[] labels=[] at=canvas(1, 0)
    text ask "{ask}" narrate width=34 below=line gap=1
    choice pick options=["{right}", "{w1}", "{w2}"] stack=column below=ask gap=1
  }

  answer pick=right
  hint "Could people in that time have written it down?"
  hint "What is left for us to look at today?"
}
