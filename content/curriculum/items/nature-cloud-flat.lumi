# The two-star reason: why the cloudy day's line is nearly flat, and why the sunny day's peak comes in
# the afternoon and not at noon. The reasons are the sun warming the ground, and the time that takes.
item nature.cloud-flat v=1 stars=2 skills=[nature.weather, reasoning.explain] {
  title "Why that shape?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..1
  let told={pick(k, "On the cloudy day the temperature at the hut hardly changed from morning to evening. Why?", "The sun is highest at about 12 o'clock, but the sunny day was warmest at 14 o'clock. Why?")}
  let right={pick(k, "The cloud kept the sunshine off the ground all day", "The ground and air go on warming after noon")}
  let o1={pick(k, "Clouds are made of cold air", "The thermometer is slow")}
  let o2={pick(k, "There was no wind that day", "The sun is hotter after lunch")}
  let x1={pick(k, o1, right)}
  let x2={pick(k, right, o2)}
  let x3={pick(k, o2, o1)}
  level easy {
    let k={0}
  }
  level hard {
    let k={1}
  }

  scene 36x32 {
    row all at=canvas(1, 1) space=2 align=end {
      linegraph g labels=["6", "8", "10", "12", "14", "16", "18"] values=[4, 7, 11, 15, 17, 15, 11] max=18 per=2 color=tang
      cloud cl puffs=4 rain=0
    }
    text ask "{told}" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=g {
      say "The air is warmed mostly by the ground, and the ground by the sunshine. Follow that chain."
    }
  }
  hint "What warms the ground, and what warms the air near it?"
  hint "What stops that warming, and does it stop the moment the sun starts to sink?"
}
