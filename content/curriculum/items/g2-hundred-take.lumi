# A hundred take away a two-digit number: two exchanges in a row, or a count up from the smaller.
item sub.from-hundred v=2 skills=[subtraction.columns, subtraction.within-hundred] {
  title "Take it from a hundred"
  difficulty (100 - b)
  let b=13..87
  where (b % 10 != 0)
  level easy {
    let b=71..87
  }
  level hard {
    let b=13..29
  }

  scene 22x13 {
    columns diff a=100 b=b op=sub at=canvas(1, 1)
    text ask "Take {b} away from 100 in the columns. There are no ones and no tens to take from, so start with the hundred." width=20 below=diff gap=1
  }

  answer diff=(100 - b)
  feedback {
    when (diff == 110 - b) point=diff {
      say "The ten you moved into the ones came from the tens, so there is one ten fewer."
    }
  }
  hint "Can you count up from {b} to the next ten, and then on to 100?"
  hint "In columns: the hundred becomes ten tens, then one of those tens becomes ten ones."
}
