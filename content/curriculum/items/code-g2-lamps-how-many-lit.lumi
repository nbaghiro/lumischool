# The lamps are all dark, so the child has to split the number into 8, 4, 2 and 1 before counting
# how many are lit: the audit's raise for the biggest-lamp question.
item coding.lamps-how-many-lit v=1 skills=[coding.data] {
  title "How many lamps are lit?"
  difficulty (n + 3 * (n // 8 % 2 + n // 4 % 2 + n // 2 % 2 + n % 2))
  let n={3, 5, 6, 7, 9, 10, 11, 12, 13, 14, 15}
  level easy {
    let n={3, 5, 6, 7}
  }
  level hard {
    let n={11, 13, 14, 15}
  }

  scene 29x7 {
    lamps l bits=4 n=0 at=canvas(1, 0)
    text ask "The lamps show {n}. How many lamps are lit?" width=14 right-of=l gap=1
    number-input answer below=ask gap=1
  }

  answer (n // 8 % 2 + n // 4 % 2 + n // 2 % 2 + n % 2)
  feedback {
    when (answer == n) point=l {
      say "Each lamp is worth a lot, not 1. Which lamps add up to {n}?"
    }
  }
  hint "Start with the biggest lamp. Is {n} as big as 8?"
  hint "Take away the lamps you have used. Which lamp makes the rest?"
}
