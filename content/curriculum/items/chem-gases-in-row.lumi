# Reading the key: the gases at 20 °C are shaded, from the states in ELEMENTS (RSC periodic table).
# Row two has nitrogen, oxygen, fluorine and neon; row three chlorine and argon; the first 18 hold 10 solids.
item chem.gases-in-row v=1 skills=[chemistry.elements, chemistry.states] {
  title "Gases in the table"
  difficulty w
  let w=0..1 r=2..3
  let asks={pick(w, pick(r - 2, "How many elements in row 2 are gases at 20 °C?", "How many elements in row 3 are gases at 20 °C?"), "How many of all the elements drawn are solids at 20 °C? No element drawn is a liquid.")}
  let want={pick(w, pick(r - 2, "count(gas 2)", "count(gas 3)"), "count(solid)")}
  level easy {
    let w=0..0
  }
  level hard {
    let w=1..1
  }

  scene 36x11 {
    periodic t rows=3 blank=0 mark=0 shade=gas at=canvas(1, 0)
    text ask "{asks}" narrate width=13 right-of=t gap=1
    number-input answer below=ask gap=1
  }

  check chem.elements of=t answer="{want}"
  hint "Read the key under the table. What does a shaded cell mean?"
  hint "{pick(w, \"Count the shaded cells in that row only.\", \"An element that is not a gas or a liquid is a solid. Which cells are not shaded?\")}"
}
