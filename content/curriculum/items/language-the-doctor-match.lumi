# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.the-doctor-match v=1 skills=[language.body, language.sentences] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[body.the-head]]", "[[body.the-foot]]", "[[body.the-temperature]]"), pick(k, "[[body.the-arm]]", "[[body.the-back]]", "[[body.the-cough]]"), pick(k, "[[body.the-leg]]", "[[body.the-throat]]", "[[body.the-syrup]]"), pick(k, "[[body.the-hand]]", "[[body.the-stomach]]", "[[body.the-chemist-s]]")] right=[pick(k, "the leg", "the stomach", "the syrup"), pick(k, "the head", "the foot", "the temperature"), pick(k, "the arm", "the back", "the chemist's"), pick(k, "the hand", "the throat", "the cough")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
