# Air cooled until the most it can hold equals the water it holds starts to drop it as dew: the dew
# point, from the rounded HyperPhysics table. The unknown is the dew point or how far to cool.
item chem.dew-point v=1 skills=[chemistry.water-cycle, data.tables] {
  title "When do the drops form?"
  difficulty (w * 2 + (if r <= 3 then 0 else 1))
  let w=0..1 r=2..5 s={20, 25, 30}
  let h={pick(r, 2, 5, 7, 9, 13, 17)}
  let d={pick(r, -10, 0, 5, 10, 15, 20)}
  where (s > d and (w == 1 or s == 25))
  level easy {
    let w=0..0 r=2..3
  }
  level hard {
    let w=1..1
  }

  scene 35x29 {
    table data cols=2 head=["Air °C", "Most water, g per m³"] cells=["-10", "2", "0", "5", "5", "7", "10", "9", "15", "13", "20", "17", "25", "23", "30", "30"] at=canvas(1, 0)
    text ask "Outside the hut the air is {s} °C, and each cubic metre holds {h} g of water vapour. Tonight the air cools. {if w == 0 then \"At what temperature will dew first form on the grass?\" else \"How many degrees must the air cool before dew forms?\"}" narrate width=34 below=data gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then d else s - d)
  feedback {
    when (w == 1 and answer == d and s != 2 * d) point=data {
      say "That is the temperature where dew forms. How far is it from {s} °C?"
    }
    when (w == 0 and answer == s) point=data {
      say "At {s} °C the air can hold more than {h} g, so no drops form yet. Keep cooling it."
    }
  }
  hint "Drops form when the air can hold no more than the water it has. Find {h} g in the table."
  hint "{if w == 0 then \"Read across to the temperature.\" else \"Read across to the temperature. How far is that from where the air started?\"}"
}
