item k.above-below v=1 skills=[space.position] {
  title "Above or below?"
  difficulty k
  let k=0..1
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 22x18 {
    picturecards card who=["cat"] where=[pick(k, "on", "under")] thing=["table"] letters=false at=canvas(1, 1)
    text q "The cat is by the garden table. Is it above the table or below it?" narrate width=20 below=card gap=1
    choice pick options=["above", "below"] stack=row below=q gap=1
  }

  answer pick=(if k == 0 then "above" else "below")
  hint "Is the cat higher than the table top, or lower?"
}
