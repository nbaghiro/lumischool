# Testing a job part by part: each part should go from one thing to the next, so the part with the
# mistake is the first one whose moves do not match the gap it has to cross. Every part after it is
# right but starts in the wrong place, which is the trap.
item coding.parts-which-wrong v=1 skills=[coding.decomposition, coding.debugging, coding.tracing] {
  title "Which part has the mistake?"
  difficulty (if k == 1 then 2 else if k == 2 then 1 else 0)
  let a=1..2 b=1..2 c=1..2 d=1..2 e=1..2 f=1..2 k=1..3
  where (d <= b and a + c + e <= 5 and b - d + f <= 2 and (k != 2 or d < b))
  level easy {
    let k={3}
  }
  level hard {
    let k={1}
  }

  scene 36x38 {
    row top at=canvas(1, 0) space=2 align=start {
      maze g cols=7 rows=5 gems=[1 + a, 1 + b, 1 + a + c, 1 + b - d] flag=[1 + a + c + e, 1 + b - d + f] code=["right {a}", "down {if k == 1 then b + 1 else b}", "right {c}", "up {if k == 2 then d + 1 else d}", "right {e}", "down {if k == 3 then f + 1 else f}"]
      column parts space=1 align=start {
        program p1 code=["right {a}", "down {if k == 1 then b + 1 else b}"] title="Part 1"
        program p2 code=["right {c}", "up {if k == 2 then d + 1 else d}"] title="Part 2"
        program p3 code=["right {e}", "down {if k == 3 then f + 1 else f}"] title="Part 3"
      }
    }
    text ask "Part 1 should take the robot to the first gem, part 2 on to the second gem, and part 3 to the flag. The line shows where it really went. Which part has the mistake?" narrate width=34 below=top gap=1
    choice pick options=["Part 1", "Part 2", "Part 3"] below=ask gap=1
  }

  answer pick=(if k == 1 then "Part 1" else if k == 2 then "Part 2" else "Part 3")
  feedback {
    when (k == 1 and pick == "Part 3") point=g {
      say "The robot is far from the flag, but check the first part first. Does it reach the first gem?"
    }
    when (k == 2 and pick == "Part 3") point=g {
      say "The last part starts in the wrong place. Did the part before it reach its gem?"
    }
    when (k == 2 and pick == "Part 1") point=g {
      say "The first part does reach the first gem. Check the next part."
    }
  }
  hint "Test the parts in order. Does the first part end on the first gem?"
  hint "For the first part that misses, count the squares from where it should start to where it should end."
}
