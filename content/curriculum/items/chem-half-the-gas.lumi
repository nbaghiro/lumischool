# Three stars: soda water filled full of gas at one temperature, warmed step by step; the first
# temperature in the table at which it has had to let go of more than half its gas. Tenths of a gram
# a litre from Wikipedia's carbon dioxide data page: 33, 23, 17, 13, 10, 8 at 0 to 50 °C.
item chem.half-the-gas v=1 stars=3 skills=[chemistry.gases, reasoning.constraints, data.tables] {
  title "Half the gas gone"
  difficulty k
  let k=0..2
  level easy {
    let k={0}
  }
  level hard {
    let k={2}
  }
  let start={pick(k, 0, 10, 20)}
  let right={pick(k, "30 °C", "40 °C", "50 °C")}

  scene 35x28 {
    table data cols=2 head=["Water °C", "Carbon dioxide, g a litre"] cells=["0", "3.3", "10", "2.3", "20", "1.7", "30", "1.3", "40", "1.0", "50", "0.8"] at=canvas(1, 0)
    text ask "A litre of soda water holds all the carbon dioxide it can at {start} °C, and is warmed ten degrees at a time. At which temperature in the table has it first had to let go of more than half of its gas?" narrate width=28 below=data gap=1
    choice pick options=["10 °C", "20 °C", "30 °C", "40 °C", "50 °C"] stack=row below=ask gap=1
  }

  answer pick=right
  hint "How much gas does the litre hold at {start} °C? What is half of that?"
  hint "At each warmer row, how much has it let go of so far?"
  hint "Is that more than half yet, or only just under?"
}
