# The two-star reason: a secret ballot lets each person vote as they choose, without anyone forcing
# or paying them; Britain brought it in in 1872.
item history.why-secret v=1 skills=[history.government, reasoning.why] {
  title "Why vote in secret?"
  difficulty k
  let k=0..1

  scene 32x29 {
    council c hands=[0, 0, 0, 0, 0] box=1 motion="Choose a mayor" count=0 at=canvas(1, 0)
    text ask "{if k == 0 then \"Before 1872, people in Britain called out their vote in public. Why is it better to vote in secret, in a box?\" else \"A landlord says he will raise the rent of anyone who votes against him. How does a secret vote stop that?\"}" narrate width=30 below=c gap=1
    choice pick options=["Nobody can punish or pay you for your vote", "Secret votes are counted faster", "It stops anyone from voting"] stack=column below=ask gap=1
  }

  answer pick="Nobody can punish or pay you for your vote"
  hint "What could happen to someone whose vote everyone could see?"
  hint "If nobody knows how you voted, who can put pressure on you?"
}
