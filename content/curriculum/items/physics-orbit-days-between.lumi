# How many days from one place on the ring to another, when the moon takes about twenty nine and a
# half days to go round, so each quarter of the way, two places, is about a week.
item physics.orbit-days-between v=1 skills=[physics.sky, physics.measuring] {
  title "How many days?"
  difficulty steps
  let n=0..3
  let steps={pick(n, 2, 4, 6, 6)}
  let fl={pick(n, "A", "C", "A", "B")}
  let tl={pick(n, "C", "G", "G", "H")}
  let days={pick(n, 7, 14, 21, 21)}
  level easy {
    let n=0..1
  }
  level hard {
    let n=2..3
  }

  scene 25x30 {
    orbit sky moon=-1 places=1 arrow=1 person=0 at=canvas(1, 0)
    text ask "The moon takes about twenty nine and a half days to go all the way round, so each quarter of the way takes about a week. About how many days does it take to go from place {fl} to place {tl} the way the arrow points?" narrate width=24 below=sky gap=1
    number-input answer below=ask gap=1
  }

  answer answer=days
  feedback {
    when (answer == steps) point=sky {
      say "That is the number of places, not the days. Two places make a quarter of the way round, about a week."
    }
  }
  hint "How many places does the moon pass through on the way?"
  hint "Two places are a quarter of the way round. How many quarters is that, at about a week each?"
}
