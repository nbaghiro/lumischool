# The particle picture before and after a change of state: which change it is follows from how the
# arrangement moved, in either direction.
item chem.name-the-change v=1 skills=[chemistry.states, chemistry.particles] {
  title "Which change is it?"
  difficulty k
  let k=0..3
  level easy {
    let k=0..1  # melting and freezing
  }
  level hard {
    let k=2..3  # evaporating and condensing
  }

  scene 35x20 {
    text ask "The particles in jar A change until they look like jar B. What is this change called?" width=32 at=canvas(1, 0)
    row kit below=ask gap=1 space=1 align=centre {
      column align=centre {
        particles a spread=(if k == 0 then 0 else if k == 1 then 1 else if k == 2 then 1 else 2) count=12 name=0 moving=1
        text la "A"
      }
      text arrow "→"
      column align=centre {
        particles b spread=(if k == 0 then 1 else if k == 1 then 0 else if k == 2 then 2 else 1) count=12 name=0 moving=1
        text lb "B"
      }
      choice pick options=["melting", "freezing", "evaporating", "condensing"] stack=column
    }
  }

  answer pick=(if k == 0 then "melting" else if k == 1 then "freezing" else if k == 2 then "evaporating" else "condensing")
  hint "Say which state jar A shows, then which state jar B shows."
  hint "Which change goes from the first state to the second?"
}
