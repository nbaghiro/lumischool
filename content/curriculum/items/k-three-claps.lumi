# Heard backwards: three claps given, and the word that makes them found. A long word is not the
# same as a word with many claps, which kite and sandcastle are there to show.
item k.three-claps v=1 stars=3 skills=[reading.syllables, reasoning.clues] {
  title "Which word made the claps?"
  difficulty (if n == 1 then 0 else 1)
  let n=1..3
  level easy {
    let n=1..1
  }
  level hard {
    let n=2..3
  }

  scene 28x10 {
    text ask "Ada claps a word and makes {n} claps. Which word did she clap?" narrate width=26 at=canvas(1, 1)
    choice pick options=["bicycle", "kite", "rocket"] stack=row below=ask gap=1
  }

  answer pick=pick(n, "none", "kite", "rocket", "bicycle")
  hint "Clap each word and count."
}
