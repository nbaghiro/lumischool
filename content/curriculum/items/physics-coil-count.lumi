# The way in: counting the clips an electromagnet holds, three to a row, and the checker counts them
# by the rule the drawing hangs them by.
item physics.coil-count v=1 skills=[physics.magnets, physics.circuits] {
  title "How many clips does it hold?"
  difficulty (t / 10 * c)
  let t={10, 20, 30, 40} c=1..3
  level easy {
    where (t * c <= 40)
  }
  level hard {
    where (t * c > 60)
  }

  scene 31x14 {
    electromagnet e turns=t cells=c core=0 closed=1 show=1 at=canvas(1, 0)
    text ask "Mia winds wire round an iron nail and joins it to cells. How many paper clips does her electromagnet hold?" narrate width=14 right-of=e gap=1
    number-input answer below=ask gap=1
  }

  check physics.circuit of=e answer=holds
  hint "Count the clips hanging from the nail's point, row by row."
  hint "How many rows are there, and how many clips in each?"
}
