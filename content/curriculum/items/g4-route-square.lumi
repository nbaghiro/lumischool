# The audit's raise for the map square: a start and a route, and the square reached.
item geography.route-square v=2 skills=[geography.grid-references, position.translation] {
  title "Follow the route"
  difficulty (dx + dy)
  let c=1..3 r=1..2 dx=1..3 dy=1..3 t={"hut", "tree", "boat"}
  where (c + dx <= 6 and r + dy <= 5)
  level easy {
    where (dx + dy <= 3)
  }
  level hard {
    where (dx + dy >= 5)
  }

  scene 34x18 {
    gridmap map cols=6 rows=5 col=c row=r thing=t at=canvas(1, 1)
    text ask "Start at the {t}. Go {dx} {if dx == 1 then \"square\" else \"squares\"} right and {dy} {if dy == 1 then \"square\" else \"squares\"} down. Which square are you in? Pick the letter, then write the number." narrate width=16 right-of=map gap=2
    row a below=map gap=1 space=2 align=centre {
      choice column options=["A", "B", "C", "D", "E", "F"]
      number-input row
    }
  }

  answer column=(if c + dx == 2 then "B" else if c + dx == 3 then "C" else if c + dx == 4 then "D" else if c + dx == 5 then "E" else "F") row=(r + dy)
  feedback {
    when (row == r + dy and column == (if c == 1 then "A" else if c == 2 then "B" else "C")) point=map {
      say "Going right changes the letter as well as going down changing the number."
    }
  }
  hint "Which square is the {t} in?"
  hint "Count along to the right first, then count down."
}
