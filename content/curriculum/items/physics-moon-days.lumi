item physics.moon-days v=1 skills=[physics.sky] stars=2 {
  title "The next full moon"
  let d={3, 5, 8}

  scene 35x18 {
    moonphases m from=1 step=7 count=5 at=canvas(1, 0)
    text ask "There was a full moon on {d} May. When will the next full moon be?" width=14 right-of=m gap=1
    choice pick options=["About a week later", "About two weeks later", "About four weeks later"] stack=column below=ask gap=1
  }

  answer pick="About four weeks later"
  feedback {
    when (pick == "About two weeks later") point=m {
      say "Two weeks after a full moon is a new moon. How long does the whole pattern take?"
    }
  }
  hint "How many days from one full moon to the next, in the boxes?"
  hint "Is it more like a week, or more like a month?"
}
