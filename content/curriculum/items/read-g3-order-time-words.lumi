# Five sentences where the time words, not common sense, settle the order; q shuffles the rows.
item reading.order-time-words v=1 skills=[reading.sequencing] {
  title "The time words decide"
  let k=0..2 q=0..2

  scene 36x21 {
    text ask "Number the sentences 1 to 5 in the order they happened. Look for the time words." narrate width=34 at=canvas(1, 1)
    sequence s items=[if k == 0 then if q == 0 then "After lunch she found a goat on the wrong side." else if q == 1 then "While they ate, she mended the gate." else "That evening she told Grandpa, and they laughed." else if k == 1 then if q == 0 then "At the top she drank the soup at last." else if q == 1 then "Then she caught the early ferry." else "Later the ferry took her home in the dark." else if q == 0 then "After that, Sam put a jar over the last shoot." else if q == 1 then "A week later, two green shoots came up." else "By the summer it was taller than him.", if k == 0 then if q == 0 then "At dawn, Ada let the goats out." else if q == 1 then "That evening she told Grandpa, and they laughed." else "By lunchtime the gate was shut tight." else if k == 1 then if q == 0 then "First, Jo packed a flask of soup." else if q == 1 then "Later the ferry took her home in the dark." else "On the island she climbed up to the lighthouse." else if q == 0 then "Before school, Sam planted six bean seeds." else if q == 1 then "By the summer it was taller than him." else "The next day a slug ate one of them.", if k == 0 then if q == 0 then "That evening she told Grandpa, and they laughed." else if q == 1 then "By lunchtime the gate was shut tight." else "At dawn, Ada let the goats out." else if k == 1 then if q == 0 then "Later the ferry took her home in the dark." else if q == 1 then "On the island she climbed up to the lighthouse." else "First, Jo packed a flask of soup." else if q == 0 then "By the summer it was taller than him." else if q == 1 then "The next day a slug ate one of them." else "Before school, Sam planted six bean seeds.", if k == 0 then if q == 0 then "While they ate, she mended the gate." else if q == 1 then "At dawn, Ada let the goats out." else "After lunch she found a goat on the wrong side." else if k == 1 then if q == 0 then "Then she caught the early ferry." else if q == 1 then "First, Jo packed a flask of soup." else "At the top she drank the soup at last." else if q == 0 then "A week later, two green shoots came up." else if q == 1 then "Before school, Sam planted six bean seeds." else "After that, Sam put a jar over the last shoot.", if k == 0 then if q == 0 then "By lunchtime the gate was shut tight." else if q == 1 then "After lunch she found a goat on the wrong side." else "While they ate, she mended the gate." else if k == 1 then if q == 0 then "On the island she climbed up to the lighthouse." else if q == 1 then "At the top she drank the soup at last." else "Then she caught the early ferry." else if q == 0 then "The next day a slug ate one of them." else if q == 1 then "After that, Sam put a jar over the last shoot." else "A week later, two green shoots came up."] blanks=[p1, p2, p3, p4, p5] below=ask gap=1
  }

  answer p1=(if q == 0 then 4 else if q == 1 then 2 else 5) p2=(if q == 0 then 1 else if q == 1 then 5 else 3) p3=(if q == 0 then 5 else if q == 1 then 3 else 1) p4=(if q == 0 then 2 else if q == 1 then 1 else 4) p5=(if q == 0 then 3 else if q == 1 then 4 else 2)
  hint "Which sentence has a time word that means the very beginning?"
  hint "Read the time word at the start of each sentence. Which one must come just after the first?"
}
