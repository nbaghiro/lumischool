# The way in: tesserae of one colour counted on a small mosaic, row by row. Three pictures eight
# wide and five high: a fish (24 blue, 1 black, 15 white), a boat (20 not white) and a flower (6
# red).
item art.mosaic-count v=1 skills=[art.mosaic, art.looking] {
  title "Counting the tesserae"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..3
  let r0={pick(k, "3 white 3 blue 2 white", "3 white 2 red 3 white", "4 white 1 black 3 white", "3 white 3 blue 2 white")}
  let r1={pick(k, "1 white 5 blue 1 white 1 blue", "2 white 1 red 2 yellow 1 red 2 white", "3 white 1 yellow 1 black 3 white", "1 white 5 blue 1 white 1 blue")}
  let r2={pick(k, "1 white 1 black 6 blue", "3 white 2 red 3 white", "2 white 2 yellow 1 black 3 white", "1 white 1 black 6 blue")}
  let r3={pick(k, "1 white 5 blue 1 white 1 blue", "4 white 1 green 3 white", "1 white 6 red 1 white", "1 white 5 blue 1 white 1 blue")}
  let r4={pick(k, "3 white 3 blue 2 white", "2 white 3 green 3 white", "8 blue", "3 white 3 blue 2 white")}
  let ask={pick(k, "How many blue tesserae are in the fish?", "How many red tesserae are in the flower?", "How many tesserae in the boat are not white?", "How many white tesserae are round the fish?")}
  let right={pick(k, 24, 6, 20, 15)}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 36x22 {
    pixels pic cols=8 rows=5 code=[r0, r1, r2, r3, r4] show=true beside=false upto=-1 at=canvas(1, 1)
    text ask "A mosaic is a picture made of small squares of stone or glass called tesserae. {ask}" narrate width=34 below=pic gap=1
    number-input answer below=ask gap=1
  }

  answer right
  feedback {
    when (answer != right) point=pic {
      say "Count one row at a time and write each row's number down before adding."
    }
  }
  hint "Count the row at the top first."
  hint "{pick(k, \"Add the blue in each of the five rows.\", \"Add the red in each row.\", \"Count every square that is not white, row by row.\", \"There are 40 squares in all. How many are not white?\")}"
}
