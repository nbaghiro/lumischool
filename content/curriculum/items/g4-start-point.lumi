# The move is given and the end is drawn, so the start is found by moving back.
item coords.start-point v=1 skills=[position.coordinates, position.translation] {
  title "Where it started"
  difficulty (dx + dy)
  let x=3..6 y=2..6 dx=1..3 dy=1..2
  where (x - dx >= 0 and y - dy >= 0)
  level easy {
    where (dx + dy <= 3)
  }
  level hard {
    where (dx + dy >= 5)
  }

  scene 34x16 {
    plotpoint grid max=6 quadrants=1 px=x py=y mark="Q" at=canvas(1, 0)
    column q right-of=grid gap=2 space=1 align=start {
      text ask "A point moved {dx} to the right and {dy} up, and landed on Q. Where did it start?" width=15
      equation eq "( {?px} , {?py} )"
    }
  }

  answer px=(x - dx) py=(y - dy)
  feedback {
    when (px == x + dx or py == y + dy) point=grid {
      say "That moves on again. To find the start, go back: left instead of right, down instead of up."
    }
  }
  hint "Where is Q?"
  hint "Undo the move. Which way is back from right? From up?"
}
