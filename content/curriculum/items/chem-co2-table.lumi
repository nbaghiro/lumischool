# The most carbon dioxide a litre of water holds with the gas at one atmosphere, rounded to tenths of
# a gram from Wikipedia's carbon dioxide data page (0.3346, 0.2318, 0.1688, 0.1257, 0.0973 and
# 0.0761 g in 100 ml at 0, 10, 20, 30, 40 and 50 °C). Worked in tenths.
item chem.co2-table v=1 skills=[chemistry.gases, chemistry.dissolving, data.tables] {
  title "Carbon dioxide in a litre"
  difficulty (w + r / 4)
  let w=0..1 r=0..2
  level easy {
    let w={0}
  }
  level hard {
    let w={1}
  }
  let temp={pick(r, 0, 10, 20)}
  let a={pick(r, 33, 23, 17)}
  let b={pick(r, 17, 13, 10)}

  scene 32x23 {
    table data cols=2 head=["Water °C", "Carbon dioxide, g a litre"] cells=["0", "3.3", "10", "2.3", "20", "1.7", "30", "1.3", "40", "1.0"] at=canvas(1, 0)
    text ask "The table gives the most carbon dioxide one litre of water can hold at each temperature. {if w == 0 then \"How many grams can a litre hold at \" else \"How many more grams can a litre hold at \"}{temp} °C{if w == 0 then \"?\" else \" than at \"}{if w == 1 then temp + 20 else \"\"}{if w == 1 then \" °C?\" else \"\"}" narrate width=28 below=data gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then a / 10 else (a - b) / 10)
  feedback {
    when (w == 1 and answer * 10 == a) point=data {
      say "That is how much a litre holds at {temp} °C. Take away what it holds at the warmer temperature."
    }
    when (w == 1 and answer * 10 == a + b) point=data {
      say "The warm water holds less, so the question asks for a difference, not a total."
    }
  }
  hint "Find the row for {temp} °C."
  hint "{if w == 0 then \"Where does that row meet the carbon dioxide column?\" else \"Read the warmer row as well. How far apart are the two numbers?\"}"
}
