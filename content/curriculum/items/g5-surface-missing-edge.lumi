# The unknown moves: the card is known and the height is not. Half the card is one of each face, and
# the floor comes off before sharing the rest between the two sides.
item solids.missing-edge v=1 skills=[solids.surface-area, reasoning.work-backwards] {
  title "How tall"
  difficulty ((l + w) * h / 10)
  let l=3..6 w=2..3 h=2..5
  where (l > w and h != w and h != l)
  level easy {
    let l=3..4 w={2} h=3..4
  }
  level hard {
    let l=5..6 w={3} h=4..5
  }

  scene 36x22 {
    net crate solid=cuboid cell=1 l=l w=w h=h ask=3 unit="cm" at=canvas(1, 1)
    text ask "The lock keeper's crate uses {2 * (l * w + l * h + w * h)} cm² of card. It is {l} cm long and {w} cm wide. How tall is it?" narrate width=16 right-of=crate gap=2
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=3
      text unit "cm"
    }
  }

  answer h
  feedback {
    when (answer == 2 * (l * w + l * h + w * h) / (l * w)) point=crate {
      say "Dividing by the floor gives a volume's height. Here the card is the faces, not the cubes."
    }
  }
  hint "Half the card is one of each face. What is half of it?"
  hint "Take away the floor, {l} × {w}. The rest is the front and one end, {l} + {w} wide."
}
