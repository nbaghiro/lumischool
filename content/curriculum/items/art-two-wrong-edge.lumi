# Finding the edge ruled to the wrong place: every edge on one side must meet that side's point.
item art.two-wrong-edge v=1 skills=[art.perspective, reasoning.error-spotting] {
  title "The edge ruled wrong"
  difficulty (if w == 1 or w == 3 then 1 else 0)
  let w=0..3
  let right={pick(w, "A", "B", "C", "D")}
  level easy {
    let w={0, 2}
  }
  level hard {
    let w={1, 3}
  }

  scene 36x15 {
    twopoint crate horizon=6 left=1 right=15 corner=7 stage=3 door=false letters=true wrong=w at=canvas(1, 1)
    text ask "The edges on the left side should run to the left point, and those on the right side to the right point. One of Ada's edges was ruled to the wrong place. Which?" width=18 right-of=crate gap=1
    choice pick options=["A", "B", "C", "D"] below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=crate {
      say "That edge does reach its point. Lay the ruler along each edge in turn and see which one misses."
    }
  }
  hint "Lay a ruler along one edge and carry it on to the horizon. Is it on the dot on its own side?"
  hint "Try each edge the same way. The wrong one crosses the horizon somewhere else, or not at all."
}
