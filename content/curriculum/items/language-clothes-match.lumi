# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.clothes-match v=1 skills=[language.clothes, language.weather] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[clothes.the-t-shirt]]", "[[clothes.the-coat]]", "[[clothes.the-boots]]"), pick(k, "[[clothes.the-skirt]]", "[[clothes.the-cap]]", "[[clothes.the-trousers]]"), pick(k, "[[clothes.the-shoes]]", "[[clothes.the-scarf]]", "[[clothes.the-shorts]]"), pick(k, "[[clothes.the-dress]]", "[[clothes.the-gloves]]", "[[clothes.the-swimsuit]]")] right=[pick(k, "the shoes", "the gloves", "the shorts"), pick(k, "the T-shirt", "the coat", "the boots"), pick(k, "the skirt", "the cap", "the swimsuit"), pick(k, "the dress", "the scarf", "the trousers")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
