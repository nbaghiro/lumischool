# The coins in the hand do not reach the price: the total feeds a second step, the audit's raise
# for money.count-coins.
item money.how-many-more v=1 skills=[money.coins, subtraction.difference] {
  title "Not quite enough"
  difficulty (extra + 25 * q)
  let q=0..1 d=1..3 p=1..4 extra={5, 12, 18, 25}
  where (25 * q + 10 * d + p != extra)
  level easy {
    let q={0} extra={5, 12}
  }
  level hard {
    let q={1} extra={18, 25}
  }

  scene 30x13 {
    coins hand quarters=q dimes=d nickels=0 pennies=p at=canvas(1, 1)
    pricetag tag now=(25 * q + 10 * d + p + extra) was=0 right-of=hand gap=2
    text ask "You have these coins. How many more cents do you need to buy the kite?" narrate width=28 below=hand gap=2
    number-input answer below=ask gap=1
  }

  answer extra
  feedback {
    when (answer == 25 * q + 10 * d + p) point=hand {
      say "That is what you have. The question is how much more you need to reach the price."
    }
  }
  hint "How many cents do the coins make?"
  hint "Count on from that amount to the price on the tag."
}
