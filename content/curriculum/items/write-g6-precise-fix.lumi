# The robot's sentence has one vague word among exact ones. The child picks which word to swap for a
# more precise one; the choices are all words from the sentence.
item writing.precise-fix v=1 skills=[writing.vocabulary, writing.editing, writing.word-choice] {
  title "Which word is vague?"
  difficulty k
  let k=0..2 r=0..2
  let says={pick(k, "The rocket went up into the black sky.", "Kit put her flag into the grey dust.", "Over the rim, the Earth was a nice blue ball.")}
  let right={pick(k, "went", "put", "nice")}
  let w1={pick(k, "rocket", "flag", "rim")}
  let w2={pick(k, "black", "grey", "blue")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=1..2
  }

  scene 34x16 {
    fixbot bot says="{says}" width=25 fixed=0 ring=-1 at=canvas(1, 0)
    text ask "Which word should be swapped for a more precise one?" narrate width=29 below=bot gap=1
    choice pick options=[if r == 0 then right else if r == 1 then w1 else w2, if r == 0 then w1 else if r == 1 then w2 else right, if r == 0 then w2 else if r == 1 then right else w1] below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=bot {
      say "That word already tells the reader something exact. Find the one that could be used about almost anything."
    }
  }
  hint "Which word could be used in a sentence about anything at all?"
  hint "One choice is a noun, one a verb and one an adjective. Try a better word in each place: where does the sentence improve most?"
}
