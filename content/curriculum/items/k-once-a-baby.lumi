item k.once-a-baby v=1 skills=[history.family, history.change] {
  title "Once a baby"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..3
  let who={pick(k, "your mum or dad", "your teacher", "your grandma or grandpa", "the oldest person you know")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 26x11 {
    text q "Was {who} once a baby?" narrate width=24 at=canvas(1, 1)
    choice pick options=["yes", "no"] stack=row below=q gap=1
  }

  answer pick="yes"
  hint "Is anyone born already grown up?"
}
