# Reading the heating curve from the thermometer in the steam: drops fall once the water boils, and the
# reading stays at 100 °C while it does. The unknown is the minute the first drop falls or how long
# water was collected.
item chem.still-curve v=1 skills=[chemistry.heating, data.line-graph] {
  title "When did the drops fall?"
  difficulty (w * 2 + (if e == 2 then 0 else 1))
  let w=0..1 k=0..2 e={2, 3}
  let t1={pick(k, 20, 40, 30)}
  let t2={pick(k, 40, 60, 50)}
  let t3={pick(k, 60, 80, 70)}
  let t4={pick(k, 80, 100, 90)}
  let t5={pick(k, 100, 100, 100)}
  let asks={pick(w, "The first drop fell into the beaker as soon as the water boiled. After how many minutes was that?", "Drops fell into the beaker for as long as the water boiled. For how many minutes did water collect?")}
  let second={pick(w, "Count the steps before the flat part begins. How many minutes is each step?", "How many steps along the bottom does the flat part cover, and how many minutes is each step?")}
  level easy {
    let w=0..0
  }
  level hard {
    let w=1..1
  }

  scene 35x26 {
    heatcurve curve temps=[t1, t2, t3, t4, t5, 100, 100, 100] every=e min=0 max=120 step=20 at=canvas(1, 0)
    text ask "A grown-up heats salty water in a flask. The thermometer sits in the steam, and she reads it every {e} minutes. {asks}" narrate width=34 below=curve gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then if k == 1 then 3 * e else 4 * e else if k == 1 then 4 * e else 3 * e)
  feedback {
    when (answer == 100) point=curve {
      say "100 is the temperature on the flat part. The question asks for minutes, read along the bottom."
    }
  }
  hint "Find where the line stops climbing and stays flat. What is happening to the water there?"
  hint "{second}"
}
