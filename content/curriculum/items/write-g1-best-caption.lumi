# Two captions are true and one is not, and of the two true ones only one tells a reader where the
# animal is. The false one names the wrong thing, so it cannot be argued true. Choosing the better
# true caption is the reasoning; the grown-up can ask why.
item writing.best-caption v=1 stars=2 skills=[writing.captions, reasoning.compare] {
  title "The caption that tells the most"
  difficulty (if s == 2 then 1 else 0)
  let a=0..3 s=0..3 q=0..2
  let who={if a == 0 then "dog" else if a == 1 then "fox" else if a == 2 then "rabbit" else "duck"}
  let where={if s == 0 then "on" else if s == 1 then "in" else if s == 2 then "under" else "by"}
  let thing={if s == 0 then "rug" else if s == 1 then "tub" else if s == 2 then "table" else "log"}
  let c0={if a == 0 and s == 0 and q == 0 then "A dog." else if a == 0 and s == 0 and q == 1 then "A dog on a bed." else if a == 0 and s == 0 and q == 2 then "A dog on a rug." else if a == 0 and s == 1 and q == 0 then "A dog." else if a == 0 and s == 1 and q == 1 then "A dog in a box." else if a == 0 and s == 1 and q == 2 then "A dog in a tub." else if a == 0 and s == 2 and q == 0 then "A dog." else if a == 0 and s == 2 and q == 1 then "A dog under a bed." else if a == 0 and s == 2 and q == 2 then "A dog under a table." else if a == 0 and s == 3 and q == 0 then "A dog." else if a == 0 and s == 3 and q == 1 then "A dog by a box." else if a == 0 and s == 3 and q == 2 then "A dog by a log." else if a == 1 and s == 0 and q == 0 then "A fox." else if a == 1 and s == 0 and q == 1 then "A fox on a bed." else if a == 1 and s == 0 and q == 2 then "A fox on a rug." else if a == 1 and s == 1 and q == 0 then "A fox." else if a == 1 and s == 1 and q == 1 then "A fox in a box." else if a == 1 and s == 1 and q == 2 then "A fox in a tub." else if a == 1 and s == 2 and q == 0 then "A fox." else if a == 1 and s == 2 and q == 1 then "A fox under a bed." else if a == 1 and s == 2 and q == 2 then "A fox under a table." else if a == 1 and s == 3 and q == 0 then "A fox." else if a == 1 and s == 3 and q == 1 then "A fox by a box." else if a == 1 and s == 3 and q == 2 then "A fox by a log." else if a == 2 and s == 0 and q == 0 then "A rabbit." else if a == 2 and s == 0 and q == 1 then "A rabbit on a bed." else if a == 2 and s == 0 and q == 2 then "A rabbit on a rug." else if a == 2 and s == 1 and q == 0 then "A rabbit." else if a == 2 and s == 1 and q == 1 then "A rabbit in a box." else if a == 2 and s == 1 and q == 2 then "A rabbit in a tub." else if a == 2 and s == 2 and q == 0 then "A rabbit." else if a == 2 and s == 2 and q == 1 then "A rabbit under a bed." else if a == 2 and s == 2 and q == 2 then "A rabbit under a table." else if a == 2 and s == 3 and q == 0 then "A rabbit." else if a == 2 and s == 3 and q == 1 then "A rabbit by a box." else if a == 2 and s == 3 and q == 2 then "A rabbit by a log." else if a == 3 and s == 0 and q == 0 then "A duck." else if a == 3 and s == 0 and q == 1 then "A duck on a bed." else if a == 3 and s == 0 and q == 2 then "A duck on a rug." else if a == 3 and s == 1 and q == 0 then "A duck." else if a == 3 and s == 1 and q == 1 then "A duck in a box." else if a == 3 and s == 1 and q == 2 then "A duck in a tub." else if a == 3 and s == 2 and q == 0 then "A duck." else if a == 3 and s == 2 and q == 1 then "A duck under a bed." else if a == 3 and s == 2 and q == 2 then "A duck under a table." else if a == 3 and s == 3 and q == 0 then "A duck." else if a == 3 and s == 3 and q == 1 then "A duck by a box." else "A duck by a log."}
  let c1={if a == 0 and s == 0 and q == 0 then "A dog on a bed." else if a == 0 and s == 0 and q == 1 then "A dog on a rug." else if a == 0 and s == 0 and q == 2 then "A dog." else if a == 0 and s == 1 and q == 0 then "A dog in a box." else if a == 0 and s == 1 and q == 1 then "A dog in a tub." else if a == 0 and s == 1 and q == 2 then "A dog." else if a == 0 and s == 2 and q == 0 then "A dog under a bed." else if a == 0 and s == 2 and q == 1 then "A dog under a table." else if a == 0 and s == 2 and q == 2 then "A dog." else if a == 0 and s == 3 and q == 0 then "A dog by a box." else if a == 0 and s == 3 and q == 1 then "A dog by a log." else if a == 0 and s == 3 and q == 2 then "A dog." else if a == 1 and s == 0 and q == 0 then "A fox on a bed." else if a == 1 and s == 0 and q == 1 then "A fox on a rug." else if a == 1 and s == 0 and q == 2 then "A fox." else if a == 1 and s == 1 and q == 0 then "A fox in a box." else if a == 1 and s == 1 and q == 1 then "A fox in a tub." else if a == 1 and s == 1 and q == 2 then "A fox." else if a == 1 and s == 2 and q == 0 then "A fox under a bed." else if a == 1 and s == 2 and q == 1 then "A fox under a table." else if a == 1 and s == 2 and q == 2 then "A fox." else if a == 1 and s == 3 and q == 0 then "A fox by a box." else if a == 1 and s == 3 and q == 1 then "A fox by a log." else if a == 1 and s == 3 and q == 2 then "A fox." else if a == 2 and s == 0 and q == 0 then "A rabbit on a bed." else if a == 2 and s == 0 and q == 1 then "A rabbit on a rug." else if a == 2 and s == 0 and q == 2 then "A rabbit." else if a == 2 and s == 1 and q == 0 then "A rabbit in a box." else if a == 2 and s == 1 and q == 1 then "A rabbit in a tub." else if a == 2 and s == 1 and q == 2 then "A rabbit." else if a == 2 and s == 2 and q == 0 then "A rabbit under a bed." else if a == 2 and s == 2 and q == 1 then "A rabbit under a table." else if a == 2 and s == 2 and q == 2 then "A rabbit." else if a == 2 and s == 3 and q == 0 then "A rabbit by a box." else if a == 2 and s == 3 and q == 1 then "A rabbit by a log." else if a == 2 and s == 3 and q == 2 then "A rabbit." else if a == 3 and s == 0 and q == 0 then "A duck on a bed." else if a == 3 and s == 0 and q == 1 then "A duck on a rug." else if a == 3 and s == 0 and q == 2 then "A duck." else if a == 3 and s == 1 and q == 0 then "A duck in a box." else if a == 3 and s == 1 and q == 1 then "A duck in a tub." else if a == 3 and s == 1 and q == 2 then "A duck." else if a == 3 and s == 2 and q == 0 then "A duck under a bed." else if a == 3 and s == 2 and q == 1 then "A duck under a table." else if a == 3 and s == 2 and q == 2 then "A duck." else if a == 3 and s == 3 and q == 0 then "A duck by a box." else if a == 3 and s == 3 and q == 1 then "A duck by a log." else "A duck."}
  let c2={if a == 0 and s == 0 and q == 0 then "A dog on a rug." else if a == 0 and s == 0 and q == 1 then "A dog." else if a == 0 and s == 0 and q == 2 then "A dog on a bed." else if a == 0 and s == 1 and q == 0 then "A dog in a tub." else if a == 0 and s == 1 and q == 1 then "A dog." else if a == 0 and s == 1 and q == 2 then "A dog in a box." else if a == 0 and s == 2 and q == 0 then "A dog under a table." else if a == 0 and s == 2 and q == 1 then "A dog." else if a == 0 and s == 2 and q == 2 then "A dog under a bed." else if a == 0 and s == 3 and q == 0 then "A dog by a log." else if a == 0 and s == 3 and q == 1 then "A dog." else if a == 0 and s == 3 and q == 2 then "A dog by a box." else if a == 1 and s == 0 and q == 0 then "A fox on a rug." else if a == 1 and s == 0 and q == 1 then "A fox." else if a == 1 and s == 0 and q == 2 then "A fox on a bed." else if a == 1 and s == 1 and q == 0 then "A fox in a tub." else if a == 1 and s == 1 and q == 1 then "A fox." else if a == 1 and s == 1 and q == 2 then "A fox in a box." else if a == 1 and s == 2 and q == 0 then "A fox under a table." else if a == 1 and s == 2 and q == 1 then "A fox." else if a == 1 and s == 2 and q == 2 then "A fox under a bed." else if a == 1 and s == 3 and q == 0 then "A fox by a log." else if a == 1 and s == 3 and q == 1 then "A fox." else if a == 1 and s == 3 and q == 2 then "A fox by a box." else if a == 2 and s == 0 and q == 0 then "A rabbit on a rug." else if a == 2 and s == 0 and q == 1 then "A rabbit." else if a == 2 and s == 0 and q == 2 then "A rabbit on a bed." else if a == 2 and s == 1 and q == 0 then "A rabbit in a tub." else if a == 2 and s == 1 and q == 1 then "A rabbit." else if a == 2 and s == 1 and q == 2 then "A rabbit in a box." else if a == 2 and s == 2 and q == 0 then "A rabbit under a table." else if a == 2 and s == 2 and q == 1 then "A rabbit." else if a == 2 and s == 2 and q == 2 then "A rabbit under a bed." else if a == 2 and s == 3 and q == 0 then "A rabbit by a log." else if a == 2 and s == 3 and q == 1 then "A rabbit." else if a == 2 and s == 3 and q == 2 then "A rabbit by a box." else if a == 3 and s == 0 and q == 0 then "A duck on a rug." else if a == 3 and s == 0 and q == 1 then "A duck." else if a == 3 and s == 0 and q == 2 then "A duck on a bed." else if a == 3 and s == 1 and q == 0 then "A duck in a tub." else if a == 3 and s == 1 and q == 1 then "A duck." else if a == 3 and s == 1 and q == 2 then "A duck in a box." else if a == 3 and s == 2 and q == 0 then "A duck under a table." else if a == 3 and s == 2 and q == 1 then "A duck." else if a == 3 and s == 2 and q == 2 then "A duck under a bed." else if a == 3 and s == 3 and q == 0 then "A duck by a log." else if a == 3 and s == 3 and q == 1 then "A duck." else "A duck by a box."}
  let full={if a == 0 and s == 0 then "A dog on a rug." else if a == 0 and s == 1 then "A dog in a tub." else if a == 0 and s == 2 then "A dog under a table." else if a == 0 and s == 3 then "A dog by a log." else if a == 1 and s == 0 then "A fox on a rug." else if a == 1 and s == 1 then "A fox in a tub." else if a == 1 and s == 2 then "A fox under a table." else if a == 1 and s == 3 then "A fox by a log." else if a == 2 and s == 0 then "A rabbit on a rug." else if a == 2 and s == 1 then "A rabbit in a tub." else if a == 2 and s == 2 then "A rabbit under a table." else if a == 2 and s == 3 then "A rabbit by a log." else if a == 3 and s == 0 then "A duck on a rug." else if a == 3 and s == 1 then "A duck in a tub." else if a == 3 and s == 2 then "A duck under a table." else "A duck by a log."}

  scene 32x17 {
    picturecards card who=["{who}"] where=["{where}"] thing=["{thing}"] letters=false at=canvas(1, 1)
    column q right-of=card gap=2 space=1 align=start {
      text ask "Two of these captions are true. Which one tells a reader the most?" narrate width=20
      choice pick options=["{c0}", "{c1}", "{c2}"] stack=column
    }
  }

  answer pick=full
  hint "First cross out the caption that is not true."
  hint "Of the two that are left, which one says where the {who} is?"
}
