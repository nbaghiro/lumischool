# Non-routine: a temperature that meets two conditions at once, one melted and one not. No method
# is given; the child tries each temperature against both melting points.
item chem.room-temp v=1 stars=3 skills=[chemistry.states, reasoning.constraints] {
  title "How warm is the water?"
  difficulty (if k == 2 or k == 3 then 0 else if k == 0 then 1 else 2)
  let k=0..3

  scene 35x14 {
    table data cols=2 head=["Melts at about", "Degrees"] cells=["chocolate", 34, "candle wax", 60, "butter", 37] at=canvas(1, 0)
    text ask "Bowls of each sit in a water bath. {if k == 0 then \"The chocolate is runny and the candle wax is still hard.\" else if k == 1 then \"The butter is runny and the candle wax is still hard.\" else if k == 2 then \"The chocolate, the butter and the candle wax are all runny.\" else \"The chocolate and the candle wax are both still hard.\"} Which could the temperature be?" width=14 right-of=data gap=1
    choice pick options=["{if k == 1 then 42 else 20}", "{if k == 1 then 20 else 40}", "{if k == 3 then 70 else 80}"] below=ask gap=1
  }

  answer pick=(if k == 0 then "40" else if k == 1 then "42" else if k == 2 then "80" else "20")
  check chem.state of=data
  hint "Try each temperature. Is it hotter than where the first thing melts?"
  hint "Now check the same temperature against the second thing. Does it fit both?"
}
