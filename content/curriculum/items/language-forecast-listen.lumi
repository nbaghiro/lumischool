# Listening: the grown-up reads the phrase from the grown-ups' sheet, or the device plays it, and
# the child types it. Marked word by word by the dictation checker: accent-strict, since a
# word with its accent missing is a different spelling; case and punctuation are not marked.
item language.forecast-listen v=1 skills=[language.weather, language.reading, language.listening, language.spelling] {
  title "Listen and write"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x21 {
    column all at=canvas(1, 1) space=1 align=start {
      weatherweek towns days=["Bilbao", "Madrid", "Sevilla", "Pirineos", "Valencia"] skies=["rain", "sunny-spells", "sun", "snow", "wind"] temps=["14 °C", "22 °C", "27 °C", "-2 °C", "20 °C"]
      text ask "Listen to the [[language.name]], then write it. Your grown-up will read it, or press play." width=32
      number-input answer width=32
    }
  }

  check writing.dictation text="{pick(k, \"[[phrase.tomorrow-it-is-going-to-rain]]\", \"[[phrase.today-it-is-twenty-degrees]]\", \"[[phrase.in-the-north-it-rains-a-lot]]\", \"[[phrase.in-the-afternoon-there-will-be-storms-in]]\", \"[[phrase.in-the-pyrenees-it-snows-at-night-and-it]]\", \"[[phrase.on-saturday-it-is-sunny-in-seville-but-i]]\")}"
  hint "Listen to the whole sentence once before you write a word."
  hint "Write it a few words at a time. Which words from today do you hear?"
}
