# Years between the first cities, BC, in the rounded dates the record gives as "about".
item history.city-bc-gap v=1 skills=[history.cities, history.bc-ad] {
  title "How much later?"
  difficulty (if k <= 1 then 0 else if k <= 3 then 1 else 2)
  let k=0..5
  let ea={pick(k, "Uruk was at its biggest", "Uruk was at its biggest", "The Great Pyramid was built", "Uruk was at its biggest", "The Great Pyramid was built", "Mohenjo-daro was built")}
  let a={pick(k, 3100, 3100, 2560, 3100, 2560, 2500)}
  let eb={pick(k, "Mohenjo-daro was built", "the Shang kings ruled China from", "the Shang kings ruled China from", "the Great Pyramid was built", "Mohenjo-daro was built", "the Shang kings ruled China from")}
  let b={pick(k, 2500, 1600, 1600, 2560, 2500, 1600)}

  scene 36x16 {
    timeline line from=-3500 to=-1000 step=500 years=[] labels=[] at=canvas(1, 0)
    text ask "{ea} about {a} BC, and {eb} about {b} BC. About how many years later was the second?" narrate width=28 below=line gap=1
    number-input answer right-of=ask gap=1
  }

  answer (a - b)
  feedback {
    when (answer == a + b) point=line {
      say "Both years are BC. The gap between them is the bigger number take away the smaller."
    }
  }
  hint "Both years count back from year one. Which is further back?"
  hint "Take the smaller number of years from the bigger."
}
