# A quaver and two semiquavers, then the other way round: onsets 0, 0.5, 0.75, 1, 1.25, 1.5, 2, 3.
item music.semi-tap-mix v=1 skills=[music.rhythm] {
  title "Long-short-short, short-short-long"

  scene 34x18 {
    notes bar clef=treble notes=[E4, G4, G4, E4, E4, G4, C5, C5] values=[0.5, 0.25, 0.25, 0.25, 0.25, 0.5, 1, 1] meter=4 letters=false at=canvas(1, 1)
    text ask "Tap this bar: a quaver and two semiquavers, then two semiquavers and a quaver, then two crotchets." narrate width=32 below=bar gap=1
  }

  check music.rhythm beats=[0, 0.5, 0.75, 1, 1.25, 1.5, 2, 3] grade=5
  hint "Say ti ti-ka, ti-ka ti, ta, ta."
  hint "Each group of three notes still takes exactly one beat."
}
