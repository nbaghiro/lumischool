# The four pictures are muddled; the child puts them in order in their head and names the one in a
# given place. The step is not named, so the pictures have to be read.
item chem.fossil-first v=1 skills=[chemistry.rocks, ordering] {
  title "Which comes first?"
  difficulty (if n == 2 or n == 3 then 1 else 0)
  let k=0..3 n=1..4
  level easy {
    let n={1, 4}
  }
  level hard {
    let n={2, 3}
  }

  scene 28x16 {
    text ask "These pictures show how a fossil forms, but they are muddled. Which picture comes {if n == 1 then \"first\" else if n == 2 then \"second\" else if n == 3 then \"third\" else \"last\"}?" width=26 at=canvas(1, 0)
    fossilsteps f order=[if k == 0 then 3 else if k == 1 then 2 else if k == 2 then 4 else 1, if k == 0 then 1 else if k == 1 then 4 else if k == 2 then 3 else 4, if k == 0 then 4 else if k == 1 then 1 else if k == 2 then 2 else 3, if k == 0 then 2 else if k == 1 then 3 else if k == 2 then 1 else 2] blank=-1 letters=1 below=ask gap=0
    choice pick options=["A", "B", "C", "D"] below=f gap=0
  }

  check chem.rocks of=f pick="step({n})"
  hint "Find the picture where the shell is still in the sea. What happens to it next?"
  hint "Mud covers it, then more layers turn it to rock, then the rock wears away. Which picture is that step?"
}
