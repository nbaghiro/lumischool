item k.next-birthday v=1 skills=[history.celebrations, counting.one-more] {
  title "How old next birthday?"
  difficulty (if w == 0 then 0 else 1)
  let a=3..7 w=0..1
  level easy {
    let w={0}
  }
  level hard {
    let w={1}
  }

  scene 26x12 {
    text q "Ben is {a} now. How old {if w == 0 then \"will he be on his next birthday\" else \"was he on his last birthday before this one\"}?" narrate width=24 at=canvas(1, 1)
    number-input answer below=q gap=1
  }

  answer (if w == 0 then a + 1 else a - 1)
  hint "Each birthday you are one year older."
}
