# Four creatures matched to four homes, the homes shuffled four ways, none of them 1, 2, 3, 4 or
# a turn of it, so one answer does not give the rest.
item nature.match-homes v=1 skills=[nature.habitats] {
  title "Match each one to its home"
  let k=0..3

  scene 30x28 {
    row all at=canvas(1, 1) space=2 align=end {
      pond pool pads=2 fish=1 frog=false
      cobweb web spokes=8 spider=1
    }
    text ask "Write the number of its home next to each creature." narrate width=28 below=all gap=1
    match m left=["spider", "fish", "owl", "bee"] right=["{if k == 0 then \"a flower\" else if k == 1 then \"a hole in a tree\" else if k == 2 then \"the pond\" else \"a hole in a tree\"}", "{if k == 0 then \"the pond\" else if k == 1 then \"a web\" else if k == 2 then \"a flower\" else \"a flower\"}", "{if k == 0 then \"a web\" else if k == 1 then \"a flower\" else if k == 2 then \"a hole in a tree\" else \"the pond\"}", "{if k == 0 then \"a hole in a tree\" else if k == 1 then \"the pond\" else if k == 2 then \"a web\" else \"a web\"}"] blanks=[a, b, c, d] below=ask gap=1
  }

  answer a=(if k == 0 then 3 else if k == 1 then 2 else if k == 2 then 4 else 4) b=(if k == 0 then 2 else if k == 1 then 4 else if k == 2 then 1 else 3) c=(if k == 0 then 4 else if k == 1 then 1 else if k == 2 then 3 else 1) d=(if k == 0 then 1 else if k == 1 then 3 else if k == 2 then 2 else 2)
  hint "Start with the one you are surest of. Where does a spider live?"
  hint "The fish breathes water, the owl sleeps up high, and the bee lives where its food is."
}
