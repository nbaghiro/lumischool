# The way in: a web written as two chains that share a creature, and the number of arrows that
# point into one creature, which is how many things it eats. The top creature has two arrows in
# and the plant none, which is the point.
item nature.arrows-into v=1 skills=[nature.food-webs] {
  title "How many arrows in?"
  difficulty (if w == 2 then 0 else if w == 0 then 2 else 1)
  let c=0..1 w=0..2
  let x={pick(c, "seaweed", "tiny plants")}
  let y1={pick(c, "crab", "small fish")}
  let y2={pick(c, "sea snail", "shrimp")}
  let z={pick(c, "gull", "seal")}
  let who={pick(w, x, y1, z)}
  level easy {
    let w=1..2
  }
  level hard {
    let w=0..1
  }

  scene 34x21 {
    row pics at=canvas(1, 1) space=2 align=end {
      crabs pc count=1
      fishshoal pf rows=2 cols=4 facing=1
      gull pg flying=0
    }
    text one "{x}  →  {y1}  →  {z}" narrate below=pics gap=1
    text two "{x}  →  {y2}  →  {z}" narrate below=one gap=0
    text ask "These two reef chains share their ends, so together they make a web. Each arrow points to the eater. How many arrows point into the {who}?" narrate width=32 below=two gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then 0 else if w == 1 then 1 else 2)
  feedback {
    when (w == 2 and answer == 1) point=two {
      say "The {z} is at the end of both chains. Count the arrow into it on each line."
    }
    when (w == 0 and answer > 0) point=one {
      say "Every arrow starts at the {x} and none point back to it. A plant eats nothing: it makes its own food."
    }
    when (w == 1 and answer == 2) point=one {
      say "The {y1} has an arrow in from the {x} and an arrow out to the {z}. Count only the arrows that point into it."
    }
  }
  hint "Find the {who} on both lines. Look for arrowheads that touch it."
  hint "An arrow into a creature means it eats what the arrow comes from. How many things does the {who} eat here?"
}
