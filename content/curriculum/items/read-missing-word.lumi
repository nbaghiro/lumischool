item reading.missing-word v=2 skills=[reading.inference] stars=2 {
  title "The word that is missing"
  difficulty (if k == 2 then 1 else 0)
  let k=0..2

  scene 36x12 {
    sentence strip before="{if k == 0 then \"The box was too\" else if k == 1 then \"The jug was\" else \"We left\"}" blank=6 after="{if k == 0 then \"to lift, so we pushed it.\" else if k == 1 then \", so nobody had a drink.\" else \", so the bus was not crowded.\"}" at=canvas(1, 1)
    text ask "Write the word that belongs in the gap." width=22 below=strip gap=1
    word-input pick options=["{if k == 0 then \"heavy\" else if k == 1 then \"empty\" else \"early\"}"] letters=5 below=ask gap=1
  }

  answer pick=(if k == 0 then "heavy" else if k == 1 then "empty" else "early")
  hint "Read the whole sentence. The part after the gap tells you what the missing word has to be."
}
