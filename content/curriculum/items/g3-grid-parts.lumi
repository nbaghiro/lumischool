# The grid method for one digit, written as its three steps, so each part can be seen and checked.
item multiply.grid-parts v=1 skills=[multiplication.short, multiplication.partition] {
  title "Tens and ones, then add"
  difficulty ((10 * t + o) * b)
  let t=1..9 o=1..9 b=3..9
  where (t * b < 100)
  level easy {
    let t=1..3 o=1..6 b=3..4
  }
  level hard {
    let t=5..9 o=6..9 b=6..9
  }

  scene 17x9 {
    equation e1 "{10 * t} × {b} =" at=canvas(1, 1)
    number-input tens right-of=e1 gap=1
    equation e2 "{o} × {b} =" below=e1 gap=1
    number-input ones right-of=e2 gap=1
    equation e3 "{10 * t + o} × {b} =" below=e2 gap=1
    number-input total right-of=e3 gap=1
  }

  answer tens=(10 * t * b) ones=(o * b) total=((10 * t + o) * b)
  feedback {
    when (total == 10 * t * b + o) point=e3 {
      say "The ones were multiplied by {b} too. Add the two answers above."
    }
    when (tens == t * b) point=e1 {
      say "{10 * t} is ten times {t}, so the answer is ten times {t} × {b}."
    }
  }
  hint "What is {t} × {b}? How does that help with {10 * t} × {b}?"
  hint "The whole number is the tens and the ones together. Add the two parts."
}
