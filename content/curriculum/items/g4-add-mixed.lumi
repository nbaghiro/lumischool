# Mixed numbers with the same parts, 4.NF.3c, where the fractions pass one whole.
item fraction.add-mixed v=1 skills=[fractions.mixed-numbers, fractions.add-like] {
  title "Adding mixed numbers"
  difficulty (k + p + q)
  let k={4, 5, 6, 8} p=1..2 q=1..3 a=1..7 c=1..7
  where (a < k and c < k and a + c > k)
  level easy {
    let k={4, 5} q={1}
  }
  level hard {
    let k={6, 8} p={2} q={3}
  }

  scene 30x6 {
    equation eq "{p} {a}/{k} + {q} {c}/{k} = {?whole}  {?top}/{k}" at=canvas(1, 1)
    text ask "Add, and write the answer as whole ones and a fraction." narrate below=eq gap=1
  }

  answer whole=(p + q + 1) top=(a + c - k)
  feedback {
    when (whole == p + q and top == a + c) point=eq {
      say "{a + c}/{k} is more than one whole. Change {k}/{k} into another whole one."
    }
  }
  hint "Add the whole ones first. Then add the fractions."
  hint "Is {a + c}/{k} more than one whole?"
}
