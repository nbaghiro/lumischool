# The robot picks up a gem by walking over it. The question is an extreme: how far can the program
# run before the second gem is picked up. k decides which block walks over the second gem.
item coding.one-gem-most v=1 skills=[coding.tracing] {
  title "Only one gem"
  difficulty (a + (if k == 1 then 3 else if k == 0 then 2 else 1))
  let a=1..3 b=2..3 k=0..2
  level easy {
    let a=1..2 k={0, 2}
  }
  level hard {
    let a=2..3 k={0, 1}
  }

  scene 31x16 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks b code=["right {a}", "down 1", "right {b}", "down 1"] numbers=true words=false
      maze g cols=7 rows=3 gems=[2, 1, if k == 0 then a + 2 else if k == 1 then a + b + 1 else a + 1, if k == 0 then 2 else if k == 1 then 3 else 2] code=["right {a}", "down 1", "right {b}", "down 1"] upto=0 trail=none
    }
    text ask "The robot picks up a gem when it walks over one. What is the most blocks it can do and still have only one gem?" width=29 below=top gap=1
    number-input answer below=ask gap=0
  }

  answer (if k == 0 then 2 else if k == 1 then 3 else 1)
  feedback {
    when (answer == 4) point=g {
      say "After all four blocks, how many gems has it walked over?"
    }
  }
  hint "Do one block at a time. After each block, how many gems has it got?"
  hint "Stop the block before it walks over the second gem."
}
