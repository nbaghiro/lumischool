item art.tiles-to-cover v=1 skills=[art.pattern, reasoning.two-steps] {
  title "Enough tiles for the wall"
  difficulty (w * h)
  let w={12, 15, 18} h={9, 12}
  level easy {
    let w={12, 15} h={9}
  }
  level hard {
    let w={15, 18} h={12}
  }

  scene 30x12 {
    tilerepeat wall drop=0 cols=3 rows=2 missing=-1 ring=0 colour=green at=canvas(1, 1)
    text ask "The ringed tile is 3 squares wide and 3 squares tall. How many tiles cover a wall {w} squares wide and {h} squares tall?" width=18 right-of=wall gap=1
    number-input answer below=ask gap=1
  }

  answer (w / 3 * (h / 3))
  feedback {
    when (answer == w * h) point=wall {
      say "That is how many squares the wall has. Each tile covers more than one square."
    }
  }
  hint "How many tiles fit along the bottom of the wall?"
  hint "How many rows of them fit up the wall? Then how many tiles in all?"
}
