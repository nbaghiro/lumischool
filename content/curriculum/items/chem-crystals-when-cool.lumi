# The hot cup that held its full count of spoons cools, and the spoons the cold water cannot hold
# come back out as crystals on the string; warmed again, they dissolve back.
item chem.crystals-when-cool v=1 skills=[chemistry.crystals, chemistry.dissolving] {
  title "As it cools"
  difficulty w
  let w=0..1 t=0..1
  let hot={pick(t, 8, 7)}
  let cold={pick(t, 3, 2)}
  let right={pick(w, "It grows on the string", "They dissolve again")}
  level easy {
    let w=0..0
  }
  level hard {
    let w=1..1
  }

  scene 34x26 {
    crystalstring jar days=(if w == 0 then 1 else 4) crystals=(if w == 0 then 2 else 5) kind=salt at=canvas(0, 0)
    text ask "A cup of water at 60 °C dissolved {hot} spoons of salt, and a string was hung in it. It cooled to 10 °C, where water holds only {cold} spoons. {if w == 0 then \"What happens to the salt the cold water cannot hold?\" else \"Crystals grew on the string. Then the cup is warmed back to 60 °C. What happens to them?\"}" narrate width=20 right-of=jar gap=1
    choice pick options=[if w == 0 then "It grows on the string" else "They dissolve again", if w == 0 then "It stays dissolved" else "They stay on the string", if w == 0 then "It goes into the air" else "They melt into water"] stack=column below=jar gap=1
  }

  answer pick=right
  feedback {
    when (w == 0 and pick == "It goes into the air") point=jar {
      say "Salt does not go into the air when the water cools; only water does, when it evaporates. The salt has to come out somewhere in the cup."
    }
    when (w == 1 and pick == "They melt into water") point=jar {
      say "Salt melts only at a very high heat. In warm water it dissolves, which is going back into the water, not turning into it."
    }
  }
  hint "Cold water holds fewer spoons than hot. The spoons it cannot hold have to leave the water."
  hint "{if w == 0 then \"Look at the string.\" else \"Hot water holds all the spoons again, so where does the salt on the string go?\"}"
}
