# The two-star reason: Ben puts an animal in a group from one thing he saw it eat, and the fact that
# shows he is wrong is another food on its list, not how it looks or where it lives.
item nature.eater-mistake v=1 stars=2 skills=[nature.feeding, reasoning.explain] {
  title "One meal is not the whole list"
  difficulty (if k == 0 then 0 else 1)
  let k=0..2
  let claim={pick(k, "Ben saw the fox catch a rabbit, so he says the fox is a meat eater.", "Ben saw the badger dig up a bluebell bulb, so he says the badger is a plant eater.", "Ben saw the heron standing still in the reeds, so he says the heron eats reeds.")}
  let right={pick(k, "Foxes also eat berries and fruit", "Badgers also eat worms and birds' eggs", "Herons catch fish and frogs")}
  let o1={pick(k, "Foxes have red fur", "Badgers dig their homes underground", "Herons have long legs")}
  let o2={pick(k, "Foxes come out at dusk", "Badgers come out at night", "Reeds grow at the water's edge")}
  let x1={pick(k, o1, right, o2)}
  let x2={pick(k, right, o2, o1)}
  let x3={pick(k, o2, o1, right)}
  level easy {
    let k={0}
  }
  level hard {
    let k=1..2
  }

  scene 36x29 {
    row all at=canvas(1, 1) space=2 align=end {
      fox fx facing=1
      badger bd facing=-1 count=1
      heron hn facing=-1 reeds=3
    }
    text ask "{claim} Ada says he needs to know more. Which fact shows that Ben is wrong?" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=all {
      say "That may be true, but it says nothing about what the animal eats. Which fact is about food?"
    }
  }
  hint "Ben's group depends on what the animal eats. Which fact is about food?"
  hint "Does that fact fit Ben's group, or does it show the animal eats something else as well?"
}
