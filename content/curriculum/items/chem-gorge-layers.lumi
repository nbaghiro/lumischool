# The gorge's layers from the top, and the rule that a layer laid down on another is younger than
# it (the law of superposition; BGS). The unknown is the oldest layer, which of two is older, or the
# rock above a layer.
item chem.gorge-layers v=1 skills=[chemistry.rocks, reasoning.order] {
  title "Reading the gorge's walls"
  difficulty w
  let w=0..2 s=0..1 r=0..1
  let l1={pick(s, "sandstone", "limestone")}
  let l2={pick(s, "shale", "sandstone")}
  let l3={pick(s, "limestone", "mudstone")}
  let l4={pick(s, "mudstone", "chalk")}
  let l5={pick(s, "chalk", "shale")}
  let right={pick(w, l5, l3, l4)}
  let first={pick(w, "Which layer is at the bottom of the wall?", "Find both layers in the table. Which one is lower down?", "Find that layer in the table. Which layer is right under it?")}
  let w1={pick(w, l1, l1, l2)}
  let w2={pick(w, l3, l2, l5)}
  level easy {
    let w=0..0
  }
  level hard {
    let w=1..2
  }

  scene 35x24 {
    row kit at=canvas(1, 0) space=2 align=start {
      strata s layers=5 names=1
      table data cols=2 head=["Layer", "Rock"] cells=["1 top", l1, "2", l2, "3", l3, "4", l4, "5 bottom", l5]
    }
    text ask "The river has cut the gorge through five layers of rock, each laid down on top of the one before. {if w == 0 then \"Which layer was laid down first?\" else if w == 1 then \"Which was laid down earlier, the \" else \"Which layer was laid down just before the \"}{if w == 1 then l1 else if w == 0 then \"\" else l3}{if w == 1 then \" or the \" else if w == 0 then \"\" else \"?\"}{if w == 1 then l3 else \"\"}{if w == 1 then \"?\" else \"\"}" narrate width=34 below=kit gap=1
    choice pick options=[pick(r, right, w1), pick(r, w1, right), w2] below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=s {
      say "Each layer was laid down on top of the one below it. Which one had to be there first?"
    }
  }
  hint "{first}"
  hint "A layer on top was laid down after the layer under it. Which is lower down?"
}
