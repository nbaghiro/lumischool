# Tests that take every way: a decision inside a decision has three ways through it, so a set of
# tests that shows every if saying yes and no needs a number in each of three bands.
item coding.test-covers v=1 skills=[coding.testing, coding.decisions, reasoning.logic] {
  title "Every way through"
  difficulty k
  let k=0..2
  let a={pick(k, 50, 40, 30)} b={pick(k, 20, 15, 10)}
  let good={pick(k, "10, 30 and 70", "10, 25 and 60", "9, 10 and 30")}
  let o1={pick(k, "10 and 70", "5, 20 and 35", "10, 29 and 30")}
  let o2={pick(k, "30, 40 and 60", "20 and 90", "5, 9 and 29")}
  level easy {
    let k={0}
  }
  level hard {
    let k={2}
  }

  scene 36x36 {
    program p code=["if oxygen is less than {a}", "  if oxygen is less than {b}", "    say danger", "  otherwise", "    say low", "otherwise", "  say fine"] text=true at=canvas(0, 0)
    earth e up=1 right-of=p gap=3
    text ask "The crew test the oxygen alarm by setting oxygen to numbers they choose. Which set of tests makes each if say yes at least once and no at least once?" width=34 below=p gap=1
    choice pick options=[pick(k, good, o1, o2), pick(k, o1, o2, good), pick(k, o2, good, o1)] stack=column below=ask gap=1
  }

  check coding.tests of=p input=oxygen pick=covers
  answer pick=good
  feedback {
    when (pick != good) point=p {
      say "Work out what each test says. Does the set give danger, low and fine?"
    }
  }
  hint "There are three things the alarm can say. Which number makes each one?"
  hint "Check the edges: is {b} less than {b}? Is {a} less than {a}?"
}
