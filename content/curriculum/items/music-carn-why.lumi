# The two-star reason: the double bass is the biggest and lowest string instrument, so a light tune
# on it sounds heavy, like an elephant. The wrong reasons are about loudness and speed.
item music.carn-why v=1 stars=2 skills=[music.instruments, music.pitch, reasoning.explain] {
  title "Why the double bass?"
  let r=0..1

  scene 36x30 {
    orchestra band show=["violin", "cello", "double bass"] sizes=1 labels=1 families=0 ring=2 at=canvas(1, 1)
    text ask "Ben asks why Saint-Saens gave the elephant's tune to the double bass and not to a violin. What is the best reason?" narrate width=34 below=band gap=1
    choice pick options=[pick(r, "It is the biggest string, so it sounds low", "It is the only loud string instrument"), "It can only play slowly", pick(r, "It is the only loud string instrument", "It is the biggest string, so it sounds low")] stack=column below=ask gap=1
  }

  answer pick="It is the biggest string, so it sounds low"
  feedback {
    when (pick != "It is the biggest string, so it sounds low") point=band {
      say "Compare the sizes in the drawing. What does a bigger instrument do to the sound?"
    }
  }
  hint "Which of the three plays lowest?"
  hint "What is an elephant like: light and quick, or big and heavy?"
}
