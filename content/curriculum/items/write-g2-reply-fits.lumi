# Every reply is about the same thing as the question, but only one answers what it asks: a place,
# a time, a person or a thing.
item writing.reply-fits v=1 skills=[writing.speech, writing.questions] {
  title "The reply that answers"
  difficulty (if k == 1 then 1 else 0)
  let k=0..3 r=0..2
  level easy {
    let k={0, 2, 3}  # where, who and what
  }
  level hard {
    let k={1, 3}  # when, whose reply is a day
  }
  let asks={if k == 0 then "Where is my hat?" else if k == 1 then "When is the party?" else if k == 2 then "Who made this cake?" else "What is in the box?"}
  let right={if k == 0 then "On the peg." else if k == 1 then "On Saturday." else if k == 2 then "Dad made it." else "A new kite."}
  let w1={if k == 0 then "It is red." else if k == 1 then "At Gran's." else if k == 2 then "It has jam in." else "Under the bed."}
  let w2={if k == 0 then "I have one too." else if k == 1 then "Mia is coming." else if k == 2 then "It is for you." else "Nan gave it."}
  let o1={if r == 0 then right else w1}
  let o2={if r == 1 then right else if r == 0 then w1 else w2}
  let o3={if r == 2 then right else w2}
  let one={if k == 0 then "boy" else if k == 1 then "girl" else if k == 2 then "kid" else "gran"}
  let two={if k == 0 then "gran" else if k == 1 then "boy" else if k == 2 then "girl" else "kid"}

  scene 37x15 {
    comic strip who=["{one}", "{two}"] says=["{asks}", ""] moods=["worried", "happy"] with=["", ""] thinks=[0, 0] holds=["", ""] labels=["1", "2"] at=canvas(1, 1)
    column q right-of=strip gap=1 space=1 align=start {
      text ask "Which reply fits bubble 2?" narrate width=13
      choice pick options=["{o1}", "{o2}", "{o3}"] stack=column
    }
  }

  answer pick=right
  hint "What does bubble 1 ask about: a place, a time, a person or a thing?"
  hint "Which reply tells you that?"
}
