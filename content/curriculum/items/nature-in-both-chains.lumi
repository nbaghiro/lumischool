# The creature the two chains share, and the creature that eats two things: reading the web for
# what joins it up. The shared creature is the plant or the top, which is the plain half; the one
# that eats two things needs the arrows counted.
item nature.in-both-chains v=1 skills=[nature.food-webs] {
  title "Where the chains join"
  difficulty (if w == 0 then 0 else 1)
  let c=0..1 w=0..1
  let x={pick(c, "seaweed", "tiny plants")}
  let y1={pick(c, "crab", "small fish")}
  let y2={pick(c, "sea snail", "shrimp")}
  let z={pick(c, "gull", "seal")}
  let asks={pick(w, "Which creature is in both chains and eats something?", "Which creature eats two different things?")}
  level easy {
    let w=0..0
  }
  level hard {
    let w=1..1
  }

  scene 34x26 {
    row pics at=canvas(1, 1) space=2 align=end {
      crabs pc count=1
      gull pg flying=1
    }
    text one "{x}  →  {y1}  →  {z}" narrate below=pics gap=1
    text two "{x}  →  {y2}  →  {z}" narrate below=one gap=0
    text ask "{asks}" narrate width=32 below=two gap=1
    choice pick options=[x, y1, z] stack=column below=ask gap=1
  }

  answer pick=z
  feedback {
    when (pick == x) point=one {
      say "The {x} is in both chains, but it eats nothing: it is the plant that starts them. Look at the other end."
    }
    when (pick == y1) point=two {
      say "That one is in only one of the two chains. Which creature is written on both lines?"
    }
  }
  hint "Which names appear on both lines? One of them is a plant."
  hint "The creature at the end of both chains has two arrows coming in: it eats two things."
}
