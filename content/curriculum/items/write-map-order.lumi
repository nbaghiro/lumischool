# v2 puts the directions beside a smaller map, so the question fits a third of a page, and the
# turns vary, so the written directions change with the map. The directions are listed in one of
# three orders, so the key is not the same in every version; the blanks are named w to z because a
# and b are the turns.
item writing.map-order v=2 skills=[writing.directions, writing.instructions] {
  title "The directions in order"
  let a={"left", "right"} b={"left", "right"}

  scene 37x15 {
    treasuremap map stops=["palm", "cave", "pond"] turns=[a, b, "on"] heading="right" step=4 names=true at=canvas(1, 1)
    sequence s items=["{if a == \"right\" then \"Walk to the palm tree.\" else if b == \"right\" then \"Pass the pond to the X.\" else \"Turn left at the cave.\"}", "{if a == \"right\" then \"Turn right at the palm.\" else if b == \"right\" then \"Turn right at the cave.\" else \"Walk to the palm tree.\"}", "{if a == \"right\" then \"Pass the pond to the X.\" else if b == \"right\" then \"Walk to the palm tree.\" else \"Pass the pond to the X.\"}", "{if a == \"right\" and b == \"left\" then \"Turn left at the cave.\" else if a == \"right\" then \"Turn right at the cave.\" else \"Turn left at the palm.\"}"] blanks=[w, x, y, z] right-of=map gap=1
    text ask "Number the directions 1 to 4 so they get you to the X." width=35 below=map gap=1
  }

  answer w=(if a == "right" then 1 else if b == "right" then 4 else 3) x=(if a == "right" then 2 else if b == "right" then 3 else 1) y=(if a == "right" then 4 else if b == "right" then 1 else 4) z=(if a == "right" then 3 else 2)
  hint "Follow the path from the boat and read the stops in the order you meet them."
  hint "Which direction comes before you reach the palm?"
}
