# The audit's raise for describing-column: naming words that end in -y and describing words that
# do not, so the ending is no guide and the test with "the" has to be used.
item writing.describing-hard v=1 skills=[writing.word-classes] {
  title "Naming or describing, without the clue"
  difficulty (if w == 1 or w == 3 then 1 else 0)
  let w=0..3 set=0..1
  level easy {
    let w={0, 2}  # a thing in the describing column
  }
  level hard {
    let w={1, 3}  # a describing word in the things column
  }
  let a={if set == 0 then "puppy" else "jelly"}
  let b={if set == 0 then "soft" else "round"}
  let c={if set == 0 then "lolly" else "pony"}
  let d={if set == 0 then "tall" else "cold"}
  let key={if w == 0 then a else if w == 1 then b else if w == 2 then c else d}

  scene 35x17 {
    text ask "One word is in the wrong column. Write it." narrate width=22 at=canvas(1, 1)
    word-input pick options=["{key}"] letters=5 right-of=ask gap=1
    wordsort sort heads=["Naming", "Describing"] words=["{a}", "{b}", "{c}", "{d}"] into=[if w == 0 then 1 else 0, if w == 1 then 0 else 1, if w == 2 then 1 else 0, if w == 3 then 0 else 1] below=ask gap=1
  }

  answer pick=key
  hint "Put the in front of each word. Does it sound like a thing?"
  hint "A word that ends in y can still be a thing, like a puppy."
}
