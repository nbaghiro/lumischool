# A translation adds the same amount across and up to every corner, crossing zero on the way.
item quadrant.slide-corner v=1 skills=[position.transformations, number.negatives] negatives {
  title "Sliding the triangle"
  difficulty ((if dx < 0 then 1 else 0) + (if dy < 0 then 1 else 0) + c / 2)
  let x={-1, 0, 1} y={-1, 0, 1} dx={-5, -3, 2, 3} dy={-4, -2, 1} c=0..2
  where (x + dx >= -4 and x + 2 + dx <= 4 and y + dy >= -4 and y + 3 + dy <= 4)
  level easy {
    where (dx > 0 or dy > 0)
    let c={0, 1}
  }
  level hard {
    where (dx < 0 and dy < 0)
  }

  scene 35x21 {
    moveshape m max=4 shape=1 x=x y=y move="translate" dx=dx dy=dy image=0 names=1 at=canvas(1, 1)
    text ask "The triangle slides {abs(dx)} {if dx < 0 then \"left\" else \"right\"} and {abs(dy)} {if dy < 0 then \"down\" else \"up\"}. Where does corner {pick(c, \"A\", \"B\", \"C\")} land?" narrate width=12 right-of=m gap=2
    row eq below=ask gap=1 space=0 align=centre {
      text o "("
      number-input ix width=3
      text comma ","
      number-input iy width=3
      text cl ")"
    }
  }

  answer ix=(x + pick(c, 0, 2, 0) + dx) iy=(y + pick(c, 0, 0, 3) + dy)
  feedback {
    when (ix == x + pick(c, 0, 2, 0) - dx or iy == y + pick(c, 0, 0, 3) - dy) point=m {
      say "Left and down make the numbers smaller, right and up make them bigger. Check which way each one goes."
    }
  }
  hint "What are the coordinates of corner {pick(c, \"A\", \"B\", \"C\")} now?"
  hint "Count across, then up or down, from that corner. Where do you cross zero?"
}
