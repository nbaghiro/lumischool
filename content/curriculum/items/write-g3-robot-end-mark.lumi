# The way in: a question or a telling sentence, from the words alone. No exclamation is offered,
# since almost any telling sentence could take one.
item writing.robot-end-mark v=1 skills=[writing.editing, writing.punctuation] {
  title "The mark at the end"
  difficulty (if k == 4 then 2 else if k == 0 or k == 2 then 1 else 0)
  let k=0..5
  level easy {
    let k={1, 2, 3, 5}  # tellings, and where did you put the magnet
  }
  level hard {
    let k={0, 2, 4}  # questions, one starting with is
  }

  scene 30x8 {
    caption bot text="{if k == 0 then \"Can you pass me the wire\" else if k == 1 then \"The robot has six wheels\" else if k == 2 then \"Where did you put the magnet\" else if k == 3 then \"We fixed the lamp on Friday\" else if k == 4 then \"Is the bulb too bright\" else \"The wire goes under the table\"}" width=28 at=canvas(1, 1)
    text ask "Which mark goes at the end?" below=bot gap=1
    choice pick options=[".", "?"] right-of=ask gap=1
  }

  answer pick=(if k == 0 or k == 2 or k == 4 then "?" else ".")
  hint "Read it aloud. Is the robot asking something or telling something?"
  hint "Does it start with a word like can, where or is?"
}
