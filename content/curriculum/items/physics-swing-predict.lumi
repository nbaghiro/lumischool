# Predicting from the class's table: a heavier bob or a bigger angle changes nothing, so the time is
# the row with the same string. The times are the real ones for 20, 50 and 80 cm.
item physics.swing-predict v=1 skills=[physics.motion, physics.method, data.tables] {
  title "Predict from the table"
  difficulty w
  let w=0..2 m={100, 200} g={20, 25}
  let len={pick(w, 20, 50, 80)}
  level easy {
    let w=0..1
  }
  level hard {
    let w=1..2
  }
  let secs={pick(w, 9.0, 14.2, 17.9)}

  scene 30x22 {
    table t cols=4 head=["String", "Bob", "Angle", "10 swings"] cells=["20 cm", "50 g", "10°", "9.0 s", "50 cm", "50 g", "10°", "14.2 s", "80 cm", "50 g", "10°", "17.9 s"] at=canvas(1, 0)
    pendulum p length=(len / 10) mass=m angle=g below=t gap=1
    text ask "Mia hangs a {m} g bob on a {len} cm string and lets it go at {g}°. How many seconds will ten swings take?" narrate width=16 right-of=p gap=1
    number-input answer below=ask gap=1
  }

  answer decimals(secs, 1)
  feedback {
    when (answer > secs) point=t {
      say "A heavier bob and a bigger angle do not slow a pendulum down. Which row has the same string?"
    }
    when (answer < secs) point=t {
      say "The bob and the angle do not change the time. Which row has the same string?"
    }
  }
  hint "Which of the three things in the table changes the time of a swing?"
  hint "Find the row with the same string. Does anything else matter?"
}
