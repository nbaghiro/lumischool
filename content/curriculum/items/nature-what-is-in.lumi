# Reading a grid reference the other way round: a square is named and the child says what is in
# it, which is sometimes nothing, since the map holds one thing. The empty square is the trap for a
# child who names the thing without finding the square. At easy the square always holds the thing
# and sits near the corner; at hard it is far from the corner and half the time next to the thing.
item nature.what-is-in v=1 skills=[nature.maps] {
  title "What is in that square?"
  difficulty (e + (if c >= 4 and r >= 3 then 1 else 0))
  let c=1..5 r=1..4 t=0..2 e=0..1 d=0..1
  let thing={pick(t, "hut", "tree", "boat")}
  let qc={if e == 0 then c else if d == 0 then c + 1 else c - 1}
  let qr={if e == 0 then r else if d == 0 then r else r + 1}
  where (qc >= 1 and qc <= 5 and qr <= 4)
  let letter={pick(min(max(qc, 1), 5) - 1, "A", "B", "C", "D", "E")}
  let right={if e == 0 then thing else "nothing"}
  level easy {
    let c=1..3 r=1..3 e=0..0
  }
  level hard {
    let c=4..5 r=3..4
  }

  scene 34x16 {
    gridmap map cols=5 rows=4 col=c row=r thing=thing at=canvas(1, 1)
    text ask "Ada's map of the marsh island. What is in square {letter}{qr}?" narrate width=18 right-of=map gap=2
    choice pick options=["hut", "tree", "boat", "nothing"] below=map gap=1
  }

  answer pick=right
  feedback {
    when (e == 1 and pick == thing) point=map {
      say "That is the {thing}, but it is not in {letter}{qr}. Find {letter} along the top and {qr} down the side, and look in that square."
    }
    when (e == 0 and pick == "nothing") point=map {
      say "Run your finger down from {letter} and across from {qr}. Something is drawn where they meet."
    }
  }
  hint "Find the letter along the top and the number down the side. Slide a finger from each until they meet."
  hint "Look only in that one square. Is anything drawn in it?"
}
