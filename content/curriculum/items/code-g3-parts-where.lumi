# The way in to splitting a job: two parts run one after the other, so part 2 starts on the square
# where part 1 stopped. The slip is running part 2 from the start square.
item coding.parts-where v=1 skills=[coding.decomposition, coding.sequences, coding.tracing] {
  title "Two parts, one after the other"
  difficulty (a + b + c + d)
  let a=1..3 b=1..2 c=1..3 d=1..2
  where (d <= b and a + c <= 6)
  level easy {
    where (a + b + c + d <= 5)
  }
  level hard {
    where (a + b + c + d >= 7)
  }

  scene 36x26 {
    row top at=canvas(1, 0) space=2 align=start {
      maze g cols=7 rows=4 gems=[1 + a, 1 + b] code=["right {a}", "down {b}", "right {c}", "up {d}"] upto=0 trail=none
      column parts space=1 align=start {
        program p1 code=["right {a}", "down {b}"] title="Part 1"
        program p2 code=["right {c}", "up {d}"] title="Part 2"
      }
    }
    text ask "The groundskeeper robot runs part 1, which takes it to the gem, and then part 2. Which square does it stop on?" narrate width=34 below=top gap=1
    row ans below=ask gap=1 space=1 align=centre {
      text lc "column"
      number-input col width=3
      text lr "row"
      number-input row width=3
    }
  }

  check coding.runs of=g col=col row=row
  feedback {
    when (col == 1 + a and row == 1 + b) point=g {
      say "That is the gem, where part 1 stops. Part 2 starts there and moves on."
    }
    when (col == 1 + c) point=p2 {
      say "Part 2 does not start back at the start. It starts on the gem."
    }
  }
  hint "Put a finger on the gem. That is where the first part leaves the robot."
  hint "From the gem, how far right and how far up does the second part go?"
}
