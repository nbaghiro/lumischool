# Dishes sorted under three headings, with one in the wrong column to find.
item writing.dishes-under v=1 skills=[writing.layout, reasoning.sorting] {
  title "Under the right heading"
  difficulty (if w == 3 then 2 else if w == 1 or w == 5 then 1 else 0)
  let w=0..5
  let wrong={pick(w, "tea", "soup", "jelly", "pie", "milk", "cake")}
  level easy {
    let w={0, 2, 4}
  }
  level hard {
    let w={1, 3, 5}
  }

  scene 34x27 {
    text ask "One dish is under the wrong heading. Which one?" narrate width=32 at=canvas(1, 1)
    wordsort sort heads=["Drinks", "Mains", "Puddings"] words=["tea", "soup", "jelly", "pie", "milk", "cake"] into=[if w == 0 then 1 else 0, if w == 1 then 2 else 1, if w == 2 then 0 else 2, if w == 3 then 2 else 1, if w == 4 then 1 else 0, if w == 5 then 0 else 2] below=ask gap=1
    choice pick options=["tea", "soup", "jelly", "pie", "milk", "cake"] stack=column right-of=sort gap=1
  }

  answer pick=wrong
  feedback {
    when (pick != wrong) point=sort {
      say "Read each column's heading, then each dish under it. Is it something you drink, a main course, or a pudding?"
    }
  }
  hint "Go down each column: does every dish belong to its heading?"
  hint "Drinks are things you drink; mains are the meal; puddings are the sweet things after."
}
