# A half turn about a point that is not the origin: the image is as far past the centre as the corner
# was before it, across and up both changing sign.
item symmetry.lander-half-turn v=1 skills=[shapes.symmetry.point, position.four-quadrants] negatives {
  title "Turned about a point"
  difficulty (k + abs(cx) + abs(cy))
  let x={-2, -1, 0} y={-2, -1, 0} cx={1, 2} cy={0, 1, 2} k=0..2
  let px={x + pick(k, 0, 2, 0)}
  let py={y + pick(k, 0, 0, 3)}
  where (py != cy and 2 * cx - x <= 5 and 2 * cy - y <= 5 and 2 * cy - y - 3 >= -5)
  level easy {
    let k={0} cx={1} cy={0, 1}
  }
  level hard {
    let k={1, 2} cx={2} cy={1, 2}
  }

  scene 36x26 {
    moveshape m max=5 shape=1 x=x y=y move="rotate" turn=180 cx=cx cy=cy image=0 names=1 at=canvas(1, 1)
    text ask "The triangle is a solar panel beside the lander. It turns a half turn about the ringed point ({cx}, {cy}). Where does corner {pick(k, \"A\", \"B\", \"C\")} land?" narrate width=10 right-of=m gap=1
    row eq below=ask gap=1 space=0 align=centre {
      text o "("
      number-input ix width=2
      text comma ","
      number-input iy width=2
      text cl ")"
    }
  }

  answer ix=(2 * cx - px) iy=(2 * cy - py)
  feedback {
    when (ix == 0 - px and iy == 0 - py) point=m {
      say "That is a half turn about (0, 0). This turn is about the ringed point."
    }
    when (ix == 2 * cx - px and iy == py) point=m {
      say "Across is right. A half turn moves it up or down past the centre too."
    }
  }
  hint "How far is corner {pick(k, \"A\", \"B\", \"C\")} from the ringed point, across and up?"
  hint "After a half turn it is the same distance from the ringed point on the opposite side."
}
