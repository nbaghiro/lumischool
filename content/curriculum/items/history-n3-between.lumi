# Years between two events of the family's country, from the record (n as in n3-order).
item history.n3-between v=1 skills=[history.nation, history.timeline] {
  title "How many years between?"
  difficulty k
  let n=0..4 k=0..1
  let e1={if k == 0 then pick(n, "Caesar lands in Britain", "First flight", "Great Fire of Edo", "Rostov first mentioned", "Qin unites China") else pick(n, "Caesar lands in Britain", "Rosa Parks kept her seat", "Survey of Japan began", "Suzdal first mentioned", "Qin unites China")}
  let y1={if k == 0 then pick(n, -55, 1903, 1657, 862, -221) else pick(n, -55, 1955, 1800, 1024, -221)}
  let e2={if k == 0 then pick(n, "Romans conquer Britain", "Moon landing", "Television broadcasts in Japan", "Moscow first mentioned", "Paper") else pick(n, "Great Fire of London", "Moon landing", "Map of Japan finished", "Moscow first mentioned", "Paper money")}
  let y2={if k == 0 then pick(n, 43, 1969, 1953, 1147, 105) else pick(n, 1666, 1969, 1821, 1147, 1024)}
  let i={n + 5 * k}
  let from={pick(i, -100, 1900, 1600, 800, -300, -500, 1950, 1790, 1000, -500)}
  let to={pick(i, 100, 1980, 2000, 1200, 200, 2000, 1980, 1830, 1200, 1500)}
  let step={pick(i, 50, 10, 50, 50, 100, 500, 5, 10, 25, 250)}

  scene 36x14 {
    timeline line from=from to=to step=step years=[y1, y2] labels=["{e1}", "{e2}"] at=canvas(0, 0)
    text ask "How many years after the first was the second? There was no year nought." narrate width=24 below=line gap=1
    number-input answer right-of=ask gap=1
  }

  check history.dates of=line answer="between(0 1)"
  hint "Read the year of each flag from the scale."
  hint "Count from the first to the second. Across year one, take one away."
}
