# Keep going until nothing swaps: how many passes that takes depends on how far the small cards
# have to travel, not on how many swaps the first pass makes. The audit's raise for sort-pass.
item coding.passes-needed v=1 skills=[coding.algorithms] {
  title "How many passes?"
  difficulty (if k == 0 then 1 else if k == 1 then 2 else 3)
  let k=0..3

  scene 33x12 {
    sortcards c cards=[if k == 0 then 3 else if k == 1 then 2 else if k == 2 then 5 else 2, if k == 0 then 1 else if k == 1 then 5 else if k == 2 then 4 else 4, if k == 0 then 2 else if k == 1 then 1 else if k == 2 then 2 else 6, if k == 0 then 5 else if k == 1 then 4 else 1] compare=0 swap=false at=canvas(1, 0)
    column q right-of=c gap=2 space=1 align=start {
      text ask "Do passes from the left, swapping as you go, until a pass has no swaps. How many passes had a swap in them?" width=16
      number-input answer
    }
  }

  answer (if k == 0 then 1 else if k == 1 then 2 else 3)
  hint "Do one pass and write the new row down."
  hint "Now do another pass on the new row. Stop when nothing changes."
}
