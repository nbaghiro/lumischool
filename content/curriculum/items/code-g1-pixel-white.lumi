# The audit's raise for counting red: count the white instead, which the picture does not help with
# when it is hidden, so every line has to be read and its white squares added.
item coding.pixel-white v=1 skills=[coding.sequences, coding.data] {
  title "How many white squares?"
  difficulty (2 * a + b + c)
  let a=1..2 b=1..3 c=1..2
  level easy {
    let a={1} b=1..3 c={1}
  }
  level hard {
    let a={2} b=2..3 c=1..2
  }

  scene 30x15 {
    pixels p cols=6 rows=4 code=["{a} white {6 - 2 * a} blue {a} white", "{b} white {6 - b} blue", "6 blue", "{c} white {6 - c} blue"] show=false at=canvas(1, 0)
    text ask "Colour the squares the code says. How many are white?" width=24 below=p gap=1
    number-input answer right-of=ask gap=1
  }

  check coding.runs of=p answer=painted(white)
  feedback {
    when (answer == 2 * a + b + c + 6) point=p {
      say "A line with no white in it has no white squares to count."
    }
  }
  hint "Read one line at a time. How many white squares does it say?"
  hint "Add up the white from every line."
}
