# A pair of tests that misses a bug: the two versions agree outside a band of inputs, so a pair with
# both numbers outside the band passes and the bug goes unseen.
item coding.test-miss v=1 skills=[coding.testing, coding.debugging, reasoning.logic] {
  title "Tests that miss it"
  difficulty k
  let k=0..2
  let a={pick(k, 4, 3, 5)} b={pick(k, 6, 7, 6)}
  let miss={pick(k, "3 and 8", "1 and 9", "5 and 7")}
  let c1={pick(k, "5 and 9", "4 and 10", "6 and 8")}
  let c2={pick(k, "2 and 6", "2 and 7", "2 and 6")}
  level easy {
    let k={0}
  }
  level hard {
    let k={2}
  }

  scene 36x30 {
    program p code=["if crew is more than {a}", "  say big lander", "otherwise", "  say small lander"] text=true at=canvas(0, 0)
    lander ld rungs=6 right-of=p gap=3
    text ask "Crews of more than {a} need the big lander. A copy of the program has {b} in line 1 instead of {a}. Ben tested the copy with three pairs of crew sizes. Which pair would not show the mistake?" width=34 below=p gap=1
    choice pick options=[pick(k, c1, miss, c2), pick(k, miss, c2, c1), pick(k, c2, c1, miss)] stack=column below=ask gap=1
  }

  check coding.tests of=p input=crew bug="1: if crew is more than {b}" pick=misses
  answer pick=miss
  feedback {
    when (pick != miss) point=p {
      say "One of those crews is more than {a} but not more than {b}. The two versions give it different landers."
    }
  }
  hint "For which crew sizes do more than {a} and more than {b} give different answers?"
  hint "A pair misses the mistake when neither of its numbers is one of those."
}
