# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.postcard-match v=1 skills=[language.reading, language.time] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[postcard.yesterday]]", "[[postcard.dear]]", "[[postcard.we-saw]]"), pick(k, "[[postcard.today]]", "[[postcard.love-at-the-end]]", "[[postcard.we-are-going]]"), pick(k, "[[postcard.tomorrow]]", "[[postcard.see-you-soon]]", "[[postcard.we-eat]]"), pick(k, "[[postcard.now]]", "[[postcard.regards]]", "[[postcard.i-swim]]")] right=[pick(k, "tomorrow", "regards", "we eat"), pick(k, "yesterday", "dear", "we saw"), pick(k, "today", "love, at the end", "I swim"), pick(k, "now", "see you soon", "we are going")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
