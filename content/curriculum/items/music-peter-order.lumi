# Three woodwinds put in order from highest to lowest by size, read from the drawing: flute,
# clarinet, bassoon. The list is given in a different order each time.
item music.peter-order v=1 skills=[music.instruments, music.pitch, reasoning.order] {
  title "High to low"
  difficulty (if k == 0 then 0 else 1)
  let k=0..2
  let s1={pick(k, "flute", "bassoon", "clarinet")}
  let s2={pick(k, "bassoon", "clarinet", "flute")}
  let s3={pick(k, "clarinet", "flute", "bassoon")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..2
  }

  scene 36x27 {
    orchestra band show=["clarinet", "bassoon", "flute"] sizes=1 labels=1 families=0 ring=-1 at=canvas(1, 1)
    text ask "Number these from 1, the highest, to 3, the lowest. They are drawn in proportion to each other." narrate width=34 below=band gap=1
    sequence s items=[s1, s2, s3] blanks=[a, b, c] below=ask gap=1
  }

  answer a=pick(k, 1, 3, 2) b=pick(k, 3, 2, 1) c=pick(k, 2, 1, 3)
  feedback {
    when (b != pick(k, 3, 2, 1)) point=band {
      say "The longest tube plays the lowest notes. Which is longest?"
    }
  }
  hint "Find the smallest and the biggest first."
  hint "The smallest is highest, so it is number 1."
}
