# The story: a capped bottle of air from the hut at 20 °C put out at 0 °C. The syringe's table says
# 100 ml of air becomes 93 ml, so every 100 ml loses 7 ml of room and the soft bottle is pushed in.
item chem.bottle-crumples v=1 stars=1 skills=[chemistry.gases, ratio.scaling] {
  title "The crumpled bottle"
  difficulty (w * 2 + (if v <= 1000 then 0 else 1))
  let w=0..1 v={500, 1000, 1500, 2000}
  let less={7 * v / 100}
  level easy {
    let w=0..0 v={500, 1000}
  }
  level hard {
    let w=1..1
  }

  scene 35x18 {
    row kit at=canvas(1, 0) space=2 align=end {
      hut h pictures=2
      table data cols=2 head=["Temperature °C", "Air, ml"] cells=["20", "100", "0", "93"]
    }
    text ask "Leo caps an empty {v} ml plastic bottle in the hut at 20 °C and leaves it outside, where it is 0 °C. The table is from the syringe of air. {if w == 0 then \"About how many millilitres less room does the air in the bottle take outside?\" else \"About how many millilitres does the air in the bottle fill outside?\"}" narrate width=34 below=kit gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then less else v - less)
  feedback {
    when (answer == 7) point=data {
      say "7 ml is for each 100 ml. How many lots of 100 ml does the bottle hold?"
    }
    when (w == 1 and answer == less) point=data {
      say "That is how much room the air lost. How much does it still fill?"
    }
  }
  hint "In the table, how much room does 100 ml of air lose between 20 °C and 0 °C?"
  hint "How many lots of 100 ml are in the bottle?"
}
