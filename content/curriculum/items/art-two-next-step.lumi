# The order of the construction: the near edge, lines to both points, the back edges upright where
# the sides end, and, when the top shows, the far corner found by ruling across.
item art.two-next-step v=1 skills=[art.perspective, reasoning.sequence] {
  title "What comes next?"
  difficulty (if k == 2 then 1 else 0)
  let k=0..2
  let s={pick(k, 1, 2, 2)}
  let h={pick(k, 6, 6, 2)}
  let right={pick(k, "Rule lines from both ends of it to both points", "Draw an upright back edge where each side ends", "Rule from each back top corner to the other point")}
  let o1={pick(k, "Draw an upright back edge where each side ends", "Rule from each back top corner to the other point", "Rule lines from both ends of it to both points")}
  let o2={pick(k, "Rule from each back top corner to the other point", "Rule lines from both ends of it to both points", "Draw an upright back edge where each side ends")}
  let r={k % 3}
  level easy {
    let k={1}
  }
  level hard {
    let k={1, 2}
  }

  scene 36x25 {
    twopoint crate horizon=h left=1 right=15 corner=8 stage=s door=false at=canvas(1, 1)
    text ask "{pick(k, \"Ada has ruled the horizon, put a point at each end and drawn the crate's near edge. What does she draw next?\", \"Ada has ruled lines from both ends of the near edge to both points. What does she draw next?\", \"The crate's top shows, and Ada has drawn its two sides with their back edges. How does she find the far corner of the top?\")}" width=18 right-of=crate gap=1
    choice pick options=[if r == 0 then right else if r == 1 then o1 else o2, if r == 0 then o1 else if r == 1 then o2 else right, if r == 0 then o2 else if r == 1 then right else o1] stack=column at=canvas(1, 14)
  }

  answer pick=right
  feedback {
    when (pick != right) point=crate {
      say "Look at what is on the page already. Which step needs only what is there?"
    }
  }
  hint "What is drawn so far? Which lines do the next ones start from?"
  hint "Edges come from the near edge first, then the back edges cut them off, then the top joins the back corners."
}
