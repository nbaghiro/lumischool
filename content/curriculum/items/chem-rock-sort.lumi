item chem.rock-sort v=1 skills=[chemistry.rocks] {
  title "Sorted wrong"
  difficulty w
  let w=0..3

  scene 37x18 {
    text ask "One rock is in the wrong column. Which one?" width=22 at=canvas(1, 0)
    wordsort s heads=["soaks up water", "keeps water out"] words=["sandstone", "granite", "chalk", "slate"] into=[if w == 0 then 1 else 0, if w == 1 then 0 else 1, if w == 2 then 1 else 0, if w == 3 then 0 else 1] below=ask gap=1
    choice pick options=["sandstone", "granite", "chalk", "slate"] stack=column right-of=s gap=1
  }

  answer pick=(if w == 0 then "sandstone" else if w == 1 then "granite" else if w == 2 then "chalk" else "slate")
  hint "Which of these rocks are made of grains with gaps between them?"
  hint "Water soaks into the gaps. Check each rock is under the right heading."
}
