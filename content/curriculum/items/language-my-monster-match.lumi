# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.my-monster-match v=1 skills=[language.describing, language.numbers] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[describe.the-eyes]]", "[[describe.big]]", "[[describe.one-eye]]"), pick(k, "[[describe.the-legs]]", "[[describe.small]]", "[[describe.two-eyes]]"), pick(k, "[[describe.the-horns]]", "[[describe.round]]", "[[describe.one-horn]]"), pick(k, "[[describe.the-stripes]]", "[[describe.long]]", "[[describe.two-horns]]")] right=[pick(k, "the horns", "long", "one horn"), pick(k, "the eyes", "big", "one eye"), pick(k, "the legs", "small", "two horns"), pick(k, "the stripes", "round", "two eyes")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
