# Open: two sentences about one picture, one that tells and one that asks, marked by a grown-up.
item reading.tell-and-ask v=1 stars=3 skills=[reading.punctuation, writing.sentences] {
  title "One that tells, one that asks"
  let f=1..3 d=2..4

  scene 32x20 {
    pond pic pads=d fish=f frog=true at=canvas(1, 1)
    text ask "Write one sentence that tells about the pond, and one that asks." narrate width=16 right-of=pic gap=1
    writinglines lines lines=2 width=30 prompt="" below=pic gap=1
  }

  check writing.by-eye look-for="Two sentences about the pond: one that tells something and ends with a full stop, and one that asks something and ends with a question mark, each starting with a capital letter."
  hint "What can you see in the pond? That is a sentence that tells."
  hint "What would you like to know about it? Start with who, what or where."
}
