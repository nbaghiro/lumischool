# The unknown moves from the number to the place: which item number gives the number wanted.
item coding.list-which-place v=1 skills=[coding.lists, reasoning.work-backwards] {
  title "Which place?"
  difficulty (k + (if s == 1 then 1 else 0))
  let s=0..1 k=1..5
  let a={pick(s, 12, 30)} b={pick(s, 25, 14)} c={pick(s, 8, 21)} d={pick(s, 31, 9)} e={pick(s, 17, 26)}
  level easy {
    let k=1..3 s={0}
  }
  level hard {
    let k=3..5
  }

  scene 36x18 {
    program p code=["set mill to list {a}, {b}, {c}, {d}, {e}", "set n to item ? of mill"] at=canvas(1, 0)
    listbox l name=mill code=["set mill to list {a}, {b}, {c}, {d}, {e}"] below=p gap=1
    text ask "The list is the sacks each boat brings to the mill. Mira wants n to be {pick(k - 1, a, b, c, d, e)}. What goes in place of the question mark?" width=14 right-of=l gap=1
    number-input answer below=ask gap=1
  }

  answer k
  feedback {
    when (answer == pick(k - 1, a, b, c, d, e)) point=l {
      say "{answer} is the number Mira wants. The question mark is its place in the list."
    }
  }
  hint "Find the cell that holds the number Mira wants."
  hint "Is the question mark a number kept in the list, or a place?"
}
