# The evidence question of every sitting: the line of our text that proves a point the question
# makes in other words. Three versions a sitting: k = 3s is the plain one (the words are close to the
# question's), 3s + 1 asks for a reason or a feeling, 3s + 2 asks for what a character does not say.
item reading.willows-line v=1 skills=[reading.evidence, reading.whole-book] {
  title "Which line proves it?"
  difficulty (k - 3 * floor(k / 3))
  let k=0..26

  scene 34x8 {
    row all at=canvas(1, 1) space=2 align=centre {
      bookcast c who=pick(k, "mole", "mole", "toad", "rat", "rat", "mole", "mole", "rat", "mole", "toad", "toad", "toad", "toad", "toad", "toad", "mole", "mole", "rat", "toad", "toad", "toad", "rat", "toad", "toad", "toad", "toad", "rat") pose=pick(k, "wave", "stand", "wave", "walk", "walk", "stand", "stand", "walk", "walk", "walk", "stand", "stand", "walk", "stand", "stand", "stand", "stand", "walk", "walk", "stand", "wave", "stand", "stand", "stand", "wave", "stand", "stand") dir=1
      column q space=1 align=start {
        text ask "{pick(k, \"Which line of chapter 1 tells you the Mole had never been out in a boat?\", \"Which line of chapter 1 tells you what made the Mole snatch the sculls from the Rat?\", \"Which line of chapter 2 shows Toad did not mind at all that his cart was wrecked?\", \"Which line of chapter 3 says what the Rat pushed into his belt before he went after the Mole?\", \"Which line of chapter 3 tells you how the Rat worked out where the Mole had gone?\", \"Which line of chapter 4 shows the Mole has decided the Wild Wood is not the place for him?\", \"Which line of chapter 5 tells you how the name of the Mole's house was written over his door?\", \"Which line of chapter 5 gives the reason the Rat would not stop when the Mole first called?\", \"Which line of chapter 5 shows the Mole gave in and walked on without another word?\", \"Which line of chapter 6 tells you what Toad used to climb out of his bedroom window?\", \"Which line of chapter 6 shows Toad had not meant his promise to give up motor-cars?\", \"Which line of chapter 6 shows Toad could not stop himself once he heard the car start?\", \"Which line of chapter 8 tells you what Toad did when the engine-driver called out to him?\", \"Which line of chapter 8 shows Toad had no plan to wash the engine-driver's shirts?\", \"Which line of chapter 8 shows Toad forgot he was dressed as a woman when he tried to pay?\", \"Which line of chapter 9 tells you what the Mole fetched to give the Rat something to do?\", \"Which line of chapter 9 shows the Mole could see his friend was not himself?\", \"Which line of chapter 9 tells you where the Rat meant to go when he set off with his bag?\", \"Which line of chapter 10 tells you how Toad got away from the barge?\", \"Which line of chapter 10 shows the barge-woman had doubted Toad before she saw him wash?\", \"Which line of chapter 10 shows what the narrator thinks of the song Toad made up?\", \"Which line of chapter 11 tells you when the weasels will all be in one room?\", \"Which line of chapter 11 gives the reason Toad's father kept the tunnel from him?\", \"Which line of chapter 11 shows how Toad first took the news about his father?\", \"Which line of chapter 12 says in a few words that Toad had changed?\", \"Which line of chapter 12 shows Toad thanked the girl who helped him out of prison?\", \"Which line of chapter 12 gives the Rat's reason for stopping Toad's songs?\")}" width=24
        number-input answer
      }
    }
  }

  check book.line book=wind-in-the-willows chapter="{pick(k, 1, 1, 2, 3, 3, 4, 5, 5, 5, 6, 6, 6, 8, 8, 8, 9, 9, 9, 10, 10, 10, 11, 11, 11, 12, 12, 12)}" holds="{pick(k, \"I’ve never been in a boat\", \"more jealous of Rat, sculling so strongly\", \"satisfied expression, and at intervals he faintly murmured\", \"shoved a brace of pistols into it\", \"running along straight and purposeful\", \"that he was an animal of tilled field and hedge-row\", \"painted, in Gothic lettering\", \"something suspiciously like approaching snow\", \"and followed submissively in the track of the Rat\", \"knotting the sheets from\", \"I’m not a bit sorry or repentant really\", \"old passion seized on Toad and completely mastered him\", \"Toad jumped, rolled down a short embankment\", \"and couldn’t if he tried and, anyhow, he wasn’t going to begin\", \"in search of the necessary money, where his waistcoat\", \"returned with a pencil and\", \"and set and turned a streaked and shifting grey\", \"Going South, with the rest of them\", \"jumped lightly on the horse’s back\", \"from the conceited way you talked\", \"the most conceited song that any\", \"banquet to-morrow night\", \"very light and volatile in character\", \"was inclined to be sulky at first\", \"He was indeed an altered Toad\", \"locket set with pearls\", \"your songs are all conceit and\")}"
  hint "Which part of the chapter is the question about? Turn to the page where that happens."
  hint "Say the answer in your own words first, then look for the line that says the same thing."
  hint "Is the whole idea on your line, or does it start on the line before?"
}
