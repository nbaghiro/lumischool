item columns.add v=1 skills=[addition.columns] {
  title "Add in columns"
  difficulty ((if a % 100 + b % 100 >= 100 then 1 else 0) + (if a % 1000 + b % 1000 >= 1000 then 1 else 0))
  let a=1000..8999 b=1000..8999
  where (a + b < 10000)
  where (a % 10 + b % 10 >= 10)  # at least one carry, in the ones
  level easy {
    where (a % 100 + b % 100 < 100 and a % 1000 + b % 1000 < 1000)  # the ones carry only
  }
  level hard {
    where (a % 100 + b % 100 >= 100 and a % 1000 + b % 1000 >= 1000)  # every column carries
  }

  scene 8x5 {
    columns answer a=a b=b op=add at=canvas(1, 0)
  }

  answer (a + b)
  feedback {
    when (answer == a + b - 10) point=answer {
      say "A column made ten or more. Carry the ten into the next column."
    }
  }
}
