item physics.planet-order v=1 skills=[physics.sky] {
  title "Out from the sun"
  difficulty k
  let k=2..7
  level easy {
    let k=2..4
  }
  level hard {
    let k=5..7
  }

  scene 33x15 {
    planets row count=8 names=1 at=canvas(0, 0)
    text ask "Which planet is number {k} out from the sun?" width=13 below=row gap=1
    choice pick options=["{if k <= 4 then \"Venus\" else \"Jupiter\"}", "{if k <= 4 then \"Earth\" else \"Saturn\"}", "{if k <= 4 then \"Mars\" else \"Uranus\"}", "{if k <= 4 then \"Mercury\" else \"Neptune\"}"] below=ask gap=1
  }

  answer pick=(if k == 2 then "Venus" else if k == 3 then "Earth" else if k == 4 then "Mars" else if k == 5 then "Jupiter" else if k == 6 then "Saturn" else "Uranus")
  hint "Which planet is nearest the sun, and which comes next?"
}
