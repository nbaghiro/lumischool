item physics.pendulum-faster v=1 skills=[physics.motion] {
  title "Which swings faster?"
  difficulty (8 - abs(x - y) + (if m != n then 1 else 0))
  let x=2..8 y=2..8 m={50, 100, 200} n={50, 100, 200}
  where (x != y)
  level easy {
    where (abs(x - y) >= 3 and m == n)
  }
  level hard {
    where (abs(x - y) == 1 and x > y and m > n or abs(x - y) == 1 and x < y and m < n)
  }

  scene 26x16 {
    row two at=canvas(1, 0) space=1 align=start {
      pendulum a length=x mass=m tag="A"
      pendulum b length=y mass=n tag="B"
    }
    text ask "Which one swings to and fro more times in ten seconds?" width=16 below=two gap=0
    choice pick options=["A", "B"] right-of=ask gap=1
  }

  check physics.forces of=a vs=b pick=faster
  feedback {
    when (pick == "A" and x > y and m > n) point=a {
      say "A has the heavier bob, but the weight makes no difference. Look at the strings."
    }
    when (pick == "B" and y > x and n > m) point=b {
      say "B has the heavier bob, but the weight makes no difference. Look at the strings."
    }
  }
  hint "Which string is shorter?"
}
