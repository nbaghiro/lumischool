item physics.pendulum-table v=1 skills=[physics.motion, physics.method] stars=2 {
  title "Predict from the table"
  let w=0..1

  scene 30x15 {
    table data cols=3 head=["String", "Bob", "Swings in 10 s"] cells=["25 cm", "50 g", 10, "100 cm", "50 g", 5] at=canvas(1, 0)
    text ask "Mia keeps the {if w == 0 then \"25 cm\" else \"100 cm\"} string and puts on a 200 g bob. How many swings in 10 seconds now?" narrate width=28 below=data gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then 10 else 5)
  feedback {
    when (answer != 10 and answer != 5) point=data {
      say "A heavier bob does not change how fast a pendulum swings. What did the same string do before?"
    }
  }
  hint "Does the weight of the bob change how fast it swings?"
  hint "So what did that string give in the table?"
}
