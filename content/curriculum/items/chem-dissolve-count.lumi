# Several steps: the child says which things they can see, and the ones that are missing from the
# picture are the ones that dissolved.
item chem.dissolve-count v=1 skills=[chemistry.dissolving] {
  title "How many dissolved?"
  difficulty (if k == 1 or k == 3 then 2 else 1)
  let k=0..5
  level easy {
    let k={0, 1, 2, 4}
  }
  level hard {
    let k={1, 3, 5}  # two of the three dissolve, or the cork floats
  }

  scene 25x11 {
    mixture mix things=["{if k == 0 then \"sand\" else if k == 1 then \"sugar\" else if k == 2 then \"iron\" else if k == 3 then \"salt\" else if k == 4 then \"pebbles\" else \"cork\"}", "{if k == 0 then \"salt\" else if k == 1 then \"salt\" else if k == 2 then \"sugar\" else if k == 3 then \"sugar\" else if k == 4 then \"sugar\" else \"sand\"}", "{if k == 0 then \"cork\" else if k == 1 then \"pebbles\" else if k == 2 then \"cork\" else if k == 3 then \"sand\" else if k == 4 then \"iron\" else \"salt\"}"] water=1 names=0 at=canvas(1, 0)
    text ask "{if k == 0 then \"sand\" else if k == 1 then \"sugar\" else if k == 2 then \"iron filings\" else if k == 3 then \"salt\" else if k == 4 then \"pebbles\" else \"cork\"}, {if k == 0 then \"salt\" else if k == 1 then \"salt\" else if k == 2 then \"sugar\" else if k == 3 then \"sugar\" else if k == 4 then \"sugar\" else \"sand\"} and {if k == 0 then \"cork\" else if k == 1 then \"pebbles\" else if k == 2 then \"cork\" else if k == 3 then \"sand\" else if k == 4 then \"iron filings\" else \"salt\"} were stirred into the water. How many of them dissolved?" width=14 right-of=mix gap=1
    number-input answer below=ask gap=1
  }

  answer (if k == 0 then 1 else if k == 1 then 2 else if k == 2 then 1 else if k == 3 then 2 else if k == 4 then 1 else 1)
  feedback {
    when (answer == 3) point=mix {
      say "Some of them are still in the glass. Which can you see?"
    }
  }
  hint "Which of the three can you still see, at the bottom or on the top?"
  hint "Where has a thing gone if you cannot see it anywhere in the water? How many are like that?"
}
