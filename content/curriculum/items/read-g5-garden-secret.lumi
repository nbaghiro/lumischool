# The two-star reason: why Colin goes on groaning in front of the nurse and the doctor in chapter 24.
# Dickon tells his mother it is to keep the news for his father; the wrong reasons fit things the
# nurse says (his appetite) or how he used to be (ill indoors).
item reading.garden-secret v=1 stars=2 skills=[reading.inference, reading.characters, reading.evidence] {
  title "Why does he still groan?"
  set right="To keep his news for his father."

  scene 35x23 {
    column all at=canvas(1, 1) space=1 align=start {
      row top space=1 align=end {
        bookcast m who=mary pose=think dir=1
        flowers f count=2 petals=6
        text ask "By chapter 24 Colin is growing strong, yet he still groans and frets in front of the nurse and the doctor. Why?" width=15
      }
      choice pick options=["He still feels ill when he is indoors.", right, "He wants the nurse to bring more food."] stack=column
    }
  }

  answer pick=right
  feedback {
    when (pick == "He still feels ill when he is indoors.") point=m {
      say "Does Colin feel ill any more? Find what Dickon tells his mother about the groaning."
    }
    when (pick == "He wants the nurse to bring more food.") point=m {
      say "Food comes into it, but that is what the nurse notices. What is Colin trying to hide?"
    }
  }
  hint "Who must not find out yet that Colin can stand and walk?"
  hint "What does Dickon tell his mother Colin is saving the secret for?"
}
