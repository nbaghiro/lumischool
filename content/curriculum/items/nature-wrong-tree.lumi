# The two-star reason: the year painted in order, with one tree that does not belong where it is.
# A bare tree in summer's place is easy to spot; blossom or falling leaves in the wrong place needs
# each tree read against the season it should show.
item nature.wrong-tree v=1 stars=2 skills=[nature.seasons, reasoning.find-the-mistake] {
  title "One tree is wrong"
  difficulty (if k <= 1 then 0 else if k <= 3 then 1 else 2)
  let k=0..5
  let a={if k == 2 then "winter" else if k == 4 then "autumn" else "spring"}
  let b={if k == 0 then "winter" else if k == 5 then "autumn" else "summer"}
  let c={if k == 3 then "spring" else "autumn"}
  let d={if k == 1 then "summer" else "winter"}
  let pos={if k == 0 or k == 5 then 2 else if k == 1 then 4 else if k == 3 then 3 else 1}
  level easy {
    let k=0..1
  }
  level hard {
    let k=4..5
  }

  scene 36x22 {
    seasontrees year seasons=[a, b, c, d] names=0 at=canvas(1, 1)
    text ask "Ada painted her tree in spring, summer, autumn and winter, in that order. One painting is in the wrong place. Which one?" narrate width=34 below=year gap=1
    choice pick options=["1", "2", "3", "4"] below=ask gap=1
  }

  answer pick=(if pos == 1 then "1" else if pos == 2 then "2" else if pos == 3 then "3" else "4")
  feedback {
    when (k == 4 and pick == "3") point=year {
      say "The third tree is losing its leaves, and that is autumn, where it should be. Look at the first tree: is that spring?"
    }
    when (k == 5 and pick == "3") point=year {
      say "The third tree is right for autumn. The second tree looks like autumn too, and that place is summer."
    }
  }
  hint "Say the seasons along the row: spring, summer, autumn, winter. Look at each tree as you say its season."
  hint "Which tree does not match the season you said for it?"
}
