# Four events of one chapter put back in the order the book tells them; they are shuffled so no two
# neighbours on the page are neighbours in the story.
item reading.wild-order v=1 skills=[reading.sequencing, reading.whole-book] {
  title "In the order it happened"
  let k=0..1

  scene 35x19 {
    column all at=canvas(1, 1) space=1 align=start {
      row top space=1 align=end {
        text ask "These happen in chapter {pick(k, 3, 6)}. Number them in the order the book tells them." width=24
        bookcast b who=buck pose=walk dir=-1
      }
      sequence s items=[pick(k, "Buck gets between Spitz and Pike.", "Buck saves Thornton in the rapids."), pick(k, "Starving huskies raid the camp.", "Buck moves the sled of flour."), pick(k, "The team chases a snowshoe rabbit.", "Thornton tells Buck to jump off a cliff."), pick(k, "Dolly goes mad and chases Buck.", "Buck leaps at Black Burton.")] blanks=[p1, p2, p3, p4]
    }
  }

  answer p1=3 p2=pick(k, 1, 4) p3=pick(k, 4, 1) p4=2
  hint "Which one starts the chapter? Which one ends it?"
  hint "Put the two ends first, then ask which of the middle two leads to the other."
}
