# Four panels out of order, and one word (still, again) that fixes a panel's place. The question
# asks for the second or third picture, so the whole order has to be worked out.
item reading.comic-order v=2 skills=[reading.comics, reading.sequencing] {
  title "Put the pictures in order"
  difficulty (pos - 1)
  let c=0..5 pos=1..2

  scene 37x16 {
    comic strip who=[if c == 0 then "girl" else if c == 1 then "girl" else if c == 2 then "girl" else if c == 3 then "gran" else if c == 4 then "gran" else "gran", if c == 0 then "girl" else if c == 1 then "girl" else if c == 2 then "girl" else if c == 3 then "gran" else if c == 4 then "gran" else "gran", if c == 0 then "girl" else if c == 1 then "girl" else if c == 2 then "girl" else if c == 3 then "gran" else if c == 4 then "gran" else "gran", if c == 0 then "girl" else if c == 1 then "girl" else if c == 2 then "girl" else if c == 3 then "gran" else if c == 4 then "gran" else "gran"] says=[if c == 0 then "Now it is as tall as me." else if c == 1 then "Look, a tiny green shoot." else if c == 2 then "At last it has a flower." else if c == 3 then "I will try again." else if c == 4 then "Oh no, I dropped the eggs." else "It is ready. Who wants some?", if c == 0 then "Let's plant a seed." else if c == 1 then "At last it has a flower." else if c == 2 then "Now it is as tall as me." else if c == 3 then "I will bake a cake." else if c == 4 then "It is ready. Who wants some?" else "I will try again.", if c == 0 then "At last it has a flower." else if c == 1 then "Let's plant a seed." else if c == 2 then "Look, a tiny green shoot." else if c == 3 then "It is ready. Who wants some?" else if c == 4 then "I will bake a cake." else "Oh no, I dropped the eggs.", if c == 0 then "Look, a tiny green shoot." else if c == 1 then "Now it is as tall as me." else if c == 2 then "Let's plant a seed." else if c == 3 then "Oh no, I dropped the eggs." else if c == 4 then "I will try again." else "I will bake a cake."] moods=[if c == 0 then "happy" else if c == 1 then "excited" else if c == 2 then "excited" else if c == 3 then "happy" else if c == 4 then "sad" else "excited", if c == 0 then "happy" else if c == 1 then "excited" else if c == 2 then "happy" else if c == 3 then "happy" else if c == 4 then "excited" else "happy", if c == 0 then "excited" else if c == 1 then "happy" else if c == 2 then "excited" else if c == 3 then "excited" else if c == 4 then "happy" else "sad", if c == 0 then "excited" else if c == 1 then "happy" else if c == 2 then "happy" else if c == 3 then "sad" else if c == 4 then "happy" else "happy"] with=[if c == 0 then "" else if c == 1 then "" else if c == 2 then "" else if c == 3 then "" else if c == 4 then "" else "", if c == 0 then "" else if c == 1 then "" else if c == 2 then "" else if c == 3 then "" else if c == 4 then "" else "", if c == 0 then "" else if c == 1 then "" else if c == 2 then "" else if c == 3 then "" else if c == 4 then "" else "", if c == 0 then "" else if c == 1 then "" else if c == 2 then "" else if c == 3 then "" else if c == 4 then "" else ""] thinks=[if c == 0 then 0 else if c == 1 then 0 else if c == 2 then 0 else if c == 3 then 0 else if c == 4 then 0 else 0, if c == 0 then 0 else if c == 1 then 0 else if c == 2 then 0 else if c == 3 then 0 else if c == 4 then 0 else 0, if c == 0 then 0 else if c == 1 then 0 else if c == 2 then 0 else if c == 3 then 0 else if c == 4 then 0 else 0, if c == 0 then 0 else if c == 1 then 0 else if c == 2 then 0 else if c == 3 then 0 else if c == 4 then 0 else 0] holds=[if c == 0 then "" else if c == 1 then "" else if c == 2 then "" else if c == 3 then "" else if c == 4 then "" else "", if c == 0 then "" else if c == 1 then "" else if c == 2 then "" else if c == 3 then "" else if c == 4 then "" else "", if c == 0 then "" else if c == 1 then "" else if c == 2 then "" else if c == 3 then "" else if c == 4 then "" else "", if c == 0 then "" else if c == 1 then "" else if c == 2 then "" else if c == 3 then "" else if c == 4 then "" else ""] labels=["A", "B", "C", "D"] at=canvas(0, 0)
    text ask "Which picture comes {if pos == 1 then \"second\" else \"third\"} in the story?" narrate width=20 below=strip gap=1
    choice pick options=["A", "B", "C", "D"] right-of=ask gap=1
  }

  answer pick=(if pos == 1 then if c == 0 then "D" else if c == 1 then "A" else if c == 2 then "C" else if c == 3 then "D" else if c == 4 then "A" else "C" else if c == 0 then "A" else if c == 1 then "D" else if c == 2 then "B" else if c == 3 then "A" else if c == 4 then "D" else "B")
  hint "Which picture has to come first? Which one is the end?"
  hint "Look for a word like still or again. What must have happened before it?"
}
