# Non-routine: two rates at once. The rows show only the first ten minutes, so the child carries
# each pattern on in their head to the moment the question names.
item chem.ice-both v=1 stars=3 skills=[chemistry.states, reasoning.two-rates] {
  title "Two ice cubes"
  difficulty (if k == 1 then 0 else if k == 0 then 1 else 2)
  let k=0..2

  scene 30x18 {
    row pair at=canvas(1, 0) space=1 align=start {
      icemelt one every=10 count=2 place=(if k == 0 then 2 else if k == 1 then 2 else 1)
      icemelt two every=10 count=2 place=(if k == 0 then 1 else if k == 1 then 0 else 2)
    }
    text ask "{if k == 0 then \"When the ice in the sun has all melted, how much of the ice on the table is left?\" else if k == 1 then \"When the ice in the sun has all melted, how much of the ice in the freezer is left?\" else \"When the ice on the table is half gone, how much of the ice in the sun is left?\"}" width=19 below=pair gap=0
    choice pick options=["all of it", "half of it", "none of it"] below=ask gap=0
  }

  answer pick=(if k == 0 then "half of it" else if k == 1 then "all of it" else "none of it")
  hint "How long does the first cube take to melt all the way, or half way?"
  hint "What happens to the other cube in that same time?"
  hint "Carry each row on, ten minutes at a time, until you reach that moment."
}
