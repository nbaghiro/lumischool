# The way in: apples in one row, read aloud and counted. Up to three is seen at a glance.
item k.how-many-apples v=1 skills=[counting.to-five] {
  title "How many apples?"
  difficulty n
  let n=1..5
  level easy {
    let n=1..3
  }
  level hard {
    let n=4..5
  }

  scene 22x8 {
    props row count=n prop=apple at=canvas(1, 1)
    text ask "How many apples?" narrate below=row gap=1
    number-input answer right-of=ask gap=1
  }

  answer n
  feedback {
    when (answer == n + 1) point=row {
      say "Touch each apple once. Did one apple get two numbers?"
    }
  }
  hint "Can you see how many without counting?"
  hint "Touch each apple as you say a number. What was the last number?"
}
