# Three stars: the fewest cells for a night lamp, a bulb against an LED as bright. The joules for the
# night over 10 000 J a cell, rounded up, since a cell part used up is still a whole cell.
item physics.cell-night-lamp v=1 stars=3 skills=[physics.energy, reasoning.constraints, reasoning.chain] {
  title "Cells for the night"
  difficulty v
  let v=0..3
  let hrs={pick(v, 10, 8, 10, 12)}
  let p={pick(v, 2, 5, 5, 10)}
  let bulb={pick(v, 8, 15, 18, 44)}
  let led={pick(v, 1, 2, 3, 6)}
  level easy {
    let v=0..0
  }
  level hard {
    let v=2..3
  }

  scene 24x33 {
    energyflow e thing="filament bulb" from="electricity" to="light" input=100 useful=5 wasted=[95] wastes=["heating"] blank=-1 unit=J at=canvas(1, 0)
    text ask "The rope bridge over the gorge has a lamp that must stay on for {hrs} hours each night. A filament bulb uses {p} J each second; an LED as bright uses an eighth of that. Each cell stores 10 000 J. How many cells are needed for a night with the bulb?" narrate width=22 below=e gap=1
    number-input bulbs below=ask gap=1
    text then "And with the LED?" narrate width=22 below=bulbs gap=1
    number-input leds below=then gap=1
  }

  answer bulbs=bulb leds=led
  feedback {
    when (bulbs == bulb - 1) point=ask {
      say "That many cells run out before morning. A cell part used up still has to be a whole cell."
    }
    when (leds == led - 1) point=then {
      say "That many cells run out before morning. Round up to whole cells."
    }
  }
  hint "How many seconds is {hrs} hours, and how many joules does the bulb use in that time?"
  hint "How many cells of 10 000 J cover that, with none running out? Do the same for the LED."
}
