# Finding the wrong word and writing the right one, the audit's raise for picking the wrong word
# only. None of the fixes is a capital, since typed letters do not show case.
item writing.fix-the-word v=1 skills=[writing.editing, writing.spelling] {
  title "Write the right word"
  difficulty (if k == 0 or k == 1 then 0 else if k == 3 or k == 6 then 2 else 1)
  let k=0..7
  level easy {
    let k={0, 1, 2, 4}  # too, cat, blue, see
  }
  level hard {
    let k={3, 5, 6, 7}  # red for read, for, no for know, flu
  }

  scene 30x15 {
    fixbot bot says="{if k == 0 then \"The dog ran too the park.\" else if k == 1 then \"I have three cat at home.\" else if k == 2 then \"The wind blue the kite away.\" else if k == 3 then \"She red the whole book.\" else if k == 4 then \"We ate lunch on the see wall.\" else if k == 5 then \"My brother has for fish.\" else if k == 6 then \"I no the way to the canal.\" else \"The owl flu over the barn.\"}" width=20 fixed=0 ring=-1 at=canvas(1, 1)
    text ask "One word is wrong. Write the word it should be." width=18 below=bot gap=1
    word-input fix options=["{if k == 0 then \"to\" else if k == 1 then \"cats\" else if k == 2 then \"blew\" else if k == 3 then \"read\" else if k == 4 then \"sea\" else if k == 5 then \"four\" else if k == 6 then \"know\" else \"flew\"}"] letters=5 right-of=ask gap=1
  }

  answer fix=(if k == 0 then "to" else if k == 1 then "cats" else if k == 2 then "blew" else if k == 3 then "read" else if k == 4 then "sea" else if k == 5 then "four" else if k == 6 then "know" else "flew")
  hint "Read the sentence aloud. Which word sounds right but means something else?"
  hint "What is the sentence trying to say? Write the word that says it."
}
