item physics.fuel-left v=1 skills=[physics.rate] {
  title "How much is left?"
  difficulty ((if k % 2 == 0 then 0 else 1) + k / 10)
  let k={1, 2, 3, 5, 6, 7}
  level easy {
    let k={2, 6}
  }
  level hard {
    let k={1, 3, 5, 7}
  }

  scene 32x14 {
    fuelgauge gauge level=(k / 8) at=canvas(1, 1)
    text ask "The tank holds 40 litres. How many litres are left?" width=24 below=gauge gap=1
    number-input answer right-of=ask gap=2
  }

  answer (5 * k)
  feedback {
    when (answer == k) point=gauge {
      say "Each eighth of the tank is 5 litres, so count in fives."
    }
    when (answer == 40 - 5 * k) point=gauge {
      say "The needle shows what is left, not what has been used."
    }
  }
  hint "How many litres is one eighth of the tank?"
}
