# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.hungry-match v=1 skills=[language.food] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[food.the-bread]]", "[[food.the-fish]]", "[[food.i-am-hungry]]"), pick(k, "[[food.the-cheese]]", "[[food.the-eggs]]", "[[food.i-am-thirsty]]"), pick(k, "[[food.the-water]]", "[[food.the-potatoes]]", "[[food.i-would-like]]"), pick(k, "[[food.the-milk]]", "[[food.the-juice]]", "[[food.here-you-are]]")] right=[pick(k, "the water", "the juice", "I would like"), pick(k, "the bread", "the fish", "I am hungry"), pick(k, "the cheese", "the eggs", "here you are"), pick(k, "the milk", "the potatoes", "I am thirsty")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
