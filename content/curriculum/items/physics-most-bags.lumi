# The three-star non-routine question: the most bags a rope can take, which means starting from the
# lightest and stopping before the limit, with no method on the page.
item physics.most-bags v=1 stars=3 skills=[physics.weight, reasoning.most] {
  title "The most bags"
  difficulty t
  let t={4, 6, 10, 12, 14, 18, 20}
  level easy {
    let t={4, 6}
  }
  level hard {
    let t={18, 20}
  }

  scene 34x23 {
    row bags at=canvas(1, 1) space=1 align=start {
      springscale one max=10 step=2 value=2 unit=N
      springscale two max=10 step=2 value=4 unit=N
      springscale three max=10 step=2 value=6 unit=N
      springscale four max=10 step=2 value=8 unit=N
    }
    text ask "Mia has these four bags. The rope up to the platform can hold {t} newtons at most. What is the most bags she can send up on it at once?" narrate width=32 below=bags gap=1
    number-input answer below=ask gap=1
  }

  answer (if t < 6 then 1 else if t < 12 then 2 else if t < 20 then 3 else 4)
  feedback {
    when (answer == t) point=bags {
      say "That is the pull in newtons. The question asks how many bags."
    }
    when (answer > (if t < 6 then 1 else if t < 12 then 2 else if t < 20 then 3 else 4)) point=bags {
      say "Add up the bags you chose. Together they pull more than {t} newtons, so the rope cannot hold them all."
    }
    when (answer < (if t < 6 then 1 else if t < 12 then 2 else if t < 20 then 3 else 4)) point=one {
      say "There is room for another bag. Start from the lightest and keep adding while the total stays under {t}."
    }
  }
  hint "Which bag pulls least? Start with that one."
  hint "Add the next lightest bag. Is the total still {t} newtons or less?"
  hint "Keep going until the next bag would take the total past {t}."
}
