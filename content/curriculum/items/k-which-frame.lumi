# Two frames of different colours, so the answer is a colour said aloud and not a letter to read.
item k.which-frame v=1 skills=[counting.to-ten, colours.naming] {
  title "Which frame?"
  difficulty (if abs(a - b) == 1 then 1 else 0)
  let a=5..10 b=5..10 w=0..1
  where (a != b)
  level easy {
    where (abs(a - b) >= 3)
  }
  level hard {
    where (abs(a - b) == 1)
  }

  scene 28x14 {
    tenframe pink count=a color=berry at=canvas(1, 1)
    tenframe blue count=b color=sky right-of=pink gap=2
    text ask "Which frame has {if w == 0 then a else b} counters?" narrate width=26 below=pink gap=1
    choice pick options=["the pink one", "the blue one"] below=ask gap=1
  }

  answer pick=(if w == 0 then "the pink one" else "the blue one")
  hint "Count the counters in the pink frame. Then count the blue frame."
}
