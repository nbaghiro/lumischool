# One number in a two-block path is wrong, and the child names the block and mends it. With one
# block across and one down, only that block can mend it, which the checker proves.
item coding.robot-stops-short v=1 skills=[coding.debugging] {
  title "Mend the number"
  difficulty (2 * k + a + b)
  let a=2..4 b=1..3 k=1..2 d={-1, 1}
  where ((if k == 1 then a + d else b + d) >= 1 and (if k == 1 then a + d else b + d) <= (if k == 1 then 4 else 3))  # the wrong block stays on the grid, so the robot never stops on the flag by bumping the edge
  level easy {
    let a=2..3 b=1..2 k={1}
  }
  level hard {
    let a=3..4 b=2..3 k={2}
  }

  scene 37x14 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks bl code=["right {if k == 1 then a + d else a}", "down {if k == 2 then b + d else b}"] numbers=true
      maze g cols=5 rows=4 col=1 row=1 face=right flag=[1 + a, 1 + b] code=["right {if k == 1 then a + d else a}", "down {if k == 2 then b + d else b}"] trail=line
    }
    text ask "Which block is wrong? What should its number be?" width=10 right-of=top gap=1
    row ans below=top gap=1 space=1 align=centre {
      text lb "block"
      number-input which width=3
      text ln "number"
      number-input to width=3
    }
  }

  check coding.runs of=g goal=flag which=wrong to=fix
  hint "Does the robot go too far or not far enough? Across or down?"
  hint "Count the squares from the start to the flag, across and then down."
}
