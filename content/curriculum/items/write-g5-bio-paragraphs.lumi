# Facts from Caroline's life matched to the paragraph of the biography they belong in. The right
# list turns with r.
item writing.bio-paragraphs v=1 skills=[writing.biography, writing.paragraphs] {
  title "Which paragraph?"
  difficulty k
  let k=0..1 r=0..2
  let s1={pick(k, "born in Hanover", "ill as a small child")}
  let s2={pick(k, "found eight comets", "paid by the king")}
  let s3={pick(k, "went home at 72", "died at 97")}
  let c1={"her early life"}
  let c2={"her work"}
  let c3={"her last years"}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 35x19 {
    row top at=canvas(1, 0) space=2 align=end {
      text ask "The biography has three paragraphs. Write the number of the paragraph each fact belongs in." narrate width=22
      telescope scope tilt=35
    }
    match m left=["{s1}", "{s2}", "{s3}"] right=["{if r == 0 then c2 else if r == 1 then c3 else c1}", "{if r == 0 then c3 else if r == 1 then c1 else c2}", "{if r == 0 then c1 else if r == 1 then c2 else c3}"] blanks=[x, y, z] below=top gap=1
  }

  answer x=(if r == 0 then 3 else if r == 1 then 2 else 1) y=(if r == 0 then 1 else if r == 1 then 3 else 2) z=(if r == 0 then 2 else if r == 1 then 1 else 3)
  hint "Ask of each fact: when in her life did it happen?"
  hint "A biography's paragraphs follow a life from the start to the end. Which facts are from the start, the middle and the end?"
}
