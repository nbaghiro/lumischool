# The unknown is one input of a call: spent is known at the end, so the missing price is what is
# left divided by the count.
item coding.inputs-missing v=1 skills=[coding.procedures, reasoning.work-backwards, money.dollars-and-cents] {
  title "The missing price"
  difficulty (c + q)
  let a=1..3 p=2..4 c=2..4 q=2..6
  where (p != q)
  level easy {
    let c={2}
    where (q <= 4)
  }
  level hard {
    let c=3..4
  }

  scene 36x17 {
    program pr code=["define buy count price", "  add count * price to spent", "set spent to 0", "buy {a} {p}", "buy {c} ?"] at=canvas(1, 0)
    stallcounter stall w=10 h=12 counter=4 right-of=pr gap=1
    text ask "At the end spent is {a * p + c * q} dollars. What price goes in place of the question mark?" width=22 below=pr gap=1
    number-input answer right-of=ask gap=1
  }

  answer q
  feedback {
    when (answer == c * q) point=pr {
      say "That is what the second buy adds. It buys {c} things, so share it among them."
    }
    when (answer == c * q - c and c * q - c != q) point=pr {
      say "The second buy adds count times price, so divide what is left by {c}."
    }
  }
  hint "What does the first buy add? How much is left for the second?"
  hint "The second buy is that many things at one price each. Share what is left among them."
}
