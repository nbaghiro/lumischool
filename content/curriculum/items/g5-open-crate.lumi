# A crate with no lid: five faces, so the top is left out once and not the pair. A second reason in
# the core, since the pairs rule has to be bent rather than followed.
item solids.open-crate v=1 skills=[solids.surface-area, reasoning.explain] {
  title "No lid"
  difficulty ((l * w + 2 * l * h + 2 * w * h) / 10)
  let l=3..8 w=2..5 h=2..5
  where (l > w and w != h)
  level easy {
    let l=3..4 w={2} h={3}
  }
  level hard {
    let l=7..8 w={4, 5} h={3, 5}
  }

  scene 36x14 {
    net box solid=box cell=2 at=canvas(1, 1)
    text ask "Apples at the market go in open crates with no lid, {l} cm long, {w} cm wide and {h} cm tall. How much card is one crate?" narrate width=20 right-of=box gap=2
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=4
      text unit "cm²"
    }
  }

  answer (l * w + 2 * l * h + 2 * w * h)
  feedback {
    when (answer == 2 * (l * w + l * h + w * h)) point=box {
      say "That has a lid on. Which face is missing from the net?"
    }
    when (answer == 2 * l * h + 2 * w * h) point=box {
      say "That leaves out the bottom as well. The apples need a floor."
    }
  }
  hint "How many faces does an open crate have?"
  hint "Which faces come in pairs, and which one is on its own?"
}
