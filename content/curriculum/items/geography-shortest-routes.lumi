# Every shortest route, found by listing: with only east and south allowed, a route is an order of
# the east steps and the south steps, and children who list them by where the turn comes find all.
item geography.shortest-routes v=1 stars=3 skills=[geography.routes, reasoning.all-the-ways] {
  title "How many shortest routes?"
  let c=1..3 r=1..2 dx=1..2 dy=1..3
  where (r + dy <= 5)
  let bc={if c + dx == 2 then "B" else if c + dx == 3 then "C" else if c + dx == 4 then "D" else "E"}
  let hc={if c == 1 then "A" else if c == 2 then "B" else "C"}

  scene 35x14 {
    gridmap map cols=6 rows=5 col=c row=r thing=hut at=canvas(1, 1)
    text ask "The hut is in {hc}{r} and the boat is in {bc}{r + dy}. Walk from the hut to the boat one square at a time, only east or south. How many different routes are there?" width=17 right-of=map gap=2
    number-input answer below=ask gap=1
  }

  answer (if dx == 1 then dy + 1 else (dy + 1) * (dy + 2) / 2)
  feedback {
    when (answer == 2 and dx + dy > 2) point=map {
      say "Going all the way east first, or all the way south first, are two routes. The turns can come in other places too."
    }
  }
  hint "Try one route with your finger. Where could the turn come instead?"
  hint "Write each route as letters, E for east and S for south. How many different orders are there?"
}
