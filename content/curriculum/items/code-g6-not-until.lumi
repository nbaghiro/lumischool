# Not in a loop: repeat until not the river is more than the mark runs while the river is above it.
# The mill lets water out two at a time, so the count is how many takes of 2 bring it to the mark
# or below; when the gap is odd it goes one below.
item coding.not-until v=1 skills=[coding.logic, coding.repetition, coding.simulation, coding.text] {
  title "Let the water out"
  difficulty ((r - m) / 2)
  let r=8..16 m=3..7
  where (r - m >= 3)
  level easy {
    where (r - m <= 6 and (r - m) % 2 == 0)
  }
  level hard {
    where (r - m >= 7 and (r - m) % 2 == 1)
  }

  scene 36x23 {
    row top at=canvas(1, 0) space=2 align=start {
      program p code=["set river to {r}", "set gates to 0", "repeat until not river is more than {m}", "  take 2 from river", "  add 1 to gates"] text=true
      kingfisher kf flying=1 facing=0
    }
    text ask "The mill opens a sluice gate each time round, which lets the river down by 2. How many gates does it open?" narrate width=34 below=top gap=1
    number-input answer width=3 below=ask gap=1
  }

  check coding.runs of=p answer="value(gates)"
  feedback {
    when (answer == (r - m) // 2 and (r - m) % 2 == 1) point=p {
      say "After that many the river is still above {m}. The loop runs once more."
    }
    when (answer == r - m) point=p {
      say "Each time round takes 2 away, not 1."
    }
  }
  hint "The loop goes on while the river is more than {m}. Write the river after each time round."
  hint "Stop as soon as the river is down to the mark or below it. How many times did it go round?"
}
