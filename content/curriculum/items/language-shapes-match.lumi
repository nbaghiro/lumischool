# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.shapes-match v=1 skills=[language.shapes, language.numbers] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[shape.the-circle]]", "[[shape.the-rectangle]]", "[[shape.the-side]]"), pick(k, "[[shape.the-square]]", "[[shape.the-heart]]", "[[shape.the-corner]]"), pick(k, "[[shape.the-triangle]]", "[[shape.the-pentagon]]", "[[shape.the-square]]"), pick(k, "[[shape.the-star]]", "[[shape.the-hexagon]]", "[[shape.the-rectangle]]")] right=[pick(k, "the triangle", "the hexagon", "the square"), pick(k, "the circle", "the rectangle", "the side"), pick(k, "the square", "the heart", "the rectangle"), pick(k, "the star", "the pentagon", "the corner")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
