# The two-star reason: which sky tells tonight's weather. Weather here comes from the west, so cloud
# on the western horizon is tonight's cloud, and a clear sky overhead now says little about later.
item nature.look-west v=1 stars=2 skills=[nature.weather, reasoning.explain] {
  title "Who is more likely right?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..1
  let told={pick(k, "At 17 o'clock the sky over the observatory is clear. Ada says it will be clear for the telescope tonight. Ben points to a thick bank of cloud low in the west. Who is more likely right, and why?", "At 17 o'clock it is cloudy over the observatory, but the western sky is clear right down to the sea. Ben says there is no hope for the telescope tonight. Ada says the cloud will clear. Who is more likely right, and why?")}
  let right={pick(k, "Ben: the weather here comes from the west", "Ada: the clear sky in the west is coming")}
  let o1={pick(k, "Ada: a clear sky now stays clear all night", "Ben: cloud always lasts until morning")}
  let o2={pick(k, "Ben: clouds always come at night", "Ada: the sea makes the clouds go away")}
  let x1={pick(k, o1, right)}
  let x2={pick(k, right, o2)}
  let x3={pick(k, o2, o1)}
  level easy {
    let k={0}
  }
  level hard {
    let k={1}
  }

  scene 36x30 {
    row all at=canvas(1, 1) space=2 align=end {
      daysky sky night=false clouds=2
      telescope tl tilt=40
    }
    text ask "{told}" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=sky {
      say "Which way does the weather move here? Look the way it comes from."
    }
  }
  hint "From which direction does the weather come to the observatory?"
  hint "So which part of the sky shows the weather that is on its way?"
}
