# Taking away across ten, 1.OA.C.6: the loose ones first, then the rest from the full frame.
item sub.take-from-ten v=1 skills=[subtraction.bridge-ten] {
  title "Take away past ten"
  difficulty m
  let k=1..6 m=3..9
  where (m > k)  # the take-away has to cross the ten
  level easy {
    let k=1..3 m=3..5
  }
  level hard {
    let k=3..6 m=7..9
  }

  scene 28x13 {
    row frames at=canvas(1, 1) space=2 {
      tenframe full count=10 color=berry
      tenframe part count=k color=berry
    }
    text ask "Take away {m} counters. How many are left?" narrate width=26 below=frames gap=1
    number-input answer below=ask gap=1
  }

  answer (10 + k - m)
  feedback {
    when (answer == 10 - m) point=part {
      say "Do not forget the {k} in the second frame."
    }
    when (answer == 10 + k + m) point=frames {
      say "Taking away makes the number smaller."
    }
  }
  hint "Take the {k} in the second frame first. How many more do you still have to take?"
  hint "Take those from the full frame. How many are left in it?"
}
