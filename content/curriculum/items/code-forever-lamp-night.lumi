# The story: Pip's lamp at the lamp rocks shows red, then green, all night, one light a minute, and
# the red lights are counted: every odd minute is red.
item coding.forever-lamp-night v=1 skills=[coding.repetition, patterns.repeating] {
  title "Red lights in the night"
  difficulty (m % 2)
  let m={4, 6, 7, 9}
  let right={if m == 4 then 2 else if m == 6 then 3 else if m == 7 then 4 else 5}
  level easy {
    let m={4, 6}
  }
  level hard {
    let m={7, 9}
  }

  scene 32x25 {
    row top space=2 align=start at=canvas(1, 1) {
      lighthouse tower stripes=3 beam=1
      program p code=["repeat for ever", "  light red", "  light green"] title="Pip's lamp"
    }
    text ask "At the lamp rocks, Pip's lamp shows one light each minute, all night. How many red lights does it show in the first {m} minutes?" narrate width=30 below=top gap=1
    number-input answer below=ask gap=1
  }

  answer right
  feedback {
    when (answer == m) point=p {
      say "That counts every light. Only one light in two is red."
    }
    when (m % 2 == 1 and answer == right - 1) point=p {
      say "The first light is red, so with an odd number of minutes there is one more red than green."
    }
  }
  hint "Minute 1 is red, minute 2 is green. What colour is minute 3?"
  hint "Red comes on minutes 1, 3, 5 and so on. How many of those are there up to {m}?"
}
