# One sound, two letters: c and k both make the sound at the start of cat and kite, which is the
# first time a child meets a sound that is spelled more than one way.
item k.cat-and-kite v=1 stars=2 skills=[reading.phonics, reasoning.explain] {
  title "Same sound, same letter?"
  difficulty k
  let k=0..1
  let a={pick(k, "cat", "cup")}
  let b={pick(k, "kite", "kid")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 30x20 {
    lettercards cards letters=["c", "k"] at=canvas(1, 1)
    text ask "{a} and {b} start with the same sound. Do they start with the same letter?" narrate width=28 below=cards gap=1
    choice pick options=["Yes, both start with c.", "No, one starts with c and one with k."] stack=column below=ask gap=1
  }

  answer pick="No, one starts with c and one with k."
  hint "Both cards make the same sound. Which card does {b} use?"
}
