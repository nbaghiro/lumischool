# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.wild-animals-match v=1 skills=[language.animals, language.sentences] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[wild.the-sea]]", "[[wild.the-river]]", "[[wild.it-lives]]"), pick(k, "[[wild.the-desert]]", "[[wild.the-ice]]", "[[wild.it-eats]]"), pick(k, "[[wild.the-jungle]]", "[[wild.the-mountain]]", "[[wild.it-swims]]"), pick(k, "[[wild.the-forest]]", "[[wild.the-island]]", "[[wild.it-flies]]")] right=[pick(k, "the jungle", "the island", "it swims"), pick(k, "the sea", "the river", "it lives"), pick(k, "the desert", "the ice", "it flies"), pick(k, "the forest", "the mountain", "it eats")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
