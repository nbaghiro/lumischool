# The two-star reason: what holds a body up. Out of the water an octopus slumps flat while a fish or a
# crab keeps its shape, because the octopus has no hard skeleton and in the sea the water held it up.
item nature.out-of-water v=1 stars=2 skills=[nature.skeletons, reasoning.explain] {
  title "Why does it slump?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..2
  let told={pick(k, "In the aquarium video, an octopus is lifted out of the water for a moment and slumps flat on the keeper's hand. A fish lifted out keeps its shape. Why?", "In the water a jellyfish spreads out wide and round. Washed up on the sand, it lies in a flat heap. Why?", "A crab lifted out of its tank keeps its shape, and so does a fish, but for different reasons. Why does the crab keep its shape?")}
  let right={pick(k, "Bones hold the fish up; the octopus has none", "It has no hard skeleton; only water held its shape", "Its hard case holds it up, as the fish's bones do")}
  let o1={pick(k, "The octopus was frightened and went to sleep", "The sand is too hot for it", "Its claws hold it up")}
  let o2={pick(k, "The fish is stronger than the octopus", "It is dead, so it has lost its bones", "It holds its breath out of the water")}
  let x1={pick(k, o1, right, o2)}
  let x2={pick(k, right, o2, o1)}
  let x3={pick(k, o2, o1, right)}
  level easy {
    let k={0}
  }
  level hard {
    let k=1..2
  }

  scene 36x29 {
    row all at=canvas(1, 1) space=2 align=end {
      octopus oc spots=4
      fish fs size=3 tone=glow facing=-1
      crabs cr count=1
    }
    text ask "{told}" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=all {
      say "Think about what holds each body in shape: bones inside, a hard case outside, or nothing hard at all."
    }
  }
  hint "Which of the three kinds of body does this creature have?"
  hint "If nothing hard holds it up, what held it up in the sea?"
}
