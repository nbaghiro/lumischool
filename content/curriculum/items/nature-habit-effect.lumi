# Lifestyle and the body: habits that help and harm. That regular exercise strengthens the heart and
# muscles, that smoking damages the lungs, and that too much sugar harms teeth is recalled from the
# NHS's general advice; England's year six names "diet, exercise, drugs and lifestyle".
item nature.habit-effect v=1 skills=[nature.diet, nature.body] {
  title "What does it do to the body?"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..3
  let habit={pick(k, "walking or running most days", "drinking fizzy drinks full of sugar every day", "smoking cigarettes", "sleeping too little, night after night")}
  let right={pick(k, "makes the heart and muscles stronger", "harms the teeth and adds unused energy", "damages the lungs, so less oxygen gets in", "leaves the body and brain tired and slow")}
  let o1={pick(k, "makes the lungs smaller", "makes the bones stronger", "makes the heart beat more slowly forever", "makes the muscles grow faster")}
  let x1={pick(k, right, o1, o1, right)}
  let x2={pick(k, o1, right, right, o1)}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 34x30 {
    row all at=canvas(1, 1) space=2 align=end {
      parts ch of=chest
      runners rn count=2 numbers=0
    }
    text ask "On the noticeboard by the rope bridge is a poster about keeping the body well. What does {habit} do to the body?" narrate width=32 below=all gap=1
    choice pick options=[x1, x2] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=ch {
      say "Think about which part of the body this habit reaches, and whether it helps or harms that part."
    }
  }
  hint "Which part of the body does this habit work, or reach?"
  hint "Does it make that part stronger, or wear it down?"
}
