# The way in: the nails are drawn after the days have passed, so the child reads which ones have gone
# orange, and the checker agrees with the same rule the drawing uses.
item chem.rust-yes-no v=1 skills=[chemistry.changes, chemistry.rusting] {
  title "Has it rusted?"
  difficulty v
  let v=0..17

  scene 30x10 {
    row kit at=canvas(1, 0) space=1 align=start {
      nails n jars=["{if v == 0 then \"water\" else if v == 1 then \"water\" else if v == 2 then \"water\" else if v == 3 then \"water\" else if v == 4 then \"water\" else if v == 5 then \"water\" else if v == 6 then \"salt\" else if v == 7 then \"salt\" else if v == 8 then \"salt\" else if v == 9 then \"salt\" else if v == 10 then \"salt\" else if v == 11 then \"salt\" else if v == 12 then \"oil\" else if v == 13 then \"oil\" else if v == 14 then \"oil\" else if v == 15 then \"oil\" else if v == 16 then \"oil\" else \"oil\"}", "{if v == 0 then \"dry\" else if v == 1 then \"dry\" else if v == 2 then \"dry\" else if v == 3 then \"dry\" else if v == 4 then \"dry\" else if v == 5 then \"dry\" else if v == 6 then \"painted\" else if v == 7 then \"painted\" else if v == 8 then \"painted\" else if v == 9 then \"painted\" else if v == 10 then \"painted\" else if v == 11 then \"painted\" else if v == 12 then \"salt\" else if v == 13 then \"salt\" else if v == 14 then \"salt\" else if v == 15 then \"salt\" else if v == 16 then \"salt\" else \"salt\"}", "{if v == 0 then \"oil\" else if v == 1 then \"oil\" else if v == 2 then \"oil\" else if v == 3 then \"oil\" else if v == 4 then \"oil\" else if v == 5 then \"oil\" else if v == 6 then \"water\" else if v == 7 then \"water\" else if v == 8 then \"water\" else if v == 9 then \"water\" else if v == 10 then \"water\" else if v == 11 then \"water\" else if v == 12 then \"dry\" else if v == 13 then \"dry\" else if v == 14 then \"dry\" else if v == 15 then \"dry\" else if v == 16 then \"dry\" else \"dry\"}"] days=(if v == 0 then 7 else if v == 1 then 7 else if v == 2 then 7 else if v == 3 then 10 else if v == 4 then 10 else if v == 5 then 10 else if v == 6 then 7 else if v == 7 then 7 else if v == 8 then 7 else if v == 9 then 10 else if v == 10 then 10 else if v == 11 then 10 else if v == 12 then 7 else if v == 13 then 7 else if v == 14 then 7 else if v == 15 then 10 else if v == 16 then 10 else 10) letters=1 names=1
      column side space=1 align=start {
        text ask "These nails were left for {if v == 0 then \"7\" else if v == 1 then \"7\" else if v == 2 then \"7\" else if v == 3 then \"10\" else if v == 4 then \"10\" else if v == 5 then \"10\" else if v == 6 then \"7\" else if v == 7 then \"7\" else if v == 8 then \"7\" else if v == 9 then \"10\" else if v == 10 then \"10\" else if v == 11 then \"10\" else if v == 12 then \"7\" else if v == 13 then \"7\" else if v == 14 then \"7\" else if v == 15 then \"10\" else if v == 16 then \"10\" else \"10\"} days. Has the nail in jar {if v == 0 then \"A\" else if v == 1 then \"B\" else if v == 2 then \"C\" else if v == 3 then \"A\" else if v == 4 then \"B\" else if v == 5 then \"C\" else if v == 6 then \"A\" else if v == 7 then \"B\" else if v == 8 then \"C\" else if v == 9 then \"A\" else if v == 10 then \"B\" else if v == 11 then \"C\" else if v == 12 then \"A\" else if v == 13 then \"B\" else if v == 14 then \"C\" else if v == 15 then \"A\" else if v == 16 then \"B\" else \"C\"} gone rusty?" width=15
        choice pick options=["yes", "no"]
      }
    }
  }

  check chem.change of=n pick="rusts({if v == 0 then \"A\" else if v == 1 then \"B\" else if v == 2 then \"C\" else if v == 3 then \"A\" else if v == 4 then \"B\" else if v == 5 then \"C\" else if v == 6 then \"A\" else if v == 7 then \"B\" else if v == 8 then \"C\" else if v == 9 then \"A\" else if v == 10 then \"B\" else if v == 11 then \"C\" else if v == 12 then \"A\" else if v == 13 then \"B\" else if v == 14 then \"C\" else if v == 15 then \"A\" else if v == 16 then \"B\" else \"C\"})"
  hint "Find jar {if v == 0 then \"A\" else if v == 1 then \"B\" else if v == 2 then \"C\" else if v == 3 then \"A\" else if v == 4 then \"B\" else if v == 5 then \"C\" else if v == 6 then \"A\" else if v == 7 then \"B\" else if v == 8 then \"C\" else if v == 9 then \"A\" else if v == 10 then \"B\" else if v == 11 then \"C\" else if v == 12 then \"A\" else if v == 13 then \"B\" else if v == 14 then \"C\" else if v == 15 then \"A\" else if v == 16 then \"B\" else \"C\"}. Is its nail still grey and shiny, or orange?"
  hint "What colour is rust? Can you see any of that colour on the nail?"
}
