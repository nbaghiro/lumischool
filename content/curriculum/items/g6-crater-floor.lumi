# The rule from the radius: area = radius × radius × 3.14.
item circle.crater-floor v=1 skills=[circles.area, decimals.multiply] {
  title "The crater floor"
  difficulty r
  let r={4, 5, 6, 7, 8, 9, 20}
  level easy {
    let r={4, 5}
  }
  level hard {
    let r={7, 8, 9, 20}
  }

  scene 35x16 {
    circleparts c size=5 lines=1 radius=r unit="m" at=canvas(1, 1)
    crater cr count=1 right-of=c gap=2
    text ask "A round crater has a radius of {r} m. Using 3.14, what is the area of its floor, in square metres?" narrate width=18 below=cr gap=1
    number-input answer width=7 below=ask gap=1
  }

  answer decimals(r * r * 3.14, 0)
  feedback {
    when (answer == 2 * r * 3.14) point=c {
      say "That is the distance round the crater. The area is the radius times the radius times 3.14."
    }
    when (answer == r * 3.14) point=c {
      say "The radius is used twice: radius times radius, then times 3.14."
    }
    when (answer == 4 * r * r * 3.14) point=c {
      say "That used the diameter. The line drawn is a radius, from the centre to the rim."
    }
  }
  hint "Is the line drawn a radius or a diameter?"
  hint "Multiply the radius by itself first. What do you multiply that by?"
}
