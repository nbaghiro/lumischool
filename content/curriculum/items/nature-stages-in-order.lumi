# Numbering the bean's growth: the cards describe the drawings rather than name them, and they are
# muddled. The reference picture above shows fewer stages as the level rises: all four at easy, so
# the cards are matched to it; three at medium, with the leaves left out, so one card has to be
# placed from knowing the order; two at hard, so two cards have to be.
item nature.stages-in-order v=1 skills=[nature.growing, reasoning.order] {
  title "Number the bean"
  difficulty ((if p <= 1 then 0 else if p <= 3 then 1 else 2) + 4 - shown)
  set shown=3
  let p=0..5
  let a={pick(p, 1, 0, 3, 2, 3, 2)}
  let b={pick(p, 0, 2, 0, 3, 1, 0)}
  let c={pick(p, 2, 1, 1, 0, 0, 3)}
  let d={pick(p, 3, 3, 2, 1, 2, 1)}
  let wa={pick(a, "a seed in the soil", "a shoot with two small leaves", "a taller stem with more leaves", "a flower on top")}
  let wb={pick(b, "a seed in the soil", "a shoot with two small leaves", "a taller stem with more leaves", "a flower on top")}
  let wc={pick(c, "a seed in the soil", "a shoot with two small leaves", "a taller stem with more leaves", "a flower on top")}
  let wd={pick(d, "a seed in the soil", "a shoot with two small leaves", "a taller stem with more leaves", "a flower on top")}
  level easy {
    set shown=4
    let p=0..1
  }
  level hard {
    set shown=2
    let p=4..5
  }

  scene 32x32 {
    growstages grow stages=shown numbers=false names=0 at=canvas(1, 1)
    text ask "Ada drew her bean in the long grass as it grew. The cards say what each drawing showed, but they are muddled. Number them 1 to 4 in the order the bean grew, starting with the seed." narrate width=30 below=grow gap=1
    sequence s items=["{wa}", "{wb}", "{wc}", "{wd}"] blanks=[q, r, t, u] below=ask gap=1
  }

  answer q=(a + 1) r=(b + 1) t=(c + 1) u=(d + 1)
  feedback {
    when (q == 1 and r == 2 and t == 3 and u == 4) point=s {
      say "The cards are muddled, so they are not in order as they stand. Find the seed first: that is number 1."
    }
    when ((if a == 3 then q else if b == 3 then r else if c == 3 then t else u) == 3 and (if a == 2 then q else if b == 2 then r else if c == 2 then t else u) == 4) point=grow {
      say "The flower comes last. Before it opens, the stem grows taller and makes more leaves."
    }
  }
  hint "Which card is the seed in the soil? That is number 1. Which card is the flower? That is number 4."
  hint "After the shoot with its two small leaves, the stem grows taller and gets more leaves. Then the flower."
}
