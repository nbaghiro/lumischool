# The two-star reason: why pulling a hand off a hot pipe is quicker than catching a ruler. A reflex
# goes from the skin to the spinal cord and straight back to the muscle, without waiting for the
# brain to decide (recalled; China's grades five and six science, 6.3④, asks how the body responds to
# what it senses).
item nature.reflex-faster v=1 stars=2 skills=[nature.nerves, reasoning.explain] {
  title "Why is it quicker?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..1
  let told={pick(k, "Ben pulls his hand off a hot pipe before he even feels the pain, far faster than he catches the ruler. Why can it be so quick?", "Ada's eye blinks shut when a speck of dust flies at it, before she knows it is there. Why does she not have to decide to blink?")}
  let right={pick(k, "The spinal cord sends the message straight back", "A reflex: the message takes a short way round")}
  let o1={pick(k, "Hot things make nerves go faster", "Eyes do not have nerves")}
  let o2={pick(k, "His hand is nearer his brain than his eyes", "She saw the dust and chose to blink")}
  let x1={pick(k, o1, right)}
  let x2={pick(k, right, o2)}
  let x3={pick(k, o2, o1)}
  level easy {
    let k={0}
  }
  level hard {
    let k={1}
  }

  scene 36x29 {
    parts nv of=nerves at=canvas(1, 1)
    text ask "{told}" narrate width=20 right-of=nv gap=2
    choice pick options=[x1, x2, x3] stack=column below=nv gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=nv {
      say "Follow the message on the chart. Does it have to go all the way to the brain and wait there?"
    }
  }
  hint "In catching the ruler, which part has to decide before the hand moves?"
  hint "Is there a shorter way for a message to get from the skin to a muscle?"
}
