# Every swap until the row is sorted, over all the passes: the total counts the pairs that start
# the wrong way round.
item coding.total-swaps v=1 skills=[coding.algorithms] {
  title "Swaps all the way"
  difficulty (if k == 2 then 2 else if k == 3 then 3 else if k == 0 then 4 else 5)
  let k=0..3

  scene 33x13 {
    sortcards c cards=[if k == 0 then 4 else if k == 1 then 7 else if k == 2 then 4 else 1, if k == 0 then 1 else if k == 1 then 3 else if k == 2 then 2 else 5, if k == 0 then 3 else if k == 1 then 5 else if k == 2 then 6 else 3, if k == 0 then 2 else if k == 1 then 1 else if k == 2 then 5 else 2] compare=0 swap=false at=canvas(1, 0)
    column q right-of=c gap=2 space=1 align=start {
      text ask "Sort the cards with passes from the left. How many swaps do you make altogether?" width=16
      number-input answer
    }
  }

  answer (if k == 0 then 4 else if k == 1 then 5 else if k == 2 then 2 else 3)
  hint "Count the swaps in the first pass, and write the new row down."
  hint "Keep going pass after pass, adding up the swaps, until a pass has none."
}
