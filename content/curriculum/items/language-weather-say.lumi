# Speaking, marked by a grown-up who ticks what they heard (reading.recited). The phrase to
# say is on the child's page, so hearing it from the device is a second way in, never the only one.
item language.weather-say v=1 skills=[language.weather, language.speaking] {
  title "Today's weather"
  let k=0..2

  scene 34x8 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "{pick(k, \"Look out of the window and tell a grown-up the weather in [[language.name]].\", \"Be a forecaster: read the chart in the lesson aloud, day by day, in [[language.name]].\", \"Ask a grown-up [[phrase.what-is-the-weather-like]] and answer it together, with two things about the weather.\")}" width=32
    }
  }

  check reading.recited look-for="The weather said the way the lesson says it, for the sky and for hot or cold." notice=["The sky said", "Hot or cold said", "Two weather phrases joined", "Days named on the chart"]
  hint "Say it in English first."
  hint "Is anything falling from the sky?"
}
