# Read without buttons and without the grown-up saying it: the word is on cards, and the child
# blends it alone and finds the picture.
item k.read-the-cards v=1 skills=[reading.decoding, reading.blending] {
  title "Read the cards"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..4 p=0..2
  let want={pick(k, "cat", "dog", "pig", "hen", "fox")}
  let o1={pick(k, "hen", "duck", "cat", "fox", "pig")}
  let o2={pick(k, "fox", "pig", "duck", "dog", "hen")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..4
  }

  scene 30x25 {
    lettercards word letters=["{pick(k, \"c\", \"d\", \"p\", \"h\", \"f\")}", "{pick(k, \"a\", \"o\", \"i\", \"e\", \"o\")}", "{pick(k, \"t\", \"g\", \"g\", \"n\", \"x\")}"] at=canvas(1, 1)
    picturecards cards who=[if p == 0 then want else o1, if p == 1 then want else o2, if p == 2 then want else if p == 0 then o1 else o2] where=["by", "by", "by"] thing=["log", "log", "log"] letters=true below=word gap=1
    text q "Ada laid out letter cards on the garden table. Read the word by yourself. Which picture is it?" narrate width=28 below=cards gap=1
    choice pick options=["A", "B", "C"] stack=row below=q gap=1
  }

  answer pick=pick(p, "A", "B", "C")
  hint "Say the sound of each card, then push them together."
}
