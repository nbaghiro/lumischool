# A build task on the half-the-gap model: the turtle draws the cooling as a graph, one square right for
# each ten minutes and down by what the cocoa loses, so the drops halve. The drops are not all the
# same, so no plain repeat draws them, and written out they take more lines than the five slots.
item coding.cool-build v=1 skills=[coding.simulation, coding.variables, coding.repetition] {
  title "Draw the cooling"
  difficulty k
  let k=0..2
  let g={pick(k, 4, 8, 8)}
  level easy {
    let k={0}
  }
  level hard {
    let k={2}
  }

  scene 36x32 {
    text ask "In the research hut the cocoa is {g} degrees warmer than the air. Each ten minutes it loses half that gap. The turtle draws it as a graph: 1 square right for ten minutes, then down as many squares as the cocoa lost. Build the program that draws the pale graph." width=34 at=canvas(0, 0)
    turtle t cols=(if k == 0 then 4 else 5) rows=g col=1 row=1 face=right moves=[] target=["set gap to {g}", "repeat until gap is 1", "  right 1", "  down gap / 2", "  take gap / 2 from gap"] mark=false below=ask gap=1
    codepad answer tray=["set gap to 1", pick(k, "repeat until gap is 1", "repeat until gap is 1", "repeat 2"), "right 1", "down gap / 2", "take gap / 2 from gap"] lines=5 key=["set gap to {g}", pick(k, "repeat until gap is 1", "repeat until gap is 1", "repeat 3"), "  right 1", "  down gap / 2", "  take gap / 2 from gap"] right-of=t gap=1
  }

  check coding.builds of=t goal=target
  hint "How big is the first drop in the pale graph? The second? What happens to the drop each time?"
  hint "The drop is worked out from the gap. Should the gap shrink before the turtle goes down, or after?"
}
