# The worked version of this item carries its own pen marks, which only the answer key shows.
item measure.ruler-start v=1 skills=[length.centimetres] {
  title "It does not start at zero"
  difficulty (s + len)
  let s=1..3 len=3..7
  where (s + len <= 10)
  level easy {
    let s={1} len=3..5
  }
  level hard {
    let s=2..3 len=5..7
  }

  scene 26x13 {
    ruler r cm=10 length=len start=s thing=ribbon at=canvas(1, 0)
    loop r.object-start solution
    loop r.object-end solution
    text ask "How long is the ribbon?" narrate below=r gap=1
    number-input answer right-of=ask gap=1
    text unit "cm" right-of=answer gap=0
    note tip "From {s} to {s + len} is {len} cm." solution width=11 below=ask gap=0
  }

  answer len
  feedback {
    when (answer == s + len) point=r.object-end {
      say "The ribbon starts at {s}, not at 0. Count the centimetres it covers."
    }
  }
  hint "Take away the number where the ribbon starts."
}
