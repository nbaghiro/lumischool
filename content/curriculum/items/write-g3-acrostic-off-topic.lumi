# One line starts with the right letter and is about something else.
item writing.acrostic-off-topic v=1 skills=[writing.poems] {
  title "The line that wandered off"
  difficulty (if o == 1 or o == 2 then 1 else 0)
  let s=0..1 o=0..3

  scene 35x13 {
    listpad poem title="{if s == 0 then \"MOON\" else \"STAR\"}" items=["1. {if o == 0 then (if s == 0 then \"Muddy boots\" else \"Socks on the line\") else if s == 0 then \"Mice look up\" else \"Shining so high\"}", "2. {if o == 1 then (if s == 0 then \"Orange juice\" else \"Toast and jam\") else if s == 0 then \"Over the hill\" else \"Tiny and white\"}", "3. {if o == 2 then (if s == 0 then \"Oven chips\" else \"Apples in a bag\") else if s == 0 then \"Owls call out\" else \"All night long\"}", "4. {if o == 3 then (if s == 0 then \"Nine red pens\" else \"Red wellies\") else if s == 0 then \"Night is here\" else \"Right up there\"}"] count=0 width=17 ticks=false at=canvas(1, 1)
    column right right-of=poem gap=1 space=1 align=start {
      text ask "Every line starts with the right letter. Which line is not about the {if s == 0 then \"moon\" else \"stars\"}?" width=13
      choice pick options=["1", "2", "3", "4"]
    }
  }

  answer pick=(if o == 0 then "1" else if o == 1 then "2" else if o == 2 then "3" else "4")
  hint "Read each line and picture it. Does it belong in the night sky?"
  hint "Which line would fit a poem about something else?"
}
