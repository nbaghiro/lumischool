item k.not-the-same-start v=1 stars=2 skills=[reading.phonics, reasoning.odd-one-out] {
  title "Which one starts differently?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..2
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..2
  }

  scene 30x18 {
    picturecards cards who=[pick(k, "dog", "pig", "duck"), pick(k, "pig", "duck", "dog"), pick(k, "duck", "dog", "hen")] where=["by", "by", "by"] thing=["log", "log", "log"] letters=true at=canvas(1, 1)
    text ask "Two of these animals start with the same sound. Which one does not?" narrate width=28 below=cards gap=1
    choice pick options=["A", "B", "C"] below=ask gap=1
  }

  answer pick=pick(k, "B", "A", "C")
  hint "Say each name and stop after the first sound."
  hint "Which two sounds match?"
}
