# Coils counted against a height: each coil, pressed down, adds its own thickness to the wall, so
# the number of coils is the height over the thickness. Hard uses thicker coils, which halves the
# count.
item art.clay-coils v=1 skills=[art.clay, measure.length] {
  title "How many coils?"
  difficulty t
  let t=1..2 h=6..10
  where (h % t == 0)
  level easy {
    let t=1..1
  }
  level hard {
    let t=2..2
  }

  scene 36x19 {
    ruler stick cm=12 length=h start=0 thing=stick at=canvas(1, 1)
    text ask "Ben wants the wall of his coil pot as tall as this stick. Each coil, pressed down onto the one below, adds {t} cm to the height. How many coils does he need?" narrate width=34 below=stick gap=1
    number-input answer below=ask gap=1
  }

  answer (h / t)
  feedback {
    when (answer == h and t == 2) point=stick {
      say "That would be right for coils 1 cm thick. These add 2 cm each, so fewer are needed."
    }
  }
  hint "Read how tall the stick is on the ruler."
  hint "Each coil adds {t} cm. How many lots of {t} make the height?"
}
