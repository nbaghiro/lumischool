# Designing a network is open: several sets of bridges work, and the fewest is three. The machine
# cannot mark a drawing, so a grown-up checks it against the two test orders and the look-for.
item coding.net-design v=1 stars=3 skills=[coding.algorithms, reasoning.design] {
  title "A network of your own"
  difficulty k
  let k=0..2

  scene 36x13 {
    sortnet n inputs=[if k == 0 then 3 else if k == 1 then 2 else 3, if k == 0 then 1 else if k == 1 then 3 else 2, if k == 0 then 2 else if k == 1 then 1 else 1] pairs=[0, 0, 0, 0, 0, 0] at=canvas(1, 0)
    text ask "Draw bridges across these three lines so that any three numbers come out in order, smallest on the left. Test your network with the numbers at the top, then with 3, 2, 1. How few bridges can you use?" width=24 right-of=n gap=1
  }

  check writing.by-eye look-for="Bridges drawn between neighbouring or outer lines that sort both test orders when the numbers are walked down, smaller to the left at every bridge. Three bridges is the fewest, for example lines 1 and 2, then 2 and 3, then 1 and 2 again; a network that sorts both tests with more bridges is right too, and one that sorts only the first test is not finished."
  hint "Walk the test numbers down your network. Did the smallest reach line 1?"
  hint "After a bridge between lines 2 and 3, which pair might still be the wrong way round?"
}
