# The way in: the frog's ring drawn without names, and one stage described by what it is: the
# egg, the one just hatched, the one nearly grown. The egg is plain; the nearly grown one has to
# be told from the grown one by its tail.
item nature.stage-named v=1 skills=[nature.life-cycles] {
  title "Which stage is that?"
  difficulty w
  let w=0..2
  let asks={pick(w, "the egg stage", "the stage that has just hatched and swims with a tail", "the stage that is nearly grown, with legs and still a tail")}
  let right={pick(w, "frogspawn", "tadpole", "froglet")}
  level easy {
    let w=0..1
  }
  level hard {
    let w=1..2
  }

  scene 36x14 {
    frogcycle life stage=4 ring=1 names=0 at=canvas(1, 1)
    text ask "Ada draws the frog's life as a ring. Which stage is {asks}?" narrate width=20 right-of=life gap=2
    choice pick options=["frogspawn", "tadpole", "froglet", "frog"] below=life gap=1
  }

  answer pick=right
  feedback {
    when (w == 2 and pick == "frog") point=life {
      say "The grown frog has no tail. Look for the one with legs and a tail both."
    }
    when (w == 1 and pick == "frogspawn") point=life {
      say "Frogspawn is the egg, before anything hatches. The swimmer with a tail is the next one round the ring."
    }
    when (w == 0 and pick != "frogspawn") point=life {
      say "The egg is where the ring starts: a clump of jelly with black dots."
    }
  }
  hint "Go round the ring from the jelly with dots. Each picture is the next stage."
  hint "Egg, then a swimmer with a tail, then legs with a tail, then the frog."
}
