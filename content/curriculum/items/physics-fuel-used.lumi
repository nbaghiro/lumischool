item physics.fuel-used v=1 skills=[physics.rate] {
  title "How much has been used?"
  difficulty ((if k % 2 == 0 then 0 else 1) + k / 10)
  let k={1, 2, 3, 5, 6, 7}
  level easy {
    let k={2, 6}
  }
  level hard {
    let k={1, 3, 5, 7}
  }

  scene 32x16 {
    fuelgauge gauge level=(k / 8) at=canvas(1, 1)
    text ask "The tank held 40 litres when it was full. How many litres have been used?" width=24 below=gauge gap=1
    number-input answer right-of=ask gap=2
  }

  answer (40 - 5 * k)
  feedback {
    when (answer == 5 * k) point=gauge {
      say "That is what is left. The question asks what has gone."
    }
  }
  hint "How many litres is each eighth of the tank?"
}
