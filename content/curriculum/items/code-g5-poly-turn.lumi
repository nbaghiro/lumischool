# The way in to turtle polygons: the turtle turns once at every corner and all the way round once in
# all, so each turn is 360 shared among the corners. The inside angle is the common wrong answer.
item coding.poly-turn v=1 skills=[coding.drawing, angles.turns, coding.repetition] {
  title "The turn at each corner"
  difficulty pick(q, 1, 0, 2, 1, 2, 3, 3, 3)
  let q=0..7
  let n={pick(q, 3, 4, 5, 6, 8, 9, 10, 12)} s={pick(q, 3, 3, 2, 2, 2, 2, 1, 1)}
  let cols={pick(q, 5, 5, 5, 6, 7, 7, 6, 6)} rows={pick(q, 4, 4, 5, 5, 6, 7, 5, 5)} sc={pick(q, 2, 2, 2, 3, 3, 3, 3, 3)}
  level easy {
    let q={0, 1, 3}
  }
  level hard {
    let q=4..7
  }

  scene 36x22 {
    turtle t cols=cols rows=rows col=sc row=rows face=right moves=[] target=["repeat {n}", "  forward {s}", "  turn left {360 / n}"] at=canvas(1, 0)
    program p code=["repeat {n}", "  forward {s}", "  turn left ?"] right-of=t gap=1
    text ask "At the observatory the turtle draws star charts. The pale shape is the one to draw. What number goes in place of the question mark?" width=14 below=p gap=1
    number-input answer below=ask gap=1
  }

  answer (360 / n)
  feedback {
    when (answer == 180 - 360 / n and n != 4) point=t {
      say "That is the angle inside a corner. The turtle turns by how much its direction changes, which is the angle outside."
    }
    when (answer == 360) point=p {
      say "360 is the whole way round, and the turtle goes round once in all. Share it among the corners."
    }
  }
  hint "How many corners does the pale shape have? The turtle turns at each one."
  hint "By the end the turtle faces the way it started, so it has turned all the way round once."
}
