# The word written from its picture: [[clothes.t-shirt]], [[clothes.skirt]], [[clothes.dress]], [[clothes.boots]], [[clothes.shoes]], [[clothes.trousers]].
# Accent-tolerant: the box takes the word with its accents left off (accents=loose); ñ is a letter and is marked.
item language.clothes-write v=1 skills=[language.clothes, language.weather, language.spelling] {
  title "Write the word"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x16 {
    column all at=canvas(1, 1) space=1 align=start {
      garment g kind=pick(k, "top", "skirt", "dress", "boots", "shoes", "trousers") colour=pick(k, "sky", "glow", "berry", "berry", "sky", "mint") sleeves=short print=none pattern=plain
      text ask "Write it in [[language.name]], without the little word before it." width=32
      word-input word options=[pick(k, "[[clothes.t-shirt]]", "[[clothes.skirt]]", "[[clothes.dress]]", "[[clothes.boots]]", "[[clothes.shoes]]", "[[clothes.trousers]]")] accents=loose
    }
  }

  answer word=pick(k, "[[clothes.t-shirt]]", "[[clothes.skirt]]", "[[clothes.dress]]", "[[clothes.boots]]", "[[clothes.shoes]]", "[[clothes.trousers]]")
  hint "Say the word quietly first. What sound does it start with?"
  hint "Count the sounds, then write one letter or pair of letters for each."
}
