# How to read the air's temperature fairly: in the shade, in moving air, well above the ground, the
# same place every time. Each version puts one of those wrong and asks what it does to the reading.
item nature.where-thermometer v=1 skills=[nature.weather, reasoning.fair-test] {
  title "Where should the thermometer go?"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..3
  let told={pick(k, "Ben hangs the thermometer in full sun on the hut's wall. What will its readings be like?", "Ada wants to measure the air, not the sunshine. Where should the thermometer go?", "Ben lays the thermometer on the dark rock at noon to read the air. What will its reading be like?", "Ada reads the thermometer by the stove at 6 o'clock and on the shady path at 8 o'clock. What is wrong with comparing the two?")}
  let right={pick(k, "Too high: the sun warms the thermometer itself", "In the shade, in open air, well above the ground", "Too high: the sunny rock is warmer than the air", "Two places, so the change is not only the time")}
  let o1={pick(k, "The same as in the shade", "On the ground in the sun", "Lower than the air", "The thermometer gets tired")}
  let o2={pick(k, "Lower than in the shade", "Inside, next to the stove", "Exactly the air's temperature", "There is nothing wrong with it")}
  let x1={pick(k, right, o1, o2, o1)}
  let x2={pick(k, o1, right, o1, o2)}
  let x3={pick(k, o2, o2, right, right)}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 36x33 {
    row all at=canvas(1, 1) space=2 align=end {
      thermometer th from=-10 to=30 step=10 value=17 unit="°C"
      weatherstation ws cups=3
      hut hh
    }
    text ask "{told}" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=ws {
      say "The weather station keeps its thermometer in a white box in the shade, above the ground. Why there?"
    }
  }
  hint "What else besides the air could warm or cool the thermometer here?"
  hint "To compare readings, what must stay the same each time?"
}
