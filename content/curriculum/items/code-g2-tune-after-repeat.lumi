# A note after the repeat, and the question asks about a note at or past the end of it, so the
# repeat has to be unrolled all the way: the audit's raise for which-note.
item coding.tune-after-repeat v=1 skills=[coding.tracing, coding.repetition] {
  title "Which note comes then?"
  difficulty k
  let n=2..3 k=4..8 s=0..1
  where (k <= 2 * n + 2)
  level easy {
    let k=4..5
  }
  level hard {
    let k=6..8
  }

  scene 30x12 {
    blocks b code=["play {if s == 0 then \"C\" else \"G\"}", "repeat {n}", "  play E", "  play {if s == 0 then \"G\" else \"C\"}", "play C5"] at=canvas(1, 0)
    text ask "Which note does the tune play as note number {k}?" width=18 right-of=b gap=2
    choice pick options=["C", "E", "G"] below=ask gap=1
  }

  check coding.runs of=b pick="note({k})"
  hint "Write the notes out in a row, one letter a note, with the repeat played out in full."
  hint "Count along the row to note {k}. C5 is a C too, only higher."
}
