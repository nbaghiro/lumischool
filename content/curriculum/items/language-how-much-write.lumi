# The word written from its picture: [[num.two]], [[num.five]], [[num.ten]], [[num.three]], [[num.twelve]], [[num.four]], [[num.fifteen]].
# Accent-tolerant: the box takes the word with its accents left off (accents=loose); ñ is a letter and is marked.
item language.how-much-write v=1 skills=[language.market, language.numbers, language.spelling] {
  title "Write the word"
  difficulty pick(k, 0, 0, 0, 1, 1, 2, 2)
  let k=0..6

  scene 34x22 {
    column all at=canvas(1, 1) space=1 align=start {
      foodstall stall foods=["{pick(k, \"bread\", \"cheese\", \"fish\", \"egg\", \"cheese\", \"grapes\", \"fish\")}"] names=[""] costs=["{pick(k, \"2 €\", \"5 €\", \"10 €\", \"3 €\", \"12 €\", \"4 €\", \"15 €\")}"]
      text ask "How many euros is it? Write the number in [[language.name]]." width=32
      word-input word options=[pick(k, "[[num.two]]", "[[num.five]]", "[[num.ten]]", "[[num.three]]", "[[num.twelve]]", "[[num.four]]", "[[num.fifteen]]")] accents=loose
    }
  }

  answer word=pick(k, "[[num.two]]", "[[num.five]]", "[[num.ten]]", "[[num.three]]", "[[num.twelve]]", "[[num.four]]", "[[num.fifteen]]")
  hint "Say the word quietly first. What sound does it start with?"
  hint "Count the sounds, then write one letter or pair of letters for each."
}
