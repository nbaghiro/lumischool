# The change card rings every finger that stays: here the child counts them for other pairs, from
# none (C to A minor) to two (F to D minor).
item music.change-how-many-stay v=1 skills=[music.chord-changes] {
  title "How many fingers stay?"
  difficulty (if k == 3 then 2 else if k == 1 or k == 2 or k == 5 then 1 else 0)
  let k=0..5
  level easy {
    let k={0, 4}  # A minor to F, C to A minor
  }
  level hard {
    let k={1, 2, 3, 5}  # three-finger chords, G7 to D minor among them
  }

  scene 28x15 {
    chordchange change tuning=uke from=(if k == 0 then "Am" else if k == 1 then "F" else if k == 2 then "F" else if k == 3 then "G7" else if k == 4 then "C" else "Dm") to=(if k == 0 then "F" else if k == 1 then "Dm" else if k == 2 then "G7" else if k == 3 then "Dm" else if k == 4 then "Am" else "Am") frets=3 at=canvas(1, 1)
    text ask "A heavy ring is a finger that stays down. How many fingers stay down for this change?" width=14 right-of=change gap=1
    number-input answer below=ask gap=1
  }

  answer (if k == 1 then 2 else if k == 4 then 0 else 1)
  hint "Look for dots with a thick ring round them."
  hint "A dashed ring is a finger that moves or lifts. Does it count?"
}
