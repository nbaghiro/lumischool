# Loudness marks on a listening map, from pp to ff. Easy uses p, mf and f; hard mixes pp, p, mp and
# mf, where the child has to know that mp is softer than mf and pp softer than p.
item music.water-loud v=1 skills=[music.listening, music.dynamics] {
  title "The softest section"
  difficulty (if f <= 1 then 0 else 1)
  let f=0..3
  let l1={pick(f, 3, 4, 2, 5)}
  let l2={pick(f, 1, 2, 3, 4)}
  let l3={pick(f, 3, 4, 0, 2)}
  let l4={pick(f, 4, 1, 3, 1)}
  let l5={pick(f, 3, 4, 1, 3)}
  let right={pick(f, 2, 4, 3, 4)}
  level easy {
    let f=0..1
  }
  level hard {
    let f=2..3
  }

  scene 36x25 {
    listenmap map title="Evening on the canal" sections=[0, 1, 0, 2, 0] bars=[] tune=[-1, -1, -1, -1, -1] loud=[l1, l2, l3, l4, l5] tempo=[0, 0, 0, 0, 0] count=0 ask=-1 at=canvas(1, 1)
    text ask "The marks under the map say how loud each section is: pp, p, mp, mf, f and ff, from softest to loudest. Counting from the left, which section is the softest?" narrate width=34 below=map gap=1
    number-input answer below=ask gap=1
  }

  answer right
  feedback {
    when (answer == 1) point=map {
      say "Section 1 is where the piece starts, not where it is softest. Compare its mark with the others."
    }
  }
  hint "Which letters stand for soft, and which for loud?"
  hint "Put the marks in order from pp to ff. Which section has the mark nearest the start of that list?"
}
