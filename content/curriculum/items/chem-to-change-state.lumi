# A reason with numbers in it: the right choice is the range where the stuff is in the state asked
# for, and one wrong choice overshoots into the next state, so reading one number is not enough.
item chem.to-change-state v=1 stars=2 skills=[chemistry.states, reasoning.predict] {
  title "What would you have to do?"
  difficulty (if v <= 2 then 2 else if v <= 8 then 1 else 0)
  let v=0..11

  scene 34x22 {
    text ask "The jar shows the {if v == 0 then \"oxygen\" else if v == 1 then \"oxygen\" else if v == 2 then \"oxygen\" else if v == 3 then \"mercury\" else if v == 4 then \"mercury\" else if v == 5 then \"mercury\" else if v == 6 then \"iron\" else if v == 7 then \"iron\" else if v == 8 then \"iron\" else if v == 9 then \"water\" else if v == 10 then \"water\" else \"water\"} in a room at 20 degrees. What would you have to do to make it a {if v == 0 then \"liquid\" else if v == 1 then \"liquid\" else if v == 2 then \"liquid\" else if v == 3 then \"solid\" else if v == 4 then \"solid\" else if v == 5 then \"solid\" else if v == 6 then \"liquid\" else if v == 7 then \"liquid\" else if v == 8 then \"liquid\" else if v == 9 then \"gas\" else if v == 10 then \"gas\" else \"gas\"}? The numbers are degrees." width=28 at=canvas(1, 0)
    row kit below=ask gap=1 space=1 align=start {
      particles jar spread=(if v == 0 then 2 else if v == 1 then 2 else if v == 2 then 2 else if v == 3 then 1 else if v == 4 then 1 else if v == 5 then 1 else if v == 6 then 0 else if v == 7 then 0 else if v == 8 then 0 else if v == 9 then 1 else if v == 10 then 1 else 1) count=12 name=0
      column side space=1 align=start {
        table data cols=3 head=["Stuff", "Melts", "Boils"] cells=["{if v == 0 then \"Oxygen\" else if v == 1 then \"Oxygen\" else if v == 2 then \"Oxygen\" else if v == 3 then \"Mercury\" else if v == 4 then \"Mercury\" else if v == 5 then \"Mercury\" else if v == 6 then \"Iron\" else if v == 7 then \"Iron\" else if v == 8 then \"Iron\" else if v == 9 then \"Water\" else if v == 10 then \"Water\" else \"Water\"}", if v == 0 then -219 else if v == 1 then -219 else if v == 2 then -219 else if v == 3 then -39 else if v == 4 then -39 else if v == 5 then -39 else if v == 6 then 1538 else if v == 7 then 1538 else if v == 8 then 1538 else if v == 9 then 0 else if v == 10 then 0 else 0, if v == 0 then -183 else if v == 1 then -183 else if v == 2 then -183 else if v == 3 then 357 else if v == 4 then 357 else if v == 5 then 357 else if v == 6 then 2861 else if v == 7 then 2861 else if v == 8 then 2861 else if v == 9 then 100 else if v == 10 then 100 else 100]
        choice pick options=["{if v == 0 then \"Cool it to between -219 and -183\" else if v == 1 then \"Cool it below -219\" else if v == 2 then \"Warm it above -183\" else if v == 3 then \"Cool it below -39\" else if v == 4 then \"Cool it to between -39 and 357\" else if v == 5 then \"Warm it above -39\" else if v == 6 then \"Heat it to between 1538 and 2861\" else if v == 7 then \"Cool it below 1538\" else if v == 8 then \"Heat it above 2861\" else if v == 9 then \"Heat it above 100\" else if v == 10 then \"Heat it to between 0 and 100\" else \"Cool it below 0\"}", "{if v == 0 then \"Warm it above -183\" else if v == 1 then \"Cool it to between -219 and -183\" else if v == 2 then \"Cool it below -219\" else if v == 3 then \"Warm it above -39\" else if v == 4 then \"Cool it below -39\" else if v == 5 then \"Cool it to between -39 and 357\" else if v == 6 then \"Heat it above 2861\" else if v == 7 then \"Heat it to between 1538 and 2861\" else if v == 8 then \"Cool it below 1538\" else if v == 9 then \"Cool it below 0\" else if v == 10 then \"Heat it above 100\" else \"Heat it to between 0 and 100\"}", "{if v == 0 then \"Cool it below -219\" else if v == 1 then \"Warm it above -183\" else if v == 2 then \"Cool it to between -219 and -183\" else if v == 3 then \"Cool it to between -39 and 357\" else if v == 4 then \"Warm it above -39\" else if v == 5 then \"Cool it below -39\" else if v == 6 then \"Cool it below 1538\" else if v == 7 then \"Heat it above 2861\" else if v == 8 then \"Heat it to between 1538 and 2861\" else if v == 9 then \"Heat it to between 0 and 100\" else if v == 10 then \"Cool it below 0\" else \"Heat it above 100\"}"] stack=column
      }
    }
  }

  check chem.state of=jar table=data
  answer pick=(if v == 0 then "Cool it to between -219 and -183" else if v == 1 then "Cool it to between -219 and -183" else if v == 2 then "Cool it to between -219 and -183" else if v == 3 then "Cool it below -39" else if v == 4 then "Cool it below -39" else if v == 5 then "Cool it below -39" else if v == 6 then "Heat it to between 1538 and 2861" else if v == 7 then "Heat it to between 1538 and 2861" else if v == 8 then "Heat it to between 1538 and 2861" else if v == 9 then "Heat it above 100" else if v == 10 then "Heat it above 100" else "Heat it above 100")
  hint "What state is the {if v == 0 then \"oxygen\" else if v == 1 then \"oxygen\" else if v == 2 then \"oxygen\" else if v == 3 then \"mercury\" else if v == 4 then \"mercury\" else if v == 5 then \"mercury\" else if v == 6 then \"iron\" else if v == 7 then \"iron\" else if v == 8 then \"iron\" else if v == 9 then \"water\" else if v == 10 then \"water\" else \"water\"} in now? The jar shows it."
  hint "Which two numbers in its row does it have to be between to be a {if v == 0 then \"liquid\" else if v == 1 then \"liquid\" else if v == 2 then \"liquid\" else if v == 3 then \"solid\" else if v == 4 then \"solid\" else if v == 5 then \"solid\" else if v == 6 then \"liquid\" else if v == 7 then \"liquid\" else if v == 8 then \"liquid\" else if v == 9 then \"gas\" else if v == 10 then \"gas\" else \"gas\"}?"
  hint "Does one of the choices go too far, past the next point in the table?"
}
