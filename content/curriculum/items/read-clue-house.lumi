# A clue picks one house out of four only if every part of it is read. Every clue is something
# that can be counted or seen in black and white, because a printed sheet has no colour.
item reading.clue-house v=1 skills=[reading.find-a-detail] {
  title "Which house is it?"
  difficulty (if k == 1 or k == 2 then 0 else 1)
  let k=0..3

  scene 27x25 {
    row who at=canvas(1, 1) space=1 align=centre {
      face kid mood=happy hair=1
      bubble says "{if k == 0 then \"My house has a round door. It has two windows at the top.\" else if k == 1 then \"My house has three windows at the top.\" else if k == 2 then \"My house has a cat by the door.\" else \"My house has a square door. It has two windows at the top.\"}" width=17 from=kid
    }
    street st windows=[2, 1, 2, 3] doors=[0, 1, 1, 0] chimneys=[1, 0, 1, 1] cats=[0, 1, 0, 0] numbers=["1", "3", "5", "7"] below=who gap=1
    text ask "Which house is it?" below=st gap=1
    choice pick options=["1", "3", "5", "7"] right-of=ask gap=1
  }

  answer pick=(if k == 0 then "5" else if k == 1 then "7" else if k == 2 then "3" else "1")
  feedback {
    when (pick == "3" and k == 0) point=st {
      say "That door is round. Now count the windows at the top."
    }
    when (pick == "7" and k == 3) point=st {
      say "That door is square. Now count the windows at the top."
    }
  }
  hint "Check the houses one at a time. Cross out each one that does not fit."
}
