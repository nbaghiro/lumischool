# Whether a number is in a pattern, found without writing it all out: a step past what is shown.
item times.in-the-pattern v=1 skills=[multiplication.tables, patterns.rule] {
  title "Will it be in the pattern?"
  difficulty (t + k)
  let s=2..9 t={3, 4, 6, 7, 8, 9} k=6..10 q=0..2
  level easy {
    let t={3, 4} k=6..7
  }
  level hard {
    let t={7, 8, 9} k=9..10
  }

  scene 24x9 {
    text ask "The pattern goes {s}, {s + t}, {s + 2 * t}, and keeps going up in {t}s. Which of these numbers will be in it?" width=22 at=canvas(1, 1)
    choice pick options=[if q == 0 then s + k * t else if q == 1 then s + k * t + 1 else s + k * t - 2, if q == 0 then s + k * t + 1 else if q == 1 then s + k * t - 2 else s + k * t, if q == 0 then s + k * t - 2 else if q == 1 then s + k * t else s + k * t + 1] below=ask gap=1
  }

  answer pick=(s + k * t)
  hint "Take {s} away from each number. Which answer is then in the {t} times table?"
  hint "The numbers in the pattern are all {s} more than a number in the {t} times table."
}
