# Air has weight: a cubic metre of dry air at 20 °C and sea level weighs about 1.2 kg (1.204 kg per
# cubic metre in engineering tables), so the air in a room weighs kilograms. The unknown is the weight
# or the room's size.
item chem.air-weighs v=1 skills=[chemistry.gases, measure.mass] {
  title "What does the air weigh?"
  difficulty (d * 2 + (if v == 5 or v == 10 then 0 else 1))
  let d=0..1 v={5, 10, 50, 100}
  let kg={v * 6 / 5}
  let place={pick(d, "the observatory's dome", "the telescope room")}
  level easy {
    let d=0..0
  }
  level hard {
    let d=1..1
  }

  scene 36x11 {
    observatory dome open=1 at=canvas(1, 0)
    text ask "A cubic metre of air, which is 1000 litres, weighs about 1.2 kg. {if d == 0 then \"The observatory's dome holds \" else \"The air in the telescope room weighs about \"}{if d == 0 then v else kg}{if d == 0 then \" cubic metres of air. About how many kilograms does that air weigh?\" else \" kg. How many cubic metres of air does the room hold?\"}" narrate width=25 right-of=dome gap=1
    number-input answer below=ask gap=1
  }

  answer (if d == 0 then kg else v)
  feedback {
    when (d == 0 and answer == v) point=dome {
      say "{v} is the number of cubic metres. Each one weighs a little more than a kilogram."
    }
    when (d == 1 and answer == kg) point=dome {
      say "That is the kilograms. The question asks how many cubic metres make that much."
    }
  }
  hint "{if d == 0 then \"What does one cubic metre weigh? How many cubic metres are there?\" else \"What does one cubic metre of air weigh?\"}"
  hint "{if d == 0 then \"1.2 kg is 1 kg and a fifth of a kilogram. Add a fifth on to the number of cubic metres.\" else \"How many lots of that weight make the room's air?\"}"
}
