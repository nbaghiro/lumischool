item k.rhyme-odd v=1 skills=[reading.rhyme] {
  title "Which one does not rhyme?"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..3
  let r1={pick(k, "cat", "dog", "cake", "bee")}
  let r2={pick(k, "hat", "frog", "lake", "tree")}
  let odd={pick(k, "pig", "dig", "cap", "bat")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 24x9 {
    text ask "Which one does not rhyme with the others?" narrate width=22 at=canvas(1, 1)
    choice pick options=[r1, odd, r2] stack=row below=ask gap=1
  }

  answer pick=odd
  hint "Say all three words. Which two sound the same at the end?"
}
