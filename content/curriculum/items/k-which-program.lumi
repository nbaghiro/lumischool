item k.which-program v=1 skills=[coding.sequences, coding.planning] {
  title "Which program reaches the flag?"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..4
  let a={pick(k, 3, 4, 2, 1, 3)}
  let b={pick(k, 1, 1, 1, 2, 2)}
  let right={pick(k, "right 3, then down 1", "right 4, then down 1", "right 2, then down 1", "right 1, then down 2", "right 3, then down 2")}
  let wrong={pick(k, "right 1, then down 3", "right 1, then down 4", "right 1, then down 2", "right 2, then down 1", "right 2, then down 3")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..4
  }

  scene 30x18 {
    maze g cols=5 rows=3 col=1 row=1 flag=[1 + a, 1 + b] trail=none at=canvas(1, 1)
    text q "A toy robot on the garden path. Which program takes it to the flag? The grown-up reads them." narrate width=14 right-of=g gap=1
    choice pick options=[wrong, right] stack=column below=g gap=1
  }

  answer pick=right
  hint "Count the squares from the robot to the flag going right."
  hint "Now count the squares going down."
}
