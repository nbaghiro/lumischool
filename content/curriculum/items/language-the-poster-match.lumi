# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.the-poster-match v=1 skills=[language.reading] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[notice.entry-the-way-in]]", "[[notice.free]]", "[[notice.not-allowed]]"), pick(k, "[[notice.exit]]", "[[notice.the-dinner]]", "[[notice.danger]]"), pick(k, "[[notice.open]]", "[[notice.the-dancing]]", "[[notice.for-everyone]]"), pick(k, "[[notice.closed]]", "[[notice.if-it-rains]]", "[[notice.fireworks]]")] right=[pick(k, "open", "if it rains", "for everyone"), pick(k, "entry, the way in", "free", "not allowed"), pick(k, "exit", "the dinner", "fireworks"), pick(k, "closed", "the dancing", "danger")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
