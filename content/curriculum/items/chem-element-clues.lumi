# The three-star: an element found from clues, each ruling out part of the table. Every clue set has
# exactly one element in the first three rows that fits; states and kinds are from ELEMENTS.
item chem.element-clues v=1 stars=3 skills=[chemistry.elements, reasoning.deduction] {
  title "The mystery element"
  difficulty pick(k, 1, 0, 2, 1, 2)
  let k=0..4
  let clues={pick(k, "It is in row 2. It is a gas at 20 °C. Its number is even. It is not in the last column.", "It is in row 3. It is a gas at 20 °C. Its number is odd.", "It is in row 3. It is not a metal. Its number is odd. Its symbol has one letter.", "It is a metal. Its number is even. It is in row 3.", "It is not a gas at 20 °C. Its symbol has one letter. Its number is more than 5 and less than 10.")}
  level easy {
    let k={1, 3}
  }
  level hard {
    let k={2, 4}
  }

  scene 35x21 {
    periodic t rows=3 blank=0 mark=0 shade=pick(k, "gas", "gas", "metal", "metal", "gas") at=canvas(1, 0)
    text ask "A note left by the telescope describes one element in these three rows. {clues} What is its atomic number?" narrate width=34 below=t gap=1
    number-input answer below=ask gap=1
  }

  answer pick(k, 8, 17, 15, 12, 6)
  hint "Start with the clue that rules out the most cells. Which cells are left?"
  hint "Take the next clue and cross out the cells it rules out. How many are left now?"
  hint "Does the last clue leave exactly one?"
}
