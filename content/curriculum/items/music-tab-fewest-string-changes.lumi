# The three-star plan: a word to play from its letters, where G has two places on strings 1 to 3
# (string 1 at fret 3, or string 3 open), and the place that changes string fewest times. Each word
# here has one best place (catalog-balance batch25 notes list the counts).
item music.tab-fewest-string-changes v=1 stars=3 skills=[music.tab, reasoning.planning] {
  title "The fewest string changes"
  difficulty (if v <= 2 then 0 else if v == 3 then 1 else 2)
  let v=0..4
  let word={pick(v, "BAG", "BEG", "GAB", "EDGE", "BADGE")}
  let right={pick(v, "string 3, 1 change", "string 1, 1 change", "string 3, 1 change", "string 1, 2 changes", "string 1, 3 changes")}
  let near={pick(v, "string 1, 2 changes", "string 3, 2 changes", "string 1, 2 changes", "string 3, 3 changes", "string 3, 4 changes")}
  level easy {
    let v=0..1
  }
  level hard {
    let v=3..4
  }

  scene 36x34 {
    tab map tuning=guitar notes=["s3f0", "s3f2", "s2f0", "s2f1", "s2f3", "s1f0", "s1f1", "s1f3"] values=[] even=true letters=true ring=-1 at=canvas(1, 1)
    text ask "Ana plays {word} from its letters. Every letter but G is played where the tab shows it, and G can be string 3 open or string 1 at fret 3. Which G makes the fewest string changes, and how many are there?" narrate width=34 below=map gap=1
    choice pick options=[pick(v, "string 1, 1 change", "string 3, 1 change", "string 3, 2 changes", "string 1, 2 changes", "string 3, 3 changes"), pick(v, "string 3, 1 change", "string 1, 2 changes", "string 1, 1 change", "string 3, 2 changes", "string 1, 3 changes"), pick(v, "string 1, 2 changes", "string 1, 1 change", "string 1, 2 changes", "string 1, 3 changes", "string 3, 4 changes"), pick(v, "string 3, 2 changes", "string 3, 2 changes", "string 3, 1 change", "string 3, 3 changes", "string 1, 4 changes")] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick == near) point=ask {
      say "That G works, but it changes string more often. Try the other G and count again."
    }
    when (pick != right and pick != near) point=ask {
      say "Write the string for each letter first, then count every time the next note is on a different string."
    }
  }
  hint "Which string does each letter of {word} need? E and F are on string 1, B, C and D on string 2, A on string 3."
  hint "Which G keeps the notes next to it on the same string?"
}
