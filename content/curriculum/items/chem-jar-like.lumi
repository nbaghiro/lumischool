# From a real thing to its particle picture: the unknown moves from the jar to the thing. The three
# jars come in every order, so the answer is not always the same letter.
item chem.jar-like v=1 skills=[chemistry.states] {
  title "Which jar is like it?"
  difficulty (if t == 3 or t == 5 then 2 else if t == 1 or t == 4 then 1 else 0)
  let x=0..2 y=0..2 z=0..2 t=0..5
  where (x != y and y != z and x != z)
  level easy {
    let t={0, 2}  # a stone and the air in a balloon
  }
  level hard {
    let t={3, 5}  # an ice cube and steam
  }

  scene 35x20 {
    text ask "Which jar shows the particles in {if t == 0 then \"a stone\" else if t == 1 then \"milk\" else if t == 2 then \"the air in a balloon\" else if t == 3 then \"an ice cube\" else if t == 4 then \"orange juice\" else \"steam from a kettle\"}?" width=32 at=canvas(1, 0)
    particles one spread=x count=16 name=0 below=ask gap=0
    text la "A" below=one gap=0
    particles two spread=y count=16 name=0 right-of=one gap=2
    text lb "B" below=two gap=0
    particles three spread=z count=16 name=0 right-of=two gap=2
    text lc "C" below=three gap=0
    choice pick options=["A", "B", "C"] below=lb gap=1
  }

  answer pick=(if x == t % 3 then "A" else if y == t % 3 then "B" else "C")
  feedback {
    when (pick == "A" and x == 2 and t % 3 == 1) point=one {
      say "A liquid stays at the bottom of its jar. Its particles touch."
    }
  }
  hint "Is {if t == 0 then \"a stone\" else if t == 1 then \"milk\" else if t == 2 then \"the air in a balloon\" else if t == 3 then \"an ice cube\" else if t == 4 then \"orange juice\" else \"steam from a kettle\"} a solid, a liquid or a gas?"
  hint "Now find the jar whose particles are arranged that way."
}
