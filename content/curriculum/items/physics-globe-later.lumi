item physics.globe-later v=1 skills=[physics.sky] {
  title "Six hours later"
  let x={9, 11, 13, 15} y={21, 23, 1, 3}

  scene 21x24 {
    globe earth hours=[x, y] at=canvas(0, 0)
    text ask "The Earth turns the way the arrow shows. In 6 hours, will it be day or night for child A?" width=19 below=earth gap=0
    choice pick options=["day", "night"] below=ask gap=1
  }

  check physics.sky of=earth pick="time(a+6)"
  hint "Which way does A move as the Earth turns, and how far round is 6 hours?"
}
