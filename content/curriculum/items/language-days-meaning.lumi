# The language to English: [[phrase.today-is-monday]], [[phrase.tomorrow-is-tuesday]], [[phrase.what-day-is-it-today]], [[phrase.there-is-no-school-on-saturday]], [[phrase.see-you-on-friday]], [[phrase.on-sunday-i-go-to-the-beach]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.days-meaning v=1 skills=[language.time] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "gran", "boy", "girl", "gran")] says=[pick(k, "[[phrase.today-is-monday]]", "[[phrase.tomorrow-is-tuesday]]", "[[phrase.what-day-is-it-today]]", "[[phrase.there-is-no-school-on-saturday]]", "[[phrase.see-you-on-friday]]", "[[phrase.on-sunday-i-go-to-the-beach]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "On Sunday I go to the beach.", "There is no school on Saturday.", "Tomorrow is Tuesday.", "On Sunday I go to the beach.", "On Sunday I go to the beach.", "There is no school on Saturday."), pick(k, "Today is Monday.", "Tomorrow is Tuesday.", "See you on Friday.", "There is no school on Saturday.", "What day is it today?", "On Sunday I go to the beach."), pick(k, "What day is it today?", "See you on Friday.", "There is no school on Saturday.", "Tomorrow is Tuesday.", "See you on Friday.", "What day is it today?"), pick(k, "See you on Friday.", "What day is it today?", "What day is it today?", "What day is it today?", "There is no school on Saturday.", "See you on Friday.")] stack=column
    }
  }

  answer pick=pick(k, "Today is Monday.", "Tomorrow is Tuesday.", "What day is it today?", "There is no school on Saturday.", "See you on Friday.", "On Sunday I go to the beach.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
