# The language to English: [[phrase.i-have-a-dog]], [[phrase.my-cat-is-called-coco]], [[phrase.i-do-not-have-a-pet]], [[phrase.do-you-have-a-rabbit]], [[phrase.i-have-two-cats]], [[phrase.the-duck-is-in-the-water]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.animals-meaning v=1 skills=[language.animals] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "boy", "girl", "boy", "girl", "gran", "boy")] says=[pick(k, "[[phrase.i-have-a-dog]]", "[[phrase.my-cat-is-called-coco]]", "[[phrase.i-do-not-have-a-pet]]", "[[phrase.do-you-have-a-rabbit]]", "[[phrase.i-have-two-cats]]", "[[phrase.the-duck-is-in-the-water]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "The duck is in the water.", "Do you have a rabbit?", "My cat is called Coco.", "The duck is in the water.", "The duck is in the water.", "Do you have a rabbit?"), pick(k, "I have a dog.", "My cat is called Coco.", "I have two cats.", "Do you have a rabbit?", "I do not have a pet.", "The duck is in the water."), pick(k, "I do not have a pet.", "I have two cats.", "Do you have a rabbit?", "My cat is called Coco.", "I have two cats.", "I do not have a pet."), pick(k, "I have two cats.", "I do not have a pet.", "I do not have a pet.", "I do not have a pet.", "Do you have a rabbit?", "I have two cats.")] stack=column
    }
  }

  answer pick=pick(k, "I have a dog.", "My cat is called Coco.", "I do not have a pet.", "Do you have a rabbit?", "I have two cats.", "The duck is in the water.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
