# Two rows to compare. The longer row is not always the one with more, so the child counts both.
item k.more-apples-or-stars v=1 skills=[counting.compare] {
  title "More apples or more stars?"
  difficulty (5 - abs(a - b))
  let a=1..5 b=1..5
  where (a != b)
  roles x=apple y=star
  level easy {
    where (abs(a - b) >= 3)
  }
  level hard {
    where (abs(a - b) == 1)
  }

  scene 22x15 {
    props top count=a prop=apple at=canvas(1, 1)
    props bottom count=b prop=star below=top gap=1
    text ask "Are there more apples or more stars?" narrate below=bottom gap=1
    choice pick options=[x, y] below=ask gap=1
  }

  answer pick=(if a > b then "x" else "y")
  hint "Count the apples. Now count the stars. Which number is bigger?"
}
