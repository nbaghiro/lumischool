# The word written from its picture: [[school.pencil]], [[school.rubber]], [[school.crayon]], [[school.brush]], [[school.felt-pen]].
# Accent-tolerant: the box takes the word with its accents left off (accents=loose); ñ is a letter and is marked.
item language.pencil-case-write v=1 skills=[language.school, language.questions, language.spelling] {
  title "Write the word"
  difficulty pick(k, 0, 0, 1, 1, 2)
  let k=0..4

  scene 34x13 {
    column all at=canvas(1, 1) space=1 align=start {
      arttools tool tools=["{pick(k, \"pencil\", \"eraser\", \"crayon\", \"brush\", \"marker\")}"] colours=["{pick(k, \"blue\", \"red\", \"red\", \"yellow\", \"green\")}"] layout=one ring=-1
      text ask "Write it in [[language.name]], without the little word before it." width=32
      word-input word options=[pick(k, "[[school.pencil]]", "[[school.rubber]]", "[[school.crayon]]", "[[school.brush]]", "[[school.felt-pen]]")] accents=loose
    }
  }

  answer word=pick(k, "[[school.pencil]]", "[[school.rubber]]", "[[school.crayon]]", "[[school.brush]]", "[[school.felt-pen]]")
  hint "Say the word quietly first. What sound does it start with?"
  hint "Count the sounds, then write one letter or pair of letters for each."
}
