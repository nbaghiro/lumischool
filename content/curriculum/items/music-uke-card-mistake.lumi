# Sam's card is checked against C, the one chord the lesson teaches: the string, the fret, both, or
# neither can be wrong, so the child compares place by place rather than spotting an odd dot.
item music.uke-card-mistake v=1 stars=2 skills=[music.chord-boxes, reasoning.find-the-error] {
  title "Sam's card for C"
  difficulty (if s == 1 and f == 3 then 0 else if s == 1 or f == 3 then 1 else 2)
  let s=1..4 f=1..3
  where (s == 1 and f == 3 or s == 2 and f == 3 or s == 4 and f == 3 or s == 1 and f == 2 or s == 2 and f == 2 or s == 3 and f == 1)

  scene 34x21 {
    chordbox card tuning=uke chord=none places=["s{s}f{f}"] frets=3 show=dots name=false letters=true lit=[] at=canvas(1, 1)
    text ask "Sam drew a dot where he thinks finger 3 goes for C. What is wrong with where the dot is?" width=21 right-of=card gap=1
    choice pick options=["the string", "the fret", "both", "nothing"] stack=column below=ask gap=1
  }

  answer pick=(if s == 1 and f == 3 then "nothing" else if f == 3 then "the string" else if s == 1 then "the fret" else "both")
  hint "For C, which string does the finger go on, and at which fret?"
  hint "Check the string first, then the fret. Is each one right?"
}
