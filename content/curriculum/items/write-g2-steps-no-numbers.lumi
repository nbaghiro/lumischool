# The audit's raise for recipe-order: no numbered pictures to copy, so the order has to come from
# what must happen before what.
item writing.steps-no-numbers v=2 skills=[writing.instructions, writing.sequencing] {
  title "Which step comes first?"
  let c=0..1 q=0..2
  let a={if c == 0 then "Crack two eggs into a bowl." else "Fill a pot with soil."}
  let b={if c == 0 then "Stir in the flour." else "Push a seed into the soil."}
  let x={if c == 0 then "Pour it into the tin." else "Water it."}
  let d={if c == 0 then "Bake it in the oven." else "Wait for a shoot to grow."}
  let s1={if q == 0 then x else if q == 1 then b else d}
  let s2={if q == 0 then a else if q == 1 then d else x}
  let s3={if q == 0 then d else if q == 1 then a else b}
  let s4={if q == 0 then b else if q == 1 then x else a}

  scene 35x16 {
    text ask "These steps are mixed up. Number them 1 to 4 in the order they are done." narrate width=33 at=canvas(1, 1)
    sequence s items=["{s1}", "{s2}", "{s3}", "{s4}"] blanks=[n1, n2, n3, n4] below=ask gap=1
  }

  answer n1=(if q == 0 then 3 else if q == 1 then 2 else 4) n2=(if q == 0 then 1 else if q == 1 then 4 else 3) n3=(if q == 0 then 4 else if q == 1 then 1 else 2) n4=(if q == 0 then 2 else if q == 1 then 3 else 1)
  hint "What has to happen before anything else can?"
  hint "Which step could only be done last?"
}
