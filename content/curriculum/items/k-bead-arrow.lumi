item k.bead-arrow v=1 skills=[counting.to-ten] {
  title "Which bead?"
  difficulty m
  let m=2..10
  level easy {
    let m=2..5
  }
  level hard {
    let m=7..10
  }

  scene 24x9 {
    beadstring line beads=10 mark=m at=canvas(1, 1)
    text ask "Which bead is the arrow pointing at?" narrate below=line gap=1
    number-input answer right-of=ask gap=1
  }

  answer m
  feedback {
    when (answer == m + 1 or answer == m - 1) point=line {
      say "Count the beads from the left end, one bead for each number."
    }
  }
  hint "The first five beads are one colour. Is the arrow in the first five?"
}
