item k.plan-past-rocks v=1 stars=3 skills=[coding.planning, coding.debugging] {
  title "A plan with no bumps"

  scene 32x22 {
    maze g cols=4 rows=3 col=1 row=1 flag=[4, 3] rocks=[2, 1, 3, 3] trail=none at=canvas(1, 1)
    text q "Which plan reaches the flag without bumping a rock?" narrate width=14 right-of=g gap=1
    choice pick options=["right 3, then down 2", "down 2, then right 3", "down 1, right 3, down 1"] stack=column below=g gap=1
  }

  answer pick="down 1, right 3, down 1"
  hint "Follow each plan with a finger. Where does it hit a rock?"
  hint "Is there a row with no rocks in it?"
}
