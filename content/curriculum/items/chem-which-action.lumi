# What was done: the middle picture's arrows say it, pressed together, pulled apart, bent at both
# ends or turned opposite ways.
item chem.which-action v=1 skills=[chemistry.materials] {
  title "What was done to it?"
  difficulty (if k == 5 or k == 6 then 1 else 0)
  let k=0..8
  level easy {
    let k={0, 2, 7, 8}  # squashes and a stretch
  }
  level hard {
    let k={3, 5, 6}  # a stretch, a bend and a twist
  }

  scene 32x15 {
    squash s thing=(if k == 0 then "sponge" else if k == 1 then "clay" else if k == 2 then "band" else if k == 3 then "spring" else if k == 4 then "spring" else if k == 5 then "pipecleaner" else if k == 6 then "pipecleaner" else if k == 7 then "foil" else "ball") action=(if k == 0 then "squash" else if k == 1 then "squash" else if k == 2 then "stretch" else if k == 3 then "stretch" else if k == 4 then "squash" else if k == 5 then "bend" else if k == 6 then "twist" else if k == 7 then "squash" else "squash") after=1 at=canvas(1, 0)
    text ask "Look at the middle picture. What is being done to the {if k == 0 then \"sponge\" else if k == 1 then \"clay\" else if k == 2 then \"rubber band\" else if k == 3 then \"spring\" else if k == 4 then \"spring\" else if k == 5 then \"pipe cleaner\" else if k == 6 then \"pipe cleaner\" else if k == 7 then \"foil\" else \"ball\"}?" width=19 below=s gap=0
    choice pick options=["squash", "bend", "twist", "stretch"] below=ask gap=0
  }

  answer pick=(if k == 0 then "squash" else if k == 1 then "squash" else if k == 2 then "stretch" else if k == 3 then "stretch" else if k == 4 then "squash" else if k == 5 then "bend" else if k == 6 then "twist" else if k == 7 then "squash" else "squash")
  hint "Look at the arrows in the middle picture. Which way do they point?"
  hint "Is it being pressed in, pulled out, turned round, or curved over?"
}
