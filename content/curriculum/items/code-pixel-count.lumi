item coding.pixel-count v=1 skills=[coding.sequences, coding.data] {
  title "How many red squares?"
  difficulty (if k == 0 then 18 else if k == 1 then 22 else 24)
  let k=0..2
  level easy {
    let k=0..1
  }
  level hard {
    let k=1..2
  }

  scene 30x15 {
    pixels p cols=6 rows=5 code=["{if k == 0 then \"2 white 2 red 2 white\" else if k == 1 then \"1 white 4 red 1 white\" else \"3 white 3 red\"}", "{if k == 0 then \"1 white 4 red 1 white\" else if k == 1 then \"6 red\" else \"2 white 4 red\"}", "{if k == 0 then \"6 red\" else if k == 1 then \"6 red\" else \"1 white 5 red\"}", "{if k == 0 then \"1 white 4 red 1 white\" else if k == 1 then \"1 white 4 red 1 white\" else \"6 red\"}", "{if k == 0 then \"2 white 2 red 2 white\" else if k == 1 then \"2 white 2 red 2 white\" else \"6 red\"}"] show=false at=canvas(1, 0)
    text ask "Colour the squares the code says. How many are red?" width=24 below=p gap=1
    number-input answer right-of=ask gap=1
  }

  check coding.runs of=p answer=painted(red)
  hint "Each line is one row, from the left. Colour one row at a time."
}
