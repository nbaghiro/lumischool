# Two houses fit what is known so far, and the child chooses the clue that would tell them apart:
# the other clue fits both, so each clue has to be read against both houses.
item reading.which-clue-helps v=1 stars=2 skills=[reading.find-a-detail, reasoning.choose-evidence] {
  title "The clue that helps"
  let k=0..2

  scene 37x21 {
    text says "Two houses have {if k == 0 then \"a round door\" else if k == 1 then \"two windows at the top\" else \"a square door\"}. Which clue tells you which one is Jo's house?" narrate width=10 right-of=st gap=1
    street st windows=[2, 1, 2, 3] doors=[0, 1, 1, 0] chimneys=[1, 0, 1, 1] cats=[0, 1, 0, 0] numbers=["1", "3", "5", "7"] at=canvas(1, 1)
    choice pick options=["It has a chimney.", "{if k == 2 then \"It has three windows at the top.\" else \"It has a round door.\"}"] stack=column below=st gap=1
  }

  answer pick=(if k == 0 then "It has a chimney." else if k == 1 then "It has a round door." else "It has three windows at the top.")
  hint "Find the two houses first. Put a finger on each."
  hint "Read each clue. Does it fit one of the two houses, or both of them?"
}
