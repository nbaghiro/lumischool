# The printed word is never shown: a clue says it, the train shows the first and last beats, and
# the middle beat has to be heard and spelled. The audit's raise for syllable-train.
item reading.middle-beat v=1 skills=[reading.syllables, reading.spelling] {
  title "The beat in the middle"
  difficulty (if i == 2 then 1 else 0)
  let i=0..6
  level easy {
    let i={0, 1, 3, 4, 5, 6}
  }
  level hard {
    let i={2}  # umbrella
  }

  scene 29x11 {
    text clue "{if i == 0 then \"A big grey animal with a long trunk.\" else if i == 1 then \"A long yellow fruit.\" else if i == 2 then \"You hold it over your head in the rain.\" else if i == 3 then \"A round red fruit that goes in a salad.\" else if i == 4 then \"An animal that lived long, long ago.\" else if i == 5 then \"You type on it and play games on it.\" else \"You wear them in bed.\"}" narrate width=26 at=canvas(1, 1)
    row both below=clue gap=1 space=2 align=end {
      wordtrain train parts=[if i == 0 then "el" else if i == 1 then "ba" else if i == 2 then "um" else if i == 3 then "to" else if i == 4 then "di" else if i == 5 then "com" else "py", "", if i == 0 then "phant" else if i == 1 then "na" else if i == 2 then "la" else if i == 3 then "to" else if i == 4 then "saur" else if i == 5 then "ter" else "mas"] blank=1 word=""
      column q space=1 align=start {
        text ask "Write the middle beat." narrate width=10
        word-input beat options=["{if i == 0 then \"e\" else if i == 1 then \"na\" else if i == 2 then \"brel\" else if i == 3 then \"ma\" else if i == 4 then \"no\" else if i == 5 then \"pu\" else \"ja\"}"] letters=4
      }
    }
  }

  answer beat=(if i == 0 then "e" else if i == 1 then "na" else if i == 2 then "brel" else if i == 3 then "ma" else if i == 4 then "no" else if i == 5 then "pu" else "ja")
  hint "What is the clue about? Say the word and clap it."
  hint "Say the word again, slowly, and stop after the second clap. What did you just say?"
}
