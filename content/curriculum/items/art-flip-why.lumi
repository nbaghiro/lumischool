# The two-star reason: separate pictures shown quickly, more than about 10 to 12 a second, are seen
# as movement (Wikipedia, "Frame rate"). The wrong reasons put the movement in the paper.
item art.flip-why v=1 stars=2 skills=[art.animation, reasoning.explain] {
  title "Why does it move?"
  let r=0..1

  scene 36x26 {
    moonphases m from=0 step=4 count=6 blank=-1 days=0 at=canvas(1, 1)
    text ask "Every page of a flip book is a still picture. John Barnes Linnett called his flip book a kineograph, a moving picture, in 1868. Why do the pictures seem to move when the pages are flipped?" narrate width=34 below=m gap=1
    choice pick options=[pick(r, "Quick still pictures are seen as moving", "The paper bends the picture"), "Each page wobbles as it falls", pick(r, "The paper bends the picture", "Quick still pictures are seen as moving")] stack=column below=ask gap=1
  }

  answer pick="Quick still pictures are seen as moving"
  feedback {
    when (pick != "Quick still pictures are seen as moving") point=m {
      say "Flip the book slowly, one page at a time. Does the picture still move?"
    }
  }
  hint "What changes if you turn the pages very slowly?"
  hint "Is the movement in the paper, or in how your eyes see quick pictures?"
}
