# Every way to pay with three kinds of coin: organise by quarters, then dimes, and the nickels
# make up the rest.
item money.ways-with-quarters v=1 stars=3 skills=[money.coins, reasoning.all-the-ways] {
  title "Every way to pay"
  difficulty v
  let v={30, 35, 40, 45}

  scene 30x12 {
    coins key quarters=1 dimes=1 nickels=1 pennies=0 at=canvas(1, 1)
    text ask "Pay exactly {v} cents with quarters, dimes and nickels. You do not have to use every kind. How many different ways are there?" narrate width=18 right-of=key gap=2
    number-input answer below=ask gap=1
  }

  answer (v // 10 + 1 + (v - 25) // 10 + 1)
  feedback {
    when (answer == v // 10 + 1) point=key {
      say "Those are the ways with no quarter. Now try the ways that use one quarter."
    }
  }
  hint "Start with no quarters. How many ways can dimes and nickels make {v} cents?"
  hint "Now use one quarter. What is left to make with dimes and nickels?"
}
