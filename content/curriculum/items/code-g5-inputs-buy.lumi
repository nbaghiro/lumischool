# A block with two inputs that keeps a running total of money: each call adds its count times its
# price, so the child multiplies inside each call and adds across calls.
item coding.inputs-buy v=1 skills=[coding.procedures, coding.variables, money.dollars-and-cents] {
  title "Shopping at the city market"
  difficulty ((a * p + c * q) / 5)
  let a=1..3 p=2..5 c=1..4 q=1..3
  where (p != q)
  level easy {
    let a={1, 2} c={1, 2}
  }
  level hard {
    let a={3} c=3..4
  }

  scene 36x17 {
    program pr code=["define buy count price", "  add count * price to spent", "set spent to 0", "buy {a} {p}", "buy {c} {q}"] at=canvas(1, 0)
    variable v name=spent code=["define buy count price", "  add count * price to spent", "set spent to 0", "buy {a} {p}", "buy {c} {q}"] blank=true history=false right-of=pr gap=1
    text ask "Buy {a} {p} means {a} things at ${p} each. How many dollars is spent at the end?" width=22 below=pr gap=1
    number-input answer right-of=ask gap=1
  }

  check coding.runs of=v answer="value(spent)"
  feedback {
    when (answer == a + p + c + q and a + p + c + q != a * p + c * q) point=pr {
      say "Each buy adds count times price, not count and price."
    }
    when (answer == a * p) point=pr {
      say "That is the first buy. There is a second one after it."
    }
  }
  hint "What does the first buy add to spent?"
  hint "Now the second buy. Add the two."
}
