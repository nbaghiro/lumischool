# The language to English: [[phrase.i-would-like-a-strawberry-ice-cream]], [[phrase.do-you-have-sandwiches]], [[phrase.a-water-please]], [[phrase.that-is-seven-euros]], [[phrase.can-i-pay-by-card]], [[phrase.it-is-very-tasty]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.at-the-cafe-meaning v=1 skills=[language.food, language.market] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "gran", "gran", "girl", "boy")] says=[pick(k, "[[phrase.i-would-like-a-strawberry-ice-cream]]", "[[phrase.do-you-have-sandwiches]]", "[[phrase.a-water-please]]", "[[phrase.that-is-seven-euros]]", "[[phrase.can-i-pay-by-card]]", "[[phrase.it-is-very-tasty]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "It is very tasty.", "That is seven euros.", "Do you have sandwiches?", "It is very tasty.", "It is very tasty.", "That is seven euros."), pick(k, "I would like a strawberry ice cream.", "Do you have sandwiches?", "Can I pay by card?", "That is seven euros.", "A water, please.", "It is very tasty."), pick(k, "A water, please.", "Can I pay by card?", "That is seven euros.", "Do you have sandwiches?", "Can I pay by card?", "A water, please."), pick(k, "Can I pay by card?", "A water, please.", "A water, please.", "A water, please.", "That is seven euros.", "Can I pay by card?")] stack=column
    }
  }

  answer pick=pick(k, "I would like a strawberry ice cream.", "Do you have sandwiches?", "A water, please.", "That is seven euros.", "Can I pay by card?", "It is very tasty.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
