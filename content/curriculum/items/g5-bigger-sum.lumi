# The core's reasoning question: two sums sharing one fraction, compared by their other fraction
# without adding either.
item fraction.bigger-sum v=1 skills=[fractions.compare, reasoning.compare-without-totalling] {
  title "Which path is longer"
  difficulty ((if n1 == 1 and n2 == 1 then 0 else 1) + x / 4)
  let x={2, 3, 5} y={3, 4, 5, 6, 8} z={3, 4, 5, 6, 8} n1=1..3 n2=1..3 q=0..1
  where (y != z and n1 < y and n2 < z and n1 / y != n2 / z)
  level easy {
    let n1={1} n2={1}
  }
  level hard {
    where (n1 > 1 and n2 > 1)
  }

  scene 31x16 {
    text ask "Two paths lead from the gate to the fountain. Each is written as the lengths of its two parts, in km. Which path is longer? Decide without adding." narrate width=30 at=canvas(1, 1)
    text pa "A:   1/{x} + {if q == 0 then n1 else n2}/{if q == 0 then y else z}" below=ask gap=1
    text pb "B:   1/{x} + {if q == 0 then n2 else n1}/{if q == 0 then z else y}" below=pa gap=0
    choice pick options=["A", "B"] below=pb gap=1
  }

  answer pick=(if (n1 / y > n2 / z) == (q == 0) then "A" else "B")
  feedback {
    when (pick != (if (n1 / y > n2 / z) == (q == 0) then "A" else "B")) point=pa {
      say "Both paths start with 1/{x} km, so the longer path has the longer second part. Compare those two."
    }
  }
  hint "What is the same in both sums?"
  hint "So compare only the parts that are different. Which fraction is bigger?"
}
