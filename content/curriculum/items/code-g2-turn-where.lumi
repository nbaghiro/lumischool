# Two turns, one of them either way, and the square asked for as a column and a row.
item coding.turn-where v=1 skills=[coding.tracing] {
  title "Where does it stop?"
  difficulty (a + b + c)
  let a=1..3 b=1..3 t=0..1 c=1..2
  where (if t == 0 then 5 - a - c >= 1 else 5 - a + c <= 5)
  level easy {
    where (a + b + c <= 4)
  }
  level hard {
    where (a + b + c >= 7)
  }

  scene 37x16 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks bl code=["forward {a}", "turn right", "forward {b}", "turn {if t == 0 then \"left\" else \"right\"}", "forward {c}"]
      maze g cols=5 rows=5 col=1 row=5 face=up code=["forward {a}", "turn right", "forward {b}", "turn {if t == 0 then \"left\" else \"right\"}", "forward {c}"] upto=0 trail=none
    }
    text ask "Which square does the robot stop on?" width=17 below=top gap=1
    row ans right-of=ask gap=1 space=1 align=centre {
      text lc "column"
      number-input col width=3
      text lr "row"
      number-input row width=3
    }
  }

  check coding.runs of=g col=col row=row
  hint "Put your finger on the robot. Which way is it facing before the first block?"
  hint "Move your finger one block at a time, and turn it at every turn."
}
