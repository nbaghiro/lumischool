# The language to English: [[phrase.what-is-the-weather-like]], [[phrase.today-it-is-sunny]], [[phrase.tomorrow-it-is-going-to-rain]], [[phrase.it-is-very-hot]], [[phrase.it-is-raining-and-cold]], [[phrase.it-is-not-windy]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.weather-meaning v=1 skills=[language.weather] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "gran", "girl", "boy", "gran")] says=[pick(k, "[[phrase.what-is-the-weather-like]]", "[[phrase.today-it-is-sunny]]", "[[phrase.tomorrow-it-is-going-to-rain]]", "[[phrase.it-is-very-hot]]", "[[phrase.it-is-raining-and-cold]]", "[[phrase.it-is-not-windy]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "It is not windy.", "It is very hot.", "Today it is sunny.", "It is not windy.", "It is not windy.", "It is very hot."), pick(k, "What is the weather like?", "Today it is sunny.", "It is raining and cold.", "It is very hot.", "Tomorrow it is going to rain.", "It is not windy."), pick(k, "Tomorrow it is going to rain.", "It is raining and cold.", "It is very hot.", "Today it is sunny.", "It is raining and cold.", "Tomorrow it is going to rain."), pick(k, "It is raining and cold.", "Tomorrow it is going to rain.", "Tomorrow it is going to rain.", "Tomorrow it is going to rain.", "It is very hot.", "It is raining and cold.")] stack=column
    }
  }

  answer pick=pick(k, "What is the weather like?", "Today it is sunny.", "Tomorrow it is going to rain.", "It is very hot.", "It is raining and cold.", "It is not windy.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
