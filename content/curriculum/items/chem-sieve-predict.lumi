# A prediction from sizes: the holes are described against sand, rice and a pea, and the child
# decides which part is smaller than them.
item chem.sieve-predict v=1 skills=[chemistry.separating] {
  title "What will fall through?"
  difficulty k
  let k=0..5

  scene 31x16 {
    sieve s mixture=["{if k == 0 then \"pebbles\" else if k == 1 then \"sand\" else if k == 2 then \"peas\" else if k == 3 then \"pebbles\" else if k == 4 then \"rice\" else \"peas\"}", "{if k == 0 then \"sand\" else if k == 1 then \"flour\" else if k == 2 then \"rice\" else if k == 3 then \"rice\" else if k == 4 then \"sand\" else \"flour\"}"] holes=(if k == 0 then 2 else if k == 1 then 1 else if k == 2 then 3 else if k == 3 then 3 else if k == 4 then 2 else 2) shaken=0 names=1 at=canvas(1, 0)
    text ask "This sieve has {if k == 0 then \"holes bigger than sand but smaller than rice\" else if k == 1 then \"tiny holes, finer than sand\" else if k == 2 then \"holes bigger than rice but smaller than a pea\" else if k == 3 then \"holes bigger than rice but smaller than a pea\" else if k == 4 then \"holes bigger than sand but smaller than rice\" else \"holes bigger than sand but smaller than rice\"}. When it is shaken, what will fall through into the bowl?" width=16 right-of=s gap=1
    choice pick options=["{if k == 0 then \"pebbles\" else if k == 1 then \"sand\" else if k == 2 then \"dried peas\" else if k == 3 then \"pebbles\" else if k == 4 then \"rice\" else \"dried peas\"}", "{if k == 0 then \"sand\" else if k == 1 then \"flour\" else if k == 2 then \"rice\" else if k == 3 then \"rice\" else if k == 4 then \"sand\" else \"flour\"}"] stack=column below=ask gap=1
  }

  check chem.separate of=s pick=through
  hint "Which of the two is smaller? Is it smaller than the holes?"
  hint "Anything bigger than the holes stays in the sieve. Which one is that?"
}
