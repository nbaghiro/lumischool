# Chapter 2 of The Frozen Winter with its lines numbered. The answers are the line breaks of this
# text at width 34 (65 letters to a line), so the text and the width stay as they are.
item reading.which-line-tells v=1 skills=[reading.evidence, reading.comprehension] {
  title "Which line tells you?"
  difficulty pick(q, 1, 0, 2, 0)
  let q=0..3
  level easy {
    let q={1, 3}
  }
  level hard {
    let q={0, 2}
  }

  scene 35x37 {
    passage p title="Chapter 2: Breaking the ice" text="The boatmen tried everything. They struck the ice with poles and axes, but it froze again every night. They lit fires on the ice, and the fires only sank into little pits of black water that were white again by morning. They hitched six horses to an old iron icebreaker and dragged it along the canal, rocking it from side to side while the men on board shouted. At last it cracked a channel as far as the first lock and stuck fast. Mrs Pell, the lock-keeper, came out, looked at the ice and shook her head. The lock gates were frozen shut as well, and the paddles would not turn. That night the boatmen sat in the Lock Inn and nobody said a word. They had tried poles, axes, fire and horses, and the ice had beaten every one." width=34 at=canvas(1, 1)
    row bottom below=p gap=1 space=1 align=centre {
      canallock lock level=0 boat=0
      text ask "{pick(q, \"Which line tells you why the axes were no use?\", \"Which line tells you how far the icebreaker got?\", \"Which line shows that the boats could not have gone through the lock anyway?\", \"On which line are the first tools named?\")}" width=12
      number-input answer
    }
  }

  answer pick(q, 2, 7, 9, 1)
  feedback {
    when (answer == 4 and q == 0) point=p {
      say "That line is about the fires and the horses. Look for the words just after the axes that say what the ice did next."
    }
    when (answer == 8 and q == 2) point=p {
      say "Mrs Pell shaking her head shows she is worried, but not why. Read on to the next line."
    }
  }
  hint "Find the part of the chapter the question is about, then read the number beside it."
  hint "Check the line holds the words that answer it, not just the words near them."
}
