# The three-star: a fixed length of fence round a rectangle, and the most land it can hold. Trying
# fields in order shows the square wins: 400 m gives 1 ha, 600 m 2.25 ha, 800 m 4 ha.
item land.fence-most v=1 stars=3 skills=[measure.metric.hectares, reasoning.extremes] {
  title "The most land"
  difficulty (if p == 400 then 0 else if p == 800 then 1 else 2)
  let p={400, 600, 800}
  level easy {
    let p={400}
  }
  level hard {
    let p={600}
  }

  scene 36x16 {
    canallock lock level=0.5 boat=0 at=canvas(1, 1)
    text ask "A farmer has {p} m of fence to go round a rectangular field by the lock, with sides in whole tens of metres. What is the most land, in hectares, the fence can hold?" narrate width=17 right-of=lock gap=2
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=5
      text unit "ha"
    }
  }

  answer pick(p / 200 - 2, 1, 2.25, 4)
  feedback {
    when (answer < p * p / 160000 and answer > 0) point=lock {
      say "A field can hold more with the same fence. Try making the sides nearer the same length."
    }
    when (answer == p * p / 16) point=lock {
      say "That is the area in square metres. A hectare is 10,000 m²."
    }
  }
  hint "Try a field 10 m wide, then 50 m, then 100 m. What happens to the area?"
  hint "Half the fence is one length and one width. Which pair gives the most?"
}
