# The language to English: [[phrase.how-much-is-it]], [[phrase.it-costs-two-euros]], [[phrase.it-is-very-expensive]], [[phrase.it-is-cheap]], [[phrase.a-kilo-of-tomatoes-please]], [[phrase.how-much-are-the-strawberries]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.how-much-meaning v=1 skills=[language.market, language.numbers] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "gran", "boy", "girl", "boy", "girl")] says=[pick(k, "[[phrase.how-much-is-it]]", "[[phrase.it-costs-two-euros]]", "[[phrase.it-is-very-expensive]]", "[[phrase.it-is-cheap]]", "[[phrase.a-kilo-of-tomatoes-please]]", "[[phrase.how-much-are-the-strawberries]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "How much are the strawberries?", "It is cheap.", "It costs two euros.", "How much are the strawberries?", "How much are the strawberries?", "It is cheap."), pick(k, "How much is it?", "It costs two euros.", "A kilo of tomatoes, please.", "It is cheap.", "It is very expensive.", "How much are the strawberries?"), pick(k, "It is very expensive.", "A kilo of tomatoes, please.", "It is cheap.", "It costs two euros.", "A kilo of tomatoes, please.", "It is very expensive."), pick(k, "A kilo of tomatoes, please.", "It is very expensive.", "It is very expensive.", "It is very expensive.", "It is cheap.", "A kilo of tomatoes, please.")] stack=column
    }
  }

  answer pick=pick(k, "How much is it?", "It costs two euros.", "It is very expensive.", "It is cheap.", "A kilo of tomatoes, please.", "How much are the strawberries?")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
