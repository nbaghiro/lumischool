# The rule of tincture (Wikipedia): metal should not be put on metal, nor colour on colour, so a
# charge on a field must be a metal on a colour or a colour on a metal. The two wells hold the field
# and charge.
item art.arms-rule v=1 skills=[art.heraldry, reasoning.rules] {
  title "Does it keep the rule?"
  difficulty (if k <= 2 then 0 else 1)
  let k=0..5
  let field={pick(k, "blue", "yellow", "red", "green", "white", "black")}
  let charge={pick(k, "yellow", "red", "blue", "black", "yellow", "white")}
  let fname={pick(k, "azure", "Or", "gules", "vert", "argent", "sable")}
  let cname={pick(k, "Or", "gules", "azure", "sable", "Or", "argent")}
  let right={pick(k, "it keeps the rule", "it keeps the rule", "colour on colour", "colour on colour", "metal on metal", "it keeps the rule")}
  level easy {
    let k=0..2
  }
  level hard {
    let k=3..5
  }

  scene 36x28 {
    mixingtray tray wells=[field, charge] ring=-1 labels=true at=canvas(1, 1)
    text ask "Ana designs a shield for the market: a field of {fname}, the first well, with a charge of {cname}, the second well, on it. The rule of tincture says: no metal on metal and no colour on colour. Does her shield keep the rule?" narrate width=34 below=tray gap=1
    choice pick options=["it keeps the rule", "colour on colour", "metal on metal"] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=tray {
      say "Say whether {fname} is a metal or a colour, then the same for {cname}. Are they the same kind?"
    }
  }
  hint "The metals are Or and argent. Everything else here is a colour."
  hint "The rule is broken only when both are the same kind."
}
