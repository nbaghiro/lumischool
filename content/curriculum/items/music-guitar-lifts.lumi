# How many fingers leave the strings to change chords, which is what makes a change slow: a finger
# that stays does not lift, and nor does one that keeps its string and slides to another fret.
# The answers are lifted(changeOf(from, to)) in engine/sound/fretted.ts.
item music.guitar-lifts v=1 skills=[music.chord-changes] {
  title "Fingers off the strings"
  difficulty (if q <= 2 then 0 else if q == 5 or q == 6 then 2 else 1)
  let q=0..7
  let from={pick(q, "C", "Em", "E", "C", "G", "A", "D", "Am")}
  let to={pick(q, "Am", "E", "Em", "G", "D", "D", "E", "E")}
  let right={pick(q, 1, 0, 1, 3, 3, 2, 2, 3)}
  level easy {
    let q={0, 1, 3}
  }
  level hard {
    let q=4..7
  }

  scene 32x23 {
    row cards space=2 align=start at=canvas(1, 1) {
      chordbox a tuning=guitar chord=pick(q, "C", "Em", "E", "C", "G", "A", "D", "Am") frets=4 show=fingers name=true letters=false lit=[]
      chordbox b tuning=guitar chord=pick(q, "Am", "E", "Em", "G", "D", "D", "E", "E") frets=4 show=fingers name=true letters=false lit=[]
    }
    text ask "Ben changes from {from} to {to}. A finger that keeps its string can slide without lifting. How many fingers must he lift off the strings?" narrate width=22 below=cards gap=1
    number-input answer right-of=ask gap=1
  }

  answer right
  feedback {
    when (answer == 3 and right != 3) point=cards {
      say "Not every finger has to lift. Look for a finger that stays put, or one that keeps its string."
    }
    when (answer == 3 - right and right == 2) point=cards {
      say "Only one finger keeps its string, and it slides. The other two change string, so they lift."
    }
    when (answer == 0 and right == 1 and q == 2) point=cards {
      say "Finger 1 is not in {to} at all, so it has to come off the string."
    }
  }
  hint "Take each finger of {from}. Where does it go in {to}?"
  hint "A finger lifts when it changes string or is not needed. Count those."
}
