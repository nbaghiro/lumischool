# The story: the cloud islands, where the sky is watched from above the weather, and how many nights
# there are between one shape and the next.
item physics.clouds-moon-watch v=1 skills=[physics.sky, subtraction.to-twenty] {
  title "Watching from the cloud islands"
  difficulty gap
  let v=0..3
  let first={pick(v, "a new moon", "a half moon", "a new moon", "a growing crescent")}
  let later={pick(v, "a half moon", "a full moon", "a full moon", "a shrinking gibbous")}
  let gap={pick(v, 7, 7, 14, 14)}
  let k={pick(v, 2, 4, 4, 5)}
  level easy {
    let v=0..0
  }
  level hard {
    let v=3..3
  }

  scene 25x32 {
    orbit sky moon=k places=1 arrow=1 person=0 at=canvas(1, 0)
    text ask "From the cloud islands Mia sees {first} one night, and {later} some nights later. The moon takes about twenty nine and a half days to go round, so each quarter of the way takes about a week. About how many nights were there between them?" narrate width=24 below=sky gap=1
    number-input answer below=ask gap=1
  }

  answer answer=gap
  hint "Find both shapes on the ring, and count the places between them the way the arrow points."
  hint "Two places are a quarter of the way round, about a week of nights."
}
