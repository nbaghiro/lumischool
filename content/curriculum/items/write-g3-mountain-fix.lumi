# The unknown moves to the fixing card: the problem is given, and only one option solves it.
item writing.mountain-fix v=1 skills=[writing.planning, writing.story-structure] {
  title "The card that fixes it"
  difficulty (if s == 2 then 1 else 0)
  let s=0..2 p=0..2 ok={if s == 0 then "Dad opens an umbrella" else if s == 1 then "Gran brings a ladder" else "He builds a sand wall"} o1={if s == 0 then "Ben eats a sandwich" else if s == 1 then "Mia sings a song" else "Omar eats his lunch"} o2={if s == 0 then "A dog barks at a duck" else if s == 1 then "Mia buys an ice cream" else "A gull lands nearby"}

  scene 37x17 {
    listpad plan title="Story mountain" items=["{if s == 0 then \"Opening: a picnic in the park\" else if s == 1 then \"Opening: Mia's kite on a hill\" else \"Opening: Omar's sandcastle\"}", "{if s == 0 then \"Build-up: Ben lays out food\" else if s == 1 then \"Build-up: it flies higher\" else \"Build-up: he adds towers\"}", "{if s == 0 then \"Problem: it starts to rain\" else if s == 1 then \"Problem: it sticks in a tree\" else \"Problem: the sea creeps closer\"}", "Fixing it: ?", "{if s == 0 then \"Ending: they eat, snug and dry\" else if s == 1 then \"Ending: the kite flies again\" else \"Ending: the castle stays up\"}"] count=0 width=19 ticks=false at=canvas(1, 1)
    column right right-of=plan gap=1 space=1 align=start {
      text ask "Which note goes on the fixing card?" width=15
      choice pick options=["{if p == 0 then ok else if p == 1 then o1 else o2}", "{if p == 0 then o1 else if p == 1 then o2 else ok}", "{if p == 0 then o2 else if p == 1 then ok else o1}"] stack=column
    }
  }

  answer pick=ok
  hint "What went wrong at the top of the mountain?"
  hint "Which note makes that problem go away?"
}
