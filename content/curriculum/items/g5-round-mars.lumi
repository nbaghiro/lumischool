# Rounding a nine-digit distance to the nearest million or ten million.
item place.round-mars v=1 skills=[place-value.rounding, place-value.large-numbers] {
  title "Round the distance"
  difficulty ((if u == "ten million" then 1 else 0) + (if t >= 5 then 1 else 0))
  let a={227, 149, 384, 778} t={1, 3, 6, 8} u={"million", "ten million"}
  where (not (a == 149 and u == "ten million"))
  level easy {
    let u={"million"} t={1, 3}
  }
  level hard {
    let u={"ten million"} t={6, 8}
  }

  scene 33x10 {
    telescope scope tilt=30 at=canvas(1, 1)
    text ask "A planet was {thousands((1000 * a + 100 * t + 40) * 1000)} km from the observatory's telescope. Round the distance to the nearest {u} kilometres." narrate width=20 right-of=scope gap=2
    number-input answer width=11 below=ask gap=1
  }

  answer (if u == "million" then 1000000 * round((1000 * a + 100 * t + 40) / 1000) else 10000000 * round((1000 * a + 100 * t + 40) / 10000))
  feedback {
    when (u == "ten million" and answer == 1000000 * round((1000 * a + 100 * t + 40) / 1000)) point=ask {
      say "That is to the nearest million. The nearest ten million ends in seven zeros."
    }
    when (answer == 1000000 * a and t >= 5 and u == "million") point=ask {
      say "The hundred thousands digit is {t}, which is five or more, so round up."
    }
  }
  hint "Which two {u}s does the distance sit between?"
  hint "Look at the digit just after the {u}s place."
}
