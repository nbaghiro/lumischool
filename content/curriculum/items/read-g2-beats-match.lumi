# Pairing each word with its number of beats, where the long words and the short ones are mixed up.
item reading.beats-match v=1 skills=[reading.syllables] {
  title "Match the beats"
  let k=0..3

  scene 23x13 {
    text ask "Clap each word. Write the number of its match." narrate width=22 at=canvas(1, 1)
    match m left=[if k == 0 then "bread" else if k == 1 then "open" else if k == 2 then "idea" else "lemon", if k == 0 then "tiger" else if k == 1 then "strong" else if k == 2 then "crisp" else "hospital", if k == 0 then "banana" else if k == 1 then "animal" else if k == 2 then "garden" else "string"] right=[if k == 0 then "2 beats" else if k == 1 then "3 beats" else if k == 2 then "1 beat" else "1 beat", if k == 0 then "3 beats" else if k == 1 then "1 beat" else if k == 2 then "2 beats" else "3 beats", if k == 0 then "1 beat" else if k == 1 then "2 beats" else if k == 2 then "3 beats" else "2 beats"] blanks=[a, b, c] below=ask gap=1
  }

  answer a=(if k == 0 then 3 else if k == 1 then 3 else if k == 2 then 3 else 3) b=(if k == 0 then 1 else if k == 1 then 2 else if k == 2 then 1 else 2) c=(if k == 0 then 2 else if k == 1 then 1 else if k == 2 then 2 else 1)
  hint "Clap the first word. Then find how many beats that is on the right."
  hint "Do not go by how long the word looks. Say it and clap."
}
