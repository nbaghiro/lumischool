item k.frog-in-order v=1 stars=3 skills=[nature.life-cycles, reasoning.order] {
  title "A frog's life in order"

  scene 30x18 {
    text q "Put a frog's life in order. Write 1, 2, 3 and 4." narrate width=28 at=canvas(1, 1)
    sequence s items=["froglet with legs", "frogspawn", "frog", "tadpole"] blanks=[p, q, r, t] below=q gap=1
  }

  answer p=3 q=1 r=4 t=2
  hint "What does a frog lay in the pond?"
}
