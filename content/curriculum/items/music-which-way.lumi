# Which way along the keys for a higher or a lower note than the ringed one.
item music.which-way v=1 skills=[music.pitch, music.keys] {
  title "Which way?"
  difficulty w
  let w=0..1 k=0..2
  let key={pick(k, "E", "G", "D")}
  let want={pick(w, "higher", "lower")}
  level easy {
    let w=0..0
  }
  level hard {
    let w=1..1
  }

  scene 30x17 {
    chimebars keys bars=8 letters=1 at=canvas(1, 1)
    text ask "Ben has just played the bar {key}. He wants a note that sounds {want}. Which way along the bars does he go?" narrate width=28 below=keys gap=1
    choice pick options=["to the right", "to the left"] below=ask gap=1
  }

  answer pick=(if w == 0 then "to the right" else "to the left")
  feedback {
    when (pick != (if w == 0 then "to the right" else "to the left")) point=keys {
      say "Play {key}, then the bar on each side of it. Which side sounds {want}?"
    }
  }
  hint "Try it: play {key}, then the bar to its right, then the bar to its left."
  hint "To the right the bars get shorter and the notes go up; to the left they go down."
}
