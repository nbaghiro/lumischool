# Sea water holds about 35 g of salt in each litre (NOAA), which is 3.5 g in each 100 ml: between the
# 0 g and 5 g rows of the brine table, so it freezes between 0 °C and −3 °C, at about −2 °C. The
# unknown is the salt in a jugful or the sea water that holds some salt.
item chem.sea-salt-freeze v=1 skills=[chemistry.freezing, ratio.scaling] {
  title "How salty is the sea?"
  difficulty (w * 2 + (if v <= 400 then 0 else 1))
  let w=0..1 v={200, 400, 600, 800}
  let salt={35 * v / 1000}
  where (w == 0 or v != 200)
  level easy {
    let w=0..0 v={200, 400}
  }
  level hard {
    let w=1..1
  }

  scene 36x13 {
    jug j max=1000 step=200 level=(if w == 0 then v else 0) unit=ml at=canvas(1, 0)
    text ask "Leo fills a jug from the sea by the ice shelf. Every litre, 1000 ml, of sea water has about 35 g of salt in it. {if w == 0 then \"How many grams of salt are in his jug?\" else \"Mei needs water with \"}{if w == 0 then \"\" else salt}{if w == 0 then \"\" else \" g of sea salt in it for a test. How many millilitres of sea water hold that much?\"}" narrate width=23 right-of=j gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then salt else v)
  feedback {
    when (answer == 35) point=j {
      say "35 g is in a whole litre. How much of a litre is in the jug?"
    }
    when (w == 1 and answer == salt) point=j {
      say "That is the salt. The question asks how much sea water holds it."
    }
  }
  hint "{if w == 0 then \"What part of a litre is in the jug? Read its level.\" else \"How many grams of salt are in 200 ml, one fifth of a litre?\"}"
  hint "{if w == 0 then \"Find the salt in 200 ml first: that is one fifth of a litre.\" else \"How many lots of that make the salt she needs?\"}"
}
