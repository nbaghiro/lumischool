# One pan: ice warms, stays at 0 while it melts, the water warms, and stays at 100 while it boils.
# Both curves keep to the lesson's rule: ice warms twice as fast as water, and the melt lasts as long
# as warming the water 80 degrees (334 J against 4.18 J a gram). Boiling lasts over five times the
# warm from 0 to 100, so ten readings show either the ice warming (c=0) or the boil (c=1), not both.
item chem.pan-states v=1 skills=[chemistry.heating, chemistry.states, data.line-graph] {
  title "What is in the pan?"
  difficulty (if p == 1 or p == 3 then 0 else 1)
  let c=0..1 p=0..3
  let e={pick(c, 2, 3)}
  let m={if p == 0 then if c == 0 then 2 * e else e else if p == 1 then if c == 0 then 7 * e else 3 * e else if p == 2 then 7 * e else 1}
  where (not (p == 2 and c == 0) and not (p == 3 and c == 1))
  let right={pick(p, "Ice and water together", "Only water, getting warmer", "Water boiling into steam", "Only ice, getting warmer")}
  level easy {
    let p=1..3
  }
  level hard {
    let p=0..2
  }

  scene 35x39 {
    heatcurve curve temps=[pick(c, -40, 0), 0, 0, pick(c, 0, 40), pick(c, 0, 80), pick(c, 0, 100), pick(c, 20, 100), pick(c, 40, 100), pick(c, 60, 100), pick(c, 80, 100)] every=e min=(if c == 0 then -40 else 0) max=(if c == 0 then 80 else 120) step=20 at=canvas(1, 0)
    text ask "Ice from the water butt was heated in a pan by a grown-up, and the temperature read every {e} minutes. What is in the pan at minute {m}?" narrate width=34 below=curve gap=1
    choice pick options=["Only ice, getting warmer", "Ice and water together", "Only water, getting warmer", "Water boiling into steam"] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (p == 0 and pick == "Only ice, getting warmer") point=curve {
      say "At minute {m} the line is flat at 0. The ice is melting there, so water has already appeared beside it."
    }
    when (p == 2 and pick == "Only water, getting warmer") point=curve {
      say "At minute {m} the line is flat at 100. The water is no longer getting warmer: it is boiling."
    }
  }
  hint "Find minute {m} along the bottom, then go up to the line. Is the line climbing or flat there?"
  hint "What temperature is the line at? What happens to water at that temperature?"
}
