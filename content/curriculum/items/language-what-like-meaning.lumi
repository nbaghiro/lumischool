# The language to English: [[phrase.what-is-your-sister-like]], [[phrase.she-is-tall-and-kind]], [[phrase.she-has-blue-eyes]], [[phrase.he-wears-glasses]], [[phrase.my-father-is-short]], [[phrase.she-has-long-blonde-hair]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.what-like-meaning v=1 skills=[language.describing] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "boy", "girl", "girl", "gran", "boy", "gran")] says=[pick(k, "[[phrase.what-is-your-sister-like]]", "[[phrase.she-is-tall-and-kind]]", "[[phrase.she-has-blue-eyes]]", "[[phrase.he-wears-glasses]]", "[[phrase.my-father-is-short]]", "[[phrase.she-has-long-blonde-hair]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "She has long blonde hair.", "He wears glasses.", "She is tall and kind.", "She has long blonde hair.", "She has long blonde hair.", "He wears glasses."), pick(k, "What is your sister like?", "She is tall and kind.", "My father is short.", "He wears glasses.", "She has blue eyes.", "She has long blonde hair."), pick(k, "She has blue eyes.", "My father is short.", "He wears glasses.", "She is tall and kind.", "My father is short.", "She has blue eyes."), pick(k, "My father is short.", "She has blue eyes.", "She has blue eyes.", "She has blue eyes.", "He wears glasses.", "My father is short.")] stack=column
    }
  }

  answer pick=pick(k, "What is your sister like?", "She is tall and kind.", "She has blue eyes.", "He wears glasses.", "My father is short.", "She has long blonde hair.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
