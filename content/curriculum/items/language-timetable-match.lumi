# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.timetable-match v=1 skills=[language.school, language.time] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[subject.maths]]", "[[subject.history]]", "[[subject.the-teacher]]"), pick(k, "[[subject.science]]", "[[subject.geography]]", "[[subject.the-lesson]]"), pick(k, "[[subject.music]]", "[[subject.english]]", "[[subject.break-time]]"), pick(k, "[[subject.art]]", "[[subject.pe]]", "[[subject.the-timetable]]")] right=[pick(k, "music", "PE", "break time"), pick(k, "maths", "history", "the teacher"), pick(k, "science", "geography", "the timetable"), pick(k, "art", "English", "the lesson")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
