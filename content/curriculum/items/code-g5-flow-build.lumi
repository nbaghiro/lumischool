# The build task: the flowchart of the rover's climb has one shape rubbed off, and the path between
# the rocks shows what it was. Three slots are too few for the steps written out one by one, so the
# program needs the loop the flowchart draws.
item coding.flow-build v=1 skills=[coding.flowcharts, coding.repetition, coding.sequences] {
  title "Build what the flowchart draws"
  difficulty k
  let k=0..2
  let n={pick(k, 3, 2, 4)} a={pick(k, 2, 3, 2)}
  level easy {
    let k={0, 1}
  }
  level hard {
    let k={2}
  }

  scene 36x35 {
    text ask "The rover climbs from the observatory door to the flag on the star cliffs. Its flowchart has one shape rubbed off. Build the program the flowchart draws, so the rover reaches the flag." width=34 at=canvas(0, 0)
    flowchart f code=["repeat {n}", "  right {a}", "  down 1"] blank=pick(k, 2, 3, 1) below=ask gap=1
    maze m cols=(n * a + 1) rows=(n + 1) col=1 row=1 face=right flag=[n * a + 1, n + 1] rocks=[pick(k, 4, 5, 4), pick(k, 1, 1, 1), pick(k, 5, 6, 5), pick(k, 1, 1, 1), pick(k, 1, 7, 1), pick(k, 2, 1, 2), pick(k, 2, 1, 2), pick(k, 2, 2, 2), pick(k, 6, 2, 6), pick(k, 2, 2, 2), pick(k, 7, 3, 7), pick(k, 2, 2, 2), pick(k, 3, 4, 3), pick(k, 3, 3, 3), pick(k, 4, 5, 4), pick(k, 3, 3, 3), pick(k, 5, 6, 8), pick(k, 4, 3, 3), pick(k, 6, 5, 9), pick(k, 4, 1, 3), pick(k, 4, 5, 5), pick(k, 1, 1, 4), pick(k, 4, 5, 6), pick(k, 1, 1, 4), pick(k, 4, 5, 7), pick(k, 1, 1, 5), pick(k, 4, 5, 8), pick(k, 1, 1, 5)] right-of=f gap=2

    codepad answer tray=["right 1", "down 1", "repeat 2"] lines=3 key=["repeat {n}", "  right {a}", "  down 1"] below=m gap=1
  }

  check coding.builds of=m goal=flag
  hint "Follow the path between the rocks. What does the rover do again and again?"
  hint "The arrow up the left side of the flowchart is a repeat. Which blocks go inside it, and how many times does it go round?"
}
