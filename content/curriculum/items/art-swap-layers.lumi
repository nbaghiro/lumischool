# Finding the mistake: two layers painted in the wrong order of lightness.
item art.swap-layers v=1 skills=[art.space, art.tints, reasoning.find-the-mistake] {
  title "Which two layers are wrong?"
  difficulty (if k == 2 then 1 else 0)
  let k=0..2

  scene 34x12 {
    text ask "Ada painted the far hills green and {if k == 0 then 1 else 4} white, the middle hills green and {if k == 0 then 4 else if k == 1 then 0 else 1} white, and the near field green and {if k == 1 then 1 else if k == 2 then 4 else 0} white. Two layers have each other's paint. Which two?" width=17 at=canvas(1, 1)
    choice pick options=["far and middle", "middle and near", "far and near"] stack=column right-of=ask gap=2
  }

  answer pick=(if k == 0 then "far and middle" else if k == 1 then "middle and near" else "far and near")
  hint "Which layer should have the most white, and which the least?"
  hint "Put the three paints in order from palest to darkest. Which two are in the wrong places?"
}
