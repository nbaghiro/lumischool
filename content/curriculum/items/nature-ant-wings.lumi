# The two-star reason: someone decides whether a creature is an insect by the wrong thing (wings, or
# legs and living in the grass), and the reply that settles it is the body plan: three parts with six
# legs on the thorax. The other replies are true of the creature but decide nothing.
item nature.ant-wings v=1 stars=2 skills=[nature.insects, reasoning.explain] {
  title "What settles it?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..3
  let claim={pick(k, "Ben says the ant cannot be an insect, because it has no wings.", "Ben says the spider must be an insect, because it is small, it has legs and it lives in the grass.", "Ben says the ladybird cannot be an insect, because its back is hard and its wings are hidden under it.", "Ben says the snail must be an insect, because it is small and it lives under the leaves with the beetles.")}
  let right={pick(k, "Three body parts, six legs on the middle one", "Two body parts, eight legs on the front one", "Three body parts, six legs on the middle one", "No legs at all, and no body in three parts")}
  let o1={pick(k, "It lives in a nest with many other ants", "It spins a web to catch flies", "It has spots on its back", "It carries a shell on its back")}
  let o2={pick(k, "It carries crumbs home", "It has eyes on its head", "It walks on the ground", "It comes out after rain")}
  let x1={pick(k, right, o1, o1, o2)}
  let x2={pick(k, o1, o2, right, o1)}
  let x3={pick(k, o2, right, o2, right)}
  level easy {
    let k={0}
  }
  level hard {
    let k=2..3
  }

  scene 36x32 {
    row all at=canvas(1, 1) space=2 align=end {
      parts bug of=insect
      minibeasts four kinds=["ant", "spider", "ladybird", "snail"] legs=false
    }
    text ask "{claim} Ada says that is not how to tell. Which fact settles whether it is an insect?" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=bug {
      say "That is true, but other creatures do it too, insects and not insects. What does every insect's body have?"
    }
  }
  hint "Look at Ada's insect drawing. What is the same for every insect?"
  hint "Count the body parts and the legs on the creature, and see which part the legs join."
}
