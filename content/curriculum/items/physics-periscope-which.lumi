item physics.periscope-which v=1 skills=[physics.light] stars=1 {
  title "Which periscope works?"
  let w=0..1 t=5..6

  scene 33x17 {
    row two at=canvas(1, 0) space=2 align=start {
      periscope a tall=t flip=w show=0 tag="A"
      periscope b tall=t flip=(1 - w) show=0 tag="B"
    }
    text ask "Which periscope lets the child see the bird?" width=20 below=two gap=1
    choice pick options=["A", "B"] right-of=ask gap=2
  }

  check physics.light of=a vs=b pick=works
  hint "Draw the light from the bird. At each mirror it turns. Does it end at the eye?"
}
