# A truth table: every way two yes-or-no questions can come out, one row each, four rows in all. The
# child works the condition on every row and counts the rows that say open; with not, and and or
# the count is 1 or 3, never 2.
item coding.not-table v=1 skills=[coding.logic, coding.decisions, reasoning.all-the-ways] {
  title "Every row of the table"
  difficulty pick(k, 0, 1, 0.5, 1.5, 2)
  let k=0..4
  level easy {
    let k=0..1
  }
  level hard {
    let k=3..4
  }

  scene 36x24 {
    row top at=canvas(1, 0) space=2 align=start {
      table tt cols=3 head=["windy", "flood", "open?"] cells=["yes", "yes", "", "yes", "no", "", "no", "yes", "", "no", "no", ""]
      waterwheel ww paddles=8 lit=0
    }
    text ask "The mill's gate has a rule: open when {pick(k, \"not windy and not flood\", \"not windy or flood\", \"not windy and flood\", \"windy or not flood\", \"not windy or not flood\")}. Windy means the wind is high, and flood means the river is high. The table has a row for every way the two can come out. In how many of the four rows does the gate open?" narrate width=34 below=top gap=1
    number-input answer width=3 below=ask gap=1
  }

  answer pick(k, 1, 3, 1, 3, 3)
  feedback {
    when (answer == 2) point=tt {
      say "Work the rule on each row in turn, yes or no, and count the yeses again."
    }
    when (answer == 4 - pick(k, 1, 3, 1, 3, 3)) point=tt {
      say "That counts the rows where the gate stays shut."
    }
  }
  hint "Take the first row: windy yes, flood yes. What does not windy say there?"
  hint "Write open or shut in every row, then count the opens."
}
