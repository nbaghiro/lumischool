# Some of the numbers look prime and are not (51, 57, 91), which is the audit's raise: an odd
# number that is not in the times tables a child knows by heart still has to be tried.
item number.is-prime v=2 skills=[number.primes] {
  title "Prime or not"
  difficulty n
  let n={7, 9, 11, 15, 17, 21, 23, 25, 29, 39, 51, 57, 91}
  level easy {
    let n={7, 9, 11, 17, 21, 25}
  }
  level hard {
    let n={23, 29, 51, 57, 91}  # 51, 57 and 91 look prime and are not
  }

  scene 34x12 {
    fan cards show="{n}" cards=5 at=canvas(1, 1)
    text ask "Can {n} counters make a rectangle with more than one row, and more than one in each row? If not, {n} is prime." width=20 right-of=cards gap=1
    choice pick options=["prime", "not prime"] below=ask gap=1
  }

  answer pick=(if n in {7, 11, 17, 23, 29} then "prime" else "not prime")
  feedback {
    when (n == 9 and pick == "prime") point=cards {
      say "Nine makes three rows of three, so it is not prime."
    }
    when (n == 91 and pick == "prime") point=cards {
      say "91 is 7 rows of 13, so it is not prime."
    }
    when ((n == 51 or n == 57 or n == 39) and pick == "prime") point=cards {
      say "Try 3 rows. Add the digits of {n}: they make a multiple of 3."
    }
  }
  hint "Try 2 rows, then 3 rows, then 5 rows, then 7. Does any of them come out exactly?"
  hint "A prime has no factors except one and itself."
}
