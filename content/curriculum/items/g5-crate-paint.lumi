# The crate drawn whole rather than opened: the child sees three faces and has to count the three
# hidden ones.
item solids.crate-paint v=1 skills=[solids.surface-area] {
  title "Painting a crate"
  difficulty ((l * w + l * h + w * h) / 10)
  let l=4..7 w=2..4 h=2..5
  where (l > w and w != h and l != h)
  level easy {
    let l=4..5 w={2} h=3..4
  }
  level hard {
    let l=6..7 w={3, 4} h=4..5
  }

  scene 36x26 {
    cubestack crate l=l w=w h=h outline=1 edges=1 unit="dm" at=canvas(1, 1)
    text ask "A narrowboat carries this crate. Every face is painted, the bottom too. A decimetre is 10 cm. How many square decimetres does the paint cover?" narrate width=34 below=crate gap=1
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=5
      text unit "dm²"
    }
  }

  answer (2 * (l * w + l * h + w * h))
  feedback {
    when (answer == l * w + l * h + w * h) point=crate {
      say "Those are the three faces you can see. Three more face away from you."
    }
    when (answer == l * w * h) point=crate {
      say "That counts the cubes inside. The paint covers the faces outside."
    }
  }
  hint "Which three faces can you see? Which three are hidden?"
  hint "Each hidden face matches the one opposite it."
}
