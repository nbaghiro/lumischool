# Two-star: the turn at a corner depends only on how many corners there are, not on how long the
# sides are, so a small shape with few sides turns more than a big one with many.
item coding.poly-size v=1 stars=2 skills=[coding.drawing, angles.turns, reasoning.compare] {
  title "Which turns more?"
  difficulty k
  let k=0..2
  let na={pick(k, 6, 8, 3)} sa={pick(k, 1, 2, 1)} ca={pick(k, 3, 7, 3)} ra={pick(k, 3, 6, 3)} xa={pick(k, 2, 3, 2)}
  let nb={pick(k, 6, 5, 6)} sb={pick(k, 2, 1, 3)} cb={pick(k, 6, 3, 8)} rb={pick(k, 5, 3, 7)} xb={pick(k, 3, 2, 3)}
  level easy {
    let k={0}
  }
  level hard {
    let k=1..2
  }

  scene 36x26 {
    row both at=canvas(1, 0) space=2 align=end {
      column ca space=0 align=start {
        text la "A"
        turtle ta cols=ca rows=ra col=xa row=ra face=right moves=["repeat {na}", "  forward {sa}", "  turn left {360 / na}"] mark=false
      }
      column cb space=0 align=start {
        text lb "B"
        turtle tb cols=cb rows=rb col=xb row=rb face=right moves=["repeat {nb}", "  forward {sb}", "  turn left {360 / nb}"] mark=false
      }
    }
    text ask "The turtle drew both shapes. At which does it turn more at each corner?" width=34 below=both gap=1
    choice pick options=["A", "B", "Both the same"] below=ask gap=1
  }

  answer pick=pick(k, "Both the same", "B", "A")
  hint "Does the length of a side change how far the turtle turns at a corner?"
  hint "Count the corners of each shape, and share 360 among them."
}
