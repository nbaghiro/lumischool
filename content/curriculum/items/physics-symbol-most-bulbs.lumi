# Three stars: loop A is drawn, and loop B has four cells; the most bulbs B can have with each still
# at least as bright as A's is four divided by A's cells per bulb, rounded down.
item physics.symbol-most-bulbs v=1 stars=3 skills=[physics.circuits, reasoning.extremes, reasoning.constraints] {
  title "As many bulbs as possible"
  difficulty v
  let v=0..3
  let c={pick(v, 2, 1, 3, 4)}
  let b={pick(v, 1, 1, 2, 3)}
  let most={pick(v, 2, 4, 2, 3)}
  level easy {
    let v=0..0
  }
  level hard {
    let v=3..3
  }

  scene 36x13 {
    series a cells=c bulbs=b closed=1 symbols=1 tag="A" at=canvas(1, 0)
    text ask "Loop B has 4 cells. What is the most bulbs it can have, with every bulb at least as bright as the bulbs in loop A?" narrate width=12 right-of=a gap=1
    number-input answer below=ask gap=1
  }

  answer most
  feedback {
    when (answer == most + 1) point=a {
      say "Check that many: 4 cells shared among {most + 1} bulbs gives each less than the bulbs in A get."
    }
  }
  hint "How many cells does each bulb in A get?"
  hint "Share B's cells so each bulb gets at least that much. How many bulbs can share them?"
}
