# Four steps of a snack, muddled, numbered into the order a robot must follow. Each set has one
# order only, since every later step needs an earlier one done.
item coding.snack-order v=1 skills=[coding.sequences, coding.algorithms] {
  title "Put the steps in order"
  let s=0..3
  let snack={pick(s, "a jam sandwich", "toast", "hot cocoa", "a fruit bowl")}
  let i1={pick(s, "Spread jam on one slice", "Take the toast out", "Stir cocoa into the hot milk", "Pour yoghurt over the fruit")}
  let i2={pick(s, "Cut the sandwich in half", "Put the bread in the toaster", "Let the cocoa cool a little", "Cut the apple into pieces")}
  let i3={pick(s, "Take two slices of bread", "Spread butter on the toast", "Pour milk into a mug", "Put the pieces in a bowl")}
  let i4={pick(s, "Put the other slice on top", "Push the lever down", "Warm the milk for one minute", "Wash the apple")}

  scene 32x18 {
    text ask "Pip's steps for {snack} got muddled. Number them in the order the robot must do them." narrate width=30 at=canvas(1, 1)
    sequence steps items=["{i1}", "{i2}", "{i3}", "{i4}"] blanks=[a, b, c, d] below=ask gap=1
  }

  answer a=pick(s, 2, 3, 3, 4) b=pick(s, 4, 1, 4, 2) c=pick(s, 1, 4, 1, 3) d=pick(s, 3, 2, 2, 1)
  hint "Which step can happen before all the others? That is number 1."
  hint "For each step, ask what must already be done."
}
