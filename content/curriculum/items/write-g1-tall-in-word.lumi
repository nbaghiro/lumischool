# The audit's raise for how-many-tall: the word is a picture, not letters, so the child spells it
# in their head and then thinks about each letter's height. The first letter and the length are
# given, so a bicycle cannot be read as a bike. No word has a t, because the drawn t stops short of
# the top line and would make the count arguable.
item writing.tall-in-word v=2 skills=[writing.letter-formation, writing.spelling] {
  title "Tall letters in a word"
  difficulty (if k == 2 then 2 else if k == 4 then 1 else 0)
  let k=0..4
  level easy {
    let k={0, 1, 3}  # cup, sun, owl: three letters, none tall
  }
  level hard {
    let k={2, 4}  # bicycle and pencil
  }
  let w={if k == 0 then "cup" else if k == 1 then "sun" else if k == 2 then "bicycle" else if k == 3 then "owl" else "pencil"}
  let first={if k == 0 then "c" else if k == 1 then "s" else if k == 2 then "b" else if k == 3 then "o" else "p"}
  let n={if k <= 1 then 3 else if k == 2 then 7 else if k == 3 then 3 else 6}

  scene 32x13 {
    column q at=canvas(1, 1) space=1 align=start {
      text word "It starts with {first} and has {n} letters." width=16
      text ask "Say the word for the picture. How many of its letters are tall?" width=16
      number-input answer
    }
    art pic asset="{w}" right-of=q gap=2
  }

  answer (if k <= 1 then 0 else if k == 2 then 2 else 1)
  feedback {
    when (answer == n) point=pic {
      say "That is every letter in the word. Count only the ones that reach the top line."
    }
    when (k == 0 and answer == 1) point=pic {
      say "The p goes down below the line. That is a tail, not a tall letter."
    }
  }
  hint "Say the word slowly. Which letters do you need to write it?"
  hint "Which of those letters reach up to the top line, like b, d, h, k and l?"
}
