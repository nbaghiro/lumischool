item coding.sort-swaps v=1 skills=[coding.algorithms] {
  title "How many swaps?"
  difficulty (if k == 1 then 0 else if k == 0 then 1 else 2)
  let k=0..2

  scene 24x17 {
    sortcards c cards=[if k == 0 then 4 else if k == 1 then 2 else 6, if k == 0 then 3 else if k == 1 then 5 else 4, if k == 0 then 2 else if k == 1 then 1 else 5, if k == 0 then 1 else if k == 1 then 6 else 1] compare=0 swap=false at=canvas(1, 0)
    text ask "How many swaps does the first pass make?" width=16 below=c gap=1
    number-input answer right-of=ask gap=1
  }

  check coding.runs of=c answer=swaps
  hint "Go along in pairs from the left. Count a swap each time the bigger card comes first."
}
