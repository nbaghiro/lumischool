# The last block is hidden and has to be worked out from where the flag is. The checker proves that
# only the number in that block, and no change to any other block, reaches the flag.
item coding.turn-gap v=1 skills=[coding.tracing, coding.sequences] {
  title "The number in the gap"
  difficulty (a + b)
  let a=1..3 b=1..2 t=0..1
  level easy {
    where (a + b <= 3)
  }
  level hard {
    where (a + b >= 4)
  }

  scene 33x16 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks bl code=["forward {a}", "turn {if t == 0 then \"left\" else \"right\"}", "forward {3 - b}"] blank=3
      maze g cols=5 rows=5 col=1 row=3 face=right flag=[1 + a, if t == 0 then 3 - b else 3 + b] code=["forward {a}", "turn {if t == 0 then \"left\" else \"right\"}", "forward {3 - b}"] upto=0 trail=none
    }
    text ask "What number in the last block takes the robot to the flag?" width=27 below=top gap=1
    number-input answer right-of=ask gap=1
  }

  check coding.runs of=g goal=flag answer=fix
  hint "Where is the robot after the first two blocks, and which way is it facing?"
  hint "Count the squares from there to the flag."
}
