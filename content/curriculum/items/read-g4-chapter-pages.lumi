# Chapter lengths come from where the next chapter starts, and two chapters together from the
# start of the first to the start of the one after the second.
item reading.chapter-pages v=1 skills=[reading.text-features] {
  title "How many pages?"
  difficulty j
  let k=0..3 j=1..2 s1={if k == 0 then 3 else if k == 1 then 2 else if k == 2 then 4 else 3} s2={if k == 0 then 8 else if k == 1 then 7 else if k == 2 then 9 else 9} s3={if k == 0 then 14 else if k == 1 then 12 else if k == 2 then 15 else 13} s4={if k == 0 then 19 else if k == 1 then 18 else if k == 2 then 20 else 18}
  level easy {
    let j={1}
  }
  level hard {
    let j={2}
  }

  scene 36x15 {
    row top at=canvas(1, 1) space=2 align=start {
      contents page title=Contents book="{if k == 0 then \"All about volcanoes\" else if k == 1 then \"All about whales\" else if k == 2 then \"All about lighthouses\" else \"All about the moon\"}" entries=[if k == 0 then "How a volcano forms" else if k == 1 then "Kinds of whale" else if k == 2 then "The first lights" else "Moon phases", if k == 0 then "When it erupts" else if k == 1 then "What whales eat" else if k == 2 then "Life of a keeper" else "Craters and seas", if k == 0 then "Famous volcanoes" else if k == 1 then "Whale songs" else if k == 2 then "Storms and wrecks" else "Walking on the moon", if k == 0 then "Living nearby" else if k == 1 then "Baby whales" else if k == 2 then "Lighthouses today" else "Moon myths"] pages=[if k == 0 then 3 else if k == 1 then 2 else if k == 2 then 4 else 3, if k == 0 then 8 else if k == 1 then 7 else if k == 2 then 9 else 9, if k == 0 then 14 else if k == 1 then 12 else if k == 2 then 15 else 13, if k == 0 then 19 else if k == 1 then 18 else if k == 2 then 20 else 18] blank=-1
      column q space=1 align=start {
        text ask "How many pages long are the {if j == 1 then \"first\" else \"middle\"} two chapters together?" width=12
        number-input answer
      }
    }
  }

  answer (if j == 1 then s3 - s1 else s4 - s2)
  feedback {
    when (answer == (if j == 1 then s3 - s1 + 1 else s4 - s2 + 1)) point=page {
      say "The next chapter's first page is not part of these two. Stop one page before it."
    }
    when (answer == (if j == 1 then s2 - s1 else s3 - s2)) point=page {
      say "That is only one chapter. Keep going to the end of the second."
    }
  }
  hint "On which page does the first of the two chapters start?"
  hint "Where does the chapter after them start? The two chapters fill the pages in between."
}
