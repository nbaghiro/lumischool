# The second reasoning question in the core: which move took the shape to its image. A reflection
# flips the shape over, a half turn and a slide do not, and a slide keeps it pointing the same way.
item quadrant.which-move v=1 skills=[position.transformations, reasoning.classify] {
  title "Which move was it"
  difficulty (if t == 0 then 0 else if t == 3 then 2 else 1)
  let t=0..3 s=1..3
  level easy {
    let t={0, 1}
  }
  level hard {
    let t={2, 3}
  }

  scene 36x25 {
    moveshape m max=4 shape=s x=1 y=1 move=pick(t, "translate", "reflect", "reflect", "rotate") dx=-5 dy=-5 mirror=pick(t, "y", "y", "x", "y") turn=180 image=1 names=0 at=canvas(1, 1)
    text ask "A panel on the base plan is moved to the new place drawn: a slide, a flip in an axis, or a half turn about (0, 0). Which move was it?" narrate width=13 right-of=m gap=2
    choice pick options=["a slide", "a flip", "a half turn"] stack=column below=ask gap=1
  }

  answer pick=pick(t, "a slide", "a flip", "a flip", "a half turn")
  feedback {
    when (t == 3 and pick == "a flip") point=m {
      say "A reflection flips the shape over. Look at the image: has it been flipped, or turned all the way round?"
    }
    when (t != 3 and t != 0 and pick == "a half turn") point=m {
      say "A half turn keeps the shape the right way round, only upside down. Is this image a mirror picture of the shape?"
    }
  }
  hint "Is the image the same way round as the shape, or flipped over?"
  hint "Which axis, if any, sits exactly halfway between the shape and its image?"
}
