# The two-star reason: Ben's chord written in tab as one stack, against its card, with one number on
# the wrong fret, so that string would sound the wrong note. Hard leaves the string names off the tab,
# so the child has to know that the top line is string 1.
item music.guitar-wrong-finger v=1 stars=2 skills=[music.chord-boxes, music.tab, reasoning.find-the-error] {
  title "One number is wrong"
  difficulty (if c == 2 then 1 else 0)
  let c=0..2 w=0..2
  let chord={pick(c, "C", "G", "D")}
  let stack={pick(c * 3 + w, "s1f0_s2f2_s3f0_s4f2_s5f3", "s1f0_s2f1_s3f0_s4f3_s5f3", "s1f0_s2f1_s3f0_s4f2_s5f2", "s1f3_s2f0_s3f0_s4f0_s5f2_s6f2", "s1f3_s2f0_s3f0_s4f0_s5f3_s6f3", "s1f2_s2f0_s3f0_s4f0_s5f2_s6f3", "s1f2_s2f3_s3f1_s4f0", "s1f2_s2f2_s3f2_s4f0", "s1f3_s2f3_s3f2_s4f0")}
  let right={pick(c * 3 + w, "2", "4", "5", "6", "5", "1", "3", "2", "1")}
  level easy {
    let c=0..1
  }
  level hard {
    let c=1..2
    scene 36x25 {
      row top space=2 align=start at=canvas(1, 1) {
        chordbox box tuning=guitar chord=pick(c, "C", "G", "D") frets=4 show=fingers name=true letters=false lit=[]
        tab chord tuning=guitar notes=["{stack}"] values=[] even=true letters=false ring=-1
      }
      text ask "Ben wrote {chord} in tab, as one stack of numbers, but one number is wrong. Which string would sound wrong?" narrate width=34 below=top gap=1
      choice pick options=["1", "2", "3", "4", "5", "6"] stack=row below=ask gap=1
    }
  }

  scene 36x25 {
    row top space=2 align=start at=canvas(1, 1) {
      chordbox box tuning=guitar chord=pick(c, "C", "G", "D") frets=4 show=fingers name=true letters=false lit=[]
      tab chord tuning=guitar notes=["{stack}"] values=[] even=true letters=true ring=-1
    }
    text ask "Ben wrote {chord} in tab, as one stack of numbers, but one number is wrong. Which string would sound wrong?" narrate width=34 below=top gap=1
    choice pick options=["1", "2", "3", "4", "5", "6"] stack=row below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=chord {
      say "Take the strings one at a time. The number on each tab line should be the fret of that string's dot on the card, and 0 where the card has a ring."
    }
  }
  hint "The top line of the tab is string 1, the thinnest, which is on the right of the card."
  hint "For each tab line, what fret does the card give that string?"
}
