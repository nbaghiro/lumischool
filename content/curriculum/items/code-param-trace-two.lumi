# A block used twice with two numbers, traced: how far right and how far up the turtle ends. At t=2
# size is used twice and a move back takes some of it away.
item coding.param-trace-two v=1 skills=[coding.procedures, coding.tracing] {
  title "Two calls"
  difficulty ((if t == 2 then 1 else 0) + (if a + b > 4 then 0.5 else 0))
  let t=0..2 a=2..3 b=1..3
  let l1={pick(t, "  up size", "  right size", "  up size")}
  let l2={pick(t, "  right 1", "  up 1", "  right size")}
  let l3={pick(t, "  up 1", "  right 1", "  down 1")}
  let far={pick(t, 2, a + b + 2, a + b)}
  let high={pick(t, a + b + 2, 2, a + b - 2)}
  level easy {
    let t=0..1
  }
  level hard {
    let t=2..2
  }

  scene 33x17 {
    program prog code=["define climb size", "{l1}", "{l2}", "{l3}", "climb {a}", "climb {b}"] title="Sam's turtle" at=canvas(1, 1)
    column side space=1 align=start right-of=prog gap=2 {
      text ask "The turtle does lines 5 and 6. How many squares right of its start does it stop, and how many up?" narrate width=13
      row r1 space=1 align=centre {
        text lr "right"
        number-input goright width=3
      }
      row r2 space=1 align=centre {
        text lu "up"
        number-input goup width=3
      }
    }
  }

  answer goright=far goup=high
  feedback {
    when (goright == far and goup != high) point=prog {
      say "Right is correct. Now add up every move up in both calls, and take away any move down."
    }
    when (goup == high and goright != far) point=prog {
      say "Up is correct. Now add up every move right in both calls."
    }
  }
  hint "Write out climb {a} with {a} in place of size, then climb {b} with {b}."
  hint "Add the moves right together, then the moves up."
}
