# Non-routine: how much water has gone does not matter, because the salt cannot leave with it.
# Half the salt is the answer a child expects, and the feedback says why it is not.
item chem.sep-salt-mass v=1 stars=3 skills=[chemistry.separating, chemistry.conservation] {
  title "How much salt is in the dish?"
  difficulty q
  let g={20, 30, 40, 50} q=1..3

  scene 30x11 {
    row kit at=canvas(1, 0) space=1 align=start {
      dish d left=q day=(5 - q)
      column side space=1 align=start {
        text ask "{g} grams of salt were stirred into this water. Some of the water has evaporated. How many grams of salt are in the dish now?" width=17
        number-input answer
      }
    }
  }

  answer g
  feedback {
    when (answer == g / 2) point=d {
      say "Did any salt go off into the air with the water?"
    }
  }
  hint "What leaves the dish when water evaporates?"
  hint "Did any salt leave? Where is it now?"
}
