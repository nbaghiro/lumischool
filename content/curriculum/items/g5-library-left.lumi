# Two fractions of one whole taken away from it: what is left, in two steps with a common denominator.
item fraction.library-left v=1 skills=[fractions.add-unlike, reasoning.two-steps] {
  title "The rest of the shelves"
  difficulty (lcm(b, d) / 4)
  let b={2, 3, 4} d={3, 5, 6, 8} a=1..2 c=1..3
  where (b < d and a < b and c < d and a / b + c / d < 1 and d % b != 0)
  level easy {
    where (lcm(b, d) <= 12)
  }
  level hard {
    where (lcm(b, d) >= 15)
  }

  scene 35x12 {
    library lib columns=6 open=1 at=canvas(1, 1)
    text ask "In the city library, {a}/{b} of the shelves hold history books and {c}/{d} hold maps. The rest hold poems. What fraction of the shelves hold poems?" narrate width=20 right-of=lib gap=2
    row eq below=ask gap=1 space=1 align=centre {
      number-input top width=3
      text slash "/"
      number-input bottom width=3
    }
  }

  answer top=num(1 - a / b - c / d) bottom=den(1 - a / b - c / d)
  feedback {
    when (top == num(a / b + c / d) and bottom == den(a / b + c / d)) point=ask {
      say "That is history and maps together. The poems are the rest of the whole."
    }
  }
  hint "What fraction of the shelves do history and maps take together?"
  hint "Take that away from one whole."
}
