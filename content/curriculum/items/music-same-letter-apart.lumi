# The two-star reason: two keys with the same letter, and how far apart they are. The pattern of
# black keys repeats every seven white keys, which is why the letters do.
item music.same-letter-apart v=1 stars=2 skills=[music.keys, reasoning.explain] {
  title "The same letter twice"
  difficulty k
  let k=0..1 r=0..2
  let x={pick(k, "C", "G")}
  let right={pick(k, "Seven white keys along, at the next group of two", "Seven white keys along, at the next group of three")}
  let w1={pick(k, "Two white keys along, past the next black key", "Three white keys along, past the next black key")}
  let w2={pick(k, "Anywhere: the letters repeat with no pattern", "Anywhere: the letters repeat with no pattern")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 34x17 {
    text ask "Ada finds a {x} on the bandstand keyboard. There is another key called {x} further along. How far along is it, and how does she know?" narrate width=32 at=canvas(1, 1)
    choice pick options=[if r == 0 then right else if r == 1 then w1 else w2, if r == 0 then w1 else if r == 1 then w2 else right, if r == 0 then w2 else if r == 1 then right else w1] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick == w2) point=ask {
      say "The black keys go two, three, two, three all the way along, and the letters follow them. The pattern is the reason the letters repeat."
    }
    when (pick == w1) point=ask {
      say "Count the white keys from {x} saying the letters: seven letters bring you round to {x} again."
    }
  }
  hint "Say the letters from {x} along the white keys. When does {x} come round again?"
  hint "The black keys make the same shape again after every seven white keys, so the next {x} is by the same shape."
}
