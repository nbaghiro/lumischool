# The language to English: [[phrase.i-am-eight-years-old]], [[phrase.how-old-are-you]], [[phrase.my-brother-is-twelve]], [[phrase.my-sister-is-three]], [[phrase.how-old-is-your-father]], [[phrase.my-mother-is-thirty-one]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.how-old-meaning v=1 skills=[language.numbers, language.questions] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "girl", "boy", "gran", "girl")] says=[pick(k, "[[phrase.i-am-eight-years-old]]", "[[phrase.how-old-are-you]]", "[[phrase.my-brother-is-twelve]]", "[[phrase.my-sister-is-three]]", "[[phrase.how-old-is-your-father]]", "[[phrase.my-mother-is-thirty-one]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "My mother is thirty-one.", "My sister is three.", "How old are you?", "My mother is thirty-one.", "My mother is thirty-one.", "My sister is three."), pick(k, "I am eight years old.", "How old are you?", "How old is your father?", "My sister is three.", "My brother is twelve.", "My mother is thirty-one."), pick(k, "My brother is twelve.", "How old is your father?", "My sister is three.", "How old are you?", "How old is your father?", "My brother is twelve."), pick(k, "How old is your father?", "My brother is twelve.", "My brother is twelve.", "My brother is twelve.", "My sister is three.", "How old is your father?")] stack=column
    }
  }

  answer pick=pick(k, "I am eight years old.", "How old are you?", "My brother is twelve.", "My sister is three.", "How old is your father?", "My mother is thirty-one.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
