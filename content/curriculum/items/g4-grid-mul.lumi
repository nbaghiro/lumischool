# Long multiplication written out as four partial products, so the working is what the child hands
# in and each part can be marked on its own.
item multiply.grid v=1 skills=[multiplication.long] {
  title "Long multiplication by the grid"
  difficulty (a * b)
  let a=14..38 b=13..29
  where (a % 10 != 0 and b % 10 != 0)
  level easy {
    let a=14..19 b=13..19  # both tens digits are one
  }
  level hard {
    let a=26..38 b=23..29
  }

  scene 32x11 {
    text ask "Work out {a} times {b}. Fill in each part, then add them." width=30 at=canvas(1, 0)
    areagrid grid a=a b=b blanks=[tt, ot, to, oo, total] below=ask gap=1
  }

  answer tt=(a // 10 * 10 * (b // 10 * 10)) ot=(a % 10 * (b // 10 * 10)) to=(a // 10 * 10 * (b % 10)) oo=(a % 10 * (b % 10)) total=(a * b)
  feedback {
    when (total == tt + oo) point=grid.total {
      say "All four parts go into the total, not only the corners."
    }
  }
}
