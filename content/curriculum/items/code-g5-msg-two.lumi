# One message, two scripts that receive it: they run one after the other in the order they are
# written, so doubling then adding is not adding then doubling.
item coding.msg-two v=1 skills=[coding.events, coding.messages, coding.variables] {
  title "Two scripts hear it"
  difficulty (k + (a - 2) * 0.2)
  let k=0..1 a=2..4 b={1, 3}
  level easy {
    let k={0} a={2, 3}
  }
  level hard {
    let k={1}
  }

  scene 36x26 {
    program p code=["when the flag is tapped", "set bells to {a}", "broadcast ring", "when I receive ring", pick(k, "double bells", if b == 1 then "add 1 to bells" else "add 3 to bells"), "when I receive ring", pick(k, if b == 1 then "add 1 to bells" else "add 3 to bells", "double bells")] at=canvas(0, 0)
    clocktower ct hour=a minute=0 right-of=p gap=2
    text ask "The clock tower's program counts its bells. What is bells at the end?" width=34 below=p gap=1
    number-input answer below=ask gap=1
  }

  check coding.runs of=p answer="value(bells)"
  feedback {
    when (k == 0 and answer == 2 * (a + b)) point=p {
      say "Both scripts hear ring, but they run in the order they are written. Which one is first?"
    }
    when (k == 1 and answer == 2 * a + b) point=p {
      say "Both scripts hear ring, but they run in the order they are written. Which one is first?"
    }
    when (answer == a + b or answer == 2 * a) point=p {
      say "Two scripts start with when I receive ring. Both of them run."
    }
  }
  hint "How many scripts start with when I receive ring?"
  hint "Run them from the top of the page down, and write bells after each one."
}
