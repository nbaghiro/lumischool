# Every change on the shelf, so the child meets the reversible ones and the ones that make a new
# material in any order. The table the drawing is drawn from gives the answer.
item chem.change-undo v=1 skills=[chemistry.changes] {
  title "Can it be undone?"
  difficulty (if c == "dissolve-sugar" or c == "rise-dough" or c == "fizz" or c == "rust-nail" then 2 else if c == "boil-water" or c == "burn-candle" then 1 else 0)
  let c={"melt-ice", "freeze-water", "melt-chocolate", "boil-water", "dissolve-sugar", "toast-bread", "cook-egg", "bake-cake", "burn-candle", "rust-nail", "fizz", "rise-dough"}
  level easy {
    let c={"melt-ice", "freeze-water", "melt-chocolate", "toast-bread", "cook-egg", "bake-cake"}
  }
  level hard {
    let c={"dissolve-sugar", "boil-water", "rise-dough", "fizz", "rust-nail", "burn-candle"}
  }

  scene 30x8 {
    beforeafter ch change=c show=1 names=1 at=canvas(1, 0)
    text ask "Could you change it back to how it was?" width=13 right-of=ch gap=1
    choice pick options=["yes", "no"] below=ask gap=1
  }

  check chem.change of=ch pick=undo
  hint "Is it still the same stuff afterwards, only runny, hard or spread out?"
  hint "Could cooling, warming or drying it get the first picture back?"
}
