# What happens along a chain when one link goes: the eater above it goes hungry, and the thing
# below it grows, since nothing eats it now. Asking about the link next to the missing one is the
# plain half; asking about the plant when the middle goes, or about the top when the plant goes,
# needs the chain followed two steps.
item nature.link-goes v=1 skills=[nature.food-chains, reasoning.cause-and-effect] {
  title "When a link goes"
  difficulty (if w <= 1 then 0 else 1)
  let c=0..1 w=0..3
  let x={pick(c, "seaweed", "tiny plants")}
  let y={pick(c, "crabs", "small fish")}
  let z={pick(c, "gulls", "seals")}
  let gone={pick(w, y, z, y, x)}
  let about={pick(w, z, y, x, z)}
  let right={pick(w, "They have less to eat", "There are more of them, because nothing eats them", "There is more of it, because nothing eats it", "They have less to eat: their food has less")}
  let o1={pick(w, "They have more to eat", "There are fewer of them", "There is less of it", "Nothing changes for them")}
  let o2={pick(w, "Nothing changes for them", "Nothing changes for them", "Nothing changes for it", "They have more to eat")}
  level easy {
    let w=0..1
  }
  level hard {
    let w=2..3
  }

  scene 34x26 {
    row who at=canvas(1, 1) space=2 align=end {
      crabs pc count=2
      fishshoal pf rows=2 cols=4 facing=1
      seal ps rock=1 facing=1
    }
    text chain "{x}  →  {y}  →  {z}" narrate below=who gap=1
    text ask "One year all the {gone} on the reef {if gone == x then \"disappears\" else \"disappear\"}. What happens to the {about}?" narrate width=32 below=chain gap=1
    choice pick options=[o1, right, o2] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick == o1 and w == 2) point=chain {
      say "The {y} were the ones eating the {x}. With them gone, nothing eats it, so there is more."
    }
    when (pick == o1 and w == 0) point=chain {
      say "The {z} ate the {y}. With the {y} gone, the {z} have lost their food."
    }
    when (pick == o1 and w == 1) point=chain {
      say "The {z} were the ones eating the {y}. With the {z} gone, the {y} are safe, and there are more of them."
    }
    when (pick != right and w == 3) point=chain {
      say "The {y} eat the {x}. With no {x} there are fewer {y}, and then the {z} have fewer {y} to eat. The loss runs up the chain."
    }
    when (pick == o2 and w <= 2) point=chain {
      say "Every link in a chain leans on the one before it and feeds the one after it. Taking one out changes both its neighbours."
    }
  }
  hint "Find the {gone} in the chain. Which arrow went into them, and which came out?"
  hint "The one after a missing link loses its food. The one before it is no longer eaten, so there is more of it."
}
