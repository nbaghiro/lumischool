# A tune's key from its notes and its last note: ending on A with G sharps is A minor; ending on C
# with no sharps is C major; ending on E with D sharps is E minor.
item music.minor-which v=1 skills=[music.major-minor, music.key-signatures, reasoning.evidence] {
  title "Which key is the tune in?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..2
  let t1={pick(k, "A4", "E4", "C5")} t2={pick(k, "C5", "G4", "E5")} t3={pick(k, "B4", "Fs4", "D5")} t4={pick(k, "Gs4", "Ds4", "B4")} t5={pick(k, "A4", "E4", "C5")}
  let right={pick(k, "A minor", "E minor", "C major")}
  let o2={pick(k, "C major", "G major", "A minor")}
  let o3={pick(k, "G major", "B minor", "E minor")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..2
  }

  scene 36x30 {
    notes tune clef=treble notes=[t1, t2, t3, t4, t5] values=[1, 1, 1, 1, 4] meter=0 letters=true at=canvas(1, 1)
    text ask "Ana writes down the end of a fiddle tune she heard at the hut. Its last note is its home note. Which key is it in?" narrate width=34 below=tune gap=1
    choice pick options=[pick(k, right, o2, o3), pick(k, o2, o3, right), pick(k, o3, right, o2)] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=tune {
      say "Read the last note first: it names the key. Then look for a raised 7th, a sharp just below it."
    }
  }
  hint "What is the last note?"
  hint "Is there a note a semitone below the home note? Minor keys raise their 7th to make one."
}
