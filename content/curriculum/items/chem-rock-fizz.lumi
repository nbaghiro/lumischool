item chem.rock-fizz v=1 skills=[chemistry.rocks] {
  title "How many fizzed?"
  difficulty (if k == 2 then 3 else if k == 0 then 2 else 1)
  let k=0..3
  level easy {
    let k={0, 1}
  }
  level hard {
    let k={0, 2}  # two and three fizzing rocks
  }

  scene 18x13 {
    text ask "A drop of vinegar was put on each rock. How many rocks fizzed?" width=17 at=canvas(1, 0)
    rocks r rocks=["{if k == 0 then \"marble\" else if k == 1 then \"chalk\" else if k == 2 then \"limestone\" else \"slate\"}", "{if k == 0 then \"basalt\" else if k == 1 then \"granite\" else if k == 2 then \"chalk\" else \"basalt\"}", "{if k == 0 then \"limestone\" else if k == 1 then \"slate\" else if k == 2 then \"marble\" else \"granite\"}", "{if k == 0 then \"pumice\" else if k == 1 then \"sandstone\" else if k == 2 then \"granite\" else \"marble\"}"] test=2 letters=1 names=0 below=ask gap=0
    number-input answer below=r gap=0
  }

  check chem.rocks of=r answer="count(fizzes)"
  hint "Fizzing makes bubbles. Look above each drop."
  hint "Count the rocks with bubbles rising from them."
}
