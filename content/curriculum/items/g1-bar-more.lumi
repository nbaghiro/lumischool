# Two bars read and compared: how many more is the gap between them, not either bar.
item data.bar-more v=1 skills=[data.bar-graph, subtraction.compare] {
  title "How many more chose dogs"
  difficulty (b - c)
  let a=2..8 b=3..9 c=1..8
  where (b > c + 1)
  where (a != b and a != c)
  level easy {
    let b=3..5 c=1..3
  }
  level hard {
    let b=8..9 c=1..3
  }

  scene 32x15 {
    bargraph chart labels=["Cats", "Dogs", "Fish"] values=[a, b, c] max=10 color=mint at=canvas(1, 1)
    text ask "Children chose their favourite pet. How many more chose dogs than fish?" narrate width=16 right-of=chart gap=2
    number-input answer below=ask gap=1
  }

  answer (b - c)
  feedback {
    when (answer == b) point=chart {
      say "That is how many chose dogs. How many more than fish is the gap between the two bars."
    }
    when (answer == b + c) point=chart {
      say "That is dogs and fish together. How many more is the difference."
    }
  }
  hint "How tall is the dogs bar? How tall is the fish bar?"
  hint "Count up from the top of the fish bar to the top of the dogs bar."
}
