# Words whose length does not give the beats away: strength is long with one beat, idea is short
# with three. The audit's raise for most-beats, asked as a number.
item reading.clap-count v=1 skills=[reading.syllables] {
  title "Clap and count"
  difficulty (if w in {"strength", "stretched", "scratch"} then 3 else if w in {"caterpillar", "watermelon"} then 4 else if w in {"idea", "banana", "animal", "hospital"} then 2 else 1)
  let w={"strength", "stretched", "scratch", "open", "zebra", "igloo", "idea", "banana", "animal", "hospital", "caterpillar", "watermelon"}
  level easy {
    let w={"open", "zebra", "igloo", "banana", "animal"}
  }
  level hard {
    let w={"strength", "stretched", "scratch", "caterpillar", "watermelon"}  # one beat in eight letters, or four beats
  }

  scene 34x7 {
    wordcards card words=[w] picked=-1 at=canvas(1, 1)
    text ask "Clap the word. How many beats does it have?" narrate width=14 right-of=card gap=2
    number-input answer below=ask gap=0
  }

  answer (if w in {"strength", "stretched", "scratch"} then 1 else if w in {"open", "zebra", "igloo"} then 2 else if w in {"idea", "banana", "animal", "hospital"} then 3 else 4)
  hint "Say the word at a normal speed. Clap each time your mouth opens for a new part."
  hint "Put your hand under your chin. How many times does your chin drop?"
}
