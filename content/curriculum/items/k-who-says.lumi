item k.who-says v=1 skills=[reading.characters] {
  title "Who says it?"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..3
  let line={pick(k, "Woof, woof.", "Where is my ball?", "You found it.", "Woof, woof.")}
  let right={pick(k, "the dog", "the girl", "the girl", "the dog")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 35x20 {
    comic strip who=["girl", "dog", "girl"] says=["Where is my ball?", "Woof, woof.", "You found it."] moods=["worried", "happy", "excited"] with=["", "", "dog"] thinks=[0, 0, 0] holds=["", "", ""] labels=["1", "2", "3"] at=canvas(1, 1)
    text q "The grown-up reads: {line} Who says that?" narrate width=32 below=strip gap=1
    choice pick options=["the girl", "the dog"] stack=row below=q gap=1
  }

  answer pick=right
  hint "Find the bubble with those words. Whose mouth does it come from?"
}
