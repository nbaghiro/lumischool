# Two cars set off at the same moment from the two ends of the gorge road: the gap closes by the sum
# of their speeds every hour, so the time is the road shared by that sum.
item travel.meet-hours v=1 skills=[rates.speed.meeting] {
  title "Meeting on the gorge road"
  difficulty (t + (if whole(t) then 0 else 2) + (if v1 + v2 > 90 then 1 else 0))
  let v1={30, 40, 50} v2={40, 50, 60} t={1, 1.5, 2, 2.5, 3}
  where (v1 != v2)
  let d={plain((v1 + v2) * t)}
  level easy {
    let t={1, 2} v1={30, 40} v2={50, 60}
  }
  level hard {
    let t={1.5, 2.5}
  }

  scene 36x23 {
    motionline road mode=0 dist=d v1=v1 v2=v2 late=0 show=0 at=canvas(1, 1)
    text ask "At nine o'clock a blue car leaves the mill at A and an orange car leaves the waterfall at B, and they drive towards each other along the {d} km gorge road. After how many hours do they meet?" narrate width=34 below=road gap=1
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=4
      text unit "hours"
    }
  }

  answer t
  feedback {
    when (answer == d / v1 or answer == d / v2) point=road {
      say "That is one car driving the whole road alone. Both cars are moving, so the gap closes from both ends."
    }
    when (answer == d / (v1 - v2) or answer == d / (v2 - v1)) point=road {
      say "They drive towards each other, so their speeds add. Taking away is for one car chasing another."
    }
  }
  hint "In one hour, how far does each car go?"
  hint "So how much shorter is the gap after one hour?"
}
