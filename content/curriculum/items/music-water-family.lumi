# Who has the tune: the instrument family drawn under each section of a listening map. The question
# asks for one family's sections, or for the family that has tune A every time it comes back.
item music.water-family v=1 skills=[music.listening, music.instruments] {
  title "Who has the tune"
  difficulty (if f <= 1 then 0 else 1)
  let f=0..3
  let t1={pick(f, 1, 0, 2, 1)}
  let t2={pick(f, 0, 2, 1, 2)}
  let t3={pick(f, 1, 0, 2, 1)}
  let t4={pick(f, 0, 1, 1, 2)}
  let fam={pick(f, "strings", "strings", "woodwind", "brass")}
  let right={pick(f, 3, 3, 2, 2)}
  level easy {
    let f=0..1
  }
  level hard {
    let f=2..3
  }

  scene 36x25 {
    listenmap map title="Music for the lock gates" sections=[0, 1, 0, 1, 0] bars=[] tune=[0, t1, t2, t3, t4] loud=[-1, -1, -1, -1, -1] tempo=[0, 0, 0, 0, 0] count=0 ask=-1 at=canvas(1, 1)
    text ask "Under each section the map draws the family of instruments that has the tune: strings, woodwind, brass or percussion. In how many sections do the {fam} have the tune?" narrate width=34 below=map gap=1
    number-input answer below=ask gap=1
  }

  answer right
  feedback {
    when (answer == 5) point=map {
      say "Some sections have a different picture under them. Count only the {fam}."
    }
  }
  hint "Find the picture and the word {fam} under the strip."
  hint "Go along the strip from left to right and count each section with that picture under it."
}
