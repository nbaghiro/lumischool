# The number that was divided is the unknown: rebuild it from the groups and what was left.
item division.unknown-dividend v=1 skills=[division.short-with-remainder, division.inverse] {
  title "What was divided?"
  difficulty (d * q + r)
  let d=3..9 q=5..12 r=1..8
  where (r < d)
  level easy {
    let d=3..5 q=5..8 r=1..3
  }
  level hard {
    let d=6..9 q=9..12 r=4..8
  }

  scene 24x9 {
    unknown eq terms=["?", "÷", "{d}", "=", "{q} r {r}"] at=canvas(1, 1)
    text ask "What number was divided?" narrate below=eq gap=1
    number-input answer right-of=ask gap=1
  }

  answer (d * q + r)
  feedback {
    when (answer == d * q) point=eq {
      say "Do not forget the {r} that was left over. It was part of the number too."
    }
    when (answer == d * q - r) point=eq {
      say "The {r} left over is extra, so it is added on, not taken away."
    }
  }
  hint "The number made {q} groups of {d}. How many is that?"
  hint "Then something was left over. Put it back."
}
