# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.interview-match v=1 skills=[language.questions, language.speaking] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 36x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[interview.i-live]]", "[[interview.the-interview]]", "[[interview.where-do-you-live]]"), pick(k, "[[interview.you-live]]", "[[interview.the-question]]", "[[interview.do-you-have-brothers-or-sisters]]"), pick(k, "[[interview.i-have]]", "[[interview.the-answer]]", "[[interview.what-do-you-like-doing]]"), pick(k, "[[interview.you-have]]", "[[interview.favourite-2]]", "[[interview.what-is-your-name]]")] right=[pick(k, "I have", "favourite", "What do you like doing?"), pick(k, "I live", "the interview", "Where do you live?"), pick(k, "you live", "the question", "What is your name?"), pick(k, "you have", "the answer", "Do you have brothers or sisters?")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
