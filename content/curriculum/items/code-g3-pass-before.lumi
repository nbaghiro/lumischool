# The pass run backwards: several rows lead to the same row after a pass, and each wrong option
# here is proved not to by one pass. Working backwards is the reasoning.
item coding.pass-before v=1 stars=2 skills=[coding.algorithms, reasoning.work-backwards] {
  title "What were they before?"
  difficulty k
  let k=0..2

  scene 35x18 {
    sortcards c cards=[if k == 0 then 2 else if k == 1 then 3 else 1, if k == 0 then 5 else if k == 1 then 1 else 4, if k == 0 then 1 else if k == 1 then 4 else 2, if k == 0 then 7 else if k == 1 then 6 else 8] compare=0 swap=false at=canvas(1, 0)
    column q right-of=c gap=2 space=1 align=start {
      text ask "These are the cards after one pass. Which row could they have been in before the pass?" width=18
      choice pick options=["{if k == 0 then \"5 2 7 1\" else if k == 1 then \"1 3 6 4\" else \"1 4 2 8\"}", "{if k == 0 then \"2 5 1 7\" else if k == 1 then \"4 3 1 6\" else \"4 8 1 2\"}", "{if k == 0 then \"7 5 2 1\" else if k == 1 then \"3 1 4 6\" else \"8 1 4 2\"}"] stack=column
    }
  }

  answer pick=(if k == 0 then "5 2 7 1" else if k == 1 then "4 3 1 6" else "8 1 4 2")
  hint "Do one pass on each row. Which one comes out as the cards in the picture?"
  hint "After a pass the biggest card is always at the end. Which rows can end with that card?"
}
