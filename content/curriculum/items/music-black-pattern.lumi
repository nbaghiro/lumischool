# The three-star, played: the five black keys of one two-and-three in order, which is the pattern
# the whole keyboard repeats.
item music.black-pattern v=1 stars=3 skills=[music.keys, reasoning.planning] {
  title "The pattern of black keys"

  scene 34x16 {
    piano keys from=F3 whites=11 wide=3 labels=none at=canvas(1, 1)
    text ask "Play the black keys of one group of two and then the group of three just to its right, in order from left to right: five keys, going up." narrate width=32 below=keys gap=1
  }

  check music.plays notes=[Cs4, Ds4, Fs4, Gs4, As4]
  hint "Find a group of two. Play both, left to right, then the three keys of the next group."
  hint "Two, then three: five black keys climbing to the right."
}
