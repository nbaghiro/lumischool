# A hard case outside cannot grow, so a crab or a spider climbs out of it and grows a bigger one: the
# empty case is what a child finds on the beach or the windowsill.
item nature.why-moult v=1 skills=[nature.skeletons, reasoning.explain] {
  title "How does it get bigger?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..2
  let told={pick(k, "A crab's hard case cannot stretch. How does a young crab get bigger?", "Ben finds a whole empty spider, as thin as paper, on the lab windowsill, and the spider is alive in the corner, a little bigger. What happened?", "On the beach Ada finds a crab's case, empty and whole, and a soft crab hiding nearby. Why is the crab soft?")}
  let right={pick(k, "It climbs out and grows a new, bigger case", "It climbed out of its old case and left it", "Its new case has not gone hard yet")}
  let o1={pick(k, "The case slowly stretches as it eats", "Something ate the inside of the spider", "Crabs are soft until they are old")}
  let o2={pick(k, "It grows a second case on top of the first", "The spider grew a second spider", "The sea washed its case off")}
  let x1={pick(k, right, o1, o2)}
  let x2={pick(k, o1, right, o1)}
  let x3={pick(k, o2, o2, right)}
  level easy {
    let k={0, 2}
  }
  level hard {
    let k=1..2
  }

  scene 36x26 {
    row all at=canvas(1, 1) space=2 align=end {
      crabs cr count=2
      minibeasts sp kinds=["spider"] legs=false
    }
    text ask "{told}" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=cr {
      say "The case is the skeleton, and it is hard all over. Can a hard case grow with the animal inside it?"
    }
  }
  hint "Can the hard case get bigger, or must the animal get out of it?"
  hint "What would be left behind if the animal climbed out?"
}
