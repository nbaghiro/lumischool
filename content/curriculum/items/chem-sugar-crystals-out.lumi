# Sugar that comes out as the water cools: what 100 ml holds hot less what it holds at 20 °C, from
# published solubility rounded to whole grams (204 at 20 °C, 238 at 40, 287 at 60, 362 at 80). The
# unknown is the grams that come out, or the coolest start that gives at least a target.
item chem.sugar-crystals-out v=1 stars=3 skills=[chemistry.crystals, chemistry.dissolving, reasoning.constraints] {
  title "Sugar out of the cooling water"
  difficulty (q * 2 + (if v == 100 then 0 else 1))
  let q=0..1 t=1..3 v={100, 200}
  let hot={pick(t, 204, 238, 287, 362)}
  let temp={pick(t, 20, 40, 60, 80)}
  let want={pick(t, 0, 30, 80, 150) * v / 100}
  let steps={if q == 0 then "" else "What is the coolest temperature in the table she can start from?"}
  level easy {
    let q=0..0 v={100}
  }
  level hard {
    let q=1..1
  }

  scene 33x17 {
    table data cols=2 head=["Water °C", "Sugar"] cells=["20", "204", "40", "238", "60", "287", "80", "362"] at=canvas(1, 0)
    text ask "The table gives the grams of sugar that dissolve in 100 ml of water. {if q == 0 then \"Mei stirs sugar into \" else \"Mei wants at least \"}{if q == 0 then v else want}{if q == 0 then \" ml of water at \" else \" g of sugar crystals from \"}{if q == 0 then temp else v}{if q == 0 then \" °C until no more dissolves, and lets it cool to 20 °C. How many grams of sugar come out as crystals?\" else \" ml of water, saturated with sugar and cooled to 20 °C. \"}{steps}" narrate width=18 right-of=data gap=1
    number-input answer below=ask gap=1
  }

  answer (if q == 0 then (hot - 204) * v / 100 else temp)
  feedback {
    when (q == 0 and answer == hot * v / 100) point=data {
      say "That is all the sugar in the hot water. Some of it stays dissolved at 20 °C."
    }
    when (q == 0 and v == 200 and answer == hot - 204) point=data {
      say "The table is for 100 ml. Mei has {v} ml, twice as much."
    }
  }
  hint "How much does the water hold at the start, and how much can it still hold at 20 °C?"
  hint "The sugar it can no longer hold comes out. How much is that for 100 ml, and how much for {v} ml?"
  hint "{if q == 0 then \"Check: the crystals and the sugar still dissolved together make what went in.\" else \"Try each start in turn, from the coolest. Which is the first that gives enough?\"}"
}
