# Coldest first means the most negative first, which is the opposite of reading the digits.
item number.order-cold v=2 skills=[number.negatives, number.compare] negatives {
  title "Coldest first"
  difficulty (if r == 4 then 0 else if r == 0 then 1 else 2)
  let p={-9, -7, -3} q={-6, -2, -1} r={-4, 0, 4} s={1, 3, 8}
  where (p != q and p != r and q != r and abs(p) != s and abs(q) != s)
  level easy {
    let r={4}  # two towns below zero
  }
  level hard {
    let r={-4}  # three towns below zero
  }

  scene 22x18 {
    text ask "Put the towns in order, coldest first. Write 1 to 4 in the boxes." narrate width=21 at=canvas(1, 1)
    sequence s items=["Hilltop {q} degrees", "Bayport {s} {if s == 1 then \"degree\" else \"degrees\"}", "Frostmere {p} degrees", "Millbrook {r} degrees"] blanks=[b1, b2, b3, b4] below=ask gap=1
  }

  answer b1=(1 + (if s < q then 1 else 0) + (if p < q then 1 else 0) + (if r < q then 1 else 0)) b2=(1 + (if q < s then 1 else 0) + (if p < s then 1 else 0) + (if r < s then 1 else 0)) b3=(1 + (if q < p then 1 else 0) + (if s < p then 1 else 0) + (if r < p then 1 else 0)) b4=(1 + (if q < r then 1 else 0) + (if s < r then 1 else 0) + (if p < r then 1 else 0))
  feedback {
    when (b3 == 4) point=s {
      say "{p} is below zero, so it is colder than {s}."
    }
  }
  hint "Which towns are below zero? They are the coldest."
  hint "Of the two below zero, which is further from zero?"
}
