item physics.globe-when v=1 skills=[physics.sky, reasoning.model] stars=3 {
  title "Waiting for noon"
  difficulty ((12 - y + 24) % 24)
  let y={6, 18, 21, 0, 3}

  scene 21x23 {
    globe earth hours=[12, y] at=canvas(0, 0)
    text ask "It is noon for child A, with the sun overhead. The Earth turns once a day. How many hours until it is noon for child B?" narrate width=19 below=earth gap=0
    number-input answer below=ask gap=1
  }

  answer ((12 - y + 24) % 24)
  feedback {
    when (answer == (y - 12 + 24) % 24 and y != 0) point=earth {
      say "The Earth turns the way the arrow shows. Which way round does B have to go to reach A's place?"
    }
  }
  hint "Where does B have to get to, to have noon?"
  hint "Each quarter of a turn is 6 hours. How far round does B still have to go?"
}
