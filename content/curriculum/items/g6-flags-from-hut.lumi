# The modulus as a distance either way: the whole numbers with |x| less than k lie on both sides of
# zero, and zero itself counts once.
item negative.flags-from-hut v=1 skills=[number.negatives.modulus, reasoning.systematic] {
  title "Flags either side"
  difficulty (v + k / 10)
  let v=0..1 k=3..8
  level easy {
    let v={0} k=3..4
  }
  level hard {
    let v={1} k=6..8
  }

  scene 36x20 {
    numberline line from=-10 to=10 at=canvas(1, 1)
    text ask "A flag stands on the ice at every whole metre along a line, the hut's flag at 0, east positive and west negative. How many flags stand where |x| {if v == 0 then \"<\" else \"≤\"} {k}, that is {if v == 0 then \"less than\" else \"no more than\"} {k} m from the hut?" narrate width=34 below=line gap=1
    number-input answer width=3 below=ask gap=1
  }

  answer (2 * k + (if v == 0 then -1 else 1))
  feedback {
    when (answer == k - 1 + 2 * v or answer == k + v) point=line {
      say "That is one side of the hut. The bars mean the distance either way, east or west."
    }
    when (v == 0 and answer == 2 * k + 1) point=line {
      say "Is a flag exactly {k} m away less than {k} m away?"
    }
    when (answer == 2 * k + (if v == 0 then -2 else 0)) point=line {
      say "Did you count the hut's own flag at 0? Its distance is 0."
    }
  }
  hint "Which flags east of the hut are close enough? Which flags west?"
  hint "Does the flag at 0 count?"
}
