# The unknown in any of the four places. When one ratio is not a whole number of times the other, the
# rule for a proportion does it: the outer terms multiply to the same as the inner terms.
item proportion.missing-term v=1 skills=[algebra.equations.proportion, ratio.scaling] {
  title "The missing term"
  difficulty (pos / 2 + (if n % m == 0 then 0 else 2) + m / 2)
  let t=0..4 m=1..3 n=2..5 pos=0..3
  where (m < n)
  let p={pick(t, 2, 3, 3, 4, 2)}
  let q={pick(t, 3, 4, 5, 5, 5)}
  let a={p * m}
  let b={q * m}
  let c={p * n}
  let d={q * n}
  level easy {
    let m={1} pos={2, 3}
  }
  level hard {
    let m={2, 3} pos={0, 1}
    where (n % m != 0)
  }

  scene 36x14 {
    balanceeq beam left="{if pos == 0 then \"x\" else a} : {if pos == 1 then \"x\" else b}" right="{if pos == 2 then \"x\" else c} : {if pos == 3 then \"x\" else d}" at=canvas(1, 1)
    text ask "The beam balances because the two ratios are equal: it is a proportion. What number is x?" narrate width=15 right-of=beam gap=2
    number-input answer width=3 below=ask gap=1
  }

  answer pick(pos, a, b, c, d)
  feedback {
    when (pos == 3 and answer == c + b - a) point=beam {
      say "Adding the same amount does not keep a ratio. How many times {a} is {c}?"
    }
    when (pos == 2 and answer == d - b + a) point=beam {
      say "Taking away the same amount does not keep a ratio. How many times {b} is {d}?"
    }
    when (pos == 1 and answer == d - c + a) point=beam {
      say "A ratio is kept by multiplying, not by adding. Multiply the outer terms, then share by the other inner term."
    }
    when (pos == 0 and answer == c - d + b) point=beam {
      say "A ratio is kept by multiplying, not by adding. Multiply the inner terms, then share by the other outer term."
    }
  }
  hint "Which two terms are the outer ones, and which two are the inner ones?"
  hint "The outer terms multiply to the same number as the inner terms. Which product can you work out already?"
}
