# The unknown moved into a pot: which paint, put with the one we can see, makes the colour at the end.
item art.missing-pot v=1 skills=[art.colour-mixing, reasoning.missing-number] {
  title "Which paint is missing?"
  difficulty (if k >= 4 then 2 else if k >= 2 then 1 else 0)
  let k=0..5
  level easy {
    let k={0, 1, 2, 3}  # green and orange mixes
  }
  level hard {
    let k={2, 3, 4, 5}  # orange and purple mixes
  }

  scene 30x15 {
    paintpots pots pots=["{if k == 0 or k == 5 then \"blue\" else if k == 1 or k == 3 then \"yellow\" else \"red\"}", "?"] makes="{if k < 2 then \"blue+yellow\" else if k < 4 then \"red+yellow\" else \"red+blue\"}" labels=true at=canvas(1, 1)
    text ask "The second pot has lost its paint. Which paint was in it?" width=28 below=pots gap=1
    choice pick options=["red", "yellow", "blue"] below=ask gap=1
  }

  check paint.mixes of=pots pick=missing
  hint "Look at the pot at the end. What colour did the two pots make?"
  hint "Which two paints make that colour? One of them is already in the first pot."
}
