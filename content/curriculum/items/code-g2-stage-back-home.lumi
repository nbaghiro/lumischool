# The number in the tap script has to undo the flag script, which goes round a repeat: working
# backwards, and the repeat has to be multiplied out first.
item coding.stage-back-home v=1 stars=2 skills=[coding.events, coding.repetition, reasoning.inverse] {
  title "Back to the start"
  difficulty (n * a)
  let a=1..3 n=2..3 c=1..2
  where (c + n * a <= 8)

  scene 36x20 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks bl code=["when the flag is tapped", "repeat {n}", "  right {a}", "when tapped", "left {n * a}"] blank=5
      stage s cols=8 col=c who=rabbit code=["when the flag is tapped", "repeat {n}", "  right {a}", "when tapped", "left {n * a}"] upto=0
    }
    text ask "After the flag and then a tap, the rabbit is back where it started. The empty block is a left block. What number is on it?" width=28 below=top gap=1
    number-input answer right-of=ask gap=1
  }

  answer (n * a)
  feedback {
    when (answer == a) point=bl {
      say "That is one time round the repeat. The flag script goes round {n} times."
    }
  }
  hint "How far right does the flag script move the rabbit altogether?"
  hint "To come back, the tap script has to go the same distance the other way."
}
