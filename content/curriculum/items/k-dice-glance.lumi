# Dots in the dice pattern are seen, not counted: the pattern is the number.
item k.dice-glance v=1 skills=[counting.subitising] {
  title "How many dots?"
  difficulty n
  let n=1..6
  level easy {
    let n=1..3
  }
  level hard {
    let n=4..6
  }

  scene 30x10 {
    dice d faces=[n] at=canvas(1, 1)
    text q "Ada rolls a dice on the garden path. Look quickly: how many dots?" narrate width=18 right-of=d gap=2
    number-input answer below=q gap=1
  }

  answer n
  feedback {
    when (answer == n + 1 or answer == n - 1) point=d {
      say "Look at the shape the dots make. Which number makes that shape?"
    }
  }
  hint "Do the dots make a line, a triangle, a square, or a square with one in the middle?"
  hint "Which dice face looks just like this one?"
}
