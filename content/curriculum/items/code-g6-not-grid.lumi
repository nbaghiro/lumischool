# The three-star: no method on the page. Wind and river each read 0 to 5, so there are 36 pairs. With
# and, the yes pairs are a rectangle to count; with or, it is quicker to count the no pairs, where
# both readings are over their marks, and take them from 36.
item coding.not-grid v=1 stars=3 skills=[coding.logic, reasoning.all-the-ways, reasoning.structure] {
  title "How many days open?"
  difficulty (k * 2 + (w + v) / 10)
  let k=0..1 w=1..4 v=1..4
  level easy {
    let k={0}
  }
  level hard {
    let k={1}
  }

  scene 36x28 {
    program p code=["if not wind is more than {w} {if k == 0 then \"and\" else \"or\"} not river is more than {v}", "  say open", "otherwise", "  say shut"] text=true at=canvas(0, 0)
    text ask "The gorge path's sign reads the wind and the river, each a whole number from 0 to 5. That makes 36 different pairs. For how many of the 36 pairs does the sign say open?" narrate width=34 below=p gap=1
    number-input answer width=3 below=ask gap=1
    rainbow rb right-of=answer gap=8
  }

  answer (if k == 0 then (w + 1) * (v + 1) else 36 - (5 - w) * (5 - v))
  feedback {
    when (k == 0 and answer == w * v) point=p {
      say "Not more than {w} includes {w} itself, and 0 too. How many readings is that?"
    }
    when (k == 1 and answer == (w + 1) * (v + 1)) point=p {
      say "That counts the pairs where both are low. With or, one low reading is enough."
    }
  }
  hint "How many wind readings from 0 to 5 are not more than {w}? How many river readings are not more than {v}?"
  hint "Draw every pair as a grid, wind across and river down, and shade the ones that say open. Is it quicker to count the shut ones?"
}
