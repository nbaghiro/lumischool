# The rule of fifths: a face is five eye widths across (the neoclassical canons as a study of 103
# faces lists them, PMC3532441). The eye width is measured on the ruler.
item art.face-fifths v=1 skills=[art.proportion, art.portrait, decimals.multiply] {
  title "Five eyes wide"
  difficulty (e * 2 - 4)
  let e={2, 2.5, 3, 3.5}
  level easy {
    let e={2, 2.5}
  }
  level hard {
    let e={3, 3.5}
  }

  scene 36x21 {
    ruler eye cm=6 length=e start=0 thing=stick at=canvas(1, 1)
    text ask "By the waterfall, Ana draws Ben's portrait. She measures the width of one eye on her drawing with a stick, shown on the ruler. An old rule for faces says a face is five eyes wide. How many centimetres wide should she draw the face?" narrate width=34 below=eye gap=1
    number-input answer below=ask gap=1
  }

  answer (5 * e)
  feedback {
    when (answer == 4 * e) point=eye {
      say "Count the eye widths across a face: the two eyes, the gap between them, and one more on each side."
    }
  }
  hint "Read the eye's width from the ruler."
  hint "The face is five of those across."
}
