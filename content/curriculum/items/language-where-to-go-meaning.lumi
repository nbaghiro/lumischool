# The language to English: [[phrase.where-do-you-want-to-go]], [[phrase.i-want-to-go-to-egypt-to-see-the-pyramid]], [[phrase.in-italy-you-can-eat-pizza]], [[phrase.in-japan-you-can-see-mount-fuji]], [[phrase.i-like-the-food-of-mexico]], [[phrase.in-winter-it-is-very-cold]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.where-to-go-meaning v=1 skills=[language.travel, language.opinions] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "gran", "girl", "boy", "girl")] says=[pick(k, "[[phrase.where-do-you-want-to-go]]", "[[phrase.i-want-to-go-to-egypt-to-see-the-pyramid]]", "[[phrase.in-italy-you-can-eat-pizza]]", "[[phrase.in-japan-you-can-see-mount-fuji]]", "[[phrase.i-like-the-food-of-mexico]]", "[[phrase.in-winter-it-is-very-cold]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "In winter it is very cold.", "In Japan you can see Mount Fuji.", "I want to go to Egypt to see the pyramids.", "In winter it is very cold.", "In winter it is very cold.", "In Japan you can see Mount Fuji."), pick(k, "Where do you want to go?", "I want to go to Egypt to see the pyramids.", "I like the food of Mexico.", "In Japan you can see Mount Fuji.", "In Italy you can eat pizza.", "In winter it is very cold."), pick(k, "In Italy you can eat pizza.", "I like the food of Mexico.", "In Japan you can see Mount Fuji.", "I want to go to Egypt to see the pyramids.", "I like the food of Mexico.", "In Italy you can eat pizza."), pick(k, "I like the food of Mexico.", "In Italy you can eat pizza.", "In Italy you can eat pizza.", "In Italy you can eat pizza.", "In Japan you can see Mount Fuji.", "I like the food of Mexico.")] stack=column
    }
  }

  answer pick=pick(k, "Where do you want to go?", "I want to go to Egypt to see the pyramids.", "In Italy you can eat pizza.", "In Japan you can see Mount Fuji.", "I like the food of Mexico.", "In winter it is very cold.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
