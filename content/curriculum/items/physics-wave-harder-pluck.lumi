# Two stars: plucking the same band harder makes it vibrate further either way but no faster, so the
# trace is taller with the same number of waves; the reason is chosen with the trace.
item physics.wave-harder-pluck v=1 stars=2 skills=[physics.sound, reasoning.explain, reasoning.predict] {
  title "A harder pluck"
  difficulty (if w == 3 then 0 else 1)
  let w={3, 5}
  level easy {
    let w={3}
  }
  level hard {
    let w={5}
  }

  scene 26x40 {
    wave s waves=[w, w, 2 * w] heights=[1, 3, 1] across=10 letters=1 blank=-1 at=canvas(1, 0)
    text ask "A is a band plucked gently. The same band is plucked much harder. Which screen shows it, and why?" narrate width=20 below=s gap=1
    choice pick options=["B: it shakes further but no faster", "C: it shakes faster", "B: it shakes faster and further", "C: it shakes further"] stack=column below=ask gap=1
  }

  answer pick="B: it shakes further but no faster"
  feedback {
    when (pick == "C: it shakes faster" or pick == "C: it shakes further") point=s {
      say "C has more waves, so it is a higher note. Does plucking harder change the band's length?"
    }
    when (pick == "B: it shakes faster and further") point=s {
      say "Count the waves on A and B. Are there more on B?"
    }
  }
  hint "What decides the pitch of a band, how hard it is plucked or how long it is?"
  hint "Which screen has the same number of waves as A but taller ones?"
}
