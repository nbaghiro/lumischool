# Three notes on the staff, numbered from lowest to highest by where they sit.
item music.rank-notes v=1 skills=[music.pitch, music.staff, reasoning.order] {
  title "Lowest to highest"
  difficulty (if p == 0 then 0 else if k == 1 then 2 else 1)
  let k=0..1 p=0..2
  let lo={pick(k, "C", "D")}
  let mid={pick(k, "E", "F")}
  let hi={pick(k, "G", "A")}
  let n1={pick(p, pick(k, "C4", "D4"), pick(k, "G4", "A4"), pick(k, "E4", "F4"))}
  let n2={pick(p, pick(k, "E4", "F4"), pick(k, "C4", "D4"), pick(k, "G4", "A4"))}
  let n3={pick(p, pick(k, "G4", "A4"), pick(k, "E4", "F4"), pick(k, "C4", "D4"))}
  let l1={pick(p, lo, hi, mid)}
  let l2={pick(p, mid, lo, hi)}
  let l3={pick(p, hi, mid, lo)}
  level easy {
    let k=0..0 p=0..1
  }
  level hard {
    let k=1..1 p=1..2
  }

  scene 34x32 {
    grandstaff tune notes=["{n1}", "{n2}", "{n3}"] letters=true lit=[] landmarks=false at=canvas(1, 1)
    text ask "Three notes on the top staff. Write 1 by the lowest, 2 by the middle one and 3 by the highest." narrate width=32 below=tune gap=1
    sequence s items=["{l1}", "{l2}", "{l3}"] blanks=[x, y, z] below=ask gap=1
  }

  answer x=(if p == 0 then 1 else if p == 1 then 3 else 2) y=(if p == 0 then 2 else if p == 1 then 1 else 3) z=(if p == 0 then 3 else if p == 1 then 2 else 1)
  hint "The lowest note sits lowest on the staff. Find it first and write 1."
  hint "Then the highest, at the top, gets 3. The one left is 2."
}
