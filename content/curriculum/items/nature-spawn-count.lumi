# The story: Ada's frogspawn in the marsh pond, and how many of the eggs come all the way round
# to frogs, a half and then a quarter, which is a fraction of a fraction.
item nature.spawn-count v=1 skills=[nature.life-cycles, fractions.of-a-set] {
  title "How many frogs?"
  difficulty (n / 8 + w)
  let n={16, 24, 32, 40} w=0..1
  let asks={pick(w, "How many tadpoles hatch?", "How many of the eggs become frogs?")}
  level easy {
    let n={16, 24} w=0..0
  }
  level hard {
    let n={32, 40} w=1..1
  }

  scene 34x22 {
    row pics at=canvas(1, 1) space=2 align=end {
      pond pool pads=3 fish=0 frog=true
      frogcycle life stage=4 ring=1 names=0
    }
    text ask "Ada counts {n} eggs in a clump of frogspawn in the marsh pond. Half of the eggs hatch into tadpoles, and a quarter of the tadpoles grow into frogs. {asks}" narrate width=32 below=pics gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then n / 2 else n / 8)
  feedback {
    when (w == 1 and answer == n / 4) point=life {
      say "A quarter of the tadpoles, not a quarter of the eggs. Find the tadpoles first, then a quarter of them."
    }
    when (w == 1 and answer == n / 2) point=life {
      say "That is the tadpoles. Only a quarter of them go on to be frogs."
    }
    when (w == 0 and answer == n) point=pool {
      say "Only half of the eggs hatch."
    }
  }
  hint "Half of {n} hatch. How many is that?"
  hint "For the frogs: take a quarter of the tadpoles, not of the eggs."
}
