item writing.which-mark v=1 skills=[writing.punctuation] {
  title "Which mark to write"
  difficulty (if k == 1 then 2 else if k == 0 then 1 else 0)
  let k=0..2

  scene 32x15 {
    art pic asset="{if k == 0 then \"owl\" else if k == 1 then \"rocket\" else \"cat\"}" at=canvas(1, 1)
    sentence strip before="{if k == 0 then \"Is the owl awake\" else if k == 1 then \"Look at it go\" else \"The cat is asleep\"}" blank=2 after="" right-of=pic gap=1
    text ask "Which mark should this sentence end with?" width=18 below=strip gap=1
    choice pick options=[".", "?", "!"] below=ask gap=1
  }

  answer pick=(if k == 0 then "?" else if k == 1 then "!" else ".")
  feedback {
    when (pick == "." and k == 1) point=strip {
      say "This one is said in a loud, excited voice, so it takes an exclamation mark."
    }
  }
  hint "Telling takes a full stop, asking takes a question mark, a shout or a surprise takes an exclamation mark."
}
