# Four creatures matched to where each spends its day, the places shuffled four ways, none of them
# 1, 2, 3, 4 or a turn of it, so one answer does not give the rest.
item nature.match-place v=1 skills=[nature.habitats] {
  title "Match each one to its place"
  let k=0..3

  scene 36x23 {
    row four at=canvas(1, 1) space=1 align=end {
      seal ps rock=1 facing=1
      gull pg flying=1
      crabs pc count=1
      seaturtle pt facing=1 plates=5
    }
    text ask "Write the number of its place next to each creature." narrate width=32 below=four gap=1
    match m left=["seal", "gull", "crab", "sea turtle"] right=["{if k == 0 then \"the open sea\" else if k == 1 then \"a rock pool\" else if k == 2 then \"the air over the waves\" else \"a rock pool\"}", "{if k == 0 then \"a rock to rest on\" else if k == 1 then \"the open sea\" else if k == 2 then \"a rock to rest on\" else \"the air over the waves\"}", "{if k == 0 then \"the air over the waves\" else if k == 1 then \"a rock to rest on\" else if k == 2 then \"a rock pool\" else \"the open sea\"}", "{if k == 0 then \"a rock pool\" else if k == 1 then \"the air over the waves\" else if k == 2 then \"the open sea\" else \"a rock to rest on\"}"] blanks=[a, b, c, d] below=ask gap=1
  }

  answer a=(if k == 0 then 2 else if k == 1 then 3 else if k == 2 then 2 else 4) b=(if k == 0 then 3 else if k == 1 then 4 else if k == 2 then 1 else 2) c=(if k == 0 then 4 else if k == 1 then 1 else if k == 2 then 3 else 1) d=(if k == 0 then 1 else if k == 1 then 2 else if k == 2 then 4 else 3)
  hint "Start with the one you are surest of. Where does a gull spend its day?"
  hint "The seal rests out of the water, the crab hides in a pool, and the turtle stays out at sea."
}
