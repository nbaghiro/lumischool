item k.true-or-not v=1 skills=[reading.nonfiction] {
  title "True or made up?"
  difficulty (if k <= 2 then 0 else 1)
  let k=0..5
  let line={pick(k, "Fish live in water.", "Cats can fly.", "Snails have shells.", "A spider has eight legs.", "Ducks have fur.", "Bees visit flowers.")}
  let right={pick(k, "true", "made up", "true", "true", "made up", "true")}
  level easy {
    let k=0..2
  }
  level hard {
    let k=3..5
  }

  scene 27x26 {
    labelled pic of=windmill labels=["sails", "cap", "tower", "door", "mill"] blank=-1 title="Windmills" caption="" at=canvas(1, 1)
    text q "Ben has a fact book about garden animals, and it says only true things. Would it say: {line}" narrate width=24 below=pic gap=1
    choice pick options=["true", "made up"] stack=row below=q gap=1
  }

  answer pick=right
  hint "Have you seen this, or read it in a book you trust?"
}
