# The three-star: four baskets to slide, and the pushes to number by size. Nothing on the page
# says which push is bigger; the child has to count the apples, decide that more apples means
# heavier, and that heavier needs the bigger push. At hard the numbering runs the other way and
# the counts are close.
item physics.pushes-in-order v=1 stars=3 skills=[physics.forces, reasoning.order] {
  title "Four pushes in order"
  difficulty (pick(p, 0, 0, 1, 1, 2, 2) + 2 * way)
  set way=0
  let p=0..5
  let a={pick(p, 1, 3, 8, 4, 6, 5)}
  let b={pick(p, 3, 8, 2, 6, 3, 7)}
  let c={pick(p, 5, 1, 5, 2, 5, 4)}
  let d={pick(p, 8, 5, 3, 7, 4, 6)}
  let ra={pick(p, 1, 2, 4, 2, 4, 2)}
  let rb={pick(p, 2, 4, 1, 3, 1, 4)}
  let rc={pick(p, 3, 1, 3, 1, 3, 1)}
  let rd={pick(p, 4, 3, 2, 4, 2, 3)}
  let first={if way == 0 then "smallest" else "biggest"}
  let last={if way == 0 then "biggest" else "smallest"}
  level easy {
    let p=0..1
  }
  level hard {
    set way=1
    let p=4..5
  }

  scene 36x29 {
    basket one item=apple count=a at=canvas(0, 0)
    text la "A" below=one gap=0
    basket two item=apple count=b right-of=one gap=0
    text lb "B" below=two gap=0
    basket three item=apple count=c right-of=two gap=0
    text lc "C" below=three gap=0
    basket four item=apple count=d right-of=three gap=0
    text ld "D" below=four gap=0
    text ask "Sam slides each basket across the kitchen floor. Number the pushes he needs from the {first}, 1, to the {last}, 4." narrate width=34 below=la gap=1
    sequence s items=["A", "B", "C", "D"] blanks=[qa, qb, qc, qd] below=ask gap=1
  }

  answer qa=(if way == 0 then ra else 5 - ra) qb=(if way == 0 then rb else 5 - rb) qc=(if way == 0 then rc else 5 - rc) qd=(if way == 0 then rd else 5 - rd)
  feedback {
    when (qa == 1 and qb == 2 and qc == 3 and qd == 4 and (p != 0 or way == 1)) point=one {
      say "That is the order they stand in. Count the apples in each basket first: the push follows the apples, not the place in the row."
    }
    when (qa == (if way == 0 then 5 - ra else ra) and qb == (if way == 0 then 5 - rb else rb) and qc == (if way == 0 then 5 - rc else rc) and qd == (if way == 0 then 5 - rd else rd)) point=s {
      say "That is the right order, but the other way round. Which end is number 1?"
    }
  }
  hint "Count the apples in each basket. Which basket is the heaviest?"
  hint "A heavier basket needs a bigger push. Which push gets number 1?"
}
