# The way in to a repeat through a list: each time round, h holds the next item, so the robot moves
# by each item in turn and ends as far along as the items add up to.
item coding.each-where v=1 skills=[coding.lists, coding.repetition] {
  title "Hop by hop along the towpath"
  difficulty (n + (a + b + c) / 10)
  let n=0..1 a=1..3 b=1..3 c=1..3 e={2}
  where (a != b or b != c)
  level easy {
    let n={0}
    where (a + b + c <= 6)
  }
  level hard {
    let n={1}
  }

  scene 36x15 {
    maze m cols=12 rows=1 col=1 row=1 code=["set hops to list {a}, {b}, {c}{if n == 1 then \", 2\" else \"\"}", "for each h in hops", "  right h"] upto=0 trail=none at=canvas(1, 0)
    program p code=["set hops to list {a}, {b}, {c}{if n == 1 then \", 2\" else \"\"}", "for each h in hops", "  right h"] below=m gap=1
    text ask "The robot walks the towpath. Which column does it stop on?" width=11 right-of=p gap=1
    number-input col below=ask gap=1
  }

  check coding.runs of=m col=col
  feedback {
    when (col == a + b + c + e * n) point=m {
      say "The robot starts on column 1, so it stops one further along than the total of the hops."
    }
    when (col == 1 + a) point=p {
      say "The repeat goes round once for every item in hops, not just the first."
    }
  }
  hint "What is h the first time round? What is it the second time?"
  hint "Add up the hops, then count on from column 1."
}
