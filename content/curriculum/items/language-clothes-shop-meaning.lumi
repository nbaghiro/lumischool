# The language to English: [[phrase.do-you-have-this-t-shirt-in-blue]], [[phrase.size-thirty-two-please]], [[phrase.the-changing-room-is-at-the-back]], [[phrase.there-is-a-sale-everything-at-half-price]], [[phrase.it-fits-me-well]], [[phrase.it-is-a-bit-dear]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.clothes-shop-meaning v=1 skills=[language.market, language.clothes] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "gran", "girl", "boy", "girl")] says=[pick(k, "[[phrase.do-you-have-this-t-shirt-in-blue]]", "[[phrase.size-thirty-two-please]]", "[[phrase.the-changing-room-is-at-the-back]]", "[[phrase.there-is-a-sale-everything-at-half-price]]", "[[phrase.it-fits-me-well]]", "[[phrase.it-is-a-bit-dear]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "It is a bit dear.", "There is a sale: everything at half price.", "Size thirty-two, please.", "It is a bit dear.", "It is a bit dear.", "There is a sale: everything at half price."), pick(k, "Do you have this T-shirt in blue?", "Size thirty-two, please.", "It fits me well.", "There is a sale: everything at half price.", "The changing room is at the back.", "It is a bit dear."), pick(k, "The changing room is at the back.", "It fits me well.", "There is a sale: everything at half price.", "Size thirty-two, please.", "It fits me well.", "The changing room is at the back."), pick(k, "It fits me well.", "The changing room is at the back.", "The changing room is at the back.", "The changing room is at the back.", "There is a sale: everything at half price.", "It fits me well.")] stack=column
    }
  }

  answer pick=pick(k, "Do you have this T-shirt in blue?", "Size thirty-two, please.", "The changing room is at the back.", "There is a sale: everything at half price.", "It fits me well.", "It is a bit dear.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
