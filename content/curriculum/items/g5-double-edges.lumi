# The two-star: doubling one, two or three edges multiplies the volume by two, four or eight. The
# reason is the layers and rows, and the child uses it rather than measuring again.
item volume.double-edges v=1 stars=2 skills=[volume.cuboids, reasoning.multiplicative] {
  title "Twice as long"
  difficulty (k * 2 + v / 100)
  let v={60, 90, 120} k=1..3
  level easy {
    let k={1}
  }
  level hard {
    let k={3}
  }

  scene 33x13 {
    cubestack stack l=4 w=3 h=2 at=canvas(1, 1)
    text ask "A box holds {v} cubic centimetres. A second box has {if k == 1 then \"its length\" else if k == 2 then \"its length and its width\" else \"its length, width and height all\"} twice as long. How many cubic centimetres does it hold?" narrate width=16 right-of=stack gap=1
    number-input answer width=5 below=stack gap=1
  }

  answer (v * 2 ^ k)
  feedback {
    when (k > 1 and answer == v * 2) point=stack {
      say "Doubling the length doubles the volume. What does doubling the width do on top of that?"
    }
    when (k == 3 and answer == v * 4) point=stack {
      say "The height is doubled too, so there are twice as many layers again."
    }
  }
  hint "If the length doubles, what happens to each row of cubes?"
  hint "Each edge that doubles doubles the whole volume once more."
}
