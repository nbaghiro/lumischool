# The words from three bubbles with no pictures, out of order: the story has to be rebuilt from
# what makes sense, which is reading the words for what must come first.
item reading.bubble-order v=1 skills=[reading.comics, reading.sequencing] {
  title "Which bubble comes first?"
  let k=0..3

  scene 30x15 {
    text ask "These words come from three bubbles in one comic. Put them in order. Write 1, 2 and 3." narrate width=28 at=canvas(1, 1)
    sequence s items=[if k == 0 then "When is the next one?" else if k == 1 then "A puppy. Thank you." else if k == 2 then "It is my turn on the swing." else "This one is too big.", if k == 0 then "Here it comes now." else if k == 1 then "What a big box." else if k == 2 then "Higher, higher." else "I need a hat for the party.", if k == 0 then "Oh no, the bus has gone." else if k == 1 then "What could be inside?" else if k == 2 then "Can you push me?" else "This one fits."] blanks=[a, b, c] below=ask gap=1
  }

  answer a=(if k == 0 then 2 else if k == 1 then 3 else if k == 2 then 1 else 2) b=(if k == 0 then 3 else if k == 1 then 1 else if k == 2 then 3 else 1) c=(if k == 0 then 1 else if k == 1 then 2 else if k == 2 then 2 else 3)
  hint "Which words could only come at the start?"
  hint "Which words answer or follow another line? Those come after it."
}
