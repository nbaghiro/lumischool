# Pieces eaten out of the whole bar, then matched to a fraction with a smaller bottom number.
item fractions.chocolate-same v=1 skills=[fractions.equivalent] {
  title "How much has gone?"
  difficulty (r * c + f)
  let r=2..3 c={4, 6} f={2, 3, 4} k=1..3
  where (k < f and r * c % f == 0)
  level easy {
    let r={2} c={4}  # eight pieces, in halves or quarters
  }
  level hard {
    let r={3} f={3, 4}  # twelve or eighteen pieces, in thirds or quarters
  }

  scene 28x20 {
    chocolate bar rows=r cols=c eaten=(r * c * k / f) at=canvas(1, 1)
    text ask "The bar had {r * c} pieces. Some have been eaten. Which fraction of the bar has been eaten?" width=26 below=bar gap=1
    choice pick options=[1 / 2, 1 / 3, 2 / 3, 1 / 4, 3 / 4] below=ask gap=1
  }

  answer pick=(k / f)
  feedback {
    when (pick == 1 - k / f and 2 * k != f) point=bar {
      say "That is the part still in the foil. The question asks what has gone."
    }
  }
  hint "How many pieces have gone, out of how many?"
  hint "Can you split the bar into equal groups so the eaten pieces make whole groups?"
}
