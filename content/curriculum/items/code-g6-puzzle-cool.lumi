# Puzzle: the gap is worked out once, before the repeat, so the cocoa loses the same amount every ten
# minutes. The value as written is run; the line that belongs inside is stated.
item coding.puzzle-cool v=1 skills=[coding.debugging, coding.simulation] {
  title "Cocoa that cools too steadily"
  difficulty (n / 2)
  let n=2..3 g={32, 64}
  let s={20 + g}
  level easy {
    let n={2}
  }
  level hard {
    let n={3}
  }

  scene 36x24 {
    program p code=["set air to 20", "set cocoa to {s}", "set gap to cocoa - air", "repeat {n}", "  take gap / 2 from cocoa"] text=true at=canvas(0, 0)
    thermometer th from=0 to=100 step=20 value=s right-of=p gap=1
    text ask "The cocoa should lose half the gap each time, so less and less. What does cocoa hold as written? Which line should move inside the repeat?" width=20 at=canvas(0, 15)
    text tc "cocoa" right-of=ask gap=1
    number-input cocoa right-of=tc gap=1
    text tl "line" below=tc gap=1
    number-input line right-of=tl gap=1
  }

  check coding.runs of=p cocoa="value(cocoa)"
  answer line=3
  feedback {
    when (cocoa == pick(n - 2, 20 + g / 4, 20 + g / 8)) point=p {
      say "That is what it should be. As written, gap is worked out once, so each time round takes the same amount."
    }
  }
  hint "How many times is gap worked out? Does it ever change?"
  hint "Which line has to run again each time for gap to shrink?"
}
