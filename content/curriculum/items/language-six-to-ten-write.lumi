# The word written from its picture: [[num.six]], [[num.ten]], [[num.five]], [[num.eight]], [[num.seven]], [[num.nine]].
# Accent-tolerant: the box takes the word with its accents left off (accents=loose); ñ is a letter and is marked.
item language.six-to-ten-write v=1 skills=[language.numbers, language.spelling] {
  title "Write the word"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x16 {
    column all at=canvas(1, 1) space=1 align=start {
      tenframe frame count=pick(k, 6, 10, 5, 8, 7, 9) color=berry
      text ask "How many are in the frame? Write it in [[language.name]]." width=32
      word-input word options=[pick(k, "[[num.six]]", "[[num.ten]]", "[[num.five]]", "[[num.eight]]", "[[num.seven]]", "[[num.nine]]")] accents=loose
    }
  }

  answer word=pick(k, "[[num.six]]", "[[num.ten]]", "[[num.five]]", "[[num.eight]]", "[[num.seven]]", "[[num.nine]]")
  hint "Say the word quietly first. What sound does it start with?"
  hint "Count the sounds, then write one letter or pair of letters for each."
}
