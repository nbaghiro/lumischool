# The three land units side by side: 1 ha is 100 m by 100 m, 10,000 m², and 1 km² is 1,000 m by
# 1,000 m, which is 10 by 10 hectares, 100 ha.
item land.convert-units v=1 skills=[measure.metric.hectares, measure.convert] {
  title "Hectares and square kilometres"
  difficulty pick(q, 0, 1, 1, 2)
  let q=0..3 a={2, 3, 6, 12}
  let v={pick(q, a * 10000, a, a, a * 100)}
  level easy {
    let q={0, 2}
  }
  level hard {
    let q={1, 3}
  }

  scene 36x11 {
    sign board lines=["MILL FARM", "{thousands(v)} {pick(q, \"m²\", \"ha\", \"km²\", \"ha\")}"] kind=post color=mint at=canvas(1, 1)
    text ask "The sign by the mill gives the farm's area. What is it in {pick(q, \"hectares\", \"square metres\", \"hectares\", \"square kilometres\")}?" narrate width=20 right-of=board gap=2
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=7
      text unit "{pick(q, \"ha\", \"m²\", \"ha\", \"km²\")}"
    }
  }

  answer pick(q, a, a * 10000, a * 100, a)
  feedback {
    when (q == 0 and (answer == a * 100 or answer == a * 10)) point=board {
      say "A hectare is 100 m by 100 m. How many square metres is that?"
    }
    when (q == 1 and (answer == a * 100 or answer == a * 1000)) point=board {
      say "A hectare is 100 m by 100 m, so one hectare is 100 × 100 square metres."
    }
    when (q == 2 and answer == a * 1000) point=board {
      say "A kilometre is ten lots of 100 m, so a square kilometre is 10 rows of 10 hectares."
    }
    when (q == 3 and answer == a * 10) point=board {
      say "A square kilometre is 10 rows of 10 hectares. How many hectares is that?"
    }
  }
  hint "How long is each side of a hectare, and of a square kilometre?"
  hint "How many of the smaller squares fit in one of the bigger ones?"
}
