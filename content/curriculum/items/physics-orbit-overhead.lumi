# Two stars: where the moon must stand to be high overhead at a given hour, which is what makes a full
# moon a thing of the middle of the night and a new moon a thing of noon. The child's hour is drawn on
# the Earth, so the answer is read from the picture and not remembered.
item physics.orbit-overhead v=1 stars=2 skills=[physics.sky, reasoning.work-backwards] {
  title "Overhead at that hour"
  difficulty (if t == 0 or t == 2 then 0 else 1)
  let t=0..3
  let ans={pick(t, "A", "C", "E", "G")}
  let named={pick(t, "noon", "dusk", "midnight", "dawn")}
  level easy {
    let t={0, 2}
  }
  level hard {
    let t={1, 3}
  }

  scene 32x27 {
    orbit sky moon=-1 places=1 arrow=1 person=1 time=t at=canvas(1, 0)
    text ask "The child is standing at {named}, and the eight places the moon can be in are lettered. At which place would the moon be right over the child's head?" narrate width=26 below=sky gap=1
    choice pick options=["A", "B", "C", "D", "E", "F", "G", "H"] stack=row below=ask gap=1
  }

  answer pick=ans
  feedback {
    when (t == 0 and pick == "E") point=sky {
      say "Place E is the full moon, on the far side of the Earth from the sun. At noon the child faces the sun, so the full moon is under their feet, which is why a full moon is never overhead at noon."
    }
  }
  hint "Draw a line from the middle of the Earth out through the child. Which place does it point at?"
  hint "The child is carried round by the turning Earth, so the hour says which way they face."
}
