# Only the sums are given: guess a corner, follow it round, and adjust. At grade four the numbers
# are two-digit, so a good first guess saves a lot of adjusting.
item puzzle.triangle-sums v=1 stars=3 skills=[addition.mental, reasoning.guess-and-check] {
  title "Corners from the sums"
  difficulty (x + y + z)
  let x=12..30 y=12..30 z=12..30
  where (x != y and y != z and x != z)
  where (x % 3 == 0 and y % 4 == 0 and z % 5 == 0)

  scene 30x13 {
    sumtriangle tri a=x b=y c=z hide=corners letters=true at=canvas(1, 0)
    text ask "Each box is the sum of the two circles it joins. What number goes in circle A?" narrate width=13 right-of=tri gap=1
    number-input answer below=ask gap=1
  }

  answer x
  feedback {
    when (answer == x + y or answer == x + z) point=tri {
      say "That is a box. A circle is smaller than each box it touches."
    }
  }
  hint "Add all three boxes. Every circle has been counted twice."
  hint "Half of that is the three circles together. Which box does A not touch?"
}
