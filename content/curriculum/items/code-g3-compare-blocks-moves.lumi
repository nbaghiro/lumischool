# Two ways to measure one program: the blocks written, counting the repeat as a block, and the squares
# the robot moves when it runs. A repeat makes the second much bigger than the first.
item coding.compare-blocks-moves v=1 skills=[coding.comparing, coding.repetition, coding.tracing] {
  title "Blocks written, squares moved"
  difficulty (n * (m + 1))
  let n=2..4 m=1..3
  where (n * m <= 7)
  level easy {
    where (n * (m + 1) <= 6)
  }
  level hard {
    where (n * (m + 1) >= 8)
  }

  scene 36x22 {
    row top at=canvas(1, 0) space=2 align=start {
      maze g cols=8 rows=5 code=["repeat {n}", "  right {m}", "  down 1"] upto=0 trail=none
      program p code=["repeat {n}", "  right {m}", "  down 1"]
    }
    text ask "How many blocks does this program have, counting the repeat? How many squares does the robot move when it runs?" narrate width=34 below=top gap=1
    row ans below=ask gap=1 space=1 align=centre {
      text lb "blocks"
      number-input blocks width=3
      text ls "squares"
      number-input squares width=3
    }
  }

  check coding.runs of=g blocks=lines squares=moves
  feedback {
    when (blocks == 2 * n) point=p {
      say "That counts the moves as they run. Count the blocks as they are written: the repeat and the two inside it."
    }
    when (squares == m + 1) point=p {
      say "That is one time round. The repeat runs it {n} times."
    }
    when (squares == n * m) point=p {
      say "The down move inside the repeat moves the robot too."
    }
  }
  hint "Point at each block in the listing once. How many are there?"
  hint "How many squares does one time round move? How many times round are there?"
}
