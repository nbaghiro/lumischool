# The century of an event of the family's country, from the record (n as in n5-order).
item history.n5-century v=1 skills=[history.nation, history.centuries] {
  title "Which century?"
  difficulty k
  let n=0..4 k=0..1
  let i={n + 5 * k}
  let ev={pick(i, "Domesday Book", "Jamestown founded", "Shinkansen opens", "Novgorod first mentioned", "Grand Canal completed", "Alfred becomes king", "Georgia founded", "Television broadcasts in Japan", "Birch-bark letters found", "Qin unites China")}
  let yr={pick(i, 1086, 1607, 1964, 859, 609, 871, 1732, 1953, 1951, -221)}
  let o1={pick(i, "10th century", "16th century", "19th century", "8th century", "6th century", "8th century", "17th century", "19th century", "19th century", "2nd century BC")}
  let o2={pick(i, "11th century", "17th century", "20th century", "9th century", "7th century", "9th century", "18th century", "20th century", "20th century", "3rd century BC")}
  let o3={pick(i, "12th century", "18th century", "21st century", "10th century", "8th century", "10th century", "19th century", "21st century", "21st century", "22nd century BC")}
  let from={pick(i, 1000, 1600, 1900, 800, 600, 800, 1700, 1900, 1900, -300)}
  let to={pick(i, 1100, 1700, 2000, 900, 700, 900, 1800, 2000, 2000, -200)}
  let step={pick(i, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20)}

  scene 34x21 {
    timeline line from=from to=to step=step years=[yr] labels=["{ev}"] at=canvas(1, 0)
    text ask "In which century was this?" narrate width=16 below=line gap=1
    choice pick options=["{o1}", "{o2}", "{o3}"] stack=column right-of=ask gap=1
  }

  check history.dates of=line pick="century-name(0)"
  hint "Is the year BC or AD? Read it from the flag."
  hint "A century's number is one more than its hundreds, unless the year ends in 00."
}
