# A note about who lives where in the lane of scribes, read against the houses. Every clue alone
# fits more than one house, and in the harder versions one clue compares two houses or says what is
# next door.
item reading.which-house v=1 skills=[reading.inference, reading.comprehension] {
  title "Which house?"
  difficulty pick(k, 1, 1, 2, 2)
  let k=0..3

  scene 35x18 {
    column all at=canvas(0, 1) space=1 align=start {
      street lane windows=[2, 1, 2, 3, 1] doors=[1, 0, 0, 0, 1] chimneys=[0, 1, 1, 0, 0] cats=[0, 1, 0, 0, 1] numbers=["1", "3", "5", "7", "9"]
      row bottom space=1 align=centre {
        text ask "{pick(k, \"The bookbinder has a round door and no chimney, and there is no cat on the step. Which house?\", \"The scribe's house has more than one window upstairs, a square door and no chimney. Which house?\", \"The mapmaker lives next door to a house with a cat, and has a chimney. Which house?\", \"The inkmaker has as many windows upstairs as number 1, but not the same kind of door. Which house?\")}" width=30
        number-input answer
      }
    }
  }

  answer pick(k, 1, 7, 5, 5)
  feedback {
    when (k == 0 and answer == 9) point=lane {
      say "Number 9 has a round door and no chimney, but look at its step."
    }
    when (k == 2 and answer == 3) point=lane {
      say "Number 3 has a cat itself. The mapmaker lives next door to one."
    }
  }
  hint "Take the first clue and find every house it fits."
  hint "Now use the next clue to cross out the ones that do not fit it."
}
