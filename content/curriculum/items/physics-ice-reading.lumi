# Four iced cups after twenty minutes in a room at 20 degrees: no wrap 20, paper 15, foil and bubble
# wrap 10, cloth 5, wool 0 (ice still there). Cup B's reading is asked; at odd k it is on a half
# mark.
item physics.ice-reading v=1 skills=[physics.heat, physics.measuring] {
  title "Read the thermometer"
  difficulty (if k == 1 or k == 3 or k == 5 or k == 7 then 1 else 0)
  let k=0..7
  let w1={pick(k, "cloth", "foil", "none", "paper", "wool", "none", "foil", "wool")}
  let w2={pick(k, "none", "paper", "foil", "cloth", "bubble", "paper", "none", "cloth")}
  let w3={pick(k, "paper", "cloth", "cloth", "none", "none", "wool", "wool", "paper")}
  let w4={pick(k, "foil", "none", "paper", "foil", "paper", "foil", "cloth", "none")}
  level easy {
    let k={0, 2, 4, 6}
  }
  level hard {
    let k={1, 3, 5, 7}
  }

  scene 24x21 {
    wrapped cups wraps=["{w1}", "{w2}", "{w3}", "{w4}"] ice=1 minutes=20 at=canvas(1, 0)
    text ask "The ice in some cups has melted and the water has warmed. What does cup B's thermometer read?" narrate width=22 below=cups gap=1
    number-input answer below=ask gap=1
  }

  check physics.forces of=cups answer=reading(b)
  hint "Find cup B. Put a finger on the top of its red line."
  hint "The numbers go up in tens. A short mark halfway between two numbers is five more."
}
