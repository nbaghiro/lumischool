# Counting round the ring: from a stage Ada has found to the frog, or on past the frog to new
# frogspawn, which is the point of a cycle: it goes round. The ring is drawn whole and unnamed,
# so the child finds the stage first and then counts the arrows.
item nature.stages-until v=1 skills=[nature.life-cycles, counting.on] {
  title "How many changes?"
  difficulty (w + (if s == 1 then 0 else 1))
  let s=1..3 w=0..1
  let found={pick(s - 1, "a clump of frogspawn", "a tadpole with no legs yet", "a froglet with its back legs")}
  let until={pick(w, "it is a frog", "it lays new frogspawn")}
  level easy {
    let w=0..0
  }
  level hard {
    let w=1..1
  }

  scene 34x12 {
    frogcycle life stage=4 ring=1 names=0 at=canvas(1, 1)
    text ask "Ada finds {found} in the pond. Every arrow on the ring is one change. How many changes until {until}?" narrate width=20 right-of=life gap=2
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then 4 - s else 5 - s)
  feedback {
    when (w == 1 and answer == 4 - s) point=life {
      say "That gets it to the frog. The frog lays the frogspawn, and that is one more arrow round the ring."
    }
    when (w == 0 and answer == 5 - s) point=life {
      say "That goes one arrow too far, round to the frogspawn. Stop at the frog."
    }
    when (answer == 4 - s + 1 and w == 0 and s == 1) point=life {
      say "Count the arrows, not the pictures. From the frogspawn to the frog is three arrows."
    }
  }
  hint "Find Ada's creature on the ring. Put your finger on it."
  hint "Now follow the arrows and count each one until you reach the stage you want."
}
