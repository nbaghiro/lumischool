# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.forecast-match v=1 skills=[language.weather, language.reading] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[weather.the-north]]", "[[weather.it-is-going-to-rain]]", "[[weather.they-fall-2]]"), pick(k, "[[weather.the-south]]", "[[weather.there-will-be-storms]]", "[[weather.they-rise]]"), pick(k, "[[weather.the-degrees]]", "[[weather.clear]]", "[[weather.the-temperature]]"), pick(k, "[[weather.at-night]]", "[[weather.the-clouds]]", "[[weather.the-sky]]")] right=[pick(k, "the degrees", "the clouds", "the temperature"), pick(k, "the north", "it is going to rain", "they fall"), pick(k, "the south", "there will be storms", "the sky"), pick(k, "at night", "clear", "they rise")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
