# A street with its year on the sign and one thing in it too new for that year, proved from the
# year each thing first appeared in the dated record.
item history.street-could-not v=1 skills=[history.change, history.then-and-now] {
  title "It could not be there"
  difficulty (if k <= 2 then 0 else 1)
  let k=0..5
  let year={pick(k, 1850, 1900, 1850, 1920, 1950, 1870)}
  let a={pick(k, "horse and cart", "horse and cart", "hot-air balloon", "motor car", "motor car", "horse and cart")}
  let b={pick(k, "hot-air balloon", "bicycle", "horse and cart", "aeroplane", "television aerial", "hot-air balloon")}
  let c={pick(k, "motor car", "mobile phone", "aeroplane", "television aerial", "mobile phone", "bicycle")}
  level easy {
    let k=0..2
  }
  level hard {
    let k=3..5
  }

  scene 32x33 {
    thenandnow street year=year sign=1 things=["{a}", "{b}", "{c}"] at=canvas(1, 0)
    text ask "The sign says {year}. Which thing could not have been in the street then?" narrate width=30 below=street gap=1
    choice pick options=["{a}", "{b}", "{c}"] stack=column below=ask gap=1
  }

  check history.street of=street pick=could-not
  hint "Read the year on the sign. Which of the three is the newest thing?"
  hint "Was that thing made yet in {year}?"
}
