# The language to English: [[phrase.my-favourite-season-is-summer]], [[phrase.in-winter-it-is-cold]], [[phrase.which-is-your-favourite-season]], [[phrase.in-autumn-the-leaves-fall]], [[phrase.in-summer-i-go-to-the-beach]], [[phrase.in-spring-it-rains-a-lot]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.seasons-meaning v=1 skills=[language.weather, language.time] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "gran", "girl", "boy", "gran")] says=[pick(k, "[[phrase.my-favourite-season-is-summer]]", "[[phrase.in-winter-it-is-cold]]", "[[phrase.which-is-your-favourite-season]]", "[[phrase.in-autumn-the-leaves-fall]]", "[[phrase.in-summer-i-go-to-the-beach]]", "[[phrase.in-spring-it-rains-a-lot]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "In spring it rains a lot.", "In autumn the leaves fall.", "In winter it is cold.", "In spring it rains a lot.", "In spring it rains a lot.", "In autumn the leaves fall."), pick(k, "My favourite season is summer.", "In winter it is cold.", "In summer I go to the beach.", "In autumn the leaves fall.", "Which is your favourite season?", "In spring it rains a lot."), pick(k, "Which is your favourite season?", "In summer I go to the beach.", "In autumn the leaves fall.", "In winter it is cold.", "In summer I go to the beach.", "Which is your favourite season?"), pick(k, "In summer I go to the beach.", "Which is your favourite season?", "Which is your favourite season?", "Which is your favourite season?", "In autumn the leaves fall.", "In summer I go to the beach.")] stack=column
    }
  }

  answer pick=pick(k, "My favourite season is summer.", "In winter it is cold.", "Which is your favourite season?", "In autumn the leaves fall.", "In summer I go to the beach.", "In spring it rains a lot.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
