# Making a program better, not only right: the five cards reach the flag, and two cards can too once
# the moves the same way are added together.
item coding.shorter-program v=1 stars=3 skills=[coding.sequences, reasoning.simplify] {
  title "Two cards instead of five"
  let k=0..2

  scene 36x16 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks b code=["{if k == 0 then \"right 1\" else if k == 1 then \"down 1\" else \"right 1\"}", "{if k == 0 then \"right 1\" else if k == 1 then \"right 1\" else \"down 1\"}", "{if k == 0 then \"down 2\" else if k == 1 then \"right 1\" else \"down 1\"}", "{if k == 0 then \"right 1\" else if k == 1 then \"down 1\" else \"right 1\"}", "{if k == 0 then \"down 1\" else if k == 1 then \"right 1\" else \"down 1\"}"] words=false
      maze g cols=4 rows=4 flag=[if k == 2 then 3 else 4, if k == 1 then 3 else 4]
      codepad answer tray=["right 1", "down 1"] lines=2 words=false
    }
    text ask "These five cards take the robot to the flag. Write a program that gets there with only two cards." width=34 below=top gap=1
  }

  check coding.builds of=g goal=flag
  hint "Which way do the five cards go, altogether? How far right, and how far down?"
  hint "Put all the right moves on one card and all the down moves on the other."
}
