# The other way round from counting pieces: an improper fraction written as whole ones and a part.
item fraction.to-mixed v=1 skills=[fractions.mixed-numbers] {
  title "Whole ones and what is left"
  difficulty (w * k + r)
  let k={3, 4, 5, 6, 8} kw={"thirds", "quarters", "fifths", "sixths", "eighths"} w=1..3 r=1..7
  where (k == 3 and kw == "thirds" or k == 4 and kw == "quarters" or k == 5 and kw == "fifths" or k == 6 and kw == "sixths" or k == 8 and kw == "eighths")
  where (r < k)
  level easy {
    let k={3, 4} w=1..2
  }
  level hard {
    let k={6, 8} w={3}
  }

  scene 22x6 {
    equation eq "{w * k + r}/{k} = {?whole}  {?top}/{k}" at=canvas(1, 1)
    text ask "Write it as whole ones and a fraction." narrate below=eq gap=1
  }

  answer whole=w top=r
  feedback {
    when (whole == w + 1 and top == 0) point=eq {
      say "Check: {w + 1} whole ones would be {(w + 1) * k}/{k}, which is more than {w * k + r}/{k}."
    }
    when (whole == w * k) point=eq {
      say "Each whole one is {k}/{k}. How many whole ones fit in {w * k + r}/{k}?"
    }
  }
  hint "How many {kw} make one whole?"
  hint "How many whole ones can you take out of {w * k + r}/{k}, and how many {kw} are left?"
}
