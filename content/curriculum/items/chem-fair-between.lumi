# Non-routine: a temperature the test never tried, answered as a range rather than a number, because
# the trend says which two results it falls between and no more than that.
item chem.fair-between v=1 stars=3 skills=[chemistry.method, reasoning.predict] {
  title "A temperature nobody tried"
  difficulty (if v % 4 == 0 or v % 4 == 3 then 1 else 2)
  let v=0..11

  scene 33x18 {
    text ask "Nobody tried water at {if v == 0 then \"15°\" else if v == 1 then \"25°\" else if v == 2 then \"35°\" else if v == 3 then \"45°\" else if v == 4 then \"15°\" else if v == 5 then \"25°\" else if v == 6 then \"35°\" else if v == 7 then \"45°\" else if v == 8 then \"15°\" else if v == 9 then \"25°\" else if v == 10 then \"35°\" else \"45°\"}. About how long would the sugar take then?" width=32 at=canvas(1, 0)
    row kit below=ask gap=1 space=1 align=start {
      table data cols=2 head=["Water °C", "Seconds"] cells=[20, if v == 0 then 80 else if v == 1 then 80 else if v == 2 then 80 else if v == 3 then 80 else if v == 4 then 70 else if v == 5 then 70 else if v == 6 then 70 else if v == 7 then 70 else if v == 8 then 60 else if v == 9 then 60 else if v == 10 then 60 else 60, 30, if v == 0 then 55 else if v == 1 then 55 else if v == 2 then 55 else if v == 3 then 55 else if v == 4 then 50 else if v == 5 then 50 else if v == 6 then 50 else if v == 7 then 50 else if v == 8 then 45 else if v == 9 then 45 else if v == 10 then 45 else 45, 40, if v == 0 then 40 else if v == 1 then 40 else if v == 2 then 40 else if v == 3 then 40 else if v == 4 then 35 else if v == 5 then 35 else if v == 6 then 35 else if v == 7 then 35 else if v == 8 then 30 else if v == 9 then 30 else if v == 10 then 30 else 30]
      choice pick options=["less than {if v == 0 then \"40\" else if v == 1 then \"40\" else if v == 2 then \"40\" else if v == 3 then \"40\" else if v == 4 then \"35\" else if v == 5 then \"35\" else if v == 6 then \"35\" else if v == 7 then \"35\" else if v == 8 then \"30\" else if v == 9 then \"30\" else if v == 10 then \"30\" else \"30\"} seconds", "between {if v == 0 then \"40\" else if v == 1 then \"40\" else if v == 2 then \"40\" else if v == 3 then \"40\" else if v == 4 then \"35\" else if v == 5 then \"35\" else if v == 6 then \"35\" else if v == 7 then \"35\" else if v == 8 then \"30\" else if v == 9 then \"30\" else if v == 10 then \"30\" else \"30\"} and {if v == 0 then \"55\" else if v == 1 then \"55\" else if v == 2 then \"55\" else if v == 3 then \"55\" else if v == 4 then \"50\" else if v == 5 then \"50\" else if v == 6 then \"50\" else if v == 7 then \"50\" else if v == 8 then \"45\" else if v == 9 then \"45\" else if v == 10 then \"45\" else \"45\"} seconds", "between {if v == 0 then \"55\" else if v == 1 then \"55\" else if v == 2 then \"55\" else if v == 3 then \"55\" else if v == 4 then \"50\" else if v == 5 then \"50\" else if v == 6 then \"50\" else if v == 7 then \"50\" else if v == 8 then \"45\" else if v == 9 then \"45\" else if v == 10 then \"45\" else \"45\"} and {if v == 0 then \"80\" else if v == 1 then \"80\" else if v == 2 then \"80\" else if v == 3 then \"80\" else if v == 4 then \"70\" else if v == 5 then \"70\" else if v == 6 then \"70\" else if v == 7 then \"70\" else if v == 8 then \"60\" else if v == 9 then \"60\" else if v == 10 then \"60\" else \"60\"} seconds", "more than {if v == 0 then \"80\" else if v == 1 then \"80\" else if v == 2 then \"80\" else if v == 3 then \"80\" else if v == 4 then \"70\" else if v == 5 then \"70\" else if v == 6 then \"70\" else if v == 7 then \"70\" else if v == 8 then \"60\" else if v == 9 then \"60\" else if v == 10 then \"60\" else \"60\"} seconds"] stack=column
    }
  }

  answer pick=(if v == 0 then "more than 80 seconds" else if v == 1 then "between 55 and 80 seconds" else if v == 2 then "between 40 and 55 seconds" else if v == 3 then "less than 40 seconds" else if v == 4 then "more than 70 seconds" else if v == 5 then "between 50 and 70 seconds" else if v == 6 then "between 35 and 50 seconds" else if v == 7 then "less than 35 seconds" else if v == 8 then "more than 60 seconds" else if v == 9 then "between 45 and 60 seconds" else if v == 10 then "between 30 and 45 seconds" else "less than 30 seconds")
  hint "Which two temperatures in the table is {if v == 0 then \"15°\" else if v == 1 then \"25°\" else if v == 2 then \"35°\" else if v == 3 then \"45°\" else if v == 4 then \"15°\" else if v == 5 then \"25°\" else if v == 6 then \"35°\" else if v == 7 then \"45°\" else if v == 8 then \"15°\" else if v == 9 then \"25°\" else if v == 10 then \"35°\" else \"45°\"} between, or is it past the end of the table?"
  hint "If the water is between two of them, the time is between their two times. Which way does it go past the end?"
}
