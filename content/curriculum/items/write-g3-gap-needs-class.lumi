# The gap moves along the sentence, so the same three kinds of word are wanted in turn: the child
# chooses a word of the class the gap needs.
item writing.gap-needs-class v=1 skills=[writing.word-classes] {
  title "The word the gap needs"
  difficulty (if k == 2 or k == 5 or k == 8 then 1 else 0)
  let k=0..8
  level easy {
    let k={0, 1, 3, 4, 6, 7}  # a naming or a describing word
  }
  level hard {
    let k={2, 5, 8}  # the doing word
  }

  scene 32x19 {
    canallock lock level=0.5 boat=1 at=canvas(1, 1)
    caption line text="{if k == 0 then \"The ___ heron stood by the lock.\" else if k == 1 then \"The grey ___ stood by the lock.\" else if k == 2 then \"The grey heron ___ by the lock.\" else if k == 3 then \"A ___ boat went into the lock.\" else if k == 4 then \"A long ___ went into the lock.\" else if k == 5 then \"A long boat ___ into the lock.\" else if k == 6 then \"The ___ gate swung open.\" else if k == 7 then \"The old ___ swung open.\" else \"The old gate ___ open.\"}" width=30 below=lock gap=1
    text ask "Which word fits the gap?" below=line gap=1
    choice pick options=["{if k == 0 or k == 6 then \"ducks\" else if k == 1 then \"waded\" else if k == 2 then \"stood\" else if k == 3 then \"sailed\" else if k == 4 then \"slow\" else if k == 5 then \"went\" else if k == 7 then \"pushed\" else \"swung\"}", "{if k == 0 then \"grey\" else if k == 1 then \"tall\" else if k == 2 then \"reeds\" else if k == 3 then \"long\" else if k == 4 then \"sailed\" else if k == 5 then \"bridges\" else if k == 6 then \"old\" else if k == 7 then \"wet\" else \"ducks\"}", "{if k == 0 then \"waded\" else if k == 1 then \"heron\" else if k == 2 or k == 5 then \"tall\" else if k == 3 then \"ducks\" else if k == 4 then \"boat\" else if k == 6 then \"pushed\" else if k == 7 then \"gate\" else \"wet\"}"] below=ask gap=1
  }

  answer pick=(if k == 0 then "grey" else if k == 1 then "heron" else if k == 2 then "stood" else if k == 3 then "long" else if k == 4 then "boat" else if k == 5 then "went" else if k == 6 then "old" else if k == 7 then "gate" else "swung")
  hint "Read the sentence with each word in the gap. Which one sounds right?"
  hint "Does the gap need a thing, something that happens, or what a thing is like?"
}
