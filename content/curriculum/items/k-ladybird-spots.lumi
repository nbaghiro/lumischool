item k.ladybird-spots v=1 skills=[counting.to-five] {
  title "Spots on the ladybird"
  difficulty s
  let s=1..5
  level easy {
    let s=1..3
  }
  level hard {
    let s=4..5
  }

  scene 24x8 {
    minibeasts bug kinds=["ladybird"] spots=s legs=false at=canvas(1, 1)
    text ask "How many spots?" narrate right-of=bug gap=2
    number-input answer below=ask gap=1
  }

  answer s
  feedback {
    when (answer == s + 1) point=bug {
      say "Touch each spot once, on both wings."
    }
  }
  hint "Count the spots on one wing, then on the other wing."
}
