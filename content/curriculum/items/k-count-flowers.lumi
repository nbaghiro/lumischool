item k.count-flowers v=1 skills=[nature.plants, counting.to-five] {
  title "Flowers in the bed"
  difficulty n
  let n=2..6
  level easy {
    let n=2..3
  }
  level hard {
    let n=5..6
  }

  scene 30x18 {
    flowers f count=n petals=5 at=canvas(1, 1)
    text ask "How many flowers are growing?" narrate width=22 below=f gap=1
    number-input answer below=ask gap=1
  }

  answer n
  hint "Count the stems, one for each flower."
}
