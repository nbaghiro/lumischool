# Two magnets on rulers of their own, and how many centimetres further the stronger one pulls from.
# At d=0 to 2 the two readings are four or five apart, at d=3 to 5 two or three.
item physics.magnet-reach-difference v=1 skills=[physics.magnets, reasoning.compare, subtraction.to-twenty] {
  title "How much further?"
  difficulty (if diff > 3 then 0 else 1)
  let d=0..5
  let r1={pick(d, 8, 3, 9, 6, 7, 5)}
  let r2={pick(d, 3, 7, 5, 4, 5, 8)}
  let diff={pick(d, 5, 4, 4, 2, 2, 3)}
  level easy {
    let d=0..2
  }
  level hard {
    let d=3..5
  }

  scene 28x23 {
    column both space=1 align=start at=canvas(1, 0) {
      magnet one mode=reach reach=r1 clip=1 tag="A"
      magnet two mode=reach reach=r2 clip=1 tag="B"
    }
    text ask "Each magnet pulled the same paper clip from the mark the arrow starts at. How many centimetres further did the stronger magnet pull from?" narrate width=26 below=both gap=1
    number-input answer below=ask gap=1
  }

  answer answer=diff
  feedback {
    when (answer == r1 or answer == r2) point=both {
      say "That is one of the two readings. The question asks how much further, so take the smaller away from the bigger."
    }
  }
  hint "Read both rulers first. Which magnet pulled from further away?"
  hint "Take the smaller reading away from the bigger one."
}
