# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.my-day-match v=1 skills=[language.time, language.sentences] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[day.i-get-up]]", "[[day.i-go-to-bed]]", "[[day.first]]"), pick(k, "[[day.i-have-breakfast]]", "[[day.i-have-a-shower]]", "[[day.then]]"), pick(k, "[[day.i-have-lunch]]", "[[day.i-come-home]]", "[[day.before]]"), pick(k, "[[day.i-have-dinner]]", "[[day.i-do-my-homework]]", "[[day.after]]")] right=[pick(k, "I have lunch", "I do my homework", "before"), pick(k, "I get up", "I go to bed", "first"), pick(k, "I have breakfast", "I have a shower", "after"), pick(k, "I have dinner", "I come home", "then")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
