# The key read the other way: which row shows a named thing, so the mark can be found on the map.
item reading.key-row v=1 skills=[reading.text-features, geography.maps] {
  title "Which row of the key?"
  difficulty (if k >= 2 then 1 else 0)
  let k=0..3
  let m1={pick(k, "road", "woods", "rails", "sea")}
  let m2={pick(k, "path", "hills", "river", "peaks")}
  let m3={pick(k, "bridge", "town", "path", "river")}
  let m4={pick(k, "river", "river", "bridge", "town")}
  let l1={pick(k, "Road", "Woods", "Railway", "Across the sea")}
  let l2={pick(k, "Footpath", "Hills", "River", "Mountains")}
  let l3={pick(k, "Bridge", "Town", "Footpath", "River")}
  let l4={pick(k, "River", "River", "Bridge", "Town")}
  let want={pick(k, "the footpath", "the town", "the bridge", "the mountains")}
  let row={pick(k, 2, 3, 4, 2)}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 34x12 {
    mapkey key title=Key marks=["{m1}", "{m2}", "{m3}", "{m4}"] labels=["{l1}", "{l2}", "{l3}", "{l4}"] at=canvas(1, 1)
    text ask "Pip wants to find {want} on the map. Which row of the key shows its mark, counting from the top?" narrate width=16 right-of=key gap=1
    number-input answer below=ask gap=1
  }

  answer row
  hint "Read the words on the right of the key from the top down until you find {want}."
  hint "Then the mark on the left of that row is the one to look for on the map."
}
