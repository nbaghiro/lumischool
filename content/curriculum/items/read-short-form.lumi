# Two words squeezed into one short form, with the apostrophe where the missing letters were:
# can not to can't, it is to it's, do not to don't, I am to I'm.
item reading.short-form v=1 skills=[reading.morphology, reading.punctuation] {
  title "The short form"
  difficulty k
  let k=0..1 r=0..2
  let l1={pick(k, "can not", "I am")}
  let l2={pick(k, "it is", "do not")}
  let l3={pick(k, "is not", "we are")}
  let s1={pick(k, "can't", "I'm")}
  let s2={pick(k, "it's", "don't")}
  let s3={pick(k, "isn't", "we're")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 34x17 {
    text ask "Two words can be squeezed into one short form, with an apostrophe where letters were left out. Write the number of the short form that matches each pair." narrate width=32 at=canvas(1, 1)
    match m left=["{l1}", "{l2}", "{l3}"] right=["{if r == 0 then s2 else if r == 1 then s3 else s1}", "{if r == 0 then s3 else if r == 1 then s1 else s2}", "{if r == 0 then s1 else if r == 1 then s2 else s3}"] blanks=[x, y, z] below=ask gap=1
  }

  answer x=(if r == 0 then 3 else if r == 1 then 2 else 1) y=(if r == 0 then 1 else if r == 1 then 3 else 2) z=(if r == 0 then 2 else if r == 1 then 1 else 3)
  hint "Say the two words fast, as one. Which short form sounds like that?"
  hint "The letters before the apostrophe are the start of the first word."
}
