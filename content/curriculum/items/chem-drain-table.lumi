# Reading the drainage table: which soil a number belongs to, or which soil let most or least
# through. The sand lets most through and the clay least; the garden soil sits between.
item chem.drain-table v=1 skills=[chemistry.rocks, data.tables] {
  title "Read the drainage test"
  difficulty (if w == 2 then 1 else 0)
  let w=0..2 s=0..2 t=0..1
  let sandMl={pick(t, 80, 70)}
  let loamMl={pick(t, 40, 45)}
  let clayMl={pick(t, 10, 15)}
  let soil={pick(s, "sand", "garden soil", "clay")}
  let ml={pick(s, sandMl, loamMl, clayMl)}
  level easy {
    let w=0..1
  }
  level hard {
    let w=1..2
  }

  scene 34x20 {
    table t cols=2 head=["Soil", "Through in a minute (ml)"] cells=["sand", "{sandMl}", "garden soil", "{loamMl}", "clay", "{clayMl}"] at=canvas(1, 0)
    text ask "Ben poured 100 millilitres through each pot and wrote down how much came through into the beaker in one minute. Which soil let {if w == 0 then ml else if w == 1 then \"the most water\" else \"the least water\"}{if w == 0 then \" millilitres\" else \"\"} through?" narrate width=32 below=t gap=1
    choice pick options=["sand", "garden soil", "clay"] below=ask gap=1
  }

  answer pick=(if w == 0 then soil else if w == 1 then "sand" else "clay")
  feedback {
    when (w == 2 and pick == "sand") point=t {
      say "The sand let the most through. Least is the smallest number in the table."
    }
    when (w == 1 and pick == "clay") point=t {
      say "The clay let the least through. Most is the biggest number in the table."
    }
  }
  hint "Find the number in the second column and read back to its soil, or find the biggest or smallest number."
  hint "More through the soil means it drains well. Less through means it holds the water."
}
