# The language to English: [[phrase.what-is-it-it-is-a-triangle]], [[phrase.it-is-a-star]], [[phrase.i-have-three-circles]], [[phrase.it-is-a-heart]], [[phrase.how-many-squares-are-there]], [[phrase.it-has-four-sides]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.shapes-meaning v=1 skills=[language.shapes, language.numbers] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "girl", "gran", "boy", "girl")] says=[pick(k, "[[phrase.what-is-it-it-is-a-triangle]]", "[[phrase.it-is-a-star]]", "[[phrase.i-have-three-circles]]", "[[phrase.it-is-a-heart]]", "[[phrase.how-many-squares-are-there]]", "[[phrase.it-has-four-sides]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "It has four sides.", "It is a heart.", "It is a star.", "It has four sides.", "It has four sides.", "It is a heart."), pick(k, "What is it? It is a triangle.", "It is a star.", "How many squares are there?", "It is a heart.", "I have three circles.", "It has four sides."), pick(k, "I have three circles.", "How many squares are there?", "It is a heart.", "It is a star.", "How many squares are there?", "I have three circles."), pick(k, "How many squares are there?", "I have three circles.", "I have three circles.", "I have three circles.", "It is a heart.", "How many squares are there?")] stack=column
    }
  }

  answer pick=pick(k, "What is it? It is a triangle.", "It is a star.", "I have three circles.", "It is a heart.", "How many squares are there?", "It has four sides.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
