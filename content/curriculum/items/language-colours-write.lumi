# The word written from its picture: [[colour.red]], [[colour.blue]], [[colour.green]], [[colour.white]], [[colour.yellow]], [[colour.black]].
# Accent-tolerant: the box takes the word with its accents left off (accents=loose); ñ is a letter and is marked.
item language.colours-write v=1 skills=[language.colours, language.spelling] {
  title "Write the word"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x15 {
    column all at=canvas(1, 1) space=1 align=start {
      mixingtray tray wells=["{pick(k, \"red\", \"blue\", \"green\", \"white\", \"yellow\", \"black\")}"] labels=true
      text ask "Write this colour in [[language.name]]." width=32
      word-input word options=[pick(k, "[[colour.red]]", "[[colour.blue]]", "[[colour.green]]", "[[colour.white]]", "[[colour.yellow]]", "[[colour.black]]")] accents=loose
    }
  }

  answer word=pick(k, "[[colour.red]]", "[[colour.blue]]", "[[colour.green]]", "[[colour.white]]", "[[colour.yellow]]", "[[colour.black]]")
  hint "Say the word quietly first. What sound does it start with?"
  hint "Count the sounds, then write one letter or pair of letters for each."
}
