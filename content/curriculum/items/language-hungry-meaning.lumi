# The language to English: [[phrase.i-would-like-bread-please]], [[phrase.i-am-thirsty]], [[phrase.what-would-you-like]], [[phrase.i-am-hungry]], [[phrase.an-orange-juice-please]], [[phrase.here-you-are]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.hungry-meaning v=1 skills=[language.food] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "boy", "girl", "gran", "boy", "girl", "gran")] says=[pick(k, "[[phrase.i-would-like-bread-please]]", "[[phrase.i-am-thirsty]]", "[[phrase.what-would-you-like]]", "[[phrase.i-am-hungry]]", "[[phrase.an-orange-juice-please]]", "[[phrase.here-you-are]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "Here you are.", "I am hungry.", "I am thirsty.", "Here you are.", "Here you are.", "I am hungry."), pick(k, "I would like bread, please.", "I am thirsty.", "An orange juice, please.", "I am hungry.", "What would you like?", "Here you are."), pick(k, "What would you like?", "An orange juice, please.", "I am hungry.", "I am thirsty.", "An orange juice, please.", "What would you like?"), pick(k, "An orange juice, please.", "What would you like?", "What would you like?", "What would you like?", "I am hungry.", "An orange juice, please.")] stack=column
    }
  }

  answer pick=pick(k, "I would like bread, please.", "I am thirsty.", "What would you like?", "I am hungry.", "An orange juice, please.", "Here you are.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
