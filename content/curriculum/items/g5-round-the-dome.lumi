# The distance round a circle is about 3.14 times the diameter: from the diameter, or from the
# radius by doubling first.
item circle.round-the-dome v=1 skills=[circles.circumference, decimals.multiply] {
  title "The way round"
  difficulty ((if from == "radius" then 1 else 0) + v / 10)
  let v={2, 3, 5, 8, 12} from={"diameter", "radius"}
  level easy {
    let from={"diameter"} v={2, 3, 5}
  }
  level hard {
    let from={"radius"} v={5, 8, 12}
  }

  scene 33x17 {
    circleparts c size=6 lines=(if from == "radius" then 1 else 2) radius=(if from == "radius" then v else 0) diameter=(if from == "radius" then 0 else v) ask=3 unit="m" at=canvas(1, 1)
    text ask "A rail runs all the way round the observatory dome. Using 3.14 for how many diameters go round, how long is the rail?" narrate width=14 right-of=c gap=2
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=6
      text m "m"
    }
  }

  answer decimals(if from == "radius" then 2 * v * 3.14 else v * 3.14, 0)
  feedback {
    when (from == "radius" and answer == v * 3.14) point=c {
      say "That used the radius. The distance round is 3.14 times the diameter, which is two radii."
    }
    when (answer == 2 * v * 3.14 * 2 or answer == v * 3) point=ask {
      say "Multiply the diameter by 3.14, the number of diameters that fit round a circle."
    }
  }
  hint "What is the diameter of the dome?"
  hint "Multiply the diameter by 3.14."
}
