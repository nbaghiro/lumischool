# The median from a dot plot: count the dots to find the middle place, then count along to it.
item data.fish-median v=1 skills=[data.median, data.dot-plots] {
  title "Fish in a beak"
  difficulty pick(w, 0, 0.5, 1, 1.5)
  let w=0..3
  level easy {
    let w={0, 1}
  }
  level hard {
    let w={2, 3}
  }

  scene 34x14 {
    dotplot plot from=4 to=10 counts=[pick(w, 1, 3, 0, 1), pick(w, 2, 4, 1, 1), pick(w, 3, 2, 2, 3), pick(w, 4, 1, 2, 1), pick(w, 2, 2, 3, 1), pick(w, 1, 2, 3, 4), pick(w, 0, 1, 1, 1)] label=fish at=canvas(1, 1)
    text ask "A puffin carries fish home in its beak. The dot plot shows how many fish each puffin carried. What is the median number of fish?" narrate width=13 right-of=plot gap=2
    number-input answer width=4 below=ask gap=1
  }

  answer pick(w, 7, 6, 8, 7.5)
  feedback {
    when (answer == 7 and w != 0 and w != 3) point=plot {
      say "7 is the middle of the scale, not the middle puffin. Count the dots."
    }
    when (answer == pick(w, 0, 5, 9, 9)) point=plot {
      say "That is the mode, the tallest column. The median is the middle value when every puffin is lined up."
    }
  }
  hint "How many puffins are there altogether? Which place is the middle?"
  hint "Count the dots from the left until you reach that place."
}
