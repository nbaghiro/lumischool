# A remainder is not the digit after the point: 17 ÷ 5 is 3 r 2, and the 2 left over is 2/5, which is
# 0.4, so each length is 3.4.
item quotient.remainder v=1 skills=[fractions.division, decimals.divide] {
  title "What the remainder is"
  difficulty (a / 10 + pick(b / 2 - 1, 0, 1, 1, 3) / 2)
  let a=11..39 b={2, 4, 8}
  where (a % b != 0)
  level easy {
    let b={2} a=11..19
  }
  level hard {
    let b={8} a=20..39
  }

  scene 36x13 {
    longdiv sum n=a by=b blanks=[whole, rest] at=canvas(1, 1)
    text ask "{a} m of chain for the clock tower's weights is cut into {b} equal lengths. Divide, then write each length as a decimal." narrate width=20 right-of=sum gap=2
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=5
      text unit "m"
    }
  }

  answer whole=(a // b) rest=(a % b) answer=decimals(a / b, 1)
  feedback {
    when (answer == a // b + a % b / 10) point=sum {
      say "The remainder is {a % b} metres still to share among {b}, which is {a % b}/{b} m each, not 0.{a % b}."
    }
    when (answer == a // b) point=sum {
      say "That leaves {a % b} m unshared. Share it too, as a fraction of a metre."
    }
  }
  hint "How many whole metres does each length get? How many metres are left?"
  hint "The metres left over are shared out too. What fraction of a metre does each length get, and what decimal is that?"
}
