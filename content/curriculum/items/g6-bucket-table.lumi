# A table of an inverse proportion with one cell missing: the bucket size times the number of
# buckets is always the trough's volume.
item inverse.bucket-table v=1 skills=[proportion.inverse, data.tables] {
  title "Buckets for the trough"
  difficulty (c + v / 60)
  let v={36, 48, 60, 72} c=0..2
  level easy {
    let c={0} v={36, 48}
  }
  level hard {
    let c={2} v={60, 72}
  }

  scene 33x14 {
    table data cols=4 head=["Litres", "2", "{pick(c, 3, 4, 6)}", "{pick(c, 4, 6, 12)}"] cells=["Buckets", "{v / 2}", "{v / pick(c, 3, 4, 6)}", "?"] at=canvas(1, 1)
    text ask "The mill's horse trough is filled with buckets. How many {pick(c, 4, 6, 12)} litre buckets fill it?" narrate width=32 below=data gap=1
    number-input answer width=3 below=ask gap=1
  }

  answer (v / pick(c, 4, 6, 12))
  feedback {
    when (answer == v / pick(c, 3, 4, 6) - (v / 2 - v / pick(c, 3, 4, 6))) point=data {
      say "The numbers do not go down by the same step. Bucket size times buckets is the same in every column."
    }
  }
  hint "In each column, multiply the bucket size by the number of buckets. What do you notice?"
  hint "How many litres does the trough hold? How many of the biggest buckets make that?"
}
