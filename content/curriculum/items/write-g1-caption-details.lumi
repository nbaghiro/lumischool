# The audit's raise for which-caption: all three captions are about the same animal, so each detail
# has to be checked against the picture, not just the first word.
item writing.caption-details v=1 skills=[writing.captions] {
  title "Check every word of the caption"
  difficulty (if f == 1 then 1 else 0)
  let a=0..3 f=0..2 q=0..2
  let who={if a == 0 then "dog" else if a == 1 then "cat" else if a == 2 then "hen" else "pig"}
  let where={if f == 0 then "on" else if f == 1 then "under" else "in"}
  let thing={if f == 2 then "box" else "bed"}
  let c0={if a == 0 and f == 0 and q == 0 then "A dog on a bed." else if a == 0 and f == 0 and q == 1 then "A dog under a bed." else if a == 0 and f == 0 and q == 2 then "A dog in a box." else if a == 0 and f == 1 and q == 0 then "A dog under a bed." else if a == 0 and f == 1 and q == 1 then "A dog on a bed." else if a == 0 and f == 1 and q == 2 then "A dog in a box." else if a == 0 and f == 2 and q == 0 then "A dog in a box." else if a == 0 and f == 2 and q == 1 then "A dog on a bed." else if a == 0 and f == 2 and q == 2 then "A dog under a bed." else if a == 1 and f == 0 and q == 0 then "A cat on a bed." else if a == 1 and f == 0 and q == 1 then "A cat under a bed." else if a == 1 and f == 0 and q == 2 then "A cat in a box." else if a == 1 and f == 1 and q == 0 then "A cat under a bed." else if a == 1 and f == 1 and q == 1 then "A cat on a bed." else if a == 1 and f == 1 and q == 2 then "A cat in a box." else if a == 1 and f == 2 and q == 0 then "A cat in a box." else if a == 1 and f == 2 and q == 1 then "A cat on a bed." else if a == 1 and f == 2 and q == 2 then "A cat under a bed." else if a == 2 and f == 0 and q == 0 then "A hen on a bed." else if a == 2 and f == 0 and q == 1 then "A hen under a bed." else if a == 2 and f == 0 and q == 2 then "A hen in a box." else if a == 2 and f == 1 and q == 0 then "A hen under a bed." else if a == 2 and f == 1 and q == 1 then "A hen on a bed." else if a == 2 and f == 1 and q == 2 then "A hen in a box." else if a == 2 and f == 2 and q == 0 then "A hen in a box." else if a == 2 and f == 2 and q == 1 then "A hen on a bed." else if a == 2 and f == 2 and q == 2 then "A hen under a bed." else if a == 3 and f == 0 and q == 0 then "A pig on a bed." else if a == 3 and f == 0 and q == 1 then "A pig under a bed." else if a == 3 and f == 0 and q == 2 then "A pig in a box." else if a == 3 and f == 1 and q == 0 then "A pig under a bed." else if a == 3 and f == 1 and q == 1 then "A pig on a bed." else if a == 3 and f == 1 and q == 2 then "A pig in a box." else if a == 3 and f == 2 and q == 0 then "A pig in a box." else if a == 3 and f == 2 and q == 1 then "A pig on a bed." else "A pig under a bed."}
  let c1={if a == 0 and f == 0 and q == 0 then "A dog under a bed." else if a == 0 and f == 0 and q == 1 then "A dog in a box." else if a == 0 and f == 0 and q == 2 then "A dog on a bed." else if a == 0 and f == 1 and q == 0 then "A dog on a bed." else if a == 0 and f == 1 and q == 1 then "A dog in a box." else if a == 0 and f == 1 and q == 2 then "A dog under a bed." else if a == 0 and f == 2 and q == 0 then "A dog on a bed." else if a == 0 and f == 2 and q == 1 then "A dog under a bed." else if a == 0 and f == 2 and q == 2 then "A dog in a box." else if a == 1 and f == 0 and q == 0 then "A cat under a bed." else if a == 1 and f == 0 and q == 1 then "A cat in a box." else if a == 1 and f == 0 and q == 2 then "A cat on a bed." else if a == 1 and f == 1 and q == 0 then "A cat on a bed." else if a == 1 and f == 1 and q == 1 then "A cat in a box." else if a == 1 and f == 1 and q == 2 then "A cat under a bed." else if a == 1 and f == 2 and q == 0 then "A cat on a bed." else if a == 1 and f == 2 and q == 1 then "A cat under a bed." else if a == 1 and f == 2 and q == 2 then "A cat in a box." else if a == 2 and f == 0 and q == 0 then "A hen under a bed." else if a == 2 and f == 0 and q == 1 then "A hen in a box." else if a == 2 and f == 0 and q == 2 then "A hen on a bed." else if a == 2 and f == 1 and q == 0 then "A hen on a bed." else if a == 2 and f == 1 and q == 1 then "A hen in a box." else if a == 2 and f == 1 and q == 2 then "A hen under a bed." else if a == 2 and f == 2 and q == 0 then "A hen on a bed." else if a == 2 and f == 2 and q == 1 then "A hen under a bed." else if a == 2 and f == 2 and q == 2 then "A hen in a box." else if a == 3 and f == 0 and q == 0 then "A pig under a bed." else if a == 3 and f == 0 and q == 1 then "A pig in a box." else if a == 3 and f == 0 and q == 2 then "A pig on a bed." else if a == 3 and f == 1 and q == 0 then "A pig on a bed." else if a == 3 and f == 1 and q == 1 then "A pig in a box." else if a == 3 and f == 1 and q == 2 then "A pig under a bed." else if a == 3 and f == 2 and q == 0 then "A pig on a bed." else if a == 3 and f == 2 and q == 1 then "A pig under a bed." else "A pig in a box."}
  let c2={if a == 0 and f == 0 and q == 0 then "A dog in a box." else if a == 0 and f == 0 and q == 1 then "A dog on a bed." else if a == 0 and f == 0 and q == 2 then "A dog under a bed." else if a == 0 and f == 1 and q == 0 then "A dog in a box." else if a == 0 and f == 1 and q == 1 then "A dog under a bed." else if a == 0 and f == 1 and q == 2 then "A dog on a bed." else if a == 0 and f == 2 and q == 0 then "A dog under a bed." else if a == 0 and f == 2 and q == 1 then "A dog in a box." else if a == 0 and f == 2 and q == 2 then "A dog on a bed." else if a == 1 and f == 0 and q == 0 then "A cat in a box." else if a == 1 and f == 0 and q == 1 then "A cat on a bed." else if a == 1 and f == 0 and q == 2 then "A cat under a bed." else if a == 1 and f == 1 and q == 0 then "A cat in a box." else if a == 1 and f == 1 and q == 1 then "A cat under a bed." else if a == 1 and f == 1 and q == 2 then "A cat on a bed." else if a == 1 and f == 2 and q == 0 then "A cat under a bed." else if a == 1 and f == 2 and q == 1 then "A cat in a box." else if a == 1 and f == 2 and q == 2 then "A cat on a bed." else if a == 2 and f == 0 and q == 0 then "A hen in a box." else if a == 2 and f == 0 and q == 1 then "A hen on a bed." else if a == 2 and f == 0 and q == 2 then "A hen under a bed." else if a == 2 and f == 1 and q == 0 then "A hen in a box." else if a == 2 and f == 1 and q == 1 then "A hen under a bed." else if a == 2 and f == 1 and q == 2 then "A hen on a bed." else if a == 2 and f == 2 and q == 0 then "A hen under a bed." else if a == 2 and f == 2 and q == 1 then "A hen in a box." else if a == 2 and f == 2 and q == 2 then "A hen on a bed." else if a == 3 and f == 0 and q == 0 then "A pig in a box." else if a == 3 and f == 0 and q == 1 then "A pig on a bed." else if a == 3 and f == 0 and q == 2 then "A pig under a bed." else if a == 3 and f == 1 and q == 0 then "A pig in a box." else if a == 3 and f == 1 and q == 1 then "A pig under a bed." else if a == 3 and f == 1 and q == 2 then "A pig on a bed." else if a == 3 and f == 2 and q == 0 then "A pig under a bed." else if a == 3 and f == 2 and q == 1 then "A pig in a box." else "A pig on a bed."}
  let right={if a == 0 and f == 0 then "A dog on a bed." else if a == 0 and f == 1 then "A dog under a bed." else if a == 0 and f == 2 then "A dog in a box." else if a == 1 and f == 0 then "A cat on a bed." else if a == 1 and f == 1 then "A cat under a bed." else if a == 1 and f == 2 then "A cat in a box." else if a == 2 and f == 0 then "A hen on a bed." else if a == 2 and f == 1 then "A hen under a bed." else if a == 2 and f == 2 then "A hen in a box." else if a == 3 and f == 0 then "A pig on a bed." else if a == 3 and f == 1 then "A pig under a bed." else "A pig in a box."}

  scene 32x15 {
    picturecards card who=["{who}"] where=["{where}"] thing=["{thing}"] letters=false at=canvas(1, 1)
    column q right-of=card gap=2 space=1 align=start {
      text ask "Which caption fits the picture?" narrate width=20
      choice pick options=["{c0}", "{c1}", "{c2}"] stack=column
    }
  }

  answer pick=right
  hint "All three are about the {who}. Where is it in the picture?"
  hint "Read each caption to the end. Which one is right about every word?"
}
