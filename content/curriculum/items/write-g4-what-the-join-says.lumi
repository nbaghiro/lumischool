# The other way round from choosing the word: the whole sentence is given and the child says what
# the part after the joining word does. The sentences are the ones finish-the-join is built from.
item writing.what-the-join-says v=1 skills=[writing.joining-sentences] {
  title "What does the second half give?"
  difficulty (if w == 2 then 1 else 0)
  let s=0..3 w=0..2
  level easy {
    let w={0, 1}
  }
  level hard {
    let w={1, 2}
  }

  scene 37x11 {
    caption whole text="{if s == 0 then \"Leo put on his boots\" else if s == 1 then \"Ada practised the song every day\" else if s == 2 then \"The shop was closed\" else \"Jin ran to the bus stop\"}{if w == 0 then \" because \" else if w == 1 then \", so \" else \", but \"}{if w == 0 then (if s == 0 then \"it was muddy outside.\" else if s == 1 then \"she wanted to sing it well.\" else if s == 2 then \"it was a holiday.\" else \"he had overslept.\") else if w == 1 then (if s == 0 then \"his feet stayed dry.\" else if s == 1 then \"she knew it by heart on Friday.\" else if s == 2 then \"we went home without milk.\" else \"he caught the bus.\") else (if s == 0 then \"his feet still got wet.\" else if s == 1 then \"she still forgot the last line.\" else if s == 2 then \"the baker let us in at the back.\" else \"the bus had gone.\")}" width=35 at=canvas(1, 1)
    text ask "What does the part after the joining word give?" width=35 below=whole gap=1
    choice pick options=["a reason", "the other way", "what came next"] below=ask gap=1
  }

  answer pick=(if w == 0 then "a reason" else if w == 1 then "what came next" else "the other way")
  hint "Find the joining word. Is it because, so or but?"
  hint "Does the second half say why, say what came of it, or go against the first half?"
}
