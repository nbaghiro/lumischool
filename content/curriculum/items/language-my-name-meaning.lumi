# The language to English: [[greet.well]], [[greet.bad]], [[greet.very-well]], [[greet.my-name-is]], [[greet.so-so]], [[greet.how-are-you]], [[greet.great]], [[greet.what-is-your-name]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.my-name-meaning v=1 skills=[language.greetings, language.questions] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 0, 1, 1, 1, 2, 2)
  let k=0..7

  scene 34x31 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "girl", "boy", "girl", "boy", "girl", "boy")] says=[pick(k, "[[greet.well]]", "[[greet.bad]]", "[[greet.very-well]]", "[[greet.my-name-is]]", "[[greet.so-so]]", "[[greet.how-are-you]]", "[[greet.great]]", "[[greet.what-is-your-name]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "bad", "my name is", "my name is", "bad", "very well", "what is your name?", "so-so", "how are you?"), pick(k, "so-so", "bad", "very well", "my name is", "so-so", "how are you?", "bad", "bad"), pick(k, "well", "well", "bad", "how are you?", "bad", "very well", "great", "what is your name?")] stack=column
    }
  }

  answer pick=pick(k, "well", "bad", "very well", "my name is", "so-so", "how are you?", "great", "what is your name?")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
