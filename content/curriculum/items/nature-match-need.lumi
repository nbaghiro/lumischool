# Four features matched to the need each answers, shuffled four ways, none of them 1, 2, 3, 4 or
# a turn of it, so one answer does not give the rest.
item nature.match-need v=1 skills=[nature.habitats] {
  title "Match the feature to its job"
  let k=0..3

  scene 36x25 {
    row four at=canvas(1, 1) space=1 align=end {
      camel pc count=1 resting=0 facing=1
      fennec pf facing=1
      seal ps rock=1 facing=1
      gull pg flying=0
    }
    text ask "Write the number of the job next to each feature." narrate width=34 below=four gap=1
    match m left=["the camel's hump", "the fennec's ears", "the seal's fat", "the gull's webbed feet"] right=["{if k == 0 then \"keeping warm in the cold sea\" else if k == 1 then \"paddling on the water\" else if k == 2 then \"letting heat out\" else \"paddling on the water\"}", "{if k == 0 then \"food for days without grass\" else if k == 1 then \"keeping warm in the cold sea\" else if k == 2 then \"paddling on the water\" else \"food for days without grass\"}", "{if k == 0 then \"paddling on the water\" else if k == 1 then \"food for days without grass\" else if k == 2 then \"keeping warm in the cold sea\" else \"letting heat out\"}", "{if k == 0 then \"letting heat out\" else if k == 1 then \"letting heat out\" else if k == 2 then \"food for days without grass\" else \"keeping warm in the cold sea\"}"] blanks=[a, b, c, d] below=ask gap=1
  }

  answer a=(if k == 0 then 2 else if k == 1 then 3 else if k == 2 then 4 else 2) b=(if k == 0 then 4 else if k == 1 then 4 else if k == 2 then 1 else 3) c=(if k == 0 then 1 else if k == 1 then 2 else if k == 2 then 3 else 4) d=(if k == 0 then 3 else if k == 1 then 1 else if k == 2 then 2 else 1)
  hint "Start with the one you are surest of. What are webbed feet for?"
  hint "The hump is fat, and fat is food. The seal's fat is a coat. The fennec's ears let heat out."
}
