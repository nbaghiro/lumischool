# Looking at two things and comparing them: the drawing against the thing it was drawn from.
item art.spots-left-out v=1 skills=[art.looking, reasoning.compare] {
  title "What did Ada leave out?"
  difficulty (s + d)
  let s=4..7 d=1..3
  where (s - d >= 2)
  level easy {
    let d={1}
  }
  level hard {
    let d={2, 3}
  }

  scene 32x10 {
    minibeasts real kinds=["ladybird"] spots=s legs=false at=canvas(1, 1)
    minibeasts drawn kinds=["ladybird"] spots=(s - d) legs=false right-of=real gap=3
    text ask "Ada drew the ladybird on the left. How many spots did she leave out?" width=13 right-of=drawn gap=2
    number-input answer below=ask gap=1
  }

  answer d
  feedback {
    when (answer == s) point=real {
      say "That is how many spots the ladybird has. How many did Ada draw?"
    }
  }
  hint "Count the spots on the ladybird. Then count the spots in Ada's drawing."
  hint "How many more spots does the ladybird have than the drawing?"
}
