# The word written from its picture: [[num.eleven]], [[num.twelve]], [[num.fifteen]], [[num.thirteen]], [[num.twenty]], [[num.fourteen]], [[num.sixteen]], [[num.eighteen]], [[num.seventeen]], [[num.nineteen]].
# Accent-tolerant: the box takes the word with its accents left off (accents=loose); ñ is a letter and is marked.
item language.eleven-to-twenty-write v=1 skills=[language.numbers, language.spelling] {
  title "Write the word"
  difficulty pick(k, 0, 0, 0, 0, 1, 1, 1, 2, 2, 2)
  let k=0..9

  scene 34x23 {
    column all at=canvas(1, 1) space=1 align=start {
      tenframe a count=10 color=sky
      tenframe b count=pick(k, 1, 2, 5, 3, 10, 4, 6, 8, 7, 9) color=mint
      text ask "How many are in the two frames? Write it in [[language.name]]." width=32
      word-input word options=[pick(k, "[[num.eleven]]", "[[num.twelve]]", "[[num.fifteen]]", "[[num.thirteen]]", "[[num.twenty]]", "[[num.fourteen]]", "[[num.sixteen]]", "[[num.eighteen]]", "[[num.seventeen]]", "[[num.nineteen]]")] accents=loose
    }
  }

  answer word=pick(k, "[[num.eleven]]", "[[num.twelve]]", "[[num.fifteen]]", "[[num.thirteen]]", "[[num.twenty]]", "[[num.fourteen]]", "[[num.sixteen]]", "[[num.eighteen]]", "[[num.seventeen]]", "[[num.nineteen]]")
  hint "Say the word quietly first. What sound does it start with?"
  hint "Count the sounds, then write one letter or pair of letters for each."
}
