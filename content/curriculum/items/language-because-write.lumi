# The word written from its picture: [[opinion.fun]], [[opinion.boring]], [[opinion.easy]], [[opinion.hard]], [[opinion.great]], [[opinion.because]], [[opinion.interesting]].
# Accent-strict: the accent is part of the spelling, and a word typed without it is caught by the rule below.
item language.because-write v=1 skills=[language.opinions, language.sentences, language.spelling] {
  title "Write the word"
  difficulty pick(k, 0, 0, 0, 1, 1, 2, 2)
  let k=0..6

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      face f mood=happy hair=0
      text ask "{pick(k, \"Leo laughs all through the game. It is fun. Write it in [[language.name]].\", \"Ana yawns all through the film. It is boring. Write it in [[language.name]].\", \"Leo finishes in one minute. It is easy. Write it in [[language.name]].\", \"Ana cannot finish it after an hour. It is hard. Write it in [[language.name]].\", \"It was the best day ever. It was great. Write it in [[language.name]].\", \"The word that joins a reason: because. Write it in [[language.name]].\", \"Leo wants to know more about the ship. It is interesting. Write it in [[language.name]].\")}" width=32
      word-input word options=[pick(k, "[[opinion.fun]]", "[[opinion.boring]]", "[[opinion.easy]]", "[[opinion.hard]]", "[[opinion.great]]", "[[opinion.because]]", "[[opinion.interesting]]")]
    }
  }

  answer word=pick(k, "[[opinion.fun]]", "[[opinion.boring]]", "[[opinion.easy]]", "[[opinion.hard]]", "[[opinion.great]]", "[[opinion.because]]", "[[opinion.interesting]]")
  hint "Say the word quietly first. What sound does it start with?"
  hint "Count the sounds, then write one letter or pair of letters for each."
}
