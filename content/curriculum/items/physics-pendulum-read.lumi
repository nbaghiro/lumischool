item physics.pendulum-read v=1 skills=[physics.motion] {
  title "How long is the string?"
  difficulty l
  let l=2..8
  level easy {
    let l=2..4
  }
  level hard {
    let l=6..8
  }

  scene 24x12 {
    pendulum p length=l at=canvas(1, 0)
    text ask "How many centimetres long is the string?" width=10 right-of=p gap=1
    number-input answer below=ask gap=1
  }

  answer (l * 10)
  hint "What is written beside the bracket?"
}
