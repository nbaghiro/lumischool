# The two-star reason: the response lasts as long as the call because the beat does not stop, so a
# short answer leaves a gap and a long one runs into the next call.
item music.call-why v=1 stars=2 skills=[music.form, music.rhythm, reasoning.explain] {
  title "Why the same length?"
  let r=0..1

  scene 36x26 {
    countrow row beats=8 meter=4 now=-1 at=canvas(1, 1)
    text ask "In a leader-and-group song, Ben makes his response two beats long when the call was four. Ana says the song will go wrong. Why?" narrate width=34 below=row gap=1
    choice pick options=[pick(r, "The next call would come in too early", "A response must copy the call"), "Two beats is too short for words", pick(r, "A response must copy the call", "The next call would come in too early")] stack=column below=ask gap=1
  }

  answer pick="The next call would come in too early"
  feedback {
    when (pick != "The next call would come in too early") point=row {
      say "Count along the row: four beats of call, then the response. Where does the next call start?"
    }
  }
  hint "Does the beat stop while the response is sung?"
  hint "Count eight beats: four for the call, four for the answer. What changes if the answer is two?"
}
