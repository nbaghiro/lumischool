# Division within a hundred with something left over, at the bus stop.
item division.remainder-small v=1 skills=[division.short-with-remainder] {
  title "Divide, and say what is left"
  difficulty (d * q + r)
  let d=3..9 q=4..13 r=1..8
  where (r < d and d * q + r < 100)
  level easy {
    let d=3..5 q=4..8 r=1..3
  }
  level hard {
    let d=6..9 q=9..13 r=3..8
  }

  scene 26x11 {
    longdiv sum n=(d * q + r) by=d blanks=[quotient, rest] at=canvas(1, 1)
    text ask "Divide, and write what is left over in the small box." width=24 below=sum gap=1
  }

  answer quotient=q rest=r
  feedback {
    when (rest >= d) point=sum.bar {
      say "What is left over is always smaller than {d}, or another {d} would fit."
    }
    when (quotient == q + 1) point=sum.bar {
      say "{q + 1} lots of {d} is {d * q + d}, which is more than {d * q + r}."
    }
  }
  hint "Count in {d}s. What is the biggest you can reach without going past {d * q + r}?"
  hint "How far is that from {d * q + r}? That is what is left over."
}
