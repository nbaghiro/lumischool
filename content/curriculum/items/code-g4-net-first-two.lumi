# Only the first two bridges: each pair meets once, so the smaller of each pair is on the left line
# of that pair. The question is about the middle of the network, not what comes out.
item coding.net-first-two v=1 skills=[coding.algorithms] {
  title "After two bridges"
  difficulty i
  let k=0..3 i=1..4 a={if k == 0 then 6 else if k == 1 then 2 else if k == 2 then 9 else 5} b={if k == 0 then 3 else if k == 1 then 8 else if k == 2 then 4 else 1} c={if k == 0 then 8 else if k == 1 then 7 else if k == 2 then 1 else 9} d={if k == 0 then 2 else if k == 1 then 5 else if k == 2 then 6 else 3}
  level easy {
    let i=1..2  # the first bridge
  }
  level hard {
    let i=3..4  # the second bridge
  }

  scene 31x17 {
    sortnet n inputs=[a, b, c, d] pairs=[1, 2, 3, 4, 1, 3, 2, 4, 2, 3] at=canvas(1, 0)
    text ask "Follow the numbers down to just below the first two bridges. Which number is on line {i} then?" width=16 right-of=n gap=1
    number-input answer below=ask gap=1
  }

  answer (if i == 1 then min(a, b) else if i == 2 then max(a, b) else if i == 3 then min(c, d) else max(c, d))
  feedback {
    when (i <= 2 and a > b and answer == (if i == 1 then a else b)) point=n {
      say "That number went in on line {i}. Did it meet a smaller number at the first bridge?"
    }
  }
  hint "The first bridge joins lines 1 and 2. The second joins lines 3 and 4. Which way does each pair go?"
  hint "At a bridge the smaller number goes to the left line."
}
