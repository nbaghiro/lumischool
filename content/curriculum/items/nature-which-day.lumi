# Two days' graphs one above the other, and which was the sunny day: the one that climbs steeply to
# the afternoon and falls again. On a cloudy or rainy day the line hardly moves.
item nature.which-day v=1 skills=[nature.weather, data.line-graphs] {
  title "Which day was sunny?"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..3
  let up={pick(k, 0, 1, 0, 1)}
  let asks={pick(k, "One day was sunny and the other cloudy all day. Which graph is the sunny day?", "One day was sunny and the other cloudy all day. Which graph is the sunny day?", "One day it rained all day and the other was sunny. Which graph is the rainy day?", "One day it rained all day and the other was sunny. Which graph is the rainy day?")}
  let right={pick(k, "the top graph", "the bottom graph", "the bottom graph", "the top graph")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 34x34 {
    column both at=canvas(1, 1) space=1 align=start {
      linegraph top labels=["6", "8", "10", "12", "14", "16", "18"] values=[pick(up, 4, 8), pick(up, 7, 9), pick(up, 11, 10), pick(up, 15, 11), pick(up, 17, 11), pick(up, 15, 10), pick(up, 11, 9)] max=18 per=3 color=tang
      linegraph low labels=["6", "8", "10", "12", "14", "16", "18"] values=[pick(up, 8, 4), pick(up, 9, 7), pick(up, 10, 11), pick(up, 11, 15), pick(up, 11, 17), pick(up, 10, 15), pick(up, 9, 11)] max=18 per=3 color=sky
    }
    text ask "Ada drew the temperatures at the hut on two days in the same week. {asks}" narrate width=32 below=both gap=1
    choice pick options=["the top graph", "the bottom graph"] below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=both {
      say "Sunshine warms the ground through the morning, so a sunny day climbs high by the afternoon. Under cloud the line stays nearly flat."
    }
  }
  hint "Which line climbs a long way from morning to afternoon, and which stays nearly level?"
  hint "What does the sun do to the ground in the morning? What do clouds do to the sunshine?"
}
