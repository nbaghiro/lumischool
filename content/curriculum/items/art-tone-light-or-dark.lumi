item art.tone-light-or-dark v=1 skills=[art.tone] {
  title "Lighter or darker?"
  difficulty (if k == 1 or k == 3 then 1 else 0)
  let k={0, 1, 3, 4}
  level easy {
    let k={0, 4}
  }
  level hard {
    let k={1, 3}
  }

  scene 34x11 {
    tonescale scale steps=5 blank=-1 ring=k at=canvas(1, 1)
    text ask "Is the ringed square lighter or darker than the middle one?" width=12 right-of=scale gap=1
    choice pick options=["lighter", "darker"] below=ask gap=1
  }

  answer pick=(if k < 2 then "lighter" else "darker")
  hint "Find the middle square. Is the ringed one nearer the white end or the dark end?"
}
