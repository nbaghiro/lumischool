# Two saucers put out at the same time in different places. The faster one is the place where the
# puddle grows first, which the child reads by comparing two rows picture by picture.
item chem.ice-faster v=1 skills=[chemistry.states] {
  title "Which melted faster?"
  difficulty (if k == 1 or k == 4 then 1 else 0)
  let k=0..5
  level easy {
    let k={0, 2, 3, 5}
  }
  level hard {
    let k={0, 1, 3, 4}  # never the freezer against the sun
  }

  scene 34x16 {
    text ask "Two ice cubes were put out at the same time. Which one melted faster?" width=24 at=canvas(1, 0)
    row pair below=ask gap=0 space=1 align=start {
      icemelt one every=10 count=3 place=(if k == 0 then 0 else if k == 1 then 1 else if k == 2 then 0 else if k == 3 then 1 else if k == 4 then 2 else 2)
      icemelt two every=10 count=3 place=(if k == 0 then 1 else if k == 1 then 2 else if k == 2 then 2 else if k == 3 then 0 else if k == 4 then 1 else 0)
    }
    choice pick options=["the one {if k == 0 then \"in the freezer\" else if k == 1 then \"on the table\" else if k == 2 then \"in the freezer\" else if k == 3 then \"on the table\" else if k == 4 then \"in the sun\" else \"in the sun\"}", "the one {if k == 0 then \"on the table\" else if k == 1 then \"in the sun\" else if k == 2 then \"in the sun\" else if k == 3 then \"in the freezer\" else if k == 4 then \"on the table\" else \"in the freezer\"}"] below=pair gap=0
  }

  answer pick=(if k == 0 then "the one on the table" else if k == 1 then "the one in the sun" else if k == 2 then "the one in the sun" else if k == 3 then "the one on the table" else if k == 4 then "the one in the sun" else "the one in the sun")
  hint "Look at the saucers for 10 minutes. Which has the smaller ice cube?"
  hint "Which place is warmer?"
}
