# The three-star: all the shortest ways from the corner to the tree, going only right or down.
# One right and one down is two ways; two rights and a down is three; two of each is six, and the
# way in is to draw every way on the grid and cross off the repeats.
item nature.ways-to-tree v=1 stars=3 skills=[nature.maps, reasoning.all-ways] {
  title "All the ways"
  difficulty (if a == 1 and b == 1 then 0 else if a + b == 3 then 1 else if a + b == 4 and a != b then 2 else 3)
  let a=1..3 b=1..2
  where (a + b <= 4)
  level easy {
    let a=1..2 b=1..1
  }
  level hard {
    let a=2..2 b=2..2
  }

  scene 34x10 {
    gridmap map cols=4 rows=3 col=(a + 1) row=(b + 1) thing=tree at=canvas(1, 1)
    text ask "Ada starts in A1 and walks to the tree, one square at a time, going only right or down. How many different shortest ways are there?" narrate width=20 right-of=map gap=2
    number-input answer below=ask gap=1
  }

  answer (if a + b == 2 then 2 else if a + b == 3 then 3 else if a == b then 6 else 4)
  feedback {
    when (answer == 2 and a + b > 2) point=map {
      say "Right first and down first are two ways, but the rights and downs can be mixed: right, down, right is a way too. Draw every order you can."
    }
    when (answer == 1) point=map {
      say "There is more than one shortest way. Try going right first, then try going down first."
    }
  }
  hint "Draw one way on the grid with your finger. Now draw a way that starts with the other direction."
  hint "Every way has the same steps, {a} rights and {b} downs, in a different order. Write the orders down: R first, then D first, and every mix."
}
