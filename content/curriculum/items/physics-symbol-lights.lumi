# Does it light? The same loop rule, read from symbols: a cell, a closed switch and no loose wire. The
# checker takes the answer from the loop the diagram draws.
item physics.symbol-lights v=1 skills=[physics.circuits, physics.symbols] {
  title "Will the bulb light?"
  difficulty f
  let f=0..3 c=1..3
  level easy {
    let f=0..1
  }
  level hard {
    let f=2..3
  }

  scene 30x13 {
    series s cells=(if f == 3 then 0 else c) bulbs=1 closed=(if f == 1 then 0 else 1) loose=(if f == 2 then 1 else 0) show=0 symbols=1 at=canvas(1, 0)
    text ask "Will the bulb in this circuit diagram light?" narrate width=12 right-of=s gap=1
    choice pick options=["Yes", "No"] below=ask gap=1
  }

  check physics.circuit of=s pick=lights
  hint "Is there a cell in the loop? Is the switch closed?"
  hint "Follow the wire all the way round. Is there a gap anywhere?"
}
