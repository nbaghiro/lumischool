# The line is not drawn, so its length has to come from the program: two lots of a long side and a
# short side, which is the perimeter before the word is taught.
item coding.turtle-length v=1 skills=[coding.drawing, coding.repetition] {
  title "How long is the line?"
  difficulty (w + h)
  let w=2..4 h=1..3
  where (h < w)
  level easy {
    where (w + h <= 4)
  }
  level hard {
    where (w + h >= 6)
  }

  scene 31x16 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks bl code=["repeat 2", "  forward {w}", "  turn left", "  forward {h}", "  turn left"]
      turtle t cols=6 rows=5 col=1 row=5 face=right moves=["repeat 2", "  forward {w}", "  turn left", "  forward {h}", "  turn left"] upto=0
    }
    text ask "How many squares long is the whole line?" width=20 below=top gap=1
    number-input answer right-of=ask gap=1
  }

  check coding.runs of=t answer=moves
  feedback {
    when (answer == w + h) point=bl {
      say "That is one time round. The repeat goes round twice."
    }
    when (answer == w * h) point=bl {
      say "That counts the squares inside. The line goes round the outside."
    }
  }
  hint "How long is one time round the repeat?"
  hint "The repeat goes round two times. Add the two rounds."
}
