# Which two blocks could change places: moves on an open grid can go in any order, and the rocks are
# placed so that exactly one of the three swaps still gets through, a different one in each map.
item coding.which-swap v=1 stars=2 skills=[coding.sequences, reasoning.compare] {
  title "Two blocks swap"
  let k=0..2

  scene 32x20 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks b code=["right 2", "down 2", "right 1"] numbers=true words=false
      maze g cols=5 rows=4 flag=[4, 3] rocks=[if k == 0 then 4 else 1, 2, if k == 2 then 4 else 2, if k == 2 then 1 else 2] code=["right 2", "down 2", "right 1"] trail=line
    }
    text ask "Which two blocks could swap places and the robot still get to the flag?" width=30 below=top gap=1
    choice pick options=["1 and 2", "1 and 3", "2 and 3"] below=ask gap=1
  }

  answer pick=(if k == 0 then "1 and 2" else if k == 1 then "2 and 3" else "1 and 3")
  feedback {
    when (pick == "2 and 3" and k != 1) point=g {
      say "Try it: right 2, right 1, then down 2. Does the robot get past the rocks?"
    }
  }
  hint "Try each swap with a finger. Where does the robot go first?"
  hint "A swap is no good if the new path goes over a rock."
}
