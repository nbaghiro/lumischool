# The language to English: [[colour.pink]], [[colour.orange]], [[colour.grey]], [[colour.brown]], [[colour.purple]], [[colour.green]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.more-colours-meaning v=1 skills=[language.colours] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x24 {
    column all at=canvas(1, 1) space=1 align=start {
      sign card lines=[pick(k, "[[colour.pink]]", "[[colour.orange]]", "[[colour.grey]]", "[[colour.brown]]", "[[colour.purple]]", "[[colour.green]]")] kind=hanging color=mint
      text ask "What colour is on the sign?" width=32
      choice pick options=[pick(k, "grey", "purple", "brown", "grey", "green", "grey"), pick(k, "purple", "orange", "grey", "brown", "purple", "green"), pick(k, "pink", "grey", "orange", "orange", "brown", "purple")] stack=column
    }
  }

  answer pick=pick(k, "pink", "orange", "grey", "brown", "purple", "green")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
