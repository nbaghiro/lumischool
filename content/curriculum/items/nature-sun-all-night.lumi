# The two-star reason: the tundra has the midnight sun in summer, light all day and night, yet grows
# only low plants. Light is not what is missing; warmth is, with a growing season of a couple of
# months and frozen ground below.
item nature.sun-all-night v=1 stars=2 skills=[nature.biomes, nature.adaptation, reasoning.explain] {
  title "Light all night, and still so small"
  difficulty (if k == 0 then 0 else 1)
  let k=0..1
  let told={pick(k, "In June and July the sun never sets over the research hut, so tundra plants have light all day and all night. Why do they still grow only a few centimetres tall?", "A rainforest tree and a tundra willow both get about 12 hours of light a day, on average, over a whole year. Why is the willow no taller than a boot?")}
  let right={pick(k, "Only a few weeks are warm enough to grow", "Only about two months a year are warm enough")}
  let o1={pick(k, "The light is too bright for them", "The willow gets less light in a year")}
  let o2={pick(k, "There is too much rain", "Willows are always small trees")}
  let x1={pick(k, o1, right)}
  let x2={pick(k, right, o2)}
  let x3={pick(k, o2, o1)}
  level easy {
    let k={0}
  }
  level hard {
    let k={1}
  }

  scene 36x32 {
    row all at=canvas(1, 1) space=2 align=end {
      midnightsun ms
      hut ht
    }
    text ask "{told}" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=all {
      say "Look back at the tundra's graph. Is light the thing that runs short, or warmth?"
    }
  }
  hint "What does a plant need besides light to grow?"
  hint "How many months of the tundra's year are warm enough?"
}
