# Unplugged: three steps of an everyday job put in order, which is what a program is.
item k.teeth-in-order v=1 skills=[coding.sequences, reasoning.order] {
  title "Three steps in order"
  difficulty (if k == 0 then 0 else 1)
  let k=0..2
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..2
  }

  scene 30x16 {
    text ask "{pick(k, \"Put the steps for brushing your teeth in order. Write 1, 2 and 3.\", \"Put the steps for planting a seed in order. Write 1, 2 and 3.\", \"Put the steps for getting dressed to go out in order. Write 1, 2 and 3.\")}" narrate width=28 at=canvas(1, 1)
    sequence s items=["{pick(k, \"brush your teeth\", \"put in the seed\", \"put on your coat\")}", "{pick(k, \"put paste on the brush\", \"water it\", \"put on your socks\")}", "{pick(k, \"rinse your mouth\", \"fill the pot with soil\", \"put on your shoes\")}"] blanks=[p, q, r] below=ask gap=1
  }

  answer p=pick(k, 2, 2, 3) q=pick(k, 1, 3, 1) r=pick(k, 3, 1, 2)
  hint "What do you have to do before anything else can happen?"
}
