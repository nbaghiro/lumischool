# The word written from its picture: [[food.bread]], [[food.cheese]], [[food.fish]], [[food.eggs]], [[food.water]], [[food.potatoes]], [[food.milk]].
# Accent-tolerant: the box takes the word with its accents left off (accents=loose); ñ is a letter and is marked.
item language.hungry-write v=1 skills=[language.food, language.spelling] {
  title "Write the word"
  difficulty pick(k, 0, 0, 0, 1, 1, 2, 2)
  let k=0..6

  scene 34x24 {
    column all at=canvas(1, 1) space=1 align=start {
      foodstall stall foods=["{pick(k, \"bread\", \"cheese\", \"fish\", \"egg\", \"bread\", \"potato\", \"bread\")}"] names=[""] costs=[""]
      text ask "{pick(k, \"What is in the crate? Write it in [[language.name]], without the little word before it.\", \"What is in the crate? Write it in [[language.name]], without the little word before it.\", \"What is in the crate? Write it in [[language.name]], without the little word before it.\", \"What is in the crate? Write it in [[language.name]], without the little word before it.\", \"It comes out of the tap and you drink it. Write it in [[language.name]].\", \"What is in the crate? Write it in [[language.name]], without the little word before it.\", \"A white drink from a cow. Write it in [[language.name]].\")}" width=32
      word-input word options=[pick(k, "[[food.bread]]", "[[food.cheese]]", "[[food.fish]]", "[[food.eggs]]", "[[food.water]]", "[[food.potatoes]]", "[[food.milk]]")] accents=loose
    }
  }

  answer word=pick(k, "[[food.bread]]", "[[food.cheese]]", "[[food.fish]]", "[[food.eggs]]", "[[food.water]]", "[[food.potatoes]]", "[[food.milk]]")
  hint "Say the word quietly first. What sound does it start with?"
  hint "Count the sounds, then write one letter or pair of letters for each."
}
