# Three stages of the frog matched to the three of the butterfly that do the same job: the egg,
# the young one that eats and grows, the grown one that lays eggs. The pairs are shuffled three
# ways so one line does not give the rest.
item nature.match-cycles v=1 skills=[nature.life-cycles, reasoning.compare] {
  title "The same stage in both"
  let k=0..2

  scene 34x25 {
    row pics at=canvas(1, 1) space=2 align=end {
      frogcycle life stage=4 ring=1 names=0
      minibeasts fly kinds=["butterfly"] legs=false
    }
    text ask "The frog and the butterfly both go round. Write the number of the butterfly stage that does the same job as each frog stage." narrate width=32 below=pics gap=1
    match m left=["frogspawn", "tadpole", "frog"] right=["{if k == 0 then \"caterpillar\" else if k == 1 then \"butterfly\" else \"egg\"}", "{if k == 0 then \"butterfly\" else if k == 1 then \"egg\" else \"caterpillar\"}", "{if k == 0 then \"egg\" else if k == 1 then \"caterpillar\" else \"butterfly\"}"] blanks=[a, b, c] below=ask gap=1
  }

  answer a=(if k == 0 then 3 else if k == 1 then 2 else 1) b=(if k == 0 then 1 else if k == 1 then 3 else 2) c=(if k == 0 then 2 else if k == 1 then 1 else 3)
  hint "Which butterfly stage is the egg? That pairs with the frogspawn."
  hint "The tadpole eats and grows, like the caterpillar. The frog lays eggs, like the butterfly."
}
