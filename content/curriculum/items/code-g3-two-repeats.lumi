# Two programs that move the same way by different repeats: which goes further is a comparison of
# two products, and sometimes they are equal. CSTA 1B-AP-08, comparing two algorithms.
item coding.two-repeats v=1 stars=2 skills=[coding.repetition, reasoning.compare] {
  title "Which goes further?"
  difficulty (if k == 0 or k == 3 then 2 else if k == 4 then 1 else 0)
  let k=0..5

  scene 34x17 {
    row top at=canvas(1, 0) space=3 align=start {
      program pa code=["repeat {if k == 0 then 3 else if k == 1 then 2 else if k == 2 then 4 else if k == 3 then 6 else if k == 4 then 5 else 3}", "  right {if k == 0 then 4 else if k == 1 then 5 else if k == 2 then 2 else if k == 3 then 2 else if k == 4 then 2 else 3}"] title="Ana"
      program pb code=["repeat {if k == 0 then 4 else if k == 1 then 3 else if k == 2 then 3 else if k == 3 then 4 else if k == 4 then 3 else 2}", "  right {if k == 0 then 3 else if k == 1 then 3 else if k == 2 then 3 else if k == 3 then 3 else if k == 4 then 3 else 5}"] title="Ben"
    }
    text ask "Both robots start on the same square. Whose robot ends up further to the right?" width=32 below=top gap=1
    choice pick options=["Ana's", "Ben's", "the same"] below=ask gap=1
  }

  answer pick=(if k == 0 or k == 3 then "the same" else if k == 1 or k == 4 then "Ana's" else "Ben's")
  feedback {
    when (pick == "Ben's" and (k == 1 or k == 4)) point=pb {
      say "A bigger move or more times round does not settle it alone. Work out how far each robot goes in all."
    }
  }
  hint "How far does each robot move in one time round?"
  hint "How far is that altogether, for each of them?"
}
