# Two toys, one a very old kind and one first made within living memory; the key comes from the
# dated record in chronicle.ts.
item k.older-toy v=1 skills=[history.change, history.order] {
  title "Which toy is older?"
  difficulty (if k <= 1 then 0 else 1)
  let k=0..3
  let one={pick(k, "spinning top", "puzzle cube", "kite", "building bricks")}
  let two={pick(k, "puzzle cube", "rag doll", "building bricks", "spinning top")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 26x17 {
    toys shelf toys=["{one}", "{two}"] letters=0 at=canvas(1, 0)
    text ask "Which kind of toy did children play with long, long ago?" narrate width=22 below=shelf gap=1
    choice pick options=["{one}", "{two}"] below=ask gap=1
  }

  check history.dates of=pick pick=first
  hint "Which one could be made from wood, cloth or paper?"
}
