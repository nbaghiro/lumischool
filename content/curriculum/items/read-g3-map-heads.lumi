# The four parts a story map is built on, matched to four stops. r shuffles the headings.
item reading.map-heads v=1 skills=[reading.story-structure] {
  title "Start, problem, fix, end"
  let k=0..1 r=0..2

  scene 30x16 {
    text ask "Write the number of the part of the story next to each stop." width=29 at=canvas(1, 1)
    match m left=[if k == 0 then "Ada plants a row of beans." else "Joss sails his boat.", if k == 0 then "Snails eat the first leaves." else "The wind blows it away.", if k == 0 then "She puts eggshells round." else "Grandad hooks it back.", if k == 0 then "Ada picks a bowl of beans." else "Joss sails all afternoon."] right=[if r == 0 then "Fix" else if r == 1 then "End" else "Problem", if r == 0 then "Start" else if r == 1 then "Problem" else "End", if r == 0 then "End" else if r == 1 then "Start" else "Fix", if r == 0 then "Problem" else if r == 1 then "Fix" else "Start"] blanks=[a, b, c, d] below=ask gap=1
  }

  answer a=(if r == 0 then 2 else if r == 1 then 3 else 4) b=(if r == 0 then 4 else if r == 1 then 2 else 1) c=(if r == 0 then 1 else if r == 1 then 4 else 3) d=(if r == 0 then 3 else if r == 1 then 1 else 2)
  hint "Which stop goes wrong? That is the problem."
  hint "Which stop puts it right? The one after that is the end."
}
