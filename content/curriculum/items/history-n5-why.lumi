# The two-star reason for each country's unit (n as in n5-order).
item history.n5-why v=1 skills=[history.nation, reasoning.why] {
  title "Why?"
  let n=0..4
  let ask={pick(n, "Why did King William want the Domesday Book?", "Why did settlers cross the ocean to the colonies?", "Why did Japan build a fast railway between its cities?", "Why do birch-bark letters tell us so much?", "Why was Dujiangyan built on the river Min?")}
  let right={pick(n, "To know what everyone owned and owed", "To find land and a new life", "So people could travel quickly", "Ordinary people, even children, wrote them", "To water fields and stop floods")}
  let w1={pick(n, "To collect stories for children", "To see the other side of the Moon", "To use up spare iron", "Only princes were allowed to write them", "To make a harbour for big ships")}
  let w2={pick(n, "To choose a new capital city", "Because England had no farms", "Because planes were not allowed", "They were printed in thousands", "To mark the border of the kingdom")}

  scene 36x24 {
    timeline line from=-300 to=2100 step=300 years=[] labels=[] at=canvas(0, 0)
    text ask "{ask}" narrate width=34 below=line gap=1
    choice pick options=["{right}", "{w1}", "{w2}"] stack=column below=ask gap=1
  }

  answer pick=right
  hint "What problem did people have at the time?"
  hint "Which answer solves that problem?"
}
