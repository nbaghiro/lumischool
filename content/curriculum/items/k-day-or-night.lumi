item k.day-or-night v=1 skills=[physics.light, nature.day-and-night] {
  title "Day or night?"
  difficulty 0
  let w=0..1

  scene 30x24 {
    column skies at=canvas(1, 1) space=1 align=start {
      daysky day night=false clouds=3 stars=0
      daysky dark night=true phase=0.5 clouds=0 stars=12
    }
    text q "Which picture shows the {if w == 0 then \"night\" else \"day\"}?" narrate width=28 below=skies gap=1
    choice pick options=["the top one", "the bottom one"] stack=row below=q gap=1
  }

  answer pick=(if w == 0 then "the bottom one" else "the top one")
  hint "Where can you see the sun? Where are the moon and stars?"
  hint "Is the sky in each picture light or dark?"
}
