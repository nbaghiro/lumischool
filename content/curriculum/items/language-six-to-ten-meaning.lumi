# The language to English: [[num.six]], [[num.ten]], [[num.eight]], [[num.seven]], [[num.nine]], [[num.five]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.six-to-ten-meaning v=1 skills=[language.numbers] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x24 {
    column all at=canvas(1, 1) space=1 align=start {
      sign card lines=[pick(k, "[[num.six]]", "[[num.ten]]", "[[num.eight]]", "[[num.seven]]", "[[num.nine]]", "[[num.five]]")] kind=hanging color=berry
      text ask "What number is on the sign?" width=32
      choice pick options=[pick(k, "8", "9", "7", "5", "5", "9"), pick(k, "9", "10", "8", "7", "9", "5"), pick(k, "6", "8", "10", "10", "7", "8")] stack=column
    }
  }

  answer pick=pick(k, "6", "10", "8", "7", "9", "5")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
