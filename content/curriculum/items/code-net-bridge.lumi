item coding.net-bridge v=1 skills=[coding.algorithms] {
  title "The first bridge"
  difficulty (9 - abs(a - b))
  let a=2..9 b=2..9
  where (a != b)
  level easy {
    where (abs(a - b) >= 5)
  }
  level hard {
    where (abs(a - b) <= 2)
  }

  scene 31x17 {
    sortnet n inputs=[a, b, 1, 10] pairs=[1, 2, 3, 4, 1, 3, 2, 4, 2, 3] at=canvas(1, 0)
    text ask "At the first bridge, {a} and {b} meet. Which of them goes on down the left line?" width=16 right-of=n gap=1
    number-input answer below=ask gap=1
  }

  answer min(a, b)
  hint "At every bridge the smaller number goes left."
}
