# Sharing out by taking away: a repeat until in text, whose count and whose leftover are two
# different names. The keeper's fish are shared among the seals.
item coding.text-value v=1 skills=[coding.text, coding.variables, coding.tracing] {
  title "Fish for the seals"
  difficulty (f / e / 2 + (if f % e == 0 then 0 else 0.5))
  let e=3..5 f=10..23
  where (f / e >= 2 and f / e <= 6)
  level easy {
    let e={3}
    where (f <= 12)
  }
  level hard {
    let e={4, 5}
    where (f % e != 0 and f >= 17)
  }

  scene 36x21 {
    program p code=["set fish to {f}", "set seals to 0", "repeat until fish is less than {e}", "  take {e} from fish", "  add 1 to seals"] text=true at=canvas(1, 0)
    seal s rock=1 right-of=p gap=1
    text ask "The keeper at the research hut gives each seal {e} fish until there are not enough left for another. What do seals and fish hold at the end?" width=20 below=p gap=1
    text ts "seals" right-of=ask gap=1
    number-input seals right-of=ts gap=1
    text tf "fish" below=ts gap=1
    number-input fish right-of=tf gap=1
  }

  check coding.runs of=p seals="value(seals)" fish="value(fish)"
  feedback {
    when (fish == 0 and f % e != 0) point=p {
      say "The repeat stops as soon as fish is less than {e}, so what is left may not be 0."
    }
    when (seals == (f - f % e) / e + 1) point=p {
      say "Check the question at the top of the repeat before each time round: is fish less than {e} yet?"
    }
  }
  hint "Keep fish and seals written down, and change them each time round."
  hint "Before each time round, ask the question at the top of the repeat. When the answer is yes, stop."
}
