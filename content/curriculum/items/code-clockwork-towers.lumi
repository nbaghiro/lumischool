# The story: Sam's clockwork crane builds a tower of size blocks and puts a flag on top, three times
# with three numbers, so the pieces are the three sizes added up and one flag for each call.
item coding.clockwork-towers v=1 skills=[coding.procedures, coding.tracing] {
  title "Towers on the clockwork island"
  difficulty ((if v < 2 then 0 else 1) + (if v == 3 then 0.5 else 0))
  let v=0..3
  let a={pick(v, 2, 4, 3, 6)}
  let b={pick(v, 3, 2, 4, 5)}
  let c={pick(v, 1, 2, 5, 4)}
  level easy {
    let v=0..1
  }
  level hard {
    let v=2..3
  }

  scene 34x27 {
    row top space=2 align=start at=canvas(1, 1) {
      program prog code=["define tower size", "  repeat size", "    stack a block", "  put a flag on top", "tower {a}", "tower {b}", "tower {c}"] title="Sam's crane"
      gears g a=16 b=8 c=0 turn=1 show=1
    }
    text ask "On the clockwork island Sam's crane runs lines 5, 6 and 7. How many pieces does it use in all, blocks and flags together?" narrate width=32 below=top gap=1
    number-input pieces below=ask gap=1
  }

  answer pieces=(a + b + c + 3)
  feedback {
    when (pieces == a + b + c) point=prog {
      say "Those are the blocks. Each tower also gets a flag."
    }
    when (pieces == a + b + c + 1) point=prog {
      say "The flag line is inside the block, so every tower gets one: three towers, three flags."
    }
  }
  hint "How many pieces does tower {a} use, blocks and flag?"
  hint "Do the same for tower {b} and tower {c}, and add them up."
}
