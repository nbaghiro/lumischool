# One trolley is pushed from behind and one from in front. Only the push against the way it is
# rolling slows it down, which is the idea a stopping force rests on.
item physics.slow-it-down v=1 skills=[physics.forces] {
  title "Slow it down"
  let w=0..1

  scene 35x16 {
    forces one thing=trolley push=(if w == 0 then 4 else 0) oppose=(if w == 1 then 4 else 0) labels=false at=canvas(1, 0)
    text la "A" below=one gap=0
    forces two thing=trolley push=(if w == 1 then 4 else 0) oppose=(if w == 0 then 4 else 0) labels=false right-of=one gap=2
    text lb "B" below=two gap=0
    text ask "Both trolleys are rolling to the right. Which push will slow its trolley down?" width=24 below=la gap=1
    choice pick options=["A", "B"] right-of=ask gap=2
  }

  answer pick=(if w == 0 then "B" else "A")
  feedback {
    when (pick == "A" and w == 0) point=one {
      say "That push is from behind, going the same way. It makes the trolley go faster."
    }
    when (pick == "B" and w == 1) point=two {
      say "That push is from behind, going the same way. It makes the trolley go faster."
    }
  }
  hint "Which arrow points the other way from where the trolley is going?"
}
