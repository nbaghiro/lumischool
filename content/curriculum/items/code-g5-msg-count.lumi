# A message sent from inside a repeat: the clock strikes the hour, and every strike sends a message
# that the bell-ringer's script receives, so its lines run once for each strike.
item coding.msg-count v=1 skills=[coding.events, coding.messages, coding.repetition] {
  title "A message every strike"
  difficulty ((h - 3) / 4 + (c - 1) * 0.5)
  let h=3..9 c=1..3
  level easy {
    let h=3..5 c={1, 2}
  }
  level hard {
    let h=6..9 c={2, 3}
  }

  scene 36x24 {
    program p code=["when the flag is tapped", "set rings to 0", "repeat {h}", "  broadcast strike", "when I receive strike", "add {c} to rings"] at=canvas(0, 0)
    clocktower ct hour=h minute=0 right-of=p gap=2
    text ask "At {h} o'clock the clock tower sends strike once for each hour. What is rings at the end?" width=19 below=p gap=1
    number-input answer below=ask gap=1
  }

  check coding.runs of=p answer="value(rings)"
  feedback {
    when (answer == h and c > 1) point=p {
      say "Each strike adds {c}, not 1. Look at line 6."
    }
    when (answer == c) point=p {
      say "The repeat sends strike {h} times, and the script runs each time."
    }
  }
  hint "How many times does the broadcast line run?"
  hint "Each time strike is sent, which line runs, and what does it add?"
}
