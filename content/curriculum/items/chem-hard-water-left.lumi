# Boiled dry, each litre of water leaves its dissolved minerals behind; in the gorge's limestone water
# they are almost all calcium and magnesium, the minerals that make it hard. The unknown is the milligrams
# or grams left from some litres, or the litres that left a crust; 1000 mg is 1 g.
item chem.hard-water-left v=1 skills=[chemistry.hard-water, measure.mass] {
  title "The crust in the pan"
  difficulty (w * 2 + (if n <= 4 then 0 else 1))
  let w=0..1 m={150, 250} n={2, 4, 8, 20}
  let mg={m * n}
  level easy {
    let w=0..0 n={2, 4}
  }
  level hard {
    let w=1..1
  }

  scene 35x24 {
    row kit at=canvas(1, 0) space=2 align=end {
      waterwheel mill paddles=8 lit=0
      dish d left=0 day=5 sun=0
    }
    text ask "The mill's water has {m} mg of calcium and magnesium minerals dissolved in each litre. When water is boiled dry, they are left as a white crust. {if w == 0 then \"A grown-up boils \" else \"The miller's pan has \"}{if w == 0 then n else mg}{if w == 0 then \" litres dry. How many milligrams of crust are left?\" else \" mg of crust in it. How many litres of the mill's water were boiled dry in it?\"}" narrate width=34 below=kit gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then mg else n)
  feedback {
    when (w == 0 and answer == m) point=kit {
      say "{m} mg is from one litre. How many litres were boiled?"
    }
  }
  hint "{if w == 0 then \"How many milligrams does one litre leave?\" else \"How many milligrams does each litre leave behind?\"}"
  hint "{if w == 0 then \"Multiply by the number of litres.\" else \"How many lots of that make the crust?\"}"
}
