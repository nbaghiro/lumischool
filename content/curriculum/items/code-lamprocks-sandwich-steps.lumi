# The story: the robot opens the jar once, then does three steps for each sandwich, so n sandwiches
# take 1 + 3n steps.
item coding.lamprocks-sandwich-steps v=1 skills=[coding.sequences, coding.algorithms] {
  title "Sandwiches for the keepers"
  difficulty (n - 1)
  let n=1..4
  let many={pick(n - 1, "one sandwich", "two sandwiches", "three sandwiches", "four sandwiches")}
  level easy {
    let n=1..2
  }
  level hard {
    let n=3..4
  }

  scene 30x21 {
    art pic asset="kitchen-counter" at=canvas(1, 1)
    text ask "Pip's robot makes {many} for the lamp keepers. It opens the jam jar once. Then for each sandwich it takes two slices, spreads the jam and puts the other slice on top. How many steps does it do in all?" narrate width=28 below=pic gap=1
    number-input count below=ask gap=1
  }

  answer count=(1 + 3 * n)
  feedback {
    when (count == 3 * n) point=ask {
      say "The sandwich steps are right. Did the robot open the jar as well?"
    }
    when (n > 1 and count == 4 * n) point=ask {
      say "The jar is opened once, not once for each sandwich."
    }
  }
  hint "How many steps does one sandwich take?"
  hint "Count the sandwich steps for all {many}, then add the one step for the jar."
}
