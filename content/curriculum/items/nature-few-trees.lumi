# The two-star reason: why a zone has no trees. In the tundra the summer is short and the ground stays
# frozen below, so roots cannot go deep; in the grassland it is too dry; in the desert drier still.
item nature.few-trees v=1 stars=2 skills=[nature.zones, reasoning.explain] {
  title "Why so few trees?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..2
  let told={pick(k, "The tundra is the same distance from the sun as the fir forest, yet no tall trees grow there. Why?", "The grassland is warmer in summer than the fir forest, yet few trees grow there. Why?", "Ben says trees need warmth, so the hot desert should be full of them. Why is it not?")}
  let right={pick(k, "Summer is short and the ground below stays frozen", "There is too little rain for many trees", "Trees need water too; the desert has almost none")}
  let o1={pick(k, "Reindeer eat all the trees", "The grass is too tall for trees", "Camels eat the trees")}
  let o2={pick(k, "It is too windy for trees to stand", "Trees do not like warm summers", "The sand is too heavy")}
  let x1={pick(k, o1, right, o2)}
  let x2={pick(k, right, o2, o1)}
  let x3={pick(k, o2, o1, right)}
  level easy {
    let k={0}
  }
  level hard {
    let k=1..2
  }

  scene 36x30 {
    table zones cols=3 head=["Zone", "July °C", "Rain mm a year"] cells=["tundra", "10", "300", "fir forest", "17", "500", "grassland", "22", "350", "desert", "32", "100"] at=canvas(1, 1)
    text ask "{told}" narrate width=34 below=zones gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=zones {
      say "A tree needs warmth for long enough to grow, and water for its roots. Which of these does the table show is missing?"
    }
  }
  hint "What does a tall tree need, all year round?"
  hint "Compare the zone's warmth and rain with the fir forest's."
}
