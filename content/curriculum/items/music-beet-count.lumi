# The motif found in a line of the score, counted by its rhythm, whatever its notes: three quavers
# then a long note. Two, three or four statements in a line of 2/4 bars.
item music.beet-count v=1 skills=[music.motif, music.listening] {
  title "How many times?"
  difficulty (n - 2)
  let n=2..4
  let a1={pick(n - 2, "G4", "C5", "G4")} a2={pick(n - 2, "Ef4", "Af4", "Ef4")} b1={pick(n - 2, "F4", "Bf4", "F4")} b2={pick(n - 2, "D4", "G4", "D4")}
  let d1={pick(n - 2, "C5", "C5", "Af4")} d2={pick(n - 2, "D5", "C5", "Af4")} d3={pick(n - 2, "Ef5", "D5", "Af4")} d4={pick(n - 2, "C5", "C5", "F4")}
  let e3={pick(n - 2, 1, 1, 0.5)} e4={pick(n - 2, 1, 2, 2)} e1={pick(n - 2, 1, 0.5, 0.5)} e2={pick(n - 2, 1, 0.5, 0.5)}
  level easy {
    let n=2..3
  }
  level hard {
    let n=3..4
  }

  scene 36x35 {
    column line space=1 align=start at=canvas(1, 1) {
      notes top clef=treble notes=[a1, a1, a1, a2, b1, b1, b1, b2] values=[0.5, 0.5, 0.5, 2, 0.5, 0.5, 0.5, 2] meter=0 letters=false
      notes end clef=treble notes=[d1, d2, d3, d4] values=[e1, e2, e3, e4] meter=0 letters=false
    }
    text ask "Ana looks for the motif in this line of a score, by its rhythm: three quick notes, then a long one. The notes may change. How many times does it begin?" narrate width=34 below=line gap=1
    number-input answer below=ask gap=1
  }

  answer (if n == 4 then 3 else 2)
  feedback {
    when (answer == 1) point=line {
      say "The motif can start on other notes. Look for the rhythm, not the letters."
    }
  }
  hint "Look for three quavers in a row followed by a long note."
  hint "Check the end of the line as well as the start."
}
