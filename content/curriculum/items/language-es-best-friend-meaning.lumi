# The language to English: Mi mejor amiga se llama Eva., Es muy simpática., Es un poco tímido., Le gusta leer., Vive cerca de mí., Somos amigos desde hace años..
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.es-best-friend-meaning v=1 skills=[language.describing, language.grammar] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x33 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "girl", "boy", "girl", "gran", "boy")] says=[pick(k, "Mi mejor amiga se llama Eva.", "Es muy simpática.", "Es un poco tímido.", "Le gusta leer.", "Vive cerca de mí.", "Somos amigos desde hace años.")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "We have been friends for years.", "She likes reading.", "She is very kind.", "We have been friends for years.", "We have been friends for years.", "She likes reading."), pick(k, "My best friend is called Eva.", "She is very kind.", "She lives near me.", "She likes reading.", "He is a bit shy.", "We have been friends for years."), pick(k, "He is a bit shy.", "She lives near me.", "She likes reading.", "She is very kind.", "She lives near me.", "He is a bit shy."), pick(k, "She lives near me.", "He is a bit shy.", "He is a bit shy.", "He is a bit shy.", "She likes reading.", "She lives near me.")] stack=column
    }
  }

  answer pick=pick(k, "My best friend is called Eva.", "She is very kind.", "He is a bit shy.", "She likes reading.", "She lives near me.", "We have been friends for years.")
  hint "Find a part of the Spanish you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
