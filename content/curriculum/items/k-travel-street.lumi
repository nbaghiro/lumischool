item k.travel-street v=1 skills=[history.transport, history.then-and-now] {
  title "Travel in the street long ago"

  scene 32x36 {
    thenandnow street year=1850 sign=0 things=["horse and cart", "hot-air balloon", "aeroplane"] at=canvas(1, 0)
    text q "This street is from long, long ago. People travelled by horse, and some even flew in balloons. One thing could not have been there yet. Which one?" narrate width=30 below=street gap=1
    choice pick options=["horse and cart", "hot-air balloon", "aeroplane"] stack=column below=q gap=1
  }

  check history.street of=street pick=could-not
  hint "Which one needs an engine?"
}
