# The audit's raise for adding fractions: the sum is given and one part is missing, so the first
# fraction has to be changed into the smaller parts before anything is taken away.
item fractions.missing-part v=1 skills=[fractions.add-unlike] {
  title "The missing part"
  difficulty (b * m)
  let b={2, 3, 4} m=2..4 a=1..3 c=1..9  # the blank is one digit square
  where (a < b)
  where (c < b * m)
  where (a * m + c < b * m)
  level easy {
    let b={2, 3} m={2}
  }
  level hard {
    let b={3, 4} m=3..4
  }

  scene 30x10 {
    fraction one n=b k=a shape=bar at=canvas(1, 0)
    fraction whole n=(b * m) k=(a * m + c) shape=bar below=one gap=1
    equation eq "{a}/{b} + {?c}/{b * m} = {a * m + c}/{b * m}" below=whole gap=1
  }

  answer c=c
  feedback {
    when (c == a * m + c - a) point=eq {
      say "{a}/{b} is not {a}/{b * m}. How many pieces of size 1/{b * m} make {a}/{b}?"
    }
  }
  hint "How many pieces of size 1/{b * m} make {a}/{b}?"
  hint "Take that many away from {a * m + c}/{b * m}."
}
