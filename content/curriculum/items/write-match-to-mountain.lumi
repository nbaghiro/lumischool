# Three sentences matched to the three cards they belong on: the opening, the problem and the
# fixing.
item writing.match-to-mountain v=1 skills=[writing.planning, writing.story-structure] {
  title "Which card?"
  difficulty k
  let k=0..1 r=0..2
  let s1={pick(k, "Mia and her brother set off for the beach.", "A gull swooped and took the sandwich.")}
  let s2={pick(k, "The tide came in over the sand wall.", "Nour had saved an apple in her bag.")}
  let s3={pick(k, "Dad carried the picnic up the steps.", "Nour sat on the harbour wall with her lunch.")}
  let c1={pick(k, "Opening", "Problem")}
  let c2={pick(k, "Problem", "Fixing it")}
  let c3={pick(k, "Fixing it", "Opening")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 36x13 {
    text ask "Write the number of the card each sentence belongs on." narrate width=32 at=canvas(1, 1)
    match m left=["{s1}", "{s2}", "{s3}"] right=["{if r == 0 then c2 else if r == 1 then c3 else c1}", "{if r == 0 then c3 else if r == 1 then c1 else c2}", "{if r == 0 then c1 else if r == 1 then c2 else c3}"] blanks=[x, y, z] below=ask gap=1
  }

  answer x=(if r == 0 then 3 else if r == 1 then 2 else 1) y=(if r == 0 then 1 else if r == 1 then 3 else 2) z=(if r == 0 then 2 else if r == 1 then 1 else 3)
  hint "The opening tells who and where. The problem is what goes wrong. The fixing is how it is put right."
  hint "Read each sentence and ask: is anything going wrong here, being put right, or just starting?"
}
