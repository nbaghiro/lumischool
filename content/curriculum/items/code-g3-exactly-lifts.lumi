# Every number under the cups, sorted by how many halvings find it: seven numbers to try, and
# a pattern of one, two and four that doubles.
item coding.exactly-lifts v=1 stars=3 skills=[coding.algorithms, reasoning.all-the-ways] {
  title "Exactly that many lifts"
  difficulty k
  let k=1..3

  scene 25x15 {
    cups c cards=[2, 5, 8, 11, 14, 17, 20] open=[] target=11 crossed=false at=canvas(1, 0)
    text ask "Halving each time, how many of the seven numbers take exactly {k} lift{if k == 1 then \"\" else \"s\"} to find?" width=23 below=c gap=1
    number-input answer below=ask gap=0
  }

  answer (if k == 1 then 1 else if k == 2 then 2 else 4)
  hint "Which number is found on the very first lift?"
  hint "Try each of the seven numbers and write down how many lifts it takes."
}
