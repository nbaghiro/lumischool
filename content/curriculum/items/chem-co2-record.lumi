# Carbon dioxide in the air at Mauna Loa, Hawaii, in parts per million, annual means rounded to whole
# numbers: 1960 316.91, 1970 325.68, 1980 338.76, 1990 354.45, 2000 369.71, 2010 390.10, 2020 414.21
# (NOAA Global Monitoring Laboratory, co2_annmean_mlo.txt). w asks a reading, a rise, or how much
# faster it rose from 2010 to 2020 (24) than from 1960 to 1970 (9).
item chem.co2-record v=1 skills=[chemistry.gases, data.line-graph] {
  title "The carbon dioxide record"
  difficulty w
  let w=0..2 r=0..2
  level easy {
    let w={0}
  }
  level hard {
    let w={1, 2}
  }
  where (w != 2 or r == 0)
  let yr={pick(r, 1960, 1980, 2000)}
  let val={pick(r, 317, 339, 370)}

  scene 31x30 {
    linegraph g labels=["1960", "1970", "1980", "1990", "2000", "2010", "2020"] values=[317, 326, 339, 354, 370, 390, 414] min=300 max=420 per=10 step=20 color=berry at=canvas(1, 0)
    text ask "The graph shows the carbon dioxide in the air, in parts for every million parts of air, measured on a mountain in Hawaii. Burning coal, oil and gas adds carbon dioxide to the air. {if w == 0 then \"How many parts in a million were there in \" else if w == 1 then \"By how many parts in a million did it rise from \" else \"How many more parts in a million did it rise in the ten years from 2010 than in the ten years from 1960?\"}{if w == 0 then yr else if w == 1 then yr else \"\"}{if w == 0 then \"?\" else if w == 1 then \" to 2020?\" else \"\"}" narrate width=30 below=g gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then val else if w == 1 then 414 - val else 15)
  feedback {
    when (w == 1 and answer == 414) point=g {
      say "That is the 2020 reading. The question asks how much it rose, so take away the {yr} reading."
    }
  }
  hint "Find the years the question names along the bottom, and go up to the line."
  hint "{if w == 0 then \"Read across to the numbers at the side.\" else if w == 1 then \"Read the 2020 point too. How far apart are the two?\" else \"How much did it rise in each of the two ten years? How far apart are those rises?\"}"
}
