# A reflection in an axis: in the y axis the across number changes sign, in the x axis the up number.
item quadrant.reflect-corner v=1 skills=[position.transformations, position.four-quadrants] negatives {
  title "Reflected over the axis"
  difficulty ((if m == "x" then 1 else 0) + c / 2 + (if x < 0 then 1 else 0))
  let x={-3, 1, 2} y={-4, -2, 0} m={"y", "x"} c=0..2
  level easy {
    let x={1, 2} c={0}
  }
  level hard {
    let x={-3} c={1, 2}
  }

  scene 35x21 {
    moveshape m max=4 shape=1 x=x y=y move="reflect" mirror=m image=0 names=1 at=canvas(1, 1)
    text ask "The triangle is reflected in the {m} axis. Where does corner {pick(c, \"A\", \"B\", \"C\")} land?" narrate width=12 right-of=m gap=2
    row eq below=ask gap=1 space=0 align=centre {
      text o "("
      number-input ix width=3
      text comma ","
      number-input iy width=3
      text cl ")"
    }
  }

  answer ix=(if m == "y" then 0 - (x + pick(c, 0, 2, 0)) else x + pick(c, 0, 2, 0)) iy=(if m == "x" then 0 - (y + pick(c, 0, 0, 3)) else y + pick(c, 0, 0, 3))
  feedback {
    when (ix == (if m == "y" then x + pick(c, 0, 2, 0) else 0 - (x + pick(c, 0, 2, 0))) and iy == (if m == "y" then 0 - (y + pick(c, 0, 0, 3)) else y + pick(c, 0, 0, 3)) and x + pick(c, 0, 2, 0) != 0 and y + pick(c, 0, 0, 3) != 0) point=m {
      say "That is a reflection in the other axis. The {m} axis is the mirror line."
    }
  }
  hint "Where is corner {pick(c, \"A\", \"B\", \"C\")} now? Which axis is the mirror?"
  hint "The image is the same distance from the mirror line on the other side. Which number changes sign?"
}
