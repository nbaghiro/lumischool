# Dry air is about 21 per cent oxygen by volume (NOAA; the Met Office gives 20.95). The unknown is the
# oxygen in a jar of air, or the jar that holds some oxygen.
item chem.oxygen-in-jar v=1 skills=[chemistry.burning, percentages.of-amount] {
  title "Oxygen in the jar"
  difficulty (w * 2 + (if v == 1000 or v == 500 then 0 else 1))
  let w=0..1 v={500, 1000, 300, 2000}
  let ox={21 * v / 100}
  level easy {
    let w=0..0 v={500, 1000}
  }
  level hard {
    let w=1..1
  }

  scene 36x15 {
    candle c start=10 burnt=2 lit=0 jar=1 at=canvas(1, 0)
    text ask "Air is 21 per cent oxygen. {if w == 0 then \"The jar over the candle holds \" else \"A jar of air holds \"}{if w == 0 then v else ox}{if w == 0 then \" ml of air. How many millilitres of it are oxygen?\" else \" ml of oxygen. How many millilitres of air does the jar hold?\"}" narrate width=25 right-of=c gap=1
    number-input answer below=ask gap=1
  }

  answer (if w == 0 then ox else v)
  feedback {
    when (w == 0 and answer == 21) point=c {
      say "21 is the per cent. How many millilitres is 21 per cent of the jar's air?"
    }
    when (w == 1 and answer == ox) point=c {
      say "That is the oxygen. It is only 21 out of every 100 parts of the air."
    }
  }
  hint "{if w == 0 then \"What is 1 per cent of the jar's air?\" else \"Each 100 ml of air holds 21 ml of oxygen.\"}"
  hint "{if w == 0 then \"Then take 21 of those.\" else \"How many lots of 21 ml of oxygen are there?\"}"
}
