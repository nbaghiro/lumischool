# Half the sentences are true and half are not, and a false one is wrong in one word only, so the
# child reads to the end before answering.
item reading.true-or-not v=1 skills=[reading.sentence-meaning] {
  title "Is it true?"
  difficulty (if b == 1 then 2 else if b == 0 then 0 else 1)
  let a={"cat", "duck", "pig"} o={"cat", "duck", "pig"} b=0..3
  where (a != o)
  level easy {
    let b={0, 2}  # true as it stands, or the wrong animal
  }
  level hard {
    let b={1, 3}  # the wrong little word, or true in other words
  }

  scene 30x10 {
    picturecards card who=[a] where=["on"] thing=["rug"] letters=false at=canvas(1, 1)
    column q right-of=card gap=2 space=1 align=start {
      sentence strip before="{if b == 3 then \"A\" else \"The\"} {if b == 2 then o else a} {if b == 3 then \"sits\" else \"is\"} {if b == 1 then \"by\" else \"on\"} {if b == 3 then \"a\" else \"the\"} rug" blank=0 after="."
      row r space=2 align=centre {
        text ask "Is it true?" narrate
        choice pick options=["yes", "no"]
      }
    }
  }

  answer pick=(if b == 0 or b == 3 then "yes" else "no")
  hint "Read every word. Who is it, and where is it?"
  hint "Check the picture for each part of the sentence."
}
