# The two-star reason: why the body needs more food on a busy day, and why a growing child needs
# protein even when it has enough energy. Each answer names the job the food does.
item nature.why-more-food v=1 stars=2 skills=[nature.diet, reasoning.explain] {
  title "Why does the body need it?"
  difficulty (if k == 0 then 0 else 1)
  let k=0..1
  let told={pick(k, "On the day they cross the gorge Ben eats nearly twice as much as on a day of reading at home. Why does his body need more?", "Ada eats plenty of bread and gets enough energy, but the doctor says she should also eat eggs or beans every day while she is growing. Why?")}
  let right={pick(k, "His muscles burn more fuel to walk and climb", "Growing needs protein to build new muscle and bone")}
  let o1={pick(k, "Walking makes the stomach bigger", "Bread has no energy in it")}
  let o2={pick(k, "Fresh air makes food taste better", "Eggs have more energy than bread")}
  let x1={pick(k, o1, right)}
  let x2={pick(k, right, o2)}
  let x3={pick(k, o2, o1)}
  level easy {
    let k={0}
  }
  level hard {
    let k={1}
  }

  scene 36x28 {
    row all at=canvas(1, 1) space=2 align=end {
      ropebridge rb planks=8 gaps=0
      person pw pose=walk age=child
      plate pl item=circle count=6 label="lunch"
    }
    text ask "{told}" narrate width=34 below=all gap=1
    choice pick options=[x1, x2, x3] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=all {
      say "What job does that food do in the body: fuel, or building?"
    }
  }
  hint "Is the body using more fuel, or building something new?"
  hint "Which part of food is fuel, and which builds?"
}
