# A crowbar under a millstone: both moments worked out in newton centimetres, then whether the push's
# moment is the bigger, which the lever's own rule checks.
item physics.moment-lifts v=1 skills=[physics.moments, physics.machines, reasoning.compare] {
  title "Will the crowbar lift it?"
  difficulty (100 - abs(w * f - p * (10 - f)))
  let f=1..3 w={60, 80, 100} p={10, 20, 30}
  where (w * f != p * (10 - f))
  level easy {
    where (abs(w * f - p * (10 - f)) >= 60)
  }
  level hard {
    where (abs(w * f - p * (10 - f)) <= 30)
  }

  scene 28x32 {
    lever bar fulcrum=f load=w push=p unit=N marks=1 at=canvas(1, 0)
    text ask "A crowbar under the edge of a millstone. The steps are 10 cm apart. What is the stone's moment about the pivot, in N cm?" narrate width=23 below=bar gap=1
    number-input stone below=ask gap=1
    text then "What is the push's moment?" narrate width=23 below=stone gap=1
    number-input push below=then gap=1
    text more "Does the push lift the stone?" narrate width=16 below=push gap=1
    choice pick options=["Yes", "No"] right-of=more gap=1
  }

  answer stone=(w * f * 10) push=(p * (10 - f) * 10)
  check physics.machine of=bar pick=lifts
  feedback {
    when (pick == "No" and w * f < p * (10 - f)) point=bar {
      say "The push is smaller, but it is far from the pivot. Compare the two moments."
    }
    when (pick == "Yes" and w * f > p * (10 - f)) point=bar {
      say "The stone's moment is the bigger, so it holds the bar down."
    }
  }
  hint "How far from the pivot is the stone, and how far is the push?"
  hint "Force times distance for each. Which is bigger?"
}
