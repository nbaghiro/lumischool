# The unknown moves into the list: the flag says how far the hops must add up to, and one item is
# missing, so it is found by taking the others away.
item coding.each-missing v=1 skills=[coding.lists, reasoning.work-backwards] {
  title "The missing hop"
  difficulty (n * 2 + d / 5)
  let n=0..1 a=1..3 b=2..3 c=1..2 m=1..4
  let d={a + m + c + b * n}
  where (d <= 11)
  level easy {
    let n={0}
  }
  level hard {
    let n={1}
  }

  scene 36x17 {
    maze m cols=12 rows=1 col=1 row=1 flag=[d + 1, 1] at=canvas(1, 0)
    program p code=["set hops to list {a}, {if n == 1 then b else \"?\"}, {if n == 1 then \"?\" else c}{if n == 1 then \", \" else \"\"}{if n == 1 then c else \"\"}", "for each h in hops", "  right h"] below=m gap=1
    text ask "One hop is smudged. The robot must stop on the flag. What is the missing hop?" width=12 right-of=p gap=1
    number-input answer below=ask gap=1
  }

  answer m
  feedback {
    when (answer == d + 1 - a - c - b * n) point=m {
      say "The robot starts on column 1, so the flag is {d} squares away, not {d + 1}."
    }
    when (answer == d) point=m {
      say "{d} is the whole way. The other hops take the robot part of it already."
    }
  }
  hint "How many squares is it from the robot to the flag?"
  hint "How far do the hops you can read take the robot? How much is left?"
}
