# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.directions-match v=1 skills=[language.town, language.directions] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[town.on-the-left]]", "[[town.the-first]]", "[[town.turn]]"), pick(k, "[[town.on-the-right]]", "[[town.the-second]]", "[[town.go-on]]"), pick(k, "[[town.straight-on]]", "[[town.the-street]]", "[[town.where-is-it]]"), pick(k, "[[town.near]]", "[[town.far]]", "[[town.excuse-me]]")] right=[pick(k, "straight on", "far", "where is it?"), pick(k, "on the left", "the first", "turn"), pick(k, "on the right", "the second", "excuse me"), pick(k, "near", "the street", "go on")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
