# A sensor that follows its readings: the light meter's numbers minute by minute are in a table, and
# the lamp comes on and off as fog drifts over the ice shelf under the midnight sun.
item coding.sense-lamp v=1 skills=[coding.sensors, coding.decisions, coding.tracing] {
  title "Fog over the ice shelf"
  difficulty k
  let k=0..2
  let d={pick(k, 4, 5, 4)}
  let r0={pick(k, 6, 7, 5)} r1={pick(k, 5, 4, 3)} r2={pick(k, 3, 6, 5)} r3={pick(k, 4, 3, 3)} r4={pick(k, 2, 3, 4)} r5={pick(k, 5, 6, 2)} r6={pick(k, 6, 8, 6)}
  level easy {
    let k={0}
  }
  level hard {
    let k={2}
  }

  scene 36x33 {
    program p code=["repeat 6", "  if daylight is less than {d}", "    switch lamp on", "  otherwise", "    switch lamp off", "  wait 1"] text=true sense=["daylight reads {r0} {r1} {r2} {r3} {r4} {r5} {r6}"] at=canvas(0, 0)
    table tb cols=2 head=["Minute", "Light meter"] cells=["0", "{r0}", "1", "{r1}", "2", "{r2}", "3", "{r3}", "4", "{r4}", "5", "{r5}", "6", "{r6}"] below=p gap=1
    text ask "Fog drifts over the ice shelf. The table shows what the light meter reads each minute. The program asks at minutes 0 to 5. How many times does the lamp come on?" width=18 right-of=tb gap=1
    number-input answer below=ask gap=1
  }

  check coding.runs of=p answer="switched(lamp, on)"
  feedback {
    when (answer == 6) point=tb {
      say "The lamp comes on only when the reading is less than {d}. Check each minute against line 2."
    }
    when (k == 1 and answer == 3) point=tb {
      say "Count the times the lamp goes from off to on, not the minutes it is on."
    }
  }
  hint "Go down the table from minute 0 to minute 5. Is each reading less than {d}?"
  hint "Mark each minute on or off. How many times does off change to on?"
}
