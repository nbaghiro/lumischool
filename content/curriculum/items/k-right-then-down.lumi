item k.right-then-down v=1 stars=3 skills=[coding.sequences, coding.tracing] {
  title "Two blocks"
  difficulty (a + b)
  let a=1..3 b=1..2
  level easy {
    let a=1..2 b={1}
  }
  level hard {
    let a=2..3 b={2}
  }

  scene 26x17 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks bl code=["right {a}", "down {b}"] words=false numbers=true
      maze g cols=5 rows=3 code=["right {a}", "down {b}"] upto=0 trail=none
    }
    text ask "Do block 1, then block 2. Which square does the robot stop on?" narrate width=24 below=top gap=1
    row ans below=ask gap=1 space=1 align=centre {
      text lc "column"
      number-input col width=3
      text lr "row"
      number-input row width=3
    }
  }

  check coding.runs of=g col=col row=row
  hint "Do the first block with a finger. Stop. Now do the second block from there."
}
