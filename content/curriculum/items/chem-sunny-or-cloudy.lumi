# Two days, drawn by a thermometer and a windsock each, and on which the puddle dries faster:
# the warmer, the windier, or both. At hard both windsocks stream the same and only the
# thermometers differ, so both drawings have to be read to see which one decides.
item chem.sunny-or-cloudy v=1 skills=[chemistry.states, reasoning.compare] {
  title "Which day dries it faster?"
  difficulty (if k == 3 then 2 else if k == 2 then 1 else 0)
  let k=0..3 s=0..1
  let ta={pick(k, 25, 20, 30, 30)}
  let tb={pick(k, 10, 20, 15, 15)}
  let wa={pick(k, 1, 1, 1, 1)}
  let wb={pick(k, 1, 0, 0, 1)}
  let asks={pick(k, "One day is warmer.", "The two days are as warm as each other, and one is windy.", "One day is warmer and windier.", "The two days are as windy as each other, and one is warmer.")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 34x27 {
    row days at=canvas(1, 0) space=1 align=end {
      thermometer ta from=0 to=40 step=10 value=(if s == 0 then ta else tb)
      windsock wa wind=(if s == 0 then wa else wb)
      thermometer tb from=0 to=40 step=10 value=(if s == 0 then tb else ta)
      windsock wb wind=(if s == 0 then wb else wa)
    }
    text ask "Two days at the oasis, day A on the left and day B on the right, each with its thermometer and windsock. {asks} Nour spills a bucket on the path each morning. On which day does the puddle dry faster?" narrate width=32 below=days gap=1
    choice pick options=["Day A", "Day B"] below=ask gap=1
  }

  answer pick=(if s == 0 then "Day A" else "Day B")
  feedback {
    when (k == 3 and pick != (if s == 0 then "Day A" else "Day B")) point=days {
      say "Both windsocks stream out the same, so the wind is no help in choosing. Read the thermometers: one day is fifteen degrees warmer."
    }
    when (k <= 2 and pick != (if s == 0 then "Day A" else "Day B")) point=days {
      say "Water goes into the air faster when the air is warm and moving. Which day has more of that?"
    }
  }
  hint "Read each thermometer, then look at each windsock. Which day is warmer? Which is windier?"
  hint "Warm air and moving air both carry water away faster. The day with more of them dries the puddle first."
}
