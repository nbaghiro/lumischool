# Two rules at once: a number can fit one ring, both, or neither, and the middle is the case
# children leave out.
item logic.venn-where v=1 skills=[logic.sorting, logic.quantifiers] {
  title "Which part of the rings?"
  difficulty (if a and b then 2 else if a or b then 0 else 1)
  let r=0..2 n={5, 9, 12, 15, 18, 21, 25, 30}
  level easy {
    where ((if a then 1 else 0) + (if b then 1 else 0) == 1)  # one ring only
  }
  level hard {
    where ((if a then 1 else 0) + (if b then 1 else 0) != 1)  # the middle, or outside both
  }
  let l0={if r == 0 then "Even" else if r == 1 then "Odd" else "Ends in 5"}
  let l1={if r == 0 then "More than 20" else if r == 1 then "In the 3 times table" else "Less than 20"}
  let a={if r == 0 then n % 2 == 0 else if r == 1 then n % 2 == 1 else n % 10 == 5}
  let b={if r == 0 then n > 20 else if r == 1 then n % 3 == 0 else n < 20}

  scene 34x19 {
    text ask "Where does {n} go?" narrate at=canvas(1, 1)
    row both below=ask gap=1 space=1 align=start {
      venn rings labels=[l0, l1] left=[] both=[] right=[] outside=[]
      choice pick options=["left ring only", "the middle", "right ring only", "outside both"] stack=column
    }
  }

  answer pick=(if a and b then "the middle" else if a then "left ring only" else if b then "right ring only" else "outside both")
  hint "Does {n} fit the left rule? Does it fit the right rule?"
  hint "If it fits both, it goes where the rings overlap. If it fits neither, it goes outside."
}
