# The robot's speech sentence has one mistake: a missing comma, a missing capital, or the question
# mark outside the closing speech mark.
item writing.speech-mistake v=1 skills=[writing.speech-punctuation, writing.editing] {
  title "What is wrong with the robot's speech?"
  difficulty (if k == 2 then 1 else 0)
  let k=0..2
  let says={pick(k, "“Look up” said Leo.", "Ada said, “the moon is full.”", "“Is it cloudy”? asked Ada.")}
  let right={pick(k, "a missing comma", "a missing capital", "a mark outside")}
  level easy {
    let k=0..1
  }
  level hard {
    let k=1..2
  }

  scene 29x24 {
    fixbot bot says="{says}" width=20 fixed=0 at=canvas(1, 0)
    text ask "The robot's sentence has one mistake. What is it?" narrate width=28 below=bot gap=1
    choice pick options=["a missing comma", "a missing capital", "a mark outside"] stack=column below=ask gap=1
  }

  answer pick=right
  feedback {
    when (pick != right) point=bot {
      say "Check the three things in turn: a mark inside the closing speech mark, a capital at the start of the spoken words, and the question mark kept inside."
    }
  }
  hint "Look at the first spoken word, then at the closing speech mark."
  hint "Does every part have its mark, and is each mark on the right side of the speech mark?"
}
