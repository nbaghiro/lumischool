# Mixed numbers with different denominators: whole ones added, the fractions changed and added, and
# a whole made from the fractions carried across.
item fraction.mixed-unlike v=1 skills=[fractions.add-unlike, fractions.mixed-numbers] {
  title "Rope for the well"
  difficulty (lcm(b, d) / 4 + (if a / b + c / d > 1 then 2 else 0))
  let p=1..2 q=1..3 b={2, 3, 4} d={3, 4, 6} a=1..3 c=1..5
  where (b < d and a < b and c < d and d % b != 0)
  where (a / b + c / d != 1)
  level easy {
    where (a / b + c / d < 1)
  }
  level hard {
    where (a / b + c / d > 1)
  }

  scene 33x14 {
    well well courses=3 bucket=1 at=canvas(1, 1)
    text ask "The rope for the city well is made of two pieces, {p} {a}/{b} m and {q} {c}/{d} m long. How long is the rope? Write whole metres and a fraction in its simplest form." narrate width=22 right-of=well gap=2
    row eq below=well gap=1 space=1 align=centre {
      number-input whole width=2
      number-input top width=3
      text slash "/"
      number-input bottom width=3
      text m "m"
    }
  }

  answer whole=floor(p + q + a / b + c / d) top=num(a / b + c / d - floor(a / b + c / d)) bottom=den(a / b + c / d - floor(a / b + c / d))
  feedback {
    when (whole == p + q and a / b + c / d > 1) point=eq {
      say "The fractions make more than one whole. Carry the whole one across to the metres."
    }
  }
  hint "Add the whole metres first."
  hint "Now add the fractions in the same size parts. Is the answer more than one whole?"
}
