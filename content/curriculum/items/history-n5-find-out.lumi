# Marked by a grown-up: finding out about the country's story near home (n as in n5-order).
item history.n5-find-out v=1 stars=3 skills=[history.nation, history.enquiry] {
  title "Find out near home"
  let n=0..4
  let task={pick(n, "Find your town or village in the Domesday Book (the National Archives and other sites have it). What was written about it in 1086?", "Find the year your state or your town was founded, and who lived there before.", "Find how your family would travel from your home to Tokyo or Osaka, and how long it takes now.", "Find a picture of a birch-bark letter or of Onfim's drawings, and write a short message on paper the way he did.", "Find an old bridge, canal or waterway near you, and when it was built.")}

  scene 36x13 {
    text ask "{task}" width=34 at=canvas(1, 1)
    writinglines w lines=2 width=34 below=ask gap=1
  }

  check writing.by-eye look-for="A small, true piece of finding out done with a grown-up: what was found, a date for it, where the information came from, and how the child knows it is right." notice=["Found one real fact", "Gave a date", "Said where it came from", "Said how sure they are"] ask="Where did you find that out, and could you check it somewhere else?"
}
