# A suffix changes the job a word does as well as what it means: careful describes, kindness
# names a thing, a teacher is a person. The wrong choices are the jobs other suffixes do.
item reading.suffix-meaning v=1 skills=[reading.morphology] {
  title "What the suffix does"
  difficulty (if k == 4 then 2 else if k == 2 then 1 else 0)
  let k=0..4
  level easy {
    let k={0, 1, 3}  # careful, fearless, teacher
  }
  level hard {
    let k={2, 3, 4}  # kindness, teacher, enjoyment
  }

  scene 22x24 {
    column all at=canvas(1, 1) space=1 align=start {
      wordbricks b bricks=[if k == 0 then "care" else if k == 1 then "fear" else if k == 2 then "kind" else if k == 3 then "teach" else "enjoy", if k == 0 then "ful" else if k == 1 then "less" else if k == 2 then "ness" else if k == 3 then "er" else "ment"] root=0 roots=1 blank=-1 word="{if k == 0 then \"careful\" else if k == 1 then \"fearless\" else if k == 2 then \"kindness\" else if k == 3 then \"teacher\" else \"enjoyment\"}" labels=true
      text ask "What does {if k == 0 then \"careful\" else if k == 1 then \"fearless\" else if k == 2 then \"kindness\" else if k == 3 then \"teacher\" else \"enjoyment\"} mean?" width=20
      choice pick options=[if k == 0 then "full of care" else if k == 1 then "full of fear" else if k == 2 then "not kind" else if k == 3 then "a person who teaches" else "not enjoying", if k == 0 then "without care" else if k == 1 then "without fear" else if k == 2 then "kind again" else if k == 3 then "teaching again" else "the feeling of enjoying", if k == 0 then "care again" else if k == 1 then "fear before" else if k == 2 then "being kind" else if k == 3 then "not teaching" else "enjoying again"] stack=column
    }
  }

  answer pick=(if k == 0 then "full of care" else if k == 1 then "without fear" else if k == 2 then "being kind" else if k == 3 then "a person who teaches" else "the feeling of enjoying")
  hint "Read the root word first. Then ask what the ending adds to it."
}
