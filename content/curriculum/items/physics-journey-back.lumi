item physics.journey-back v=1 skills=[physics.motion] {
  title "There and back"
  difficulty (a + b)
  let a=6..14 b=6..14
  level easy {
    let a=6..8 b=6..8
  }
  level hard {
    let a=12..14 b=12..14
  }

  scene 30x14 {
    roaddistances road stops=["Ash", "Bray", "Cole"] legs=[a, b] unit=km at=canvas(1, 1)
    text ask "How far is it from Ash to Cole and back again?" width=22 below=road gap=1
    number-input answer right-of=ask gap=2
  }

  answer (2 * (a + b))
  feedback {
    when (answer == a + b) point=road {
      say "Coming home is the same distance again, so double it."
    }
  }
  hint "How far is it there, and how far is it back?"
}
