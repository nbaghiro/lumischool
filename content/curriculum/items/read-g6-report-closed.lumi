# A rule in the report's words, applied to its line graph: the path behind the waterfall closes when
# the flow is high, and the kingfishers fish only when it is low. The child counts the months.
item reading.report-closed v=1 skills=[reading.text-features, data.line-graph] {
  title "The rule and the graph"
  difficulty pick(k, 1, 1, 1, 2)
  let k=0..3
  level easy {
    let k={0, 2}
  }
  level hard {
    let k={1, 3}
  }

  scene 35x20 {
    text ask "{pick(k, \"The path behind the waterfall is closed in any month when the flow is above 12. For how many months was it closed?\", \"The path behind the waterfall is closed in any month when the flow is above 9. For how many months was it closed?\", \"The rope bridge is roped off in any month when the flow is above 15. For how many months was it roped off?\", \"Kingfishers can only fish when the flow is below 10. In how many of these months could they fish?\")}" at=canvas(1, 1) width=34
    row bottom below=ask gap=1 space=1 align=end {
      linegraph flow labels=["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug"] values=[8, 10, 16, 20, 14, 8, 5, 4] max=20 per=2 step=2 color=sky
      number-input answer
    }
  }

  answer pick(k, 3, 4, 2, 4)
  feedback {
    when (k == 1 and answer == 3) point=flow {
      say "February's point is just above the line for this rule. Check every month against it."
    }
    when (k == 3 and answer == 5) point=flow {
      say "Below means less than, so a month with a flow of exactly that does not count."
    }
  }
  hint "Find the number from the rule on the side of the graph, and run your finger across."
  hint "Count the months whose points are on the right side of that line."
}
