# Reading a long program as parts: the first part ends on the line that brings the robot to the gem.
# The gem sits on a corner of the path, so exactly one line ends there.
item coding.parts-split v=1 skills=[coding.decomposition, coding.tracing] {
  title "Where does the first part end?"
  difficulty (k + m / 3)
  let m=1..3 k=2..4
  level easy {
    let k={2}
  }
  level hard {
    let k={4}
  }

  scene 36x23 {
    row top at=canvas(1, 0) space=2 align=start {
      maze g cols=7 rows=4 gems=[if k == 2 then 1 + m else 3 + m, if k == 4 then 4 else 2] flag=[4 + m, 4] code=["right {m}", "down 1", "right 2", "down 2", "right 1"] upto=0 trail=none
      program p code=["right {m}", "down 1", "right 2", "down 2", "right 1"]
    }
    text ask "This program does the whole job in one go. Split it into two parts: the first part ends when the robot reaches the gem. After which line does the first part end?" narrate width=34 below=top gap=1
    number-input answer width=3 below=ask gap=1
  }

  answer k
  feedback {
    when (answer == k - 1) point=g {
      say "After that line the robot has not reached the gem yet. Follow one more line."
    }
    when (answer == k + 1) point=g {
      say "The robot is on the gem one line earlier. Where is it after each line?"
    }
  }
  hint "Put a finger on the start square and move it one line at a time."
  hint "After each line, is the finger on the gem?"
}
