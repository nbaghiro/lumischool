# Where a bug shows itself: the burst marks the square where the robot met a rock, and the child
# matches it to the block that was running, which the checker reads off the run.
item coding.bump-card v=1 skills=[coding.debugging] {
  title "Which block bumped?"
  difficulty k
  let a=2..3 b=1..2 c=1..2 k=1..3
  level easy {
    let k=1..2
  }
  level hard {
    let k=2..3
  }

  scene 32x16 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks b code=["right {a}", "down {b}", "right {c}"] numbers=true words=false
      maze g cols=7 rows=4 rocks=[if k == 3 then 1 + a + c else 1 + a, if k == 1 then 1 else 1 + b] code=["right {a}", "down {b}", "right {c}"] trail=line
    }
    text ask "The robot bumped into a rock. Which block was it doing?" width=18 below=top gap=1
    choice pick options=[1, 2, 3] right-of=ask gap=1
  }

  check coding.runs of=g pick=bumpline
  hint "Find the burst. It shows where the robot hit the rock."
  hint "Follow the line from the start. Which block drew the last part?"
}
