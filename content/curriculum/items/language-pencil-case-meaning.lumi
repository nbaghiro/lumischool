# The language to English: [[phrase.do-you-have-a-ruler]], [[phrase.yes-i-have-two-pencils]], [[phrase.no-i-do-not-have-a-rubber]], [[phrase.my-school-bag-is-blue]], [[phrase.can-i-borrow-the-scissors]], [[phrase.here-you-are]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.pencil-case-meaning v=1 skills=[language.school, language.questions] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "girl", "boy", "girl", "boy", "girl", "gran")] says=[pick(k, "[[phrase.do-you-have-a-ruler]]", "[[phrase.yes-i-have-two-pencils]]", "[[phrase.no-i-do-not-have-a-rubber]]", "[[phrase.my-school-bag-is-blue]]", "[[phrase.can-i-borrow-the-scissors]]", "[[phrase.here-you-are]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "Here you are.", "My school bag is blue.", "Yes, I have two pencils.", "Here you are.", "Here you are.", "My school bag is blue."), pick(k, "Do you have a ruler?", "Yes, I have two pencils.", "Can I borrow the scissors?", "My school bag is blue.", "No, I do not have a rubber.", "Here you are."), pick(k, "No, I do not have a rubber.", "Can I borrow the scissors?", "My school bag is blue.", "Yes, I have two pencils.", "Can I borrow the scissors?", "No, I do not have a rubber."), pick(k, "Can I borrow the scissors?", "No, I do not have a rubber.", "No, I do not have a rubber.", "No, I do not have a rubber.", "My school bag is blue.", "Can I borrow the scissors?")] stack=column
    }
  }

  answer pick=pick(k, "Do you have a ruler?", "Yes, I have two pencils.", "No, I do not have a rubber.", "My school bag is blue.", "Can I borrow the scissors?", "Here you are.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
