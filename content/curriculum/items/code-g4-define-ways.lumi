# Choosing which slots hold the new block is choosing k things from s, so the count is the number
# of ways to choose: a find-all-the-ways with no method given. The factorials are written out.
item coding.define-ways v=1 stars=3 skills=[coding.procedures, reasoning.all-the-ways] {
  title "How many programs?"
  difficulty ((if s == 3 then 6 else 24) / ((if k == 1 then 1 else if k == 2 then 2 else 6) * (if s - k == 1 then 1 else if s - k == 2 then 2 else 6)))
  let s=3..4 k=1..3
  where (k < s)

  scene 34x11 {
    blocks b code=["define hooray", "  jump", "  clap 2"] at=canvas(1, 0)
    text ask "Under the define there are {s} more lines, and each one is hooray or spin. How many different programs make a dance with exactly {2 * k} claps?" width=20 right-of=b gap=2
    number-input answer below=ask gap=1
  }

  answer ((if s == 3 then 6 else 24) / ((if k == 1 then 1 else if k == 2 then 2 else 6) * (if s - k == 1 then 1 else if s - k == 2 then 2 else 6)))
  feedback {
    when (answer == 1) point=b {
      say "The hoorays can go on different lines. Try listing them: which lines could be hooray?"
    }
  }
  hint "How many of the {s} lines must be hooray to make {2 * k} claps?"
  hint "Write the programs as rows of H and S. Keep going until you cannot make a new one."
}
