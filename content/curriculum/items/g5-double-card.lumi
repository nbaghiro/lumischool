# The two-star: every edge doubled or trebled. Each face grows by the scale twice over, so the card
# is four or nine times as much, not twice.
item solids.double-card v=1 stars=2 skills=[solids.surface-area, reasoning.multiplicative] {
  title "Twice as big"
  difficulty (k * 2 + s / 100)
  let s={52, 62, 94} k=2..3
  level easy {
    let k={2} s={52}
  }
  level hard {
    let k={3}
  }

  scene 36x14 {
    cubestack small l=4 w=3 h=2 outline=1 at=canvas(1, 1)
    text ask "A crate needs {s} cm² of card. A new crate is made with its length, width and height each {if k == 2 then \"twice\" else \"three times\"} as long. How much card does the new crate need?" narrate width=18 right-of=small gap=2
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=5
      text unit "cm²"
    }
  }

  answer (s * k * k)
  feedback {
    when (answer == s * k) point=small {
      say "Each face is {k} times as long and {k} times as wide. What does that do to its area?"
    }
    when (answer == s * k * k * k) point=small {
      say "That is what happens to the volume. The card covers faces, which grow in two directions only."
    }
  }
  hint "Take one face. If both its sides are {k} times as long, how many of the old face fit on it?"
  hint "Every face grows the same way."
}
