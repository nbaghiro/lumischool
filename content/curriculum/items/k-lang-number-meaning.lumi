item k.lang-number-meaning v=1 skills=[language.numbers] {
  title "Which number is it?"
  difficulty (if n <= 3 then 0 else 1)
  let n=1..5
  let word={pick(n, "none", "[[num.one]]", "[[num.two]]", "[[num.three]]", "[[num.four]]", "[[num.five]]")}
  level easy {
    let n=1..3
  }
  level hard {
    let n=3..5
  }

  scene 26x11 {
    text q "Listen: {word}. How many is that? Hold up that many fingers, then write the number." narrate width=24 at=canvas(1, 1)
    number-input answer below=q gap=1
  }

  answer n
  hint "Count in [[language.name]] on your fingers: [[num.one]], [[num.two]], [[num.three]]."
}
