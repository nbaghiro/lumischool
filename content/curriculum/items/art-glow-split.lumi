# Split complements on a wheel of twelve: the two colours either side of a colour's opposite, which
# glow against it more gently than the opposite itself.
item art.glow-split v=1 skills=[art.complementary, reasoning.generalise] {
  title "Either side of the opposite"
  difficulty (if k == 1 or k == 3 or k == 5 then 1 else 0)
  let k=0..5
  let r={(k + 1) % 3}
  let i={2 * k}
  let c={pick(k, "red", "orange", "yellow", "green", "blue", "purple")}
  let right={pick(k, "yellow-green and blue-green", "blue-green and blue-purple", "blue-purple and red-purple", "red-purple and red-orange", "red-orange and yellow-orange", "yellow-orange and yellow-green")}
  let w1={pick(k, "red-purple and red-orange", "red-orange and yellow-orange", "yellow-orange and yellow-green", "yellow-green and blue-green", "blue-green and blue-purple", "blue-purple and red-purple")}
  let w2={pick(k, "yellow and blue", "green and purple", "blue and red", "purple and orange", "red and yellow", "orange and green")}
  level easy {
    let k={0, 4}
  }
  level hard {
    let k={1, 3, 5}
  }

  scene 36x27 {
    colourwheel wheel segments=12 blank=[] ring=i labels=true split="none" at=canvas(1, 1)
    text ask "Ada wants her ringed {c} lamp to glow, but its opposite looks too harsh beside it. She uses the two colours either side of the opposite instead. Which two?" width=18 right-of=wheel gap=1
    choice pick options=[if r == 0 then right else if r == 1 then w1 else w2, if r == 0 then w1 else if r == 1 then w2 else right, if r == 0 then w2 else if r == 1 then right else w1] stack=column below=wheel gap=1
  }

  answer pick=right
  feedback {
    when (pick == w1) point=wheel {
      say "Those two sit either side of the {c} itself, so they are like it and will not make it glow. Go straight across first."
    }
    when (pick == w2) point=wheel {
      say "Those are a third of the way round each side. Find the opposite first, straight across, then take its two neighbours."
    }
  }
  hint "Start at the ringed {c}. Which colour is straight across the middle from it?"
  hint "Now look either side of that opposite colour. Which two colours touch it?"
}
