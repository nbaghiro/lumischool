# The three lines of a notice matched to their jobs: the ask, the reason, the when and where.
item writing.notice-parts v=1 skills=[writing.persuasion, writing.text-features] {
  title "The parts of a notice"
  difficulty k
  let k=0..1 r=0..2
  let l1={pick(k, "Please bring a tin for the food bank", "Please plant a sunflower seed")}
  let l2={pick(k, "Every tin feeds a family this winter", "The bees have fewer flowers each year")}
  let l3={pick(k, "The box is by the office door", "Seeds from the hall, all this week")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 36x13 {
    text ask "Write the number of the job each line of the notice does." narrate width=32 at=canvas(1, 1)
    match m left=["{l1}", "{l2}", "{l3}"] right=["{if r == 0 then \"the reason\" else if r == 1 then \"when and where\" else \"the ask\"}", "{if r == 0 then \"when and where\" else if r == 1 then \"the ask\" else \"the reason\"}", "{if r == 0 then \"the ask\" else if r == 1 then \"the reason\" else \"when and where\"}"] blanks=[x, y, z] below=ask gap=1
  }

  answer x=(if r == 0 then 3 else if r == 1 then 2 else 1) y=(if r == 0 then 1 else if r == 1 then 3 else 2) z=(if r == 0 then 2 else if r == 1 then 1 else 3)
  hint "The ask starts with please and a doing word. The reason says why. When and where has a place or a time in it."
  hint "Bring, plant: the asks. Feeds, have fewer: the reasons. A door, a week: when and where."
}
