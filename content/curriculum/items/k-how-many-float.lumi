item k.how-many-float v=1 skills=[physics.floating, counting.to-five] {
  title "How many float?"
  difficulty (f + s)
  let f=1..4 s=1..3
  level easy {
    let f=1..2 s={1}
  }
  level hard {
    let f=3..4 s=2..3
  }

  scene 32x20 {
    tank t float=f sunk=s letters=false at=canvas(1, 1)
    text ask "How many things are floating at the top?" narrate width=22 below=t gap=1
    number-input answer below=ask gap=1
  }

  answer f
  feedback {
    when (answer == f + s) point=t {
      say "That counts the things on the bottom too. Count only the ones at the top."
    }
  }
  hint "Look along the top of the water. Touch each thing there."
}
