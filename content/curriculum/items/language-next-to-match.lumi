# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.next-to-match v=1 skills=[language.town, language.directions] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[town.next-to]]", "[[town.near-2]]", "[[town.the-chemist-s]]"), pick(k, "[[town.opposite-2]]", "[[town.far-from]]", "[[town.the-bank]]"), pick(k, "[[town.between]]", "[[town.at-the-end-of]]", "[[town.the-church]]"), pick(k, "[[town.behind-2]]", "[[town.in-front-of]]", "[[town.the-street]]")] right=[pick(k, "between", "in front of", "the church"), pick(k, "next to", "near", "the chemist's"), pick(k, "opposite", "far from", "the street"), pick(k, "behind", "at the end of", "the bank")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
