# Which liquid is nearest to neutral, 7, whichever side it is on: milk 6.5, sea water 8.1, rain 5.6,
# baking soda 8.3. The distance from 7 matters, not the side.
item chem.ph-nearest v=1 skills=[chemistry.acids, number.distance] {
  title "Nearest to neutral"
  difficulty (if s == 1 or s == 3 or s == 5 then 1 else 0)
  let s=0..5
  level easy {
    let s={0, 2, 4}
  }
  level hard {
    let s={1, 3, 5}
  }

  scene 35x20 {
    phscale p liquids=[pick(s, "lemon", "rain", "seawater", "orange", "milk", "rain"), pick(s, "milk", "bakingsoda", "rain", "magnesia", "seawater", "orange"), pick(s, "washingsoda", "vinegar", "limewater", "seawater", "lemon", "bakingsoda"), pick(s, "magnesia", "limewater", "orange", "rain", "limewater", "washingsoda")] letters=1 names=1 at=canvas(1, 0)
    text ask "The miller wants the liquid closest to neutral to rinse a new millstone. Which one is nearest to 7?" narrate width=34 below=p gap=1
    choice pick options=["A", "B", "C", "D"] below=ask gap=1
  }

  check chem.indicator of=p pick=nearest
  hint "How far is each pointer from 7, on either side?"
  hint "Pointers just above 7 can be nearer than ones below it. Which gap is smallest?"
}
