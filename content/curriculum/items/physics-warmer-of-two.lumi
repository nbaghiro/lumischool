item physics.warmer-of-two v=1 skills=[physics.heat] {
  title "Which is warmer?"
  difficulty (3 - abs(a - b) / 10)
  let a={0, 10, 20, 30} b={0, 10, 20, 30}
  where (a != b)
  level easy {
    where (abs(a - b) >= 20)
  }
  level hard {
    where (abs(a - b) == 10)
  }

  scene 32x21 {
    text ask "Which room is warmer?" width=20 at=canvas(1, 1)
    thermometer one from=0 to=40 step=10 value=a unit="C" below=ask gap=1
    text la "A" below=one gap=1
    thermometer two from=0 to=40 step=10 value=b unit="C" right-of=one gap=3
    text lb "B" below=two gap=1
    choice pick options=["A", "B"] right-of=two gap=2
  }

  answer pick=(if a > b then "A" else "B")
  feedback {
    when (pick == "B" and a > b) point=one {
      say "The taller column is the warmer room."
    }
  }
  hint "Which column is taller?"
}
