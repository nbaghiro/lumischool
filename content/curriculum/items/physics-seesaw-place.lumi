# The see-saw rule by hand: both weights go on the plank so that weight times step comes to the same
# on each side. The parameters are one arrangement that works, which makes every variant answerable,
# and the verifier counts the others. One weight to a step keeps the stacks on the page.
item physics.seesaw-place v=1 skills=[physics.moments] stars=2 {
  title "Balance it with both weights"
  difficulty (a * x + b * y)
  let a={2, 3, 4} b={3, 5, 6} x=1..3 y=1..3 p={2, 3}
  where (a != b and x != y)
  where ((a * x + b * y) % p == 0 and (a * x + b * y) / p <= 12)
  level easy {
    let a={2, 3} b={4, 6} x=1..2 y=1..2 p={2}
  }
  level hard {
    let a={3, 4} b={5, 6} p={3}
  }

  scene 28x32 {
    text ask "Stand both weights on the plank so that it balances. Weight times step has to come to the same on each side." width=26 at=canvas(1, 0)
    balance-plank plank steps=3 load=((a * x + b * y) / p) load-at=-p bags=[a, b] most=1 below=ask gap=1
  }

  answer plank=(turning == 0 and grass == 0) {
    say "Both weights on the plank, with weight times step the same on each side."
  }
  feedback {
    when (grass > 0) point=plank.grass {
      say "Both weights go on the plank."
    }
    when (onright == 0) point=plank.left {
      say "Both weights are on the same side as the load, so that side turns the plank even more."
    }
    when (leftkg == rightkg and turning != 0) point=plank {
      say "The kilograms are the same on each side, but the steps count too. Multiply each weight by its step."
    }
    when (turning < 0) point=plank.left {
      say "The left side still turns the plank more. Move a weight further out on the right."
    }
    when (turning > 0) point=plank.right {
      say "The right side turns the plank more now. Move a weight in towards the pivot."
    }
  }
  hint "Work out weight times step for the load on the left."
  hint "Now find a step for each weight on the right that makes the same."
}
