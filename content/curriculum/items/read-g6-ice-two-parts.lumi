# Inference across the whole text: two clues from different parts (or far apart in one part) that
# only give the answer together. Each clue on its own fits more than one of the choices.
item reading.ice-two-parts v=1 skills=[reading.inference, reading.evidence] {
  title "Two clues together"
  difficulty pick(k, 1, 1, 0, 2)
  let k=0..3
  level easy {
    let k={0, 2}
  }
  level hard {
    let k={1, 3}
  }
  let right={pick(k, "The tube matters most", "They worked all night", "The shelf cracked", "She knows the ice")}
  let wrong1={pick(k, "The tube is too heavy", "They got lost", "A door slammed", "She is new here")}
  let wrong2={pick(k, "The tube is Noor's", "They met the plane", "A whale hit the ice", "She is cross")}

  scene 36x21 {
    text ask "Read the two clues. What do they tell you together?" at=canvas(1, 1) width=34
    row bottom below=ask gap=1 space=1 align=start {
      column clues space=1 align=start {
        passage a text="{pick(k, \"Part 2: One carried a steel tube wrapped in a blanket, as gently as a baby.\", \"Part 1: \\\"The team is out on the ice,\\\" said Aunt Lind. \\\"Back for breakfast.\\\"\", \"Part 3: That afternoon Noor heard a crack like a door slamming far away.\", \"Part 2: Aunt Lind put the kettle on and asked not one question about the cold.\")}" width=18 numbers=false
        passage b text="{pick(k, \"Part 3: \\\"Pack the tube on the sledge,\\\" she said quietly.\", \"Part 2: Next morning a sledge came hissing over the ice, pulled by four tired people.\", \"Part 3: ... watching a line of blue water open between the hut and the sea.\", \"Part 3: Aunt Lind ran to the window, then to the radio.\")}" width=18 numbers=false
      }
      choice pick options=[pick(k, wrong1, right, wrong2, wrong2), pick(k, right, wrong2, wrong1, right), pick(k, wrong2, wrong1, right, wrong1)] stack=column
    }
  }

  answer pick=right
  feedback {
    when (pick == wrong1) point=b {
      say "That fits one clue at most. Check it against the second clue as well."
    }
    when (pick == wrong2) point=a {
      say "Neither clue points to that. Find the answer both clues agree on."
    }
  }
  hint "What does the first clue make you think? Now read the second one."
  hint "Which answer would explain both clues at once?"
}
