# The words of the lock matched to what they mean, because an explanation uses the right name for
# each part and says what it is the first time.
item writing.lock-words v=1 skills=[writing.explanations, writing.vocabulary] {
  title "The words for the parts"
  difficulty k
  let k=0..1 r=0..2
  let l1={pick(k, "chamber", "flight")}
  let l2={pick(k, "paddle", "pound")}
  let l3={pick(k, "gate", "beam")}
  let c1={pick(k, "the box of water in the middle", "a row of locks, like stairs")}
  let c2={pick(k, "a hatch that lets water through", "the water between two locks")}
  let c3={pick(k, "a big door at each end", "the arm that swings a gate")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 32x20 {
    canallock lock level=0.5 boat=0 at=canvas(1, 0)
    text ask "Write the number of what each word means." narrate width=31 below=lock gap=1
    match m left=["{l1}", "{l2}", "{l3}"] right=["{if r == 0 then c2 else if r == 1 then c3 else c1}", "{if r == 0 then c3 else if r == 1 then c1 else c2}", "{if r == 0 then c1 else if r == 1 then c2 else c3}"] blanks=[x, y, z] below=ask gap=1
  }

  answer x=(if r == 0 then 3 else if r == 1 then 2 else 1) y=(if r == 0 then 1 else if r == 1 then 3 else 2) z=(if r == 0 then 2 else if r == 1 then 1 else 3)
  hint "Find each part on the drawing of the lock, or picture a canal with many locks."
  hint "Start with the word you are surest of, then the one left over."
}
