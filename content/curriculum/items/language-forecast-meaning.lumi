# The language to English: [[phrase.tomorrow-it-is-going-to-be-sunny]], [[phrase.in-the-afternoon-there-will-be-storms]], [[phrase.the-temperatures-are-falling]], [[phrase.it-is-twenty-degrees]], [[phrase.it-is-raining-in-the-north]], [[phrase.the-sky-is-clear]].
# The phrase is read on a sign or in a speech bubble, and the English is picked.
item language.forecast-meaning v=1 skills=[language.weather, language.reading] {
  title "What does it mean?"
  difficulty pick(k, 0, 0, 1, 1, 2, 2)
  let k=0..5

  scene 34x35 {
    column all at=canvas(1, 1) space=1 align=start {
      comic said who=[pick(k, "gran", "boy", "girl", "gran", "boy", "girl")] says=[pick(k, "[[phrase.tomorrow-it-is-going-to-be-sunny]]", "[[phrase.in-the-afternoon-there-will-be-storms]]", "[[phrase.the-temperatures-are-falling]]", "[[phrase.it-is-twenty-degrees]]", "[[phrase.it-is-raining-in-the-north]]", "[[phrase.the-sky-is-clear]]")] moods=["happy"] with=[""] thinks=[0] holds=[""] labels=[""]
      text ask "What does this mean in English?" width=32
      choice pick options=[pick(k, "The sky is clear.", "It is twenty degrees.", "In the afternoon there will be storms.", "The sky is clear.", "The sky is clear.", "It is twenty degrees."), pick(k, "Tomorrow it is going to be sunny.", "In the afternoon there will be storms.", "It is raining in the north.", "It is twenty degrees.", "The temperatures are falling.", "The sky is clear."), pick(k, "The temperatures are falling.", "It is raining in the north.", "It is twenty degrees.", "In the afternoon there will be storms.", "It is raining in the north.", "The temperatures are falling."), pick(k, "It is raining in the north.", "The temperatures are falling.", "The temperatures are falling.", "The temperatures are falling.", "It is twenty degrees.", "It is raining in the north.")] stack=column
    }
  }

  answer pick=pick(k, "Tomorrow it is going to be sunny.", "In the afternoon there will be storms.", "The temperatures are falling.", "It is twenty degrees.", "It is raining in the north.", "The sky is clear.")
  hint "Find a part of the [[language.name]] you know. What does that part mean?"
  hint "Read each English choice. Which one would someone say here?"
}
