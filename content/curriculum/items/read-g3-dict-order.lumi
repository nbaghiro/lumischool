# Dictionary order by the first letter, then the second, then the third. All the words are from the
# night sky lesson's world.
item reading.dict-order v=1 skills=[reading.dictionary, reading.alphabetical-order] {
  title "Dictionary order"
  difficulty pick(k, 0, 1, 2, 2)
  let k=0..3

  scene 29x18 {
    column all at=canvas(1, 1) space=1 align=start {
      row top space=2 align=end {
        owlflying o facing=1
        text ask "Number these words in the order a dictionary lists them." width=19
      }
      sequence s items=[pick(k, "owl", "dusk", "shine", "moon"), pick(k, "star", "dark", "shadow", "moth"), pick(k, "comet", "dim", "shut", "meteor"), pick(k, "moon", "dew", "shooting", "mist")] blanks=[p1, p2, p3, p4]
    }
  }

  answer p1=pick(k, 3, 4, 2, 3) p2=pick(k, 4, 1, 1, 4) p3=pick(k, 1, 3, 4, 1) p4=pick(k, 2, 2, 3, 2)
  feedback {
    when (k >= 1 and p1 != pick(k, 3, 4, 2, 3)) point=s {
      say "These words all start with the same letter, so the first letter cannot decide. Look at the next letter along."
    }
  }
  hint "Do the words start with different letters? If they do, order by the first letter."
  hint "When the first letters match, look at the second letter, and then the third."
}
