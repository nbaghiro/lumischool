# How many can be bought, and what is left: division with a remainder, in cents.
item money.pencils-left v=1 skills=[money.decimals, division.remainders] {
  title "How many can you buy?"
  difficulty (10 * d + 100 * d // p)
  let p={15, 20, 25, 30, 35, 40} d=1..3
  where (100 * d % p != 0)
  level easy {
    let d={1}
  }
  level hard {
    let d=2..3
  }

  scene 30x13 {
    pricetag tag now=p was=0 at=canvas(1, 1)
    text ask "A pencil costs {p} cents. You have {d} {if d == 1 then \"dollar\" else \"dollars\"}." width=18 right-of=tag gap=2
    text q1 "How many pencils can you buy?" below=tag gap=2
    number-input count right-of=q1 gap=1
    text q2 "How many cents are left?" below=q1 gap=1
    number-input left right-of=q2 gap=1
  }

  answer count=(100 * d // p) left=(100 * d % p)
  feedback {
    when (count == 100 * d // p + 1) point=tag {
      say "One more pencil would cost more than the money you have left."
    }
  }
  hint "How many cents is {d} {if d == 1 then \"dollar\" else \"dollars\"}?"
  hint "Count up in {p}s without going past it. What is left over?"
}
