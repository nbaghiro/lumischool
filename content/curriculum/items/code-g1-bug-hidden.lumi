# The audit's raise for finding the wrong card: the trail is hidden, so the child walks the program in
# their head, and says the number that mends it. The rocks leave only one card that can be mended.
item coding.bug-hidden v=1 stars=2 skills=[coding.debugging, reasoning.find-the-error] {
  title "A bug with no trail"
  difficulty w
  let w=1..4 e={-1, 1}
  where (not (w == 4 and e == 1))

  scene 33x20 {
    row top at=canvas(1, 0) space=1 align=start {
      blocks b code=["right {if w == 1 then 3 + e else 3}", "down {if w == 2 then 2 + e else 2}", "right {if w == 3 then 2 + e else 2}", "down {if w == 4 then 1 + e else 1}"] numbers=true words=false
      maze g map=["S . . . # .", "# # # . # .", ". . . . . .", ". # # # # F"] code=["right {if w == 1 then 3 + e else 3}", "down {if w == 2 then 2 + e else 2}", "right {if w == 3 then 2 + e else 2}", "down {if w == 4 then 1 + e else 1}"] upto=0 trail=none
    }
    text ask "One card has the wrong number. Which card is it, and what should its number be?" width=30 below=top gap=1
    row ans below=ask gap=1 space=1 align=centre {
      text lb "card"
      choice pick options=[1, 2, 3, 4]
      text ln "number"
      number-input answer width=3
    }
  }

  check coding.runs of=g goal=flag pick=wrong answer=fix
  hint "Walk the robot with a finger, one card at a time. Where does it first hit a rock or miss the path?"
  hint "Which card was it doing then? How far should that card have gone?"
}
