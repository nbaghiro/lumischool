# Checking what someone says against the text, and naming the line that settles it: RL.3.1.
item reading.claim-check v=2 skills=[reading.comprehension, reading.evidence] {
  title "Is Tess right?"
  difficulty (if k == 1 or k == 3 or k == 5 then 1 else 0)
  let k=0..4
  level easy {
    let k={0, 2, 4}  # plainly right or plainly wrong
  }
  level hard {
    let k={1, 3, 5}  # one detail decides, or the passage's words are said another way
  }

  scene 34x20 {
    column all at=canvas(1, 1) space=1 align=start {
      passage p text="The Ling family live on a narrowboat called Otter. It is green with a red door, and there are pots of herbs on the roof. In summer they travel along the canal from town to town. In winter they tie up at the jetty in Brayford, where the water is calm." width=32
      text ask "Tess says: {if k == 0 then \"The boat is called Otter.\" else if k == 1 then \"The boat has a green door.\" else if k == 2 then \"The family live in a house.\" else if k == 3 then \"In summer they stay in one place.\" else if k == 4 then \"In winter they tie up at a jetty.\" else \"In summer the boat moves from town to town.\"} Is Tess right?" width=32
      row q space=2 align=centre {
        choice pick options=["yes", "no"]
        text line "Which line tells you?"
        number-input answer
      }
    }
  }

  answer pick=(if k == 0 or k == 4 or k == 5 then "yes" else "no") answer=(if k == 0 or k == 2 then 1 else if k == 1 then 2 else if k == 3 or k == 5 then 3 else 4)
  hint "Find the sentence that talks about the same thing Tess talks about."
  hint "Does that sentence say what Tess says, or something different?"
}
