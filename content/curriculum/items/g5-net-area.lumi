# The net laid flat with its edges written: the surface area is the six faces added, three pairs.
item solids.net-area v=1 skills=[solids.surface-area, area.rectangles] {
  title "The card in a net"
  difficulty ((l * w + l * h + w * h) / 10)
  let l=3..6 w=2..3 h=1..4
  where (l > w and w != h)
  level easy {
    let l=3..4 w={2} h=1..2
  }
  level hard {
    let l=5..6 w={3} h=3..4
  }

  scene 36x22 {
    net crate solid=cuboid cell=1 l=l w=w h=h unit="cm" at=canvas(1, 1)
    text ask "This is the net of a crate for the market, laid flat. How many square centimetres of card is it?" narrate width=16 right-of=crate gap=2
    row eq below=ask gap=1 space=1 align=centre {
      number-input answer width=5
      text unit "cm²"
    }
  }

  answer (2 * (l * w + l * h + w * h))
  feedback {
    when (answer == l * w + l * h + w * h) point=crate {
      say "That is three faces, one of each size. Every face has a partner the same size."
    }
    when (answer == l * w * h) point=crate {
      say "That is the volume, the cubes inside. The card covers the outside: add the areas of the faces."
    }
  }
  hint "How many rectangles does the net have?"
  hint "Which rectangles are the same size? Find the area of one of each pair."
}
