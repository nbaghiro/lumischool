# The three-star: the fewest full tanks of oxygen for a crew and a stay, at 840 g a person a day
# (NASA). The need is rarely a whole number of tanks, so the answer rounds up, and one more day or
# one more person can need a tank more.
item chem.oxygen-tanks v=1 stars=3 skills=[chemistry.burning, reasoning.constraints] {
  title "How many tanks?"
  difficulty k
  let k=0..3
  let t={pick(k, 2000, 1000, 1500, 2500)}
  let c={pick(k, 2, 1, 3, 2)}
  let d={pick(k, 3, 5, 2, 4)}
  let need={840 * c * d}
  let tanks={ceil(need / t)}
  level easy {
    let k=0..1
  }
  level hard {
    let k=2..3
  }

  scene 35x19 {
    row kit at=canvas(1, 0) space=2 align=end {
      lander l rungs=6
      crater cr count=3
    }
    text ask "Each person uses about 840 g of oxygen a day. The lander's oxygen comes in tanks of {t} g each. A crew of {c} will stay on the moon for {d} days. What is the fewest full tanks they must take?" narrate width=34 below=kit gap=1
    number-input answer below=ask gap=1
  }

  answer tanks
  feedback {
    when (answer == floor(need / t) and answer != tanks) point=l {
      say "Those tanks fall a little short. The crew needs every gram, so round up."
    }
  }
  hint "How many grams does the crew need altogether?"
  hint "How many tanks of {t} g is that?"
  hint "Would a part of a tank be enough, or do they need one more?"
}
