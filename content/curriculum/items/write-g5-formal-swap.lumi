# Chatty words matched to the formal words that replace them in a letter to the director. The
# right-hand list turns with r, so the answer is not 1, 2, 3.
item writing.formal-swap v=1 skills=[writing.letters, writing.formality, writing.vocabulary] {
  title "Swap it for the formal word"
  difficulty k
  let k=0..1 r=0..2
  let s1={pick(k, "Hi Dr Shah,", "get")}
  let s2={pick(k, "loads of", "kids")}
  let s3={pick(k, "Bye for now,", "a bit")}
  let c1={pick(k, "Dear Dr Shah,", "receive")}
  let c2={pick(k, "a great many", "children")}
  let c3={pick(k, "Yours sincerely,", "slightly")}
  level easy {
    let k=0..0
  }
  level hard {
    let k=1..1
  }

  scene 35x19 {
    row top at=canvas(1, 0) space=2 align=end {
      text ask "Leo's first draft to Dr Shah is too chatty. Write the number of the formal words that should replace each chatty one." narrate width=23
      observatory obs open=1
    }
    match m left=["{s1}", "{s2}", "{s3}"] right=["{if r == 0 then c2 else if r == 1 then c3 else c1}", "{if r == 0 then c3 else if r == 1 then c1 else c2}", "{if r == 0 then c1 else if r == 1 then c2 else c3}"] blanks=[x, y, z] below=top gap=1
  }

  answer x=(if r == 0 then 3 else if r == 1 then 2 else 1) y=(if r == 0 then 1 else if r == 1 then 3 else 2) z=(if r == 0 then 2 else if r == 1 then 1 else 3)
  hint "Read each chatty word, then look for the words on the right that mean the same."
  hint "Which formal words could start or end a letter, and which say how many or how much?"
}
