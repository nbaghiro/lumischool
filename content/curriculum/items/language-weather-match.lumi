# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.weather-match v=1 skills=[language.weather] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[weather.it-is-sunny]]", "[[weather.it-is-hot]]", "[[weather.it-is-raining]]"), pick(k, "[[weather.it-is-raining]]", "[[weather.it-is-cold]]", "[[weather.it-is-snowing]]"), pick(k, "[[weather.it-is-snowing]]", "[[weather.it-is-cloudy]]", "[[weather.it-is-hot]]"), pick(k, "[[weather.it-is-windy]]", "[[weather.there-is-a-storm]]", "[[weather.it-is-sunny]]")] right=[pick(k, "it is snowing", "there is a storm", "it is hot"), pick(k, "it is sunny", "it is hot", "it is raining"), pick(k, "it is raining", "it is cold", "it is sunny"), pick(k, "it is windy", "it is cloudy", "it is snowing")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
