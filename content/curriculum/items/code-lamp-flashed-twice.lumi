# Three lamps' programs, and the one with two flashes found; at hard the waits sit between the
# flashes rather than at the end.
item coding.lamp-flashed-twice v=1 skills=[coding.sequences] {
  title "Which lamp flashed twice?"
  difficulty d
  let d=0..1 r=0..2
  let a1={pick(0, "flash short")}
  let a2={pick(d, "flash long", "wait")}
  let a3={pick(d, "wait", "flash long")}
  let b1={pick(0, "flash long")}
  let b2={pick(0, "flash short")}
  let b3={pick(0, "flash short")}
  let c1={pick(d, "flash long", "wait")}
  let c2={pick(d, "wait", "flash long")}
  let c3={pick(0, "wait")}
  let s1={pick(r, "A", "B", "C")}
  let s2={pick(r, "B", "C", "A")}
  let s3={pick(r, "C", "A", "B")}
  level easy {
    let d=0..0
  }
  level hard {
    let d=1..1
  }

  scene 36x28 {
    row lamps space=1 align=start at=canvas(1, 1) {
      program pa code=[if s1 == "A" then a1 else if s1 == "B" then b1 else c1, if s1 == "A" then a2 else if s1 == "B" then b2 else c2, if s1 == "A" then a3 else if s1 == "B" then b3 else c3] title="Lamp 1"
      program pb code=[if s2 == "A" then a1 else if s2 == "B" then b1 else c1, if s2 == "A" then a2 else if s2 == "B" then b2 else c2, if s2 == "A" then a3 else if s2 == "B" then b3 else c3] title="Lamp 2"
    }
    row low space=1 align=start below=lamps gap=1 {
      program pc code=[if s3 == "A" then a1 else if s3 == "B" then b1 else c1, if s3 == "A" then a2 else if s3 == "B" then b2 else c2, if s3 == "A" then a3 else if s3 == "B" then b3 else c3] title="Lamp 3"
      column right space=1 align=start {
        text ask "Three lamps ran their programs. Which lamp flashed exactly twice?" width=18
        choice pick options=["Lamp 1", "Lamp 2", "Lamp 3"] stack=column
      }
    }
  }

  answer pick=(if s1 == "A" then "Lamp 1" else if s2 == "A" then "Lamp 2" else "Lamp 3")
  feedback {
    when (pick != (if s1 == "A" then "Lamp 1" else if s2 == "A" then "Lamp 2" else "Lamp 3")) point=lamps {
      say "Count only the flash lines in each program. A wait is the lamp dark, not a flash."
    }
  }
  hint "Count the flash lines in each lamp's program."
  hint "One lamp flashes three times, one flashes once, and one flashes twice."
}
