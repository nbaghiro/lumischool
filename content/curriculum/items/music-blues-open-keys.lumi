# The three-star count: keys in which the whole blues, I, IV and V, can be played with a guitar's
# open shapes E, A, D, G, C, Em and Am. G (G C D), D (D G A) and A (A D E) work; C needs F, E needs
# B, F needs B flat and B needs F sharp. Of C, G, D: 2. Of C, E, G, A: 2. Of all seven: 3.
item music.blues-open-keys v=1 stars=3 skills=[music.blues, music.chords, reasoning.all-the-ways] {
  title "Keys for open strings"
  difficulty v
  let v=0..2
  let keys={pick(v, "C, G and D major", "C, E, G and A major", "C, D, E, F, G, A and B major")}
  let right={pick(v, 2, 2, 3)}
  level easy {
    let v=0..0
  }
  level hard {
    let v=2..2
  }

  scene 36x27 {
    row top space=2 align=start at=canvas(1, 1) {
      chordbox e tuning=guitar chord=E frets=3 show=fingers name=true letters=false lit=[]
      chordbox a tuning=guitar chord=A frets=3 show=fingers name=true letters=false lit=[]
    }
    text ask "Ben's guitar book has the open shapes E, A, D, G, C, Em and Am, two of them drawn here. The blues needs chords I, IV and V of its key. Of {keys}, in how many can he play the whole blues from his book?" narrate width=34 below=top gap=1
    number-input answer below=ask gap=1
  }

  answer right
  feedback {
    when (answer > right) point=ask {
      say "Check chord IV and chord V of each key, not only chord I. Is each of the three in the book, major and with no sharp or flat?"
    }
    when (answer < right) point=ask {
      say "Some keys work that are easy to miss. Try every key in the list, one at a time."
    }
  }
  hint "For each key, name notes 1, 4 and 5 of its scale."
  hint "Is every one of those three chords in the book? A chord such as F or B needs a shape the book does not have."
  hint "Count the keys where all three are there."
}
