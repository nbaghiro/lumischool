# A panel square on to the sun gives its rated watts in full sun, and the share of that the cloud
# lets through. k picks the rated watts r and the light l, in per cent, the cloud lets through.
item physics.panel-meter v=1 skills=[physics.energy, percentages.of-amounts] {
  title "Under a cloud"
  difficulty (if k <= 1 then 0 else if k <= 3 then 0.5 else 1)
  let k=0..6
  level easy {
    let k={1, 2}
  }
  level hard {
    let k={4, 5, 6}
  }
  let r={pick(k, 200, 300, 300, 400, 400, 500, 300)}
  let l={pick(k, 50, 50, 40, 35, 65, 45, 85)}
  let s={20 + 5 * (k % 2)}

  scene 23x25 {
    solarpanel p sun=s slope=(90 - s) rated=r light=l marks=1 show=0 at=canvas(1, 0)
    text ask "This panel faces the sun square on. The plate says it gives {r} W in full sun. What will the meter read with the cloud in front of the sun?" narrate width=21 below=p gap=1
    number-input watts below=ask gap=1
  }

  check physics.energy of=p watts=watts
  feedback {
    when (watts == r) point=p {
      say "That is full sun. Read what the cloud lets through."
    }
    when (watts == r - l) point=p {
      say "The cloud lets through a share of the light, {l} in every 100. Find that share of {r}."
    }
  }
  hint "How much of the light does the cloud let through?"
  hint "What is {l} per cent of {r} W?"
}
