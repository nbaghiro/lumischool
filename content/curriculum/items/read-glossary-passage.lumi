# A glossary used on a passage: the hard word is looked up, and its meaning answers a question
# the passage's own words do not.
item reading.glossary-passage v=1 skills=[reading.text-features, reading.vocabulary] {
  title "Use the glossary"
  difficulty (if k == 1 or k == 3 then 1 else 0)
  let k=0..3
  let q={pick(k, "What swam past the boat?", "Who kept close to their mothers?", "Where did the spray come from?", "What was the sea doing by then?")}
  let right={pick(k, "a group of whales", "young whales", "a breathing hole", "going out")}
  level easy {
    let k={0, 2}
  }
  level hard {
    let k={1, 3}
  }

  scene 36x28 {
    column all at=canvas(1, 1) space=1 align=start {
      passage p text="A pod swam past the boat. The calves kept close to their mothers, and one blew spray from its blowhole. By then the tide was going out." width=34 numbers=false
      text ask "{q} Use the glossary." narrate width=34
      row low space=1 align=start {
        table gloss cols=2 head=["Word", "Meaning"] cells=["blowhole", "breathing hole", "calf", "a young whale", "krill", "tiny shrimps", "pod", "a whale group", "tide", "sea in and out"]
        choice pick options=["a group of whales", "young whales", "a breathing hole", "going out"] stack=column
      }
    }
  }

  answer pick=right
  feedback {
    when (pick != right) point=gloss {
      say "{if k == 0 then \"Find pod in the glossary.\" else if k == 1 then \"Calves is the plural of calf. Find calf in the glossary.\" else if k == 2 then \"Find blowhole in the glossary.\" else \"Find tide in the glossary, then read the passage's last sentence again.\"}"
    }
  }
  hint "Find the hard word in the passage first, then find it in the glossary."
  hint "{if k == 1 then \"The glossary lists calf, and calves means more than one calf.\" else if k == 3 then \"The tide is the sea coming in and going out, and the passage says which.\" else \"The meaning column says what the word is.\"}"
}
