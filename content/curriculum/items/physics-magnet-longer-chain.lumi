# The way in: two magnets holding chains of paper clips of one size, and which of them holds more.
# At d=0 to 3 the chains are far apart or plainly equal; at d=4 to 7 they differ by one or two.
item physics.magnet-longer-chain v=1 skills=[physics.magnets, reasoning.compare] {
  title "Which magnet holds more?"
  difficulty (if d < 4 then 0 else 1)
  let d=0..7
  let a={pick(d, 7, 3, 6, 4, 5, 6, 4, 7)}
  let b={pick(d, 3, 8, 2, 4, 7, 5, 5, 7)}
  let ans={pick(d, "A", "B", "A", "They hold the same", "B", "A", "B", "They hold the same")}
  level easy {
    let d=0..3
  }
  level hard {
    let d=4..7
  }

  scene 21x36 {
    row pair space=3 align=start at=canvas(1, 0) {
      magnet one mode=chain clips=a clip=1 tag="A"
      magnet two mode=chain clips=b clip=1 tag="B"
    }
    text ask "Each magnet holds a chain of paper clips. Which magnet holds more?" narrate width=20 below=pair gap=1
    choice pick options=["A", "B", "They hold the same"] stack=column below=ask gap=1
  }

  answer pick=ans
  feedback {
    when (pick != ans and a == b) point=pair {
      say "Count both chains again. They have the same number of clips."
    }
  }
  hint "Count the clips in each chain, one at a time."
  hint "The magnet with the longer chain is holding more."
}
