# The other way round from naming a ringed string: the letter is given and the number is counted
# from the thinnest string, which is on the right of the card.
item music.uke-number-of v=1 skills=[music.uke-strings] {
  title "The number of a string"
  difficulty (if L == "G" then 2 else if L == "C" then 1 else 0)
  let L={"G", "C", "E"}
  level easy {
    let L={"C", "E"}
  }
  level hard {
    let L={"G", "C"}
  }

  scene 26x15 {
    chordbox box tuning=uke chord=none places=[] frets=3 show=dots name=false letters=true lit=[] at=canvas(1, 1)
    text ask "String 1 is A, the thinnest. What number is the {L} string?" width=13 right-of=box gap=1
    number-input answer below=ask gap=1
  }

  answer (if L == "G" then 4 else if L == "C" then 3 else 2)
  feedback {
    when (answer == (if L == "G" then 1 else if L == "C" then 2 else 3)) point=box {
      say "That counts from the left. String 1 is A, on the right, so count from there."
    }
  }
  hint "Which side of the card is the A string on?"
  hint "Count from A: A is 1. Keep going until you reach {L}."
}
