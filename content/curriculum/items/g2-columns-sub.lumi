item columns.sub-two-digit v=1 skills=[subtraction.columns] {
  title "Taking away with an exchange"
  difficulty a
  let a=32..89 b=14..49
  where (a > b)
  where (a % 10 < b % 10)
  level easy {
    let a=32..59 b=14..29
  }
  level hard {
    let a=70..89 b=35..49
  }

  scene 22x11 {
    columns diff a=a b=b op=sub at=canvas(1, 1)
    text ask "There are not enough ones, so take a ten across first." width=20 below=diff gap=1
  }

  answer diff=(a - b)
  feedback {
    when (diff == a - b + 10) point=diff {
      say "The ten you borrowed has to come off the tens column as well."
    }
  }
  hint "Cross out the tens digit, write one less, and give those ten to the ones."
}
