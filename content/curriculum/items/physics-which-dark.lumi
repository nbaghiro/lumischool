item physics.which-dark v=1 skills=[physics.circuits] stars=1 {
  title "Which one stays dark?"
  difficulty (if f == 2 then 4 else if f == 3 then 2 else if f == 1 then 1 else 0)
  let w=0..1 f=1..3 c=1..2
  level easy {
    let f={1, 3}
  }
  level hard {
    let f={2}
  }

  scene 35x18 {
    row two at=canvas(1, 0) space=2 align=start {
      series a cells=(if w == 0 and f == 3 then 0 else c) closed=(if w == 0 and f == 1 then 0 else 1) loose=(if w == 0 and f == 2 then 1 else 0) show=0 tag="A"
      series b cells=(if w == 1 and f == 3 then 0 else 3 - c) closed=(if w == 1 and f == 1 then 0 else 1) loose=(if w == 1 and f == 2 then 1 else 0) show=0 tag="B"
    }
    text ask "One of these will not light. Which one?" width=18 below=two gap=1
    choice pick options=["A", "B"] right-of=ask gap=2
  }

  check physics.circuit of=a vs=b pick=dark
  hint "Follow each loop round with your finger. Where does it stop?"
}
