# Four bubbles of one conversation, shuffled: each reply has to follow the thing it answers.
item writing.speech-order v=1 skills=[writing.speech, writing.sequencing] {
  title "Who spoke first?"
  difficulty c
  let c=0..1 q=0..2
  let a={if c == 0 then "Is that an apple tree?" else "What is in your bag?"}
  let b={if c == 0 then "Yes, and the apples are ripe." else "It is a surprise for Gran."}
  let x={if c == 0 then "Can I have one?" else "What kind of surprise?"}
  let d={if c == 0 then "Of course. Take two." else "A cake, but do not tell her."}
  let s1={if q == 0 then x else if q == 1 then b else d}
  let s2={if q == 0 then a else if q == 1 then d else x}
  let s3={if q == 0 then d else if q == 1 then a else b}
  let s4={if q == 0 then b else if q == 1 then x else a}

  scene 30x18 {
    text ask "Two friends are talking. Put what they say in order. Write 1 to 4 in the boxes." narrate width=28 at=canvas(1, 1)
    sequence s items=["{s1}", "{s2}", "{s3}", "{s4}"] blanks=[p1, p2, p3, p4] below=ask gap=1
  }

  answer p1=(if q == 0 then 3 else if q == 1 then 2 else 4) p2=(if q == 0 then 1 else if q == 1 then 4 else 3) p3=(if q == 0 then 4 else if q == 1 then 1 else 2) p4=(if q == 0 then 2 else if q == 1 then 3 else 1)
  hint "Which bubble starts the talk? It is a question nobody has asked about yet."
  hint "Find the answer to that question. What does the first friend say back?"
}
