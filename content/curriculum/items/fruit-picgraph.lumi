item graph.pictures v=1 skills=[data.picture-graphs] {
  title "Fruit chart"
  difficulty (a - b)
  let a=3..6 b=1..5 c=1..6
  where (a > b)
  where (a != c and b != c)
  level easy {
    let a=3..4 b=1..3
  }
  level hard {
    let a=5..6 b=1..2
  }

  scene 32x11 {
    text ask "Each star is one child. How many more chose apples than pears?" width=30 at=canvas(1, 0)
    picgraph g labels=["Apples", "Pears", "Plums"] counts=[a, b, c] prop=star below=ask gap=1
    number-input answer right-of=g gap=2
  }

  answer (a - b)
  feedback {
    when (answer == a + b) point=g.row(1) {
      say "That is both rows together. The question asks how many more."
    }
    when (answer == a) point=g.row(0) {
      say "That is the apples row. Take the pears away from it."
    }
  }
}
