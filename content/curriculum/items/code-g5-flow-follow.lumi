# The way in to a flowchart: a counter set, a loop that adds, and a say at the end. The diamond asks
# before every round, so the arrows go round the loop as many times as the repeat's number.
item coding.flow-follow v=1 skills=[coding.flowcharts, coding.repetition, coding.tracing] {
  title "Follow the arrows"
  difficulty ((r - 2) * 0.6 + (if b == 5 then 0.5 else 0))
  let a=1..3 r=2..4 b={2, 3, 5}
  level easy {
    let r={2} b={2, 3}
  }
  level hard {
    let r={4}
  }

  scene 36x24 {
    flowchart f code=["set photos to {a}", "repeat {r}", "  add {b} to photos", "say photos"] at=canvas(0, 0)
    telescope tel tilt=40 right-of=f gap=2
    text ask "The telescope keeps count of its photos with this flowchart. Follow the arrows from start to stop. What number does it say?" width=20 below=tel gap=1
    number-input answer below=ask gap=1
  }

  check coding.runs of=f answer="value(photos)"
  feedback {
    when (answer == a + (r - 1) * b) point=f {
      say "The diamond asks before every round, so the arrows go round the loop {r} times. Count the rounds again."
    }
    when (answer == r * b) point=f {
      say "photos does not start at 0. Look at the first box under start."
    }
  }
  hint "What does photos hold after the first box? Write it down."
  hint "Each time an arrow comes back up to the diamond, one round is done. How many rounds before it says yes?"
}
