# Four words to their English, 3 sets, the later sets with the words most often mixed up.
item language.jobs-match v=1 skills=[language.sentences, language.opinions] {
  title "Match the words"
  difficulty pick(k, 0, 1, 2)
  let k=0..2

  scene 34x19 {
    column all at=canvas(1, 1) space=1 align=start {
      text ask "Write the number of its English next to each [[language.name]] word." width=32
      match m left=[pick(k, "[[job.the-doctor]]", "[[job.the-hospital]]", "[[job.to-work]]"), pick(k, "[[job.the-pilot]]", "[[job.the-farm]]", "[[job.to-look-after]]"), pick(k, "[[job.the-cook]]", "[[job.the-office]]", "[[job.to-teach]]"), pick(k, "[[job.the-teacher]]", "[[job.the-restaurant]]", "[[job.to-make-better]]")] right=[pick(k, "the cook", "the restaurant", "to teach"), pick(k, "the doctor", "the hospital", "to work"), pick(k, "the pilot", "the farm", "to make better"), pick(k, "the teacher", "the office", "to look after")] blanks=[a, b, c, d]
    }
  }

  answer a=2 b=pick(k, 3, 3, 4) c=pick(k, 1, 4, 1) d=pick(k, 4, 1, 3)
  hint "Start with the word you are surest of, and cross its English off."
  hint "Two words look alike. Which letter is different, and what does it change?"
}
