# The way in: the chord chart of a song, one chord to a bar, and the bars of G counted. London Bridge
# has G in bars 3 and 7; Skip to My Lou in bars 3, 4 and 7 (both traditional).
item music.song-g-bars v=1 skills=[music.chord-changes] {
  title "Bars of G"
  let s=0..1
  let song={pick(s, "London Bridge", "Skip to My Lou")}
  let w1={pick(s, "Lon-don Bridge is", "Lou, lou,")}
  let w2={pick(s, "fall-ing down,", "skip to my lou,")}
  let w3={pick(s, "fall-ing down,", "Lou, lou,")}
  let w4={pick(s, "fall-ing down.", "skip to my lou,")}
  let w5={pick(s, "Lon-don Bridge is", "Lou, lou,")}
  let w6={pick(s, "fall-ing down,", "skip to my lou,")}
  let w7={pick(s, "my fair", "skip to my lou, my")}
  let w8={pick(s, "la-dy.", "dar-ling.")}
  let c4={pick(s, "C", "G")}

  scene 36x26 {
    row chart space=2 align=start at=canvas(1, 1) {
      table bars cols=2 head=["Bar", "Chord"] cells=["1", "C", "2", "C", "3", "G", "4", c4, "5", "C", "6", "C", "7", "G", "8", "C"]
      table words cols=1 head=["{song}"] cells=[w1, w2, w3, w4, w5, w6, w7, w8]
    }
    text ask "Ben plays {song} from this chart. How many bars of G are there?" narrate width=34 below=chart gap=1
    number-input answer below=ask gap=1
  }

  answer pick(s, 2, 3)
  feedback {
    when (answer == 8 - pick(s, 2, 3)) point=bars {
      say "That counts the bars of C. Count only the bars whose chord is G."
    }
  }
  hint "Run down the chord column and point at every G."
  hint "Two bars side by side can both be G. Count each one."
}
