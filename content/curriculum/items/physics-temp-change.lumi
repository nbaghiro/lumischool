item physics.temp-change v=1 skills=[physics.heat] {
  title "How much warmer?"
  difficulty ((b - a) / 5 + (if a % 10 == 0 and b % 10 == 0 then 0 else 2))
  let a={5, 10, 15, 20} b={20, 25, 30, 35}
  where (b > a)
  level easy {
    let a={10, 20} b={20, 30}
  }
  level hard {
    let a={5, 15} b={25, 35}
  }

  scene 32x16 {
    thermometer one from=0 to=40 step=10 value=a unit="C" at=canvas(1, 0)
    text la "morning" below=one gap=0
    thermometer two from=0 to=40 step=10 value=b unit="C" right-of=one gap=2
    text lb "afternoon" below=two gap=0
    text ask "How many degrees warmer was it in the afternoon?" width=10 right-of=two gap=1
    number-input answer below=ask gap=1
  }

  answer (b - a)
  feedback {
    when (answer == b) point=two {
      say "That is the afternoon's reading. How far did it climb from the morning's?"
    }
  }
  hint "What did each thermometer read?"
}
