# A power of ten written with its little number: ten multiplied by itself that many times, which is
# a one with that many zeros.
item place.power-value v=1 skills=[place-value.powers-of-ten] {
  title "Ten to the power"
  difficulty (k + (if a > 1 then 1 else 0))
  let k=3..9 a={1, 3, 4, 7}
  level easy {
    let k=3..5 a={1}
  }
  level hard {
    let k=7..9 a={3, 4, 7}
  }

  scene 30x13 {
    observatory dome open=1 at=canvas(1, 1)
    text ask "10 multiplied by itself {k} times is written 10 to the power {k}. Write {if a > 1 then \"{a} × \" else \"\"}10 to the power {k} as an ordinary number." narrate width=18 right-of=dome gap=2
    number-input answer width=11 below=dome gap=1
  }

  answer (a * 10 ^ k)
  feedback {
    when (answer == a * 10 ^ (k - 1) or answer == a * 10 ^ (k + 1)) point=ask {
      say "Count the zeros again: 10 to the power {k} has exactly {k} of them."
    }
    when (answer == a * 10 * k) point=ask {
      say "That is 10 × {k}. The power says how many tens are multiplied together."
    }
  }
  hint "What is 10 × 10? And 10 × 10 × 10? How many zeros each time?"
  hint "How many zeros does 10 to the power {k} have?"
}
