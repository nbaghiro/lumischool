# Each word matched to its opposite, the pairs England's Year 1 lists. The opposites are shuffled
# four ways, none of them 1, 2, 3, 4 or a turn of it, so one answer does not give the rest.
item chem.property-match v=2 skills=[chemistry.materials] {
  title "Opposites"
  difficulty k
  let k=0..3

  scene 27x16 {
    text ask "Write the number of the opposite next to each word." width=26 at=canvas(1, 1)
    match m left=["hard", "stretchy", "shiny", "see-through"] right=["{if k == 0 then \"dull\" else if k == 1 then \"stiff\" else if k == 2 then \"not see-through\" else \"dull\"}", "{if k == 0 then \"soft\" else if k == 1 then \"not see-through\" else if k == 2 then \"dull\" else \"not see-through\"}", "{if k == 0 then \"not see-through\" else if k == 1 then \"soft\" else if k == 2 then \"soft\" else \"stiff\"}", "{if k == 0 then \"stiff\" else if k == 1 then \"dull\" else if k == 2 then \"stiff\" else \"soft\"}"] blanks=[a, b, c, d] below=ask gap=1
  }

  answer a=(if k == 0 then 2 else if k == 1 then 3 else if k == 2 then 3 else 4) b=(if k == 0 then 4 else if k == 1 then 1 else if k == 2 then 4 else 3) c=(if k == 0 then 1 else if k == 1 then 4 else if k == 2 then 2 else 1) d=(if k == 0 then 3 else if k == 1 then 2 else if k == 2 then 1 else 2)
  hint "Start with the one you are surest of. What is the opposite of hard?"
  hint "A thing that is not shiny looks flat and plain. Which word says that?"
}
