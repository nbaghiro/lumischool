{
    "name": "lumischool",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "A family can teach a full year of maths without preparing anything",
    "scripts": {
        "mail:weekly": "node --import ./tools/scripts/resolve.ts server/mail-job.ts",
        "mail:previews": "node --import ./tools/scripts/resolve.ts tools/scripts/mail-previews.ts",
        "mail:review": "node --import ./tools/scripts/resolve.ts tools/scripts/mail-review.ts",
        "db:up": "bash tools/scripts/db-up.sh",
        "db:down": "docker compose down",
        "db:generate": "drizzle-kit generate",
        "db:check": "drizzle-kit check",
        "db:migrate": "node --import ./tools/scripts/resolve.ts server/db/migrations/migrate.ts",
        "dev": "node --import ./tools/scripts/resolve.ts tools/scripts/dev.ts",
        "dev:web": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite",
        "dev:api": "LUMISCHOOL_ENV=local node --env-file-if-exists=.env --import ./tools/scripts/resolve.ts server/http.ts",
        "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build",
        "start": "node --import ./tools/scripts/resolve.ts server/http.ts",
        "db:reset": "bash tools/scripts/db-reset.sh",
        "db:psql": "docker compose exec postgres psql -U lumischool -d lumischool",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:suppressions": "node --import ./tools/scripts/resolve.ts tools/scripts/check-suppressions.ts",
        "check:boundaries": "node --import ./tools/scripts/resolve.ts tools/scripts/check-boundaries.ts && node --import ./tools/scripts/resolve.ts tools/scripts/check-boundaries.ts --selftest > /dev/null",
        "check:voice": "node --import ./tools/scripts/resolve.ts tools/scripts/check-voice.ts --run && node --import ./tools/scripts/resolve.ts tools/scripts/check-voice.ts --selftest > /dev/null",
        "check:journeys": "node --import ./tools/scripts/resolve.ts tools/scripts/check-journeys.ts",
        "check:db": "node --import ./tools/scripts/resolve.ts tools/scripts/check-db.ts && node --import ./tools/scripts/resolve.ts tools/scripts/check-db.ts --selftest > /dev/null",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:suppressions && npm run check:boundaries && npm run check:voice && npm run check:journeys && npm run db:check && npm run check:db && npm run test:unit && npm run test:integration",
        "check:print": "node --import ./tools/scripts/resolve.ts tools/scripts/check-print.ts",
        "test:unit": "env -u GEMINI_API_KEY -u GOOGLE_API_KEY -u TUTORING_ENABLED -u TAVUS_API_KEY -u RESEND_API_KEY node --import ./tools/scripts/resolve.ts --test --test-concurrency=4 'apps/*/__tests__/*.test.ts' 'engine/**/__tests__/*.test.ts' 'school/**/__tests__/*.test.ts' 'server/**/__tests__/*.test.ts' 'tools/**/__tests__/*.test.ts'",
        "test:integration": "env -u GEMINI_API_KEY -u GOOGLE_API_KEY -u TUTORING_ENABLED -u TAVUS_API_KEY -u RESEND_API_KEY node --import ./tools/scripts/resolve.ts --test --test-concurrency=1 'server/**/__tests__/*.itest.ts'",
        "test:e2e": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 playwright test --config tools/e2e/playwright.config.ts",
        "brand:export": "node --import ./tools/scripts/resolve.ts tools/brand.ts",
        "brand:mobile": "node --import ./tools/scripts/resolve.ts tools/brand.ts --mobile",
        "art": "node --import ./tools/scripts/resolve.ts tools/scripts/art.ts",
        "pack": "node --import ./tools/scripts/resolve.ts tools/pack.ts",
        "languages:coverage": "node --import ./tools/scripts/resolve.ts tools/scripts/language-coverage.ts",
        "levels:baseline": "node --import ./tools/scripts/resolve.ts tools/scripts/levels-baseline.ts",
        "map:snapshots": "node --import ./tools/scripts/resolve.ts tools/scripts/map-snapshots.ts",
        "perf:games": "node --import ./tools/scripts/resolve.ts tools/scripts/perf-games.ts",
        "map:tiles": "node --import ./tools/scripts/resolve.ts tools/scripts/map-tiles.ts",
        "art:bake": "node --import ./tools/scripts/resolve.ts tools/scripts/art-bake.ts",
        "site:pictures": "node --import ./tools/scripts/resolve.ts tools/scripts/site-pictures.ts",
        "mobile:art": "node --import ./tools/scripts/resolve.ts tools/scripts/mobile-art.ts"
    },
    "dependencies": {
        "@fontsource-variable/shantell-sans": "^5.3.0",
        "@fontsource-variable/spline-sans-mono": "^5.3.0",
        "@fontsource/andika": "^5.3.0",
        "drizzle-orm": "^0.45.2",
        "perfect-freehand": "^1.2.3",
        "planck": "1.5.0",
        "postgres": "^3.4.7",
        "roughjs": "^4.6.6",
        "solid-js": "^1.9.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@resvg/resvg-js": "^2.6.2",
        "@types/node": "^24.10.1",
        "drizzle-kit": "^0.31.6",
        "oxlint": "^1.82.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vite-plugin-solid": "^2.11.14"
    }
}
